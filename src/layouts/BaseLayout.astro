---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string; // e.g. "/things-to-do/falls-park"
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[]; // JSON-LD, single object or multiple
  noindex?: boolean; // for private pages like /admin, /login — keeps them out of Google entirely
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  // The page's main photo. Preloading it lets the browser start downloading it
  // before the CSS is parsed, which is what Google's Largest Contentful Paint measures.
  preloadImage?: { href: string; srcset?: string; sizes?: string };
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/images/og-default.jpg',
  schema,
  noindex = false,
  ogImageAlt,
  ogType = 'website',
  preloadImage,
} = Astro.props;

// Search Console ownership check. Paste the code Google gives you (the
// content="..." part of the HTML tag) into the GOOGLE_SITE_VERIFICATION
// environment variable in Netlify, then redeploy.
const googleVerification = (process.env.GOOGLE_SITE_VERIFICATION || '9OPhAnWH2t9zzJrCLzJOlNuT0stwwzwaaCBPvbWQ8Q0').replace(/^.*content="([^"]+)".*$/s, '$1').trim();
const preloadOrigin = preloadImage?.href.startsWith('https://') ? new URL(preloadImage.href).origin : null;

// DNS has switched — confirmed by directly fetching siouxfallsgo.com and
// verifying it serves the real, current site (not the old WordPress site
// anymore). Canonical URLs now correctly point to the real production
// domain instead of the netlify.app subdomain.
const site = 'https://siouxfallsgo.com';
const canonicalURL = new URL(canonicalPath, site).toString();

// Sioux Falls, SD — real coordinates, used for geo meta tags sitewide.
const GEO = { lat: '43.5460', lng: '-96.7313', region: 'US-SD', placename: 'Sioux Falls' };

// Included on every page alongside page-specific schema, so AI engines and
// search engines have a consistent answer to "what is this site" no matter
// which page they land on first.
const ORG_SCHEMA = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sioux Falls Go',
  url: site,
  description: 'A local directory and guide for Sioux Falls, South Dakota — real vetted businesses, real events, and real local guides.',
  areaServed: { '@type': 'City', name: 'Sioux Falls', containedInPlace: { '@type': 'State', name: 'South Dakota' } },
};

// WebSite schema tells Google the site's name and how its search works,
// which is what can show a site name and search box in results.
const WEBSITE_SCHEMA = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sioux Falls Go',
  url: site,
  potentialAction: { '@type': 'SearchAction', target: `${site}/search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [ORG_SCHEMA, WEBSITE_SCHEMA, ...pageSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Sioux Falls Go</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <link rel="canonical" href={canonicalURL} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {preloadOrigin && <link rel="preconnect" href={preloadOrigin} crossorigin />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <link rel="alternate" type="application/rss+xml" title="Sioux Falls Go Guides" href="/rss.xml" />

    <meta name="geo.position" content={`${GEO.lat};${GEO.lng}`} />
    <meta name="geo.placename" content={GEO.placename} />
    <meta name="geo.region" content={GEO.region} />
    <meta name="ICBM" content={`${GEO.lat}, ${GEO.lng}`} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content="Sioux Falls Go" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />

    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-river);
    color: var(--color-bluff);
    padding: 0.75rem 1.25rem;
    z-index: 100;
  }
  .skip-link:focus {
    left: var(--space-2);
    top: var(--space-2);
  }
</style>
