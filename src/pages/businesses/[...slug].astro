  .related-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(13,23,48,0.12); }
  .related-media { height: 7rem; background: linear-gradient(135deg, #16233d, #2c3f61); background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; color: #fff; }
