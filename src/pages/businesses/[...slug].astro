---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map((business) => ({
    params: { slug: business.id },
    props: { business },
  }));
}

const { business } = Astro.props;
const { Content } = await render(business);
const category = await getEntry(business.data.category);
const neighborhood = business.data.neighborhood ? await getEntry(business.data.neighborhood) : null;
const isChampion = business.data.partnershipTier === 'community-champion';

// Related guides: same category
const allArticles = await getCollection('articles');
const relatedGuides = allArticles.filter(
  (a) => a.data.category.id === business.data.category.id && a.data.contentType !== 'business-spotlight'
);

// Spotlights written about this specific business — premium feature
const spotlights = allArticles.filter(
  (a) =>
    (a.data.contentType === 'business-spotlight' || a.data.contentType === 'press-release') &&
    a.data.relatedBusinesses.some((ref) => ref.id === business.id)
);

// "Verified" = we've confirmed this business's info recently — distinct from partnership tier
const isVerified = !!business.data.verifiedAt;

// Smart CTA — the button label and action change based on the business's
// real category, instead of one generic "Get a Quote" for every industry.
const TRADE_CATEGORIES = [
  'plumbers', 'electricians', 'painters', 'lawn-care', 'local-tree-services',
  'window-cleaning', 'flooring', 'home-watch-services', 'appliance-repair-service',
  'cleaning-services', 'home-services',
];
const CONSULT_CATEGORIES = ['marketing-agencies', 'real-estate-agents', 'professional-services', 'accountants', 'business-consulting', 'attorneys', 'business-coaches', 'wedding-planners'];
const MENU_CATEGORIES = ['restaurants-dining', 'fine-dining', 'bakeries', 'bars-and-pubs', 'breakfast-and-brunch', 'ice-cream-and-dessert', 'food-trucks'];
const DIRECTIONS_CATEGORIES = ['coffee-shops', 'shopping-retail'];
const APPOINTMENT_CATEGORIES = [
  'dentists', 'chiropractors', 'physical-therapy', 'massage-therapy',
  'mental-health-services', 'medical-clinics', 'optometrists',
  'fitness-centers', 'yoga-studios', 'nutritionists',
  'hair-salons', 'barbershops', 'nail-salons', 'spas', 'tattoo-studios', 'skin-care-clinics',
];

function getSmartCTA(categorySlug: string, biz: typeof business.data) {
  const mapsHref = biz.latitude && biz.longitude
    ? `https://maps.google.com/?q=${biz.latitude},${biz.longitude}`
    : biz.address
      ? `https://maps.google.com/?q=${encodeURIComponent(biz.address)}`
      : null;
  if (MENU_CATEGORIES.includes(categorySlug)) {
    if (biz.website) return { label: 'View Menu', href: biz.website, external: true };
    // No website on file — Get Directions is still far more useful for a
    // restaurant than a generic quote form, which doesn't apply here at all.
    if (mapsHref) return { label: 'Get Directions', href: mapsHref, external: true };
  }
  if (DIRECTIONS_CATEGORIES.includes(categorySlug) && mapsHref) {
    return { label: 'Get Directions', href: mapsHref, external: true };
  }
  if (APPOINTMENT_CATEGORIES.includes(categorySlug)) {
    return { label: 'Book an Appointment', href: '#quote-section', external: false };
  }
  if (CONSULT_CATEGORIES.includes(categorySlug)) {
    return { label: 'Schedule a Consultation', href: '#quote-section', external: false };
  }
  // Trades and anything unmapped default to the quote form, the most broadly useful action
  return { label: 'Get a Free Quote', href: '#quote-section', external: false };
}
const smartCTA = getSmartCTA(category.data.slug, business.data);

// Featured testimonial — the first real review, if any exist, to give
// immediate social proof right after the story instead of only at the
// bottom of the page.
const featuredReview = business.data.reviews[0] ?? null;

// Related businesses — same category, excluding this one. Free tier only,
// per the product decision: Champion profiles don't route attention away.
const allBusinesses = await getCollection('businesses');
const relatedBusinesses = allBusinesses
  .filter((b) => b.id !== business.id && b.data.category.id === business.data.category.id)
  .slice(0, 3);

const daysOfWeek: Array<{ key: 'mon' | 'tue' | 'wed' | 'thu' | 'fri' | 'sat' | 'sun'; label: string }> = [
  { key: 'mon', label: 'Monday' },
  { key: 'tue', label: 'Tuesday' },
  { key: 'wed', label: 'Wednesday' },
  { key: 'thu', label: 'Thursday' },
  { key: 'fri', label: 'Friday' },
  { key: 'sat', label: 'Saturday' },
  { key: 'sun', label: 'Sunday' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.data.name,
  address: business.data.showAddress ? business.data.address : undefined,
  telephone: business.data.phone,
  url: business.data.website,
};
---
<BaseLayout
  title={business.data.seo?.title || business.data.name}
  description={business.data.seo?.description || `${business.data.name} — ${category.data.name} in Sioux Falls. Hours, contact info, and services.`}
  canonicalPath={`/businesses/${business.id}`}
  schema={schema}
>
  <SiteHeader slot="header" />

  <div class="champion-hero-v2" style={business.data.heroImage ? `background-image: linear-gradient(155deg, rgba(22,35,61,0.55), rgba(61,90,133,0.45)), url(${business.data.heroImage}); background-size: cover; background-position: center;` : undefined}>
    <div class="champion-hero-glow"></div>
    <div class="container champion-hero-inner-v2">
      <p class="hero-status">
        {isVerified ? <span class="status-verified"><Icon name="check" size={13} /> Verified</span> : <span class="status-unverified"><Icon name="clock" size={13} /> Not Verified</span>}
        {(business.data.partnershipTier === 'community-listing' || business.data.partnershipTier === 'community-champion') && <> · Give Back Partner</>}
      </p>
      <p class="hero-service-label"><a href={`/${category.data.slug}`} class="category-link">{category.data.name}</a> in Sioux Falls</p>
      <h1>{business.data.name}</h1>
      <div class="hero-cta-row">
        {smartCTA.external ? (
          <a href={smartCTA.href} target="_blank" rel="nofollow noopener" class="hero-cta-primary">{smartCTA.label} →</a>
        ) : (
          <a href={smartCTA.href} class="hero-cta-primary">{smartCTA.label} →</a>
        )}
        {business.data.googleRating && (
          <span class="hero-cta-rating"><Icon name="star" size={13} /> {business.data.googleRating.toFixed(1)} ({business.data.googleReviewCount} reviews)</span>
        )}
      </div>
    </div>
  </div>

  <!-- Mobile-only sticky Call + smart CTA bar -->
  <div class="hero-sticky-bar">
    {business.data.phone && (
      <a href={`tel:${business.data.phone.replace(/[^\d+]/g, '')}`} class="hero-sticky-cta hero-sticky-cta--call"><Icon name="phone" size={14} /> Call Now</a>
    )}
    {smartCTA.external ? (
      <a href={smartCTA.href} target="_blank" rel="nofollow noopener" class="hero-sticky-cta"><Icon name="clipboard" size={14} /> {smartCTA.label}</a>
    ) : (
      <a href={smartCTA.href} class="hero-sticky-cta"><Icon name="clipboard" size={14} /> {smartCTA.label}</a>
    )}
  </div>

  {!business.data.claimed && (
    <div class="claim-banner">
      <div class="container claim-banner-inner">
        <p><Icon name="megaphone" size={16} /> Own this business? This listing hasn't been claimed yet.</p>
        <a href={`mailto:hello@siouxfallsgo.com?subject=${encodeURIComponent(`Claim my listing: ${business.data.name}`)}`} class="claim-banner-cta">Claim This Listing →</a>
      </div>
    </div>
  )}

  <div class="trust-bar">
    <div class="container trust-bar-inner">
      <div class="trust-stats">
        {business.data.googleRating && (
          <span class="trust-stat"><Icon name="star" size={14} class="filled-star" /> {business.data.googleRating.toFixed(1)} ({business.data.googleReviewCount} reviews)</span>
        )}
        {business.data.hoursSchedule && (
          <p class="trust-stat open-now-indicator" id="open-now-indicator-trust" hidden></p>
        )}
        {business.data.responseTime && (
          <span class="trust-stat"><Icon name="zap" size={14} /> Usually responds {business.data.responseTime}</span>
        )}
      </div>
      {smartCTA.external ? (
        <a class="btn btn--primary" href={smartCTA.href} target="_blank" rel="nofollow noopener">{smartCTA.label}</a>
      ) : (
        <a class="btn btn--primary" href={smartCTA.href}>{smartCTA.label}</a>
      )}
    </div>
  </div>

  <div class="container page">
    <div class="tabs" role="tablist">
      <button class="tab is-active" data-tab="story" role="tab">Story</button>
      <button class="tab" data-tab="photos" role="tab">Photos</button>
      <button class="tab" data-tab="specials" role="tab">Specials</button>
    </div>

    <div class="champion-grid-v2">
      <div class="champion-main">
        <div class="tab-panel is-active" data-panel="story">
          {business.data.pullQuote && <blockquote class="pull-quote-v2">"{business.data.pullQuote}"</blockquote>}
          <div class="prose"><Content /></div>

          {featuredReview && (
            <>
              <div class="testimonial-feature">
                <div class="review-stars">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <Icon name="star" size={16} class={i < featuredReview.rating ? 'star-filled' : 'star-empty'} />
                  ))}
                </div>
                <blockquote>"{featuredReview.text}"</blockquote>
                <cite>— {featuredReview.author}{featuredReview.date && `, ${featuredReview.date}`}</cite>
              </div>
              {business.data.reviews.length > 1 && (
                <a class="more-reviews-link" href="#reviews-section">See more reviews ↓</a>
              )}
            </>
          )}

          {business.data.ownerName && (
            <div class="owner-card">
              <div class="owner-avatar">{business.data.ownerName.charAt(0)}</div>
              <div>
                <h3>Meet {business.data.ownerName.split(' ')[0]}</h3>
                {business.data.ownerQuote && <p>"{business.data.ownerQuote}"</p>}
              </div>
            </div>
          )}
        </div>

        <div class="tab-panel" data-panel="photos">
          {business.data.gallery.length > 0 ? (
            <div class="gallery-grid">
              {business.data.gallery.map((img) => (
                <div class="gallery-item" style={`background-image: url(${img})`}></div>
              ))}
            </div>
          ) : (
            <p class="empty-note">Photo gallery coming soon — will pull from the business's uploaded media.</p>
          )}
        </div>

        <div class="tab-panel" data-panel="specials">
          <p class="empty-note">No active specials right now.</p>
        </div>
      </div>

      <aside class="champion-side-v2">
        <div class="card contact-card">
          {business.data.hoursSchedule && (
            <button class="open-now-indicator" id="open-now-indicator" type="button" hidden></button>
          )}
          {business.data.hoursSchedule && (
            <div class="hours-table-v2" id="hours-table" data-hours={JSON.stringify(business.data.hoursSchedule)} hidden>
              {daysOfWeek.map(({ key, label }) => (
                <div class="hours-row-v2" data-day={key}>
                  <span class="hours-day">{label}</span>
                  <span class="hours-time">{business.data.hoursSchedule?.[key] || 'Not listed'}</span>
                </div>
              ))}
            </div>
          )}
          <dl>
            {business.data.address && business.data.showAddress && <><dt>Address</dt><dd>{business.data.address}</dd></>}
            {neighborhood && <><dt>Neighborhood</dt><dd><a href={`/neighborhoods/${neighborhood.id}`}>{neighborhood.data.name}</a></dd></>}
            {business.data.phone && <><dt>Phone</dt><dd><a href={`tel:${business.data.phone}`}>{business.data.phone}</a></dd></>}
            {business.data.website && <><dt>Website</dt><dd><a href={business.data.website} rel="nofollow noopener" target="_blank">Visit site ↗</a></dd></>}
          </dl>
          {smartCTA.external ? (
            <a class="button contact-cta" href={smartCTA.href} target="_blank" rel="nofollow noopener">{smartCTA.label}</a>
          ) : (
            <a class="button contact-cta" href={smartCTA.href}>{smartCTA.label}</a>
          )}
        </div>

        <div class="card trust-card">
          <h3>Why we recommend them</h3>
          <ul class="trust-list">
            <li><Icon name="check" size={14} /> Locally owned &amp; operated</li>
            {business.data.googleRating && <li><Icon name="check" size={14} /> {business.data.googleRating.toFixed(1)}+ rating on Google</li>}
            {isVerified && <li><Icon name="check" size={14} /> Info confirmed by our team</li>}
            {(business.data.partnershipTier === 'community-listing' || business.data.partnershipTier === 'community-champion') && <li><Icon name="check" size={14} /> Committed to giving back to Sioux Falls</li>}
          </ul>
        </div>

        {isChampion && (
          <div class="card champion-badge-card">
            <img src="/images/community-champion-badge.png" alt="Sioux Falls Go Community Champion badge" />
            <p>A Sioux Falls Community Champion — support the locals who show up for this community.</p>
          </div>
        )}

        {spotlights.length > 0 && (
          <div class="spotlight-block">
            <h3>Latest from {business.data.name}</h3>
            {spotlights.map((s) => (
              <a class="spotlight-card" href={`/guides/${s.id}`}>
                <span class="spotlight-tag">{s.data.contentType === 'press-release' ? 'Press Release' : 'Spotlight'}</span>
                <h4>{s.data.title}</h4>
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>

    {business.data.reviews.length > 0 && (
      <section class="reviews-section" id="reviews-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">What People Are Saying</span>
        <h2>Reviews</h2>
        <div class="reviews-grid">
          {business.data.reviews.slice(0, 3).map((review) => (
            <div class="review-card">
              <div class="review-stars">
                {Array.from({ length: 5 }).map((_, i) => (
                  <Icon name="star" size={14} class={i < review.rating ? 'star-filled' : 'star-empty'} />
                ))}
              </div>
              <p class="review-text">"{review.text}"</p>
              <p class="review-author">— {review.author}{review.date && `, ${review.date}`}</p>
            </div>
          ))}
        </div>
        {business.data.placeId && (
          <a class="view-more-google" href={`https://www.google.com/maps/place/?q=place_id:${business.data.placeId}`} target="_blank" rel="nofollow noopener">
            View more reviews on Google ↗
          </a>
        )}
      </section>
    )}

    <section class="quote-section" id="quote-section">
      <div class="contour-rule" role="presentation"></div>
      <div class="quote-card">
        <div>
          <span class="eyebrow">Get In Touch</span>
          <h2>Request a Quote from {business.data.name}</h2>
          <p>Send a few details and they'll follow up directly — no account needed.</p>
        </div>
        <form name={`quote-${business.id}`} method="POST" data-netlify="true" class="quote-form">
          <input type="hidden" name="form-name" value={`quote-${business.id}`} />
          <input type="hidden" name="business" value={business.data.name} />
          <div class="quote-form-row">
            <input type="text" name="name" placeholder="Your name" required />
            <input type="tel" name="phone" placeholder="Phone number" required />
          </div>
          <input type="email" name="email" placeholder="Email address" required />
          <textarea name="message" placeholder={`What do you need from ${business.data.name}?`} rows="3" required></textarea>
          <button type="submit" class="button">Send Request</button>
        </form>
      </div>
    </section>

    <section class="share-section">
      <div class="contour-rule" role="presentation"></div>
      <div class="share-inner">
        <div>
          <h3>Know someone who'd like {business.data.name}?</h3>
          <p>Share this page — it helps local businesses more than you'd think.</p>
        </div>
        <div class="share-buttons">
          <a
            class="share-btn share-btn--facebook"
            href={`https://www.facebook.com/sharer/sharer.php?u=https://siouxfallsgo.com/businesses/${business.id}`}
            target="_blank" rel="noopener" aria-label="Share on Facebook"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
            Facebook
          </a>
          <a
            class="share-btn share-btn--linkedin"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=https://siouxfallsgo.com/businesses/${business.id}`}
            target="_blank" rel="noopener" aria-label="Share on LinkedIn"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
            LinkedIn
          </a>
          <a
            class="share-btn share-btn--instagram"
            href="https://www.instagram.com/"
            target="_blank" rel="noopener" aria-label="Open Instagram to share"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.5" cy="6.5" r="1"/></svg>
            Instagram
          </a>
          <button
            class="share-btn share-btn--copy"
            id="copy-link-btn"
            aria-label="Copy link"
          >
            <Icon name="share" size={18} />
            Copy Link
          </button>
        </div>
      </div>
    </section>

    {relatedGuides.length > 0 && (
      <section class="guides-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">From the Knowledge Base</span>
        <h2>Helpful guides for {category.data.name.toLowerCase()}</h2>
        <div class="guides-grid">
          {relatedGuides.slice(0, 3).map((article) => (
            <a class="guide-card" href={`/guides/${article.id}`}>
              <div class="guide-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={26} class="guide-card-icon" />}
              </div>
              <div class="guide-card-body">
                <span class="guide-tag">Guide</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <div class="container page-extras">
    {!isChampion && relatedBusinesses.length > 0 && (
      <section class="related-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">Keep Browsing</span>
        <h2>Other {category.data.name} in Sioux Falls</h2>
        <div class="related-grid">
          {relatedBusinesses.map((rb) => (
            <a href={`/businesses/${rb.id}`} class="related-card">
              <div class="related-media" style={rb.data.heroImage ? `background-image: url(${rb.data.heroImage})` : undefined}>
                {!rb.data.heroImage && <Icon name={category.data.icon} size={24} />}
              </div>
              <div class="related-body">
                <strong>{rb.data.name}</strong>
                {rb.data.googleRating && <span class="related-rating"><Icon name="star" size={12} class="filled-star" /> {rb.data.googleRating.toFixed(1)}</span>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .page { padding-block: var(--space-4) var(--space-6); }
  .breadcrumbs { font-size: 0.8125rem; color: var(--color-navy-light); margin-bottom: var(--space-2); }
  .breadcrumbs a { color: var(--color-navy-light); }

  .champion-hero-inner-v2 { width: 100%; position: relative; z-index: 2; text-align: center; display: flex; flex-direction: column; align-items: center; }
  /* Champion hero v2 — gradient only, no photo, avoids any collision with a business's own logo/photo text */
  .champion-hero-v2 {
    position: relative; overflow: hidden; padding-block: 4.5rem; min-height: 26rem;
    display: flex; align-items: center;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 55%, #3d5a85 100%);
  }
  .champion-hero-glow {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 85% 20%, rgba(240,126,35,0.25), transparent 55%);
  }
  .hero-status { font-size: 0.8125rem; color: rgba(255,255,255,0.65); font-weight: 600; margin: 0 0 1rem; }
  .hero-status .status-verified { color: #7FE0A8; display: inline-flex; align-items: center; gap: 0.3rem; }
  .hero-status .status-unverified { color: rgba(255,255,255,0.55); display: inline-flex; align-items: center; gap: 0.3rem; }
  .hero-service-label { color: var(--color-gold); font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.5rem; }
  .champion-hero-v2 h1 { font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; color: #fff; margin: 0; }
  .hero-cta-row { display: flex; align-items: center; justify-content: center; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .hero-cta-primary { background: var(--color-orange); color: #fff; font-weight: 700; font-size: 0.9375rem; padding: 0.8rem 1.5rem; border-radius: var(--radius); text-decoration: none; }
  .hero-cta-primary:hover { background: var(--color-orange-dark); }
  .hero-cta-rating { display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255,255,255,0.12); border: 1.5px solid rgba(255,255,255,0.3); color: #fff; font-weight: 700; font-size: 0.875rem; padding: 0.75rem 1.3rem; border-radius: var(--radius); }
  .hero-cta-rating :global(svg) { color: var(--color-gold); }

  /* Mobile-only sticky Call + smart CTA bar, matches how Airbnb/most native apps handle a primary action */
  .hero-sticky-bar { display: none; }
  @media (max-width: 48rem) {
    .hero-sticky-bar {
      display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 30;
      box-shadow: 0 -4px 16px rgba(0,0,0,0.15);
    }
    body { padding-bottom: 3.4rem; }
  }
  .hero-sticky-cta {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.4rem;
