---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LayeredHero from '../../components/LayeredHero.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map((business) => ({
    params: { slug: business.id },
    props: { business },
  }));
}

const { business } = Astro.props;
const { Content } = await render(business);
const category = await getEntry(business.data.category);
const neighborhood = business.data.neighborhood ? await getEntry(business.data.neighborhood) : null;
const isChampion = business.data.partnershipTier === 'community-champion';

// Related guides: same category
const allArticles = await getCollection('articles');
const relatedGuides = allArticles.filter(
  (a) => a.data.category.id === business.data.category.id && a.data.contentType !== 'business-spotlight'
);

// Spotlights written about this specific business — premium feature
const spotlights = allArticles.filter(
  (a) =>
    a.data.contentType === 'business-spotlight' &&
    a.data.relatedBusinesses.some((ref) => ref.id === business.id)
);

// "Verified" = we've confirmed this business's info recently — distinct from partnership tier
const isVerified = !!business.data.verifiedAt;

// Related businesses — same category, excluding this one. Free tier only,
// per the product decision: Champion profiles don't route attention away.
const allBusinesses = await getCollection('businesses');
const relatedBusinesses = allBusinesses
  .filter((b) => b.id !== business.id && b.data.category.id === business.data.category.id)
  .slice(0, 3);

const daysOfWeek: Array<{ key: 'mon' | 'tue' | 'wed' | 'thu' | 'fri' | 'sat' | 'sun'; label: string }> = [
  { key: 'mon', label: 'Monday' },
  { key: 'tue', label: 'Tuesday' },
  { key: 'wed', label: 'Wednesday' },
  { key: 'thu', label: 'Thursday' },
  { key: 'fri', label: 'Friday' },
  { key: 'sat', label: 'Saturday' },
  { key: 'sun', label: 'Sunday' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.data.name,
  address: business.data.showAddress ? business.data.address : undefined,
  telephone: business.data.phone,
  url: business.data.website,
};
---
<BaseLayout
  title={business.data.name}
  description={`${business.data.name} — ${category.data.name} in Sioux Falls. Hours, contact info, and services.`}
  canonicalPath={`/businesses/${business.id}`}
  schema={schema}
>
  <SiteHeader slot="header" />

  {isChampion ? (
    <>
      <div
        class="champion-hero"
        style={business.data.heroImage ? `background-image: linear-gradient(rgba(27,42,74,0.15),rgba(27,42,74,0.8)), url(${business.data.heroImage});` : undefined}
      >
        <div class="container champion-hero-inner">
          <a href="/community-champion" class="champion-badge-link">
            <img src="/images/community-champion-badge.png" alt="Community Champion badge — click to learn what this means" class="champion-badge-img" />
          </a>
          <div>
            <div class="hero-badges">
              {isVerified && <span class="badge badge--verified"><Icon name="check" size={11} /> Verified</span>}
              <span class="badge badge--champion-solid"><Icon name="star" size={11} /> Community Champion</span>
            </div>
            <h1>{business.data.name}</h1>
            <div class="hero-meta">
              {business.data.googleRating && (
                <span class="rating-pill"><Icon name="star" size={13} class="filled-star" /> {business.data.googleRating.toFixed(1)} ({business.data.googleReviewCount} reviews) <span class="live-tag">LIVE</span></span>
              )}
              <span><a href={`/${category.data.slug}`} class="category-link">{category.data.name}</a></span>
            </div>
          </div>
        </div>
      </div>

      <div class="container page">
        <div class="tabs" role="tablist">
          <button class="tab is-active" data-tab="story" role="tab">Story</button>
          <button class="tab" data-tab="photos" role="tab">Photos</button>
          <button class="tab" data-tab="specials" role="tab">Specials</button>
          <button class="tab" data-tab="reviews" role="tab">Reviews</button>
        </div>

        <div class="champion-grid">
          <div class="champion-main">
            <div class="tab-panel is-active" data-panel="story">
              {business.data.pullQuote && <blockquote class="pull-quote">"{business.data.pullQuote}"</blockquote>}
              <div class="prose"><Content /></div>
            </div>

            <div class="tab-panel" data-panel="photos">
              <p class="empty-note">Photo gallery coming soon — will pull from the business's uploaded media.</p>
            </div>

            <div class="tab-panel" data-panel="specials">
              <p class="empty-note">No active specials right now. Champions can offer exclusive discounts here.</p>
            </div>

            <div class="tab-panel" data-panel="reviews">
              <p class="empty-note">Live Google reviews will render here once the Places API is connected.</p>
            </div>
          </div>

          <aside class="champion-side">
            <div class="card contact-card">
              <dl>
                {business.data.address && business.data.showAddress && <><dt>Address</dt><dd>{business.data.address}</dd></>}
                {neighborhood && <><dt>Neighborhood</dt><dd><a href={`/neighborhoods/${neighborhood.id}`}>{neighborhood.data.name}</a></dd></>}
                {business.data.phone && <><dt>Phone</dt><dd><a href={`tel:${business.data.phone}`}>{business.data.phone}</a></dd></>}
                {business.data.hours
                  ? <><dt>Hours</dt><dd>{business.data.hours}</dd></>
                  : <><dt>Hours</dt><dd class="data-pending">Not listed yet</dd></>}
                {business.data.website && <><dt>Website</dt><dd><a href={business.data.website} rel="nofollow noopener" target="_blank">Visit site ↗</a></dd></>}
              </dl>
              <a class="button contact-cta" href="#">Contact Business</a>
            </div>

            {spotlights.length > 0 && (
              <div class="spotlight-block">
                <h3>Latest from {business.data.name}</h3>
                {spotlights.map((s) => (
                  <a class="spotlight-card" href={`/guides/${s.id}`}>
                    <span class="spotlight-tag">Spotlight</span>
                    <h4>{s.data.title}</h4>
                  </a>
                ))}
              </div>
            )}
          </aside>
        </div>

        <section class="quote-section">
          <div class="contour-rule" role="presentation"></div>
          <div class="quote-card">
            <div>
              <span class="eyebrow">Get In Touch</span>
              <h2>Request a Quote from {business.data.name}</h2>
              <p>Send a few details and they'll follow up directly — no account needed.</p>
            </div>
            <form name={`quote-${business.id}`} method="POST" data-netlify="true" class="quote-form">
              <input type="hidden" name="form-name" value={`quote-${business.id}`} />
              <input type="hidden" name="business" value={business.data.name} />
              <div class="quote-form-row">
                <input type="text" name="name" placeholder="Your name" required />
                <input type="tel" name="phone" placeholder="Phone number" required />
              </div>
              <input type="email" name="email" placeholder="Email address" required />
              <textarea name="message" placeholder={`What do you need from ${business.data.name}?`} rows="3" required></textarea>
              <button type="submit" class="button">Send Request</button>
            </form>
          </div>
        </section>

        <section class="share-section">
          <div class="contour-rule" role="presentation"></div>
          <div class="share-inner">
            <div>
              <h3>Know someone who'd like {business.data.name}?</h3>
              <p>Share this page — it helps local businesses more than you'd think.</p>
            </div>
            <div class="share-buttons">
              <a
                class="share-btn share-btn--facebook"
                href={`https://www.facebook.com/sharer/sharer.php?u=https://siouxfallsgo.com/businesses/${business.id}`}
                target="_blank" rel="noopener" aria-label="Share on Facebook"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
                Facebook
              </a>
              <a
                class="share-btn share-btn--linkedin"
                href={`https://www.linkedin.com/sharing/share-offsite/?url=https://siouxfallsgo.com/businesses/${business.id}`}
                target="_blank" rel="noopener" aria-label="Share on LinkedIn"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
                LinkedIn
              </a>
              <a
                class="share-btn share-btn--instagram"
                href="https://www.instagram.com/"
                target="_blank" rel="noopener" aria-label="Open Instagram to share"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.5" cy="6.5" r="1"/></svg>
                Instagram
              </a>
              <button
                class="share-btn share-btn--copy"
                id="copy-link-btn-champion"
                aria-label="Copy link"
              >
                <Icon name="share" size={18} />
                Copy Link
              </button>
            </div>
          </div>
        </section>
      </div>
    </>
  ) : (
    <>
      <LayeredHero
        eyebrow="Business Profile"
        title={business.data.name}
        photoUrl={business.data.heroImage}
        compact
      >
        <div class="hero-badges">
          <a href={`/${category.data.slug}`} class="badge badge--category">{category.data.name}</a>
          {isVerified && <span class="badge badge--verified"><Icon name="check" size={11} /> Verified</span>}
          {business.data.partnershipTier === 'community-listing' && <span class="badge badge--giveback">Give Back Partner</span>}
          {business.data.googleRating && <span class="hero-rating-pill"><Icon name="star" size={13} class="filled-star" /> {business.data.googleRating.toFixed(1)}</span>}
        </div>
      </LayeredHero>

      <div class="container page">
        <div class="quick-actions-bar">
          {business.data.phone && <a href={`tel:${business.data.phone}`} class="quick-action-btn"><Icon name="phone" size={16} /> Call</a>}
          {business.data.website && <a href={business.data.website} target="_blank" rel="nofollow noopener" class="quick-action-btn"><Icon name="globe" size={16} /> Website</a>}
          {business.data.address && business.data.showAddress && <a href={`https://maps.google.com/?q=${encodeURIComponent(business.data.address)}`} target="_blank" rel="noopener" class="quick-action-btn"><Icon name="pin" size={16} /> Directions</a>}
        </div>

        <div class="simple-layout">
          <div class="simple-main">
            <div class="prose"><Content /></div>
          </div>

          <aside class="simple-side">
            <div class="card contact-card">
              <h3>Contact &amp; Info</h3>
              <dl>
                {business.data.address && business.data.showAddress && <><dt><Icon name="pin" size={13} /> Address</dt><dd>{business.data.address}</dd></>}
                {neighborhood && <><dt>Neighborhood</dt><dd><a href={`/neighborhoods/${neighborhood.id}`}>{neighborhood.data.name}</a></dd></>}
                {business.data.phone && <><dt><Icon name="phone" size={13} /> Phone</dt><dd><a href={`tel:${business.data.phone}`}>{business.data.phone}</a></dd></>}
                {business.data.hours
                  ? <><dt><Icon name="clock" size={13} /> Hours</dt><dd>{business.data.hours}</dd></>
                  : <><dt><Icon name="clock" size={13} /> Hours</dt><dd class="data-pending">Not listed yet</dd></>}
                {business.data.website && <><dt><Icon name="globe" size={13} /> Website</dt><dd><a href={business.data.website} rel="nofollow noopener" target="_blank">Visit site →</a></dd></>}
              </dl>
            </div>

            <div class="card trust-card">
              <h3>Why we recommend them</h3>
              <ul class="trust-list">
                <li><Icon name="check" size={14} /> Locally owned &amp; operated</li>
                {business.data.googleRating && <li><Icon name="check" size={14} /> {business.data.googleRating.toFixed(1)}+ rating on Google</li>}
                {isVerified && <li><Icon name="check" size={14} /> Info confirmed by our team</li>}
                {business.data.partnershipTier === 'community-listing' && <li><Icon name="check" size={14} /> Committed to giving back to Sioux Falls</li>}
              </ul>
            </div>
          </aside>
        </div>

        <section class="share-section">
          <div class="contour-rule" role="presentation"></div>
          <div class="share-inner">
            <div>
              <h3>Know someone who'd like {business.data.name}?</h3>
              <p>Share this page — it helps local businesses more than you'd think.</p>
            </div>
            <div class="share-buttons">
              <a
                class="share-btn share-btn--facebook"
                href={`https://www.facebook.com/sharer/sharer.php?u=https://siouxfallsgo.com/businesses/${business.id}`}
                target="_blank" rel="noopener" aria-label="Share on Facebook"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
                Facebook
              </a>
              <a
                class="share-btn share-btn--linkedin"
                href={`https://www.linkedin.com/sharing/share-offsite/?url=https://siouxfallsgo.com/businesses/${business.id}`}
                target="_blank" rel="noopener" aria-label="Share on LinkedIn"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
                LinkedIn
              </a>
              <a
                class="share-btn share-btn--instagram"
                href="https://www.instagram.com/"
                target="_blank" rel="noopener" aria-label="Open Instagram to share"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.5" cy="6.5" r="1"/></svg>
                Instagram
              </a>
              <button
                class="share-btn share-btn--copy"
                id="copy-link-btn"
                aria-label="Copy link"
              >
                <Icon name="share" size={18} />
                Copy Link
              </button>
            </div>
          </div>
        </section>

        {relatedGuides.length > 0 && (
          <section class="guides-section">
            <div class="contour-rule" role="presentation"></div>
            <span class="eyebrow">From the Knowledge Base</span>
            <h2>Helpful guides for {category.data.name.toLowerCase()}</h2>
            <div class="guides-grid">
              {relatedGuides.slice(0, 3).map((article) => (
                <a class="guide-card" href={`/guides/${article.id}`}>
                  <div class="guide-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                    {!article.data.heroImage && <Icon name={category.data.icon} size={26} class="guide-card-icon" />}
                  </div>
                  <div class="guide-card-body">
                    <span class="guide-tag">Guide</span>
                    <h3>{article.data.title}</h3>
                    <p>{article.data.seo.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>
    </>
  )}

  <div class="container page-extras">
    {business.data.hoursSchedule && (
      <section class="hours-section">
        <div class="contour-rule" role="presentation"></div>
        <h2>Hours</h2>
        <div class="hours-table" id="hours-table" data-hours={JSON.stringify(business.data.hoursSchedule)}>
          {daysOfWeek.map(({ key, label }) => (
            <div class="hours-row" data-day={key}>
              <span class="hours-day">{label}</span>
              <span class="hours-time">{business.data.hoursSchedule?.[key] || 'Not listed'}</span>
            </div>
          ))}
        </div>
        <p class="open-now-indicator" id="open-now-indicator" hidden></p>
      </section>
    )}

    {isChampion && business.data.gallery.length > 0 && (
      <section class="gallery-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">Gallery</span>
        <h2>More from {business.data.name}</h2>
        <div class="gallery-grid">
          {business.data.gallery.map((img) => (
            <div class="gallery-item" style={`background-image: url(${img})`}></div>
          ))}
        </div>
      </section>
    )}

    {business.data.reviews.length > 0 && (
      <section class="reviews-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">What People Are Saying</span>
        <h2>Reviews</h2>
        <div class="reviews-grid">
          {business.data.reviews.map((review) => (
            <div class="review-card">
              <div class="review-stars">
                {Array.from({ length: 5 }).map((_, i) => (
                  <Icon name="star" size={14} class={i < review.rating ? 'star-filled' : 'star-empty'} />
                ))}
              </div>
              <p class="review-text">"{review.text}"</p>
              <p class="review-author">— {review.author}{review.date && `, ${review.date}`}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {!isChampion && relatedBusinesses.length > 0 && (
      <section class="related-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">Keep Browsing</span>
        <h2>Other {category.data.name} in Sioux Falls</h2>
        <div class="related-grid">
          {relatedBusinesses.map((rb) => (
            <a href={`/businesses/${rb.id}`} class="related-card">
              <div class="related-media" style={rb.data.heroImage ? `background-image: url(${rb.data.heroImage})` : undefined}>
                {!rb.data.heroImage && <Icon name={category.data.icon} size={24} />}
              </div>
              <div class="related-body">
                <strong>{rb.data.name}</strong>
                {rb.data.googleRating && <span class="related-rating"><Icon name="star" size={12} class="filled-star" /> {rb.data.googleRating.toFixed(1)}</span>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .page { padding-block: var(--space-4) var(--space-6); }
  .breadcrumbs { font-size: 0.8125rem; color: var(--color-navy-light); margin-bottom: var(--space-2); }
  .breadcrumbs a { color: var(--color-navy-light); }

  .badge--verified { background: #E7F6ED; color: var(--color-success); }
  .badge--giveback { background: #E7F6ED; color: var(--color-success); }
  .badge--champion-solid { background: var(--color-orange); color: #fff; }
  .hero-badges { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap; }

  /* Champion hero */
  .champion-hero {
    background:
      radial-gradient(circle at 15% 20%, rgba(240,126,35,0.18), transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(255,255,255,0.06), transparent 50%),
      linear-gradient(135deg, var(--color-navy) 0%, #131f38 100%);
    background-size: cover; background-position: center; padding-block: var(--space-5);
    box-shadow: inset 0 -1px 0 rgba(255,255,255,0.06);
  }
  .champion-hero-inner { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .champion-badge-link { flex-shrink: 0; }
  .champion-badge-img { width: 6rem; height: 6rem; display: block; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.35)); transition: transform 0.2s ease; }
  .champion-badge-link:hover .champion-badge-img { transform: scale(1.05) rotate(-3deg); }
  .champion-hero h1 { color: #fff; margin: 0 0 0.4rem; }
  .hero-meta { display: flex; gap: 1rem; color: rgba(255,255,255,0.85); font-size: 0.9375rem; flex-wrap: wrap; }
  .rating-pill { background: rgba(255,255,255,0.15); padding: 0.25rem 0.7rem; border-radius: var(--radius-pill); font-weight: 700; }
  .live-tag { font-size: 0.625rem; background: #E7F6ED; color: var(--color-success); padding: 0.1rem 0.4rem; border-radius: var(--radius-pill); font-weight: 700; margin-left: 0.3rem; }

  .tabs { display: flex; gap: 1.5rem; border-bottom: 2px solid var(--color-line); margin-top: var(--space-3); overflow-x: auto; }
  .tab { background: none; border: none; padding-bottom: 0.65rem; font-weight: 600; font-size: 0.9375rem; color: var(--color-navy-light); border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; transition: color 0.15s ease, border-color 0.15s ease; }
  .tab:hover { color: var(--color-orange-dark); }
  .tab.is-active { color: var(--color-orange); border-bottom-color: var(--color-orange); }
  .tab-panel { display: none; }
  .tab-panel.is-active { display: block; animation: fadeIn 0.25s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  .empty-note { color: var(--color-navy-light); font-style: italic; }

  .champion-grid { display: grid; grid-template-columns: 1fr 18rem; gap: var(--space-4); margin-top: var(--space-3); }
  @media (max-width: 45rem) { .champion-grid { grid-template-columns: 1fr; } }

  .pull-quote { font-family: var(--font-display); font-size: 1.25rem; color: var(--color-navy); border-left: 4px solid var(--color-orange); padding-left: 1rem; margin: 0 0 var(--space-2); font-weight: 500; }

  .contact-card { box-shadow: 0 2px 8px rgba(27,42,74,0.06); }
  .contact-card dl { margin: 0; }
  .contact-card dt { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.6875rem; text-transform: uppercase; font-weight: 700; color: var(--color-navy-light); margin-top: var(--space-2); }
