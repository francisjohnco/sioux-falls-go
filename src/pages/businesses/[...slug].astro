<script>
  document.querySelectorAll('.tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      document.querySelectorAll('.tab').forEach((t) => t.classList.remove('is-active'));
      document.querySelectorAll('.tab-panel').forEach((p) => p.classList.remove('is-active'));
      tab.classList.add('is-active');
      document.querySelector(`[data-panel="${target}"]`)?.classList.add('is-active');
    });
  });

  const copyBtn = document.getElementById('copy-link-btn') || document.getElementById('copy-link-btn-champion');
  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(location.href);
    const original = copyBtn.innerHTML;
    copyBtn.innerHTML = 'Copied!';
    setTimeout(() => { copyBtn.innerHTML = original; }, 1800);
  });

  // Live open/closed indicator, computed from the real hoursSchedule data
  const hoursTable = document.getElementById('hours-table');
  const indicator = document.getElementById('open-now-indicator');
  if (hoursTable && indicator) {
    const schedule = JSON.parse(hoursTable.dataset.hours || '{}');
    const dayKeys = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
    const now = new Date();
    const todayKey = dayKeys[now.getDay()];
    const todayRow = hoursTable.querySelector(`[data-day="${todayKey}"]`);
    todayRow?.classList.add('is-today');

    const todayHours = schedule[todayKey];
    function parseTime(str: string, base: Date): Date | null {
      const m = str.trim().match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
      if (!m) return null;
      let h = parseInt(m[1], 10);
      const min = parseInt(m[2], 10);
      const isPM = m[3].toUpperCase() === 'PM';
      if (isPM && h !== 12) h += 12;
      if (!isPM && h === 12) h = 0;
      const d = new Date(base);
      d.setHours(h, min, 0, 0);
      return d;
    }

    if (!todayHours || /closed/i.test(todayHours)) {
      indicator.textContent = 'Closed today';
      indicator.classList.add('is-closed');
      indicator.hidden = false;
    } else {
      const [openStr, closeStr] = todayHours.split('-').map((s: string) => s.trim());
      const openTime = parseTime(openStr, now);
      const closeTime = parseTime(closeStr, now);
      if (openTime && closeTime) {
        const isOpen = now >= openTime && now <= closeTime;
        indicator.textContent = isOpen ? `Open now — closes ${closeStr}` : `Closed now — opens ${openStr}`;
        indicator.classList.add(isOpen ? 'is-open' : 'is-closed');
        indicator.hidden = false;
      }
    }
  }
</script>
