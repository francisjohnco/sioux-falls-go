---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import LayeredHero from '../../components/LayeredHero.astro';

const businesses = await getCollection('businesses');
const categories = await getCollection('categories');
const champions = businesses.filter((b) => b.data.partnershipTier === 'community-champion');
const giveBack = businesses.filter((b) => b.data.partnershipTier === 'community-listing');

const newlyVerified = [...businesses]
  .sort((a, b) => b.data.verifiedAt.getTime() - a.data.verifiedAt.getTime())
  .slice(0, 4);

const categoryCounts = categories
  .map((cat) => ({ cat, count: businesses.filter((b) => b.data.category.id === cat.id).length }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const popularCategories = categoryCounts.slice(0, 8);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sioux Falls Business Directory',
};
---
<BaseLayout
  title="Business Directory"
  description="Browse trusted Sioux Falls businesses by category — verified hours, contact info, and services."
  canonicalPath="/businesses"
  schema={schema}
>
  <SiteHeader slot="header" />

  <LayeredHero
    eyebrow="Invite-Only Directory"
    title="Discover trusted local businesses in Sioux Falls"
    subtitle={`${businesses.length} businesses, personally vetted for a 4.8+ Google rating and real community involvement — not the highest bidder.`}
    photoUrl="/images/scenic/falls-park-2.jpg"
    centered
    divider="diamond-lattice"
  >
    <div class="hero-search">
      <input type="search" id="hero-search-input" placeholder="Search businesses, services, or categories..." aria-label="Search businesses" />
      <button class="hero-search-btn" aria-label="Search">🔍</button>
    </div>
    <p class="hero-popular-searches">
      Popular: {popularCategories.slice(0, 4).map((c, i) => (
        <>
          <a href={`/${c.cat.data.slug}`}>{c.cat.data.name}</a>{i < 3 ? ' · ' : ''}
        </>
      ))}
    </p>
  </LayeredHero>

  <div class="container category-pills-row">
    {popularCategories.slice(0, 6).map(({ cat }) => (
      <a href={`/${cat.data.slug}`} class="category-pill">
        <span class="category-pill-icon">{cat.data.icon}</span>
        <span>{cat.data.name}</span>
      </a>
    ))}
  </div>

  <div class="container page">
    <div class="hero-trust-row hero-trust-row--static">
      <span>✓ 4.8+ rating required</span>
      <span>✓ Real local businesses only</span>
      <span>✓ No pay-to-rank listings</span>
    </div>

    {giveBack.length > 0 && (
      <>
        <div class="contour-rule" role="presentation"></div>
        <section aria-labelledby="giveback-heading" class="giveback-list-section">
          <div class="section-header-row">
            <div>
              <span class="eyebrow">🤝 Give Back Partners</span>
              <h2 id="giveback-heading">Businesses investing in Sioux Falls</h2>
            </div>
            <a href="/businesses?tier=community-listing" class="see-all-link">See all →</a>
          </div>
          <div class="giveback-list">
            {giveBack.slice(0, 5).map(async (business) => {
              const cat = await getEntry(business.data.category);
              return (
                <a href={`/businesses/${business.id}`} class="giveback-row">
                  <div class="giveback-thumb" style={business.data.heroImage ? `background-image: url(${business.data.heroImage});` : undefined}>
                    {!business.data.heroImage && <span>{cat.data.icon}</span>}
                  </div>
                  <div class="giveback-info">
                    <strong>{business.data.name}</strong>
                    <span class="giveback-meta">{cat.data.name}</span>
                  </div>
                  {business.data.googleRating && <span class="giveback-rating">★ {business.data.googleRating.toFixed(1)}</span>}
                </a>
              );
            })}
          </div>
        </section>
      </>
    )}

    <div class="contour-rule" role="presentation"></div>

    <section aria-labelledby="new-heading">
      <span class="eyebrow">🆕 Newly Verified</span>
      <h2 id="new-heading">Recently confirmed by our team</h2>
      <div class="grid">
        {newlyVerified.slice(0, 3).map((business) => <BusinessCard business={business} compact />)}
      </div>
    </section>

    <div class="contour-rule" role="presentation"></div>

    <section aria-labelledby="all-biz-heading">
      <div class="all-biz-header">
        <div>
          <span class="eyebrow">Every Business</span>
          <h2 id="all-biz-heading">All {businesses.length} businesses</h2>
        </div>
        <div class="filter-bar" role="group" aria-label="Filter businesses">
          <select id="filter-category" aria-label="Filter by category">
            <option value="">All Categories</option>
            {categoryCounts.map(({ cat }) => <option value={cat.id}>{cat.data.name}</option>)}
          </select>
          <select id="filter-tier" aria-label="Filter by partnership tier">
            <option value="">All Businesses</option>
            <option value="community-champion">★ Champions Only</option>
            <option value="community-listing">Give Back Partners</option>
          </select>
        </div>
      </div>
      <div class="grid" id="business-grid">
        {businesses.map((business) => (
          <div
            class="business-grid-item"
            data-search={`${business.data.name} ${business.data.category.id}`.toLowerCase()}
            data-category={business.data.category.id}
            data-tier={business.data.partnershipTier || ''}
          >
            <BusinessCard business={business} />
          </div>
        ))}
      </div>
      <p id="no-results" class="empty-note" hidden>No businesses match your filters.</p>
    </section>

    <div class="claim-cta card">
      <div>
        <h3>Sioux Falls Go is invite-only.</h3>
        <p>We don't list every business — we recommend the ones that earn a 4.8+ Google rating and give back to the community. Think your business qualifies?</p>
      </div>
      <a class="button" href="/get-featured">Apply for consideration</a>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero-search { max-width: 32rem; margin-top: var(--space-3); display: flex; gap: 0.5rem; }
  .hero-search input {
    flex: 1; padding: 0.95rem 1.3rem; border-radius: var(--radius-pill); border: none;
    font-size: 0.9375rem; box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .hero-search-btn {
    width: 3.2rem; height: 3.2rem; border-radius: 50%; border: none; flex-shrink: 0;
    background: var(--color-orange); color: #fff; font-size: 1.1rem; cursor: pointer;
    box-shadow: 0 8px 24px rgba(240,126,35,0.4);
  }
  .hero-popular-searches { margin-top: var(--space-2); font-size: 0.8125rem; color: rgba(255,255,255,0.85); }
  .hero-popular-searches a { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: rgba(255,255,255,0.4); }

  .category-pills-row {
    display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center;
    margin-top: -2.75rem; position: relative; z-index: 2; padding-bottom: var(--space-2);
  }
  .category-pill {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    background: #fff; border-radius: var(--radius); padding: var(--space-2) var(--space-2);
    text-decoration: none; min-width: 6.5rem;
    box-shadow: 0 8px 20px rgba(13,23,48,0.15);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease;
  }
  .category-pill:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(240,126,35,0.22); }
  .category-pill-icon {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem; background: linear-gradient(135deg, #fff3e8, #ffe4cc);
  }
  .category-pill span:last-child { font-size: 0.75rem; font-weight: 700; color: var(--color-navy); text-align: center; }

  .hero-trust-row--static { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; padding-block: var(--space-2) var(--space-3); border-bottom: 1px solid var(--color-line); margin-bottom: var(--space-3); font-size: 0.8125rem; font-weight: 600; }
  .hero-trust-row--static span { color: var(--color-navy-light); }

  .section-header-row { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-2); }
  .see-all-link { font-size: 0.875rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; white-space: nowrap; }
  .see-all-link:hover { text-decoration: underline; }

  .giveback-list { display: flex; flex-direction: column; gap: 0.6rem; margin-top: var(--space-3); }
  .giveback-row {
    display: flex; align-items: center; gap: var(--space-2); text-decoration: none;
    background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .giveback-row:hover { transform: translateX(4px); box-shadow: 0 4px 14px rgba(13,23,48,0.1); border-color: transparent; }
  .giveback-thumb {
    width: 3.25rem; height: 3.25rem; border-radius: var(--radius); flex-shrink: 0; background-size: cover; background-position: center;
    background-color: var(--color-navy); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;
  }
  .giveback-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .giveback-info strong { font-size: 0.9375rem; color: var(--color-navy); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .giveback-meta { font-size: 0.8125rem; color: var(--color-navy-light); }
  .giveback-rating { font-weight: 700; color: var(--color-navy); font-size: 0.875rem; white-space: nowrap; }

  @media (max-width: 40rem) {
    .category-pills-row { margin-top: -1.5rem; }
    .category-pill { min-width: 5rem; padding: var(--space-1); }
  }

  .page { padding-block: var(--space-4) var(--space-6); }
  .page :global(.eyebrow) { display: block; margin-bottom: 0.2rem; }

  .featured-section { margin-bottom: var(--space-2); }
  .featured-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); margin-top: var(--space-3); }
  .featured-card {
    position: relative; display: block; text-decoration: none; border-radius: var(--radius); overflow: hidden;
    grid-column: span 1; box-shadow: 0 1px 3px rgba(13,23,48,0.08);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease;
  }
  .featured-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(13,23,48,0.18); }
  .featured-card--large { grid-column: span 2; grid-row: span 2; }
  .featured-media {
    position: relative; height: 8rem; background-size: cover; background-position: center;
    background: linear-gradient(135deg, #16233d, #2c3f61 60%, #F07E23 140%);
  }
  .featured-card--large .featured-media { height: 100%; min-height: 17rem; }
  .media-pattern { position: absolute; inset: 0; width: 100%; height: 100%; }
  .featured-badge {
    position: absolute; top: 0.6rem; left: 0.6rem;
    background: var(--color-orange); color: #fff; font-size: 0.6875rem; font-weight: 700;
    padding: 0.25rem 0.7rem; border-radius: var(--radius-pill);
  }
  .featured-body {
    position: absolute; bottom: 0; left: 0; right: 0; padding: var(--space-2);
    background: linear-gradient(0deg, rgba(13,23,48,0.85), transparent);
    display: flex; justify-content: space-between; align-items: flex-end; gap: 0.5rem;
  }
  .featured-body strong { color: #fff; font-size: 0.9375rem; }
  .featured-card--large .featured-body strong { font-size: 1.25rem; }
  .featured-rating { color: #F5B429; font-weight: 700; font-size: 0.8125rem; white-space: nowrap; }

  .category-highlight-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .category-highlight-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.5rem;
    background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius);
    padding: var(--space-3) var(--space-1); text-decoration: none;
    box-shadow: 0 1px 2px rgba(13,23,48,0.05);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .category-highlight-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(240,126,35,0.18); border-color: transparent; }
  .category-icon-badge {
    display: flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: 50%; font-size: 1.5rem;
    background: linear-gradient(135deg, #fff3e8, #ffe4cc);
  }
  .category-highlight-card strong { font-size: 0.9375rem; color: var(--color-navy); }
  .category-count { font-size: 0.75rem; color: var(--color-navy-light); }

  .more-categories { margin-top: var(--space-3); }
  .more-categories summary { cursor: pointer; font-weight: 600; color: var(--color-orange-dark); font-size: 0.9375rem; }
  .more-categories-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--space-2); }
  .more-categories-list a {
    font-size: 0.875rem; text-decoration: none; color: var(--color-navy);
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-pill);
    padding: 0.35rem 0.85rem;
  }
  .more-categories-list a:hover { border-color: var(--color-orange); color: var(--color-orange-dark); }

  .how-section { padding-block: var(--space-2); }
  .how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-3); margin-top: var(--space-3); }
  .how-step { text-align: center; }
  .how-number { font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; color: var(--color-orange); }
  .how-step h3 { font-size: 1.0625rem; margin: 0.3rem 0 0.4rem; }
  .how-step p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }

  .all-biz-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-2); }
  .filter-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filter-bar select {
    padding: 0.5rem 0.75rem; border-radius: var(--radius-pill); border: 1.5px solid var(--color-line);
    font-size: 0.875rem; background: #fff; color: var(--color-navy);
  }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--space-3); margin-top: var(--space-3); }
  .empty-note { text-align: center; color: var(--color-navy-light); margin-top: var(--space-3); }

  .claim-cta {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap;
    margin-top: var(--space-5); background: var(--color-navy); border-color: var(--color-navy);
  }
  .claim-cta h3, .claim-cta p { color: #fff; margin: 0; }
  .claim-cta p { margin-top: 0.25rem; }

  @media (max-width: 45rem) {
    .featured-grid { grid-template-columns: repeat(2, 1fr); }
    .featured-card--large { grid-column: span 2; grid-row: span 1; }
    .featured-card--large .featured-media { min-height: 10rem; }
  }
</style>

<script>
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement;
  const categoryFilter = document.getElementById('filter-category') as HTMLSelectElement;
  const tierFilter = document.getElementById('filter-tier') as HTMLSelectElement;
  const items = Array.from(document.querySelectorAll('.business-grid-item'));
  const noResults = document.getElementById('no-results')!;

  function applyFilters() {
    const q = searchInput?.value.trim().toLowerCase() || '';
    const cat = categoryFilter?.value || '';
    const tier = tierFilter?.value || '';
    let visibleCount = 0;

    items.forEach((item) => {
      const el = item as HTMLElement;
      const matchesSearch = !q || el.dataset.search?.includes(q);
      const matchesCategory = !cat || el.dataset.category === cat;
      const matchesTier = !tier || el.dataset.tier === tier;
      const match = matchesSearch && matchesCategory && matchesTier;
      el.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    noResults.hidden = visibleCount > 0;
  }

  searchInput?.addEventListener('input', applyFilters);
  categoryFilter?.addEventListener('change', applyFilters);
  tierFilter?.addEventListener('change', applyFilters);
</script>
