---
import { getCollection, getEntry } from 'astro:content';
import { getLiveArticles } from '../../lib/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import Icon from '../../components/Icon.astro';

const businesses = await getCollection('businesses');
const categories = await getCollection('categories');

// Real search index for the hero search — every business and category, by name
const searchIndex = [
  ...categories.map((c) => ({ type: 'category' as const, label: c.data.name, url: `/${c.data.slug}` })),
  ...businesses.map((b) => ({ type: 'business' as const, label: b.data.name, url: `/businesses/${b.id}` })),
];
// Hero numbers and faces: real counts, real listing photos.
const listedCategoryCount = new Set(businesses.map((b) => b.data.category.id)).size;
const heroFaces = businesses
  .filter((b) => b.data.heroImage && b.data.heroImage.startsWith('/images/businesses/') && !/logo/i.test(b.data.heroImage))
  .slice(0, 7)
  .map((b) => ({ name: b.data.name, img: b.data.heroImage! }));
// Category shortcuts that follow the season (Sioux Falls time).
const month = Number(new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', month: 'numeric' }).format(new Date()));
const SEASON: Record<string, [string, string, string][]> = {
  winter: [['hvac', 'Heating and HVAC', 'flame'], ['plumbers', 'Plumbers', 'pipe'], ['gift-shops', 'Gift shops', 'gift'], ['coffee-shops', 'Coffee shops', 'cup'], ['restaurants-dining', 'Restaurants', 'fork'], ['bakeries', 'Bakeries', 'cake']],
  spring: [['roofing', 'Roofing', 'home'], ['lawn-care', 'Lawn care', 'leaf'], ['landscaping-home-services', 'Landscaping', 'leaf'], ['cleaning-services', 'Cleaning', 'spark'], ['coffee-shops', 'Coffee shops', 'cup'], ['restaurants-dining', 'Restaurants', 'fork']],
  summer: [['ice-cream-and-dessert', 'Ice cream', 'cake'], ['lawn-care', 'Lawn care', 'leaf'], ['hvac', 'Air conditioning', 'flame'], ['family-activities', 'Family fun', 'spark'], ['coffee-shops', 'Coffee shops', 'cup'], ['restaurants-dining', 'Restaurants', 'fork']],
  fall: [['hvac', 'Furnace and HVAC', 'flame'], ['roofing', 'Roofing', 'home'], ['local-tree-services', 'Tree services', 'leaf'], ['coffee-shops', 'Coffee shops', 'cup'], ['restaurants-dining', 'Restaurants', 'fork'], ['bakeries', 'Bakeries', 'cake']],
};
const season = month === 12 || month <= 2 ? 'winter' : month <= 5 ? 'spring' : month <= 8 ? 'summer' : month === 11 ? 'winter' : 'fall';
const catSlugs = new Set(categories.map((c) => c.data.slug));
const heroChips = SEASON[season].filter(([slug]) => catSlugs.has(slug));

// Proof band numbers, straight from the listings.
const rated = businesses.filter((b) => typeof b.data.googleRating === 'number');
const avgRating = rated.length ? (rated.reduce((t, b) => t + b.data.googleRating!, 0) / rated.length).toFixed(2) : '';
const totalReviews = businesses.reduce((t, b) => t + (b.data.googleReviewCount || 0), 0);
const reviewDigits = totalReviews.toLocaleString('en-US');
const tapeItems = [avgRating && `${avgRating} average rating`, `${businesses.length} local businesses`, `${listedCategoryCount} categories`, '$0 paid to rank'].filter(Boolean) as string[];

const giveBack = businesses.filter((b) => b.data.partnershipTier === 'community-listing' || b.data.partnershipTier === 'community-champion');

const newlyVerified = businesses
  .filter((b) => b.data.verifiedAt)
  .sort((a, b) => b.data.verifiedAt!.getTime() - a.data.verifiedAt!.getTime())
  .slice(0, 6);

// Recursive count — matches the aggregation on the category pages
// themselves, so a parent category's count includes every business in its
// subtree, not just businesses tagged directly to the parent.
function countForCategory(cat: (typeof categories)[number]): number {
  const direct = businesses.filter((b) => b.data.category.id === cat.id).length;
  const children = categories.filter((c) => c.data.parentCategory?.id === cat.id);
  return direct + children.reduce((sum, child) => sum + countForCategory(child), 0);
}

const categoryCounts = categories
  .map((cat) => ({ cat, count: countForCategory(cat) }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const popularCategories = categoryCounts.slice(0, 6);

// Real stats for the closing section — computed from actual data, not made up
const givingBackCount = businesses.filter((b) => b.data.partnershipTier === 'community-champion' || b.data.partnershipTier === 'community-listing').length;
const givingBackPct = businesses.length ? Math.round((givingBackCount / businesses.length) * 100) : 0;

// Local Insights — a hand-picked set of real, useful guides, not an
// algorithmic "latest articles" dump
const insightSlugs = [
  'how-to-shop-local-and-make-every-dollar-count',
  'how-to-choose-a-plumber-in-sioux-falls',
  'how-to-choose-a-flooring-contractor-in-sioux-falls',
  'how-to-choose-a-real-estate-agent-in-sioux-falls',
  'how-to-choose-a-tree-service-in-sioux-falls',
  'how-to-choose-a-painting-contractor-in-sioux-falls',
];
const allArticles = await getLiveArticles();
const localInsights = await Promise.all(
  insightSlugs
    .map((slug) => allArticles.find((a) => a.id === slug))
    .filter((a): a is NonNullable<typeof a> => Boolean(a))
    .map(async (article) => ({ article, category: await getEntry(article.data.category) }))
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sioux Falls Business Directory',
};
---
<BaseLayout
  title="Business Directory"
  description="Browse trusted Sioux Falls businesses by category — verified hours, contact info, and services."
  canonicalPath="/businesses"
  schema={schema}
>
  <SiteHeader slot="header" />

  <!-- HERO: centered and light, built around the search -->
  <section class="dir-hero">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
      <symbol id="ci-flame" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c1 3 5 5 5 10a5 5 0 0 1-10 0c0-3 2-4 2-7 1.5 1 3 2 3 4"/></symbol>
      <symbol id="ci-pipe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h8a4 4 0 0 1 4 4v8"/><path d="M4 4v8M12 20h8"/></symbol>
      <symbol id="ci-gift" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M12 9v12M3 13h18M12 9c-3 0-5-1.5-5-3.5S9 3 12 9c3-6 5-5.5 5-3.5S15 9 12 9"/></symbol>
      <symbol id="ci-cup" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 11h2a2 2 0 0 1 0 4h-2M8 3v3M12 3v3"/></symbol>
      <symbol id="ci-fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v8a2 2 0 0 0 2 2v8M5 3v5M9 3v5M17 3c-2 2-2 6 0 8v10"/></symbol>
      <symbol id="ci-cake" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V12h16v9M2 21h20M4 16c2 1 4 1 5.3 0s3.4-1 5.4 0 4 1 5.3 0M12 12V8M12 5v.01"/></symbol>
      <symbol id="ci-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></symbol>
      <symbol id="ci-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 15M5 19l7-7"/></symbol>
      <symbol id="ci-spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/></symbol>
    </defs></svg>
    <div class="container dir-hero-inner">
      {heroFaces.length > 2 && (
        <div class="dir-faces" aria-hidden="true">
          {heroFaces.map((f) => <img src={f.img} alt="" width="56" height="56" loading="eager" decoding="async" />)}
        </div>
      )}
      <p class="dir-brand">Sioux Falls Go directory</p>
      <h1>Find the local favorites in Sioux Falls</h1>
      <p class="dir-hero-sub">{businesses.length} local businesses in {listedCategoryCount} categories, invited in and never paid to rank.</p>

      <div class="hero-search-wrap">
        <div class="hero-search">
          <span class="hero-search-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          </span>
          <input type="search" id="hero-search-input" placeholder="Try plumber or coffee" aria-label="Search businesses" data-index={JSON.stringify(searchIndex)} autocomplete="off" />
          <button class="search-place-btn" id="search-place-btn" type="button">Search</button>
        </div>
        <div class="search-results" id="search-results" hidden></div>
      </div>

      <nav class="dir-chips" aria-label="Popular right now">
        {heroChips.map(([slug, label, icon]) => (
          <a class="dir-chip" href={`/${slug}`}><svg width="18" height="18" aria-hidden="true"><use href={`#ci-${icon}`} /></svg>{label}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- PROOF BAND: typed promise, rolling review count, scrolling facts -->
  <section class="proof" id="proof" aria-label={`Invite only. Highly rated pros. ${reviewDigits} Google reviews. ${tapeItems.join('. ')}.`}>
    <div class="container proof-in" aria-hidden="true">
      <p class="proof-brand">Invite only</p>
      <p class="proof-type" data-text="Highly rated pros"></p>
      <p class="proof-lead">Behind every listing on Sioux Falls Go</p>
      <div class="proof-odo">
        {[...reviewDigits].map((c) => c === ',' ? <span class="proof-cm">,</span> : (
          <span class="proof-dg"><span class="proof-col" data-to={c}>{Array.from({ length: 10 }, (_, k) => <i>{k}</i>)}</span></span>
        ))}
      </div>
      <p class="proof-cap">Google reviews from your neighbors</p>
    </div>
    <div class="proof-tape" aria-hidden="true"><div class="proof-track">
      {[...tapeItems, ...tapeItems].map((t) => <span>{t}</span>)}
    </div></div>
  </section>

  <div class="container page">

    {giveBack.length > 0 && (
      <section aria-labelledby="giveback-heading" class="giveback-section">
        <div class="section-header-row">
          <div>
            <span class="eyebrow"><Icon name="handshake" size={13} /> Give Back Partners</span>
            <h2 id="giveback-heading">Businesses investing in Sioux Falls</h2>
          </div>
        </div>
        <div class="grid" id="giveback-grid">
          {giveBack.map((business, i) => (
            <div class="reveal-item" data-index={i} hidden={i >= 6}><BusinessCard business={business} /></div>
          ))}
        </div>
        {giveBack.length > 6 && (
          <div class="see-more-wrap"><button class="see-more-btn" data-target="giveback-grid">See more ({giveBack.length - 6} more)</button></div>
        )}
      </section>
    )}
  </div>

  <section class="verified-band">
    <div class="container">
      <span class="eyebrow"><Icon name="sparkles" size={13} /> Newly Verified</span>
      <h2>Recently confirmed by our team</h2>
      <div class="grid">
        {newlyVerified.map((business) => <BusinessCard business={business} compact />)}
      </div>
    </div>
  </section>

  <div class="container page">
    <section class="stats-band" aria-label="Directory stats">
      <div class="stats-grid">
        <div class="stat-item">
          <strong>4.8+</strong>
          <span>Google rating required to get listed</span>
        </div>
        <div class="stat-item">
          <strong>{givingBackPct}%</strong>
          <span>Giving back to Sioux Falls</span>
        </div>
        <div class="stat-item">
          <strong>{categoryCounts.length}</strong>
          <span>Categories covered</span>
        </div>
      </div>
    </section>

    {localInsights.length > 0 && (
      <section class="insights-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">Local Insights</span>
        <h2>Resources and Tips to Shop and Hire Smarter in Sioux Falls</h2>
        <div class="insights-grid">
          {localInsights.map(({ article, category }) => (
            <a class="insight-card" href={`/guides/${article.id}`}>
              <div class="insight-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={24} class="insight-card-icon" />}
              </div>
              <div class="insight-card-body">
                <span class="insight-tag">{article.data.contentType.replace('-', ' ')}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
                <span class="insight-link">Read more →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="legend-section" id="legend">
      <div class="legend-card">
        <div class="legend-copy">
          <span class="legend-eyebrow"><Icon name="heart" size={13} /> Already Shop Local?</span>
          <h2>Become a Local Legend</h2>
          <p>We're giving away gift cards, prizes, and exclusive deals from top local businesses in Sioux Falls! <Icon name="sparkles" size={18} class="legend-sparkle" /></p>
          <p class="legend-sub">Join Local Legend VIP and be the first to know about our next big giveaway. It's 100% free — no strings attached!</p>
          <span class="legend-badge"><Icon name="gift" size={13} /> Giveaways starting soon</span>
        </div>
        <form id="legend-form" class="legend-form">
          <label for="legend-name">Name</label>
          <input type="text" id="legend-name" name="name" placeholder="Name" />
          <label for="legend-email">Email*</label>
          <input type="email" id="legend-email" name="email" placeholder="Email" required />
          <button type="submit" class="button legend-submit" id="legend-submit-btn">Start Winning</button>
          <p class="legend-form-status" id="legend-form-status" hidden></p>
        </form>
      </div>
    </section>

    <section class="dir-faq" aria-labelledby="dir-faq-heading">
      <span class="eyebrow">Questions</span>
      <h2 id="dir-faq-heading">How the directory works</h2>
      <div class="dir-faq-list">
        <details class="dir-faq-item">
          <summary>How does a business get listed here?</summary>
          <p>Every business is personally vetted before it's added — a 4.8+ Google rating is required, along with a real, ongoing presence in the Sioux Falls community. We don't accept paid listings.</p>
        </details>
        <details class="dir-faq-item">
          <summary>What does "Verified" mean?</summary>
          <p>Our team has personally confirmed the business's contact info, hours, and standing — not an automated check, an actual review.</p>
        </details>
        <details class="dir-faq-item">
          <summary>What's the difference between Give Back Partners and Community Champions?</summary>
          <p>Both tiers meet the same 4.8+ rating bar. Give Back Partners commit to at least two community giveaways a year. Community Champions go further, with deeper community investment and additional visibility on the platform.</p>
        </details>
        <details class="dir-faq-item">
          <summary>Is this free for residents to use?</summary>
          <p>Completely. Sioux Falls Go makes money from businesses that choose to invest in the platform, never from residents.</p>
        </details>
      </div>
    </section>

    <div class="claim-cta">
      <div>
        <h3>Sioux Falls Go is invite-only.</h3>
        <p>We don't list every business — we recommend the ones that earn a 4.8+ Google rating and give back to the community. Think your business qualifies?</p>
      </div>
      <a class="button" href="/get-featured">Apply for consideration</a>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* HERO: centered, light, search first */
  .dir-hero { background: linear-gradient(180deg, #FFFFFF 0%, #F5F8FC 100%); border-bottom: 1px solid var(--color-line); }
  .dir-hero-inner { display: flex; flex-direction: column; align-items: center; text-align: center; padding-block: 3.6rem 3.2rem; }
  .dir-faces { display: flex; justify-content: center; margin-bottom: 1.2rem; }
  .dir-faces img { width: 3.1rem; height: 3.1rem; border-radius: 50%; object-fit: cover; border: 3px solid #fff; box-shadow: 0 4px 12px rgba(27,42,74,0.15); margin-left: -0.7rem; background: #E8EDF4; }
  .dir-faces img:first-child { margin-left: 0; }
  .dir-brand { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--color-orange-dark); margin: 0 0 0.7rem; }
  .dir-hero h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.3rem, 4.4vw, 3.8rem); line-height: 1.05; letter-spacing: -0.035em; color: var(--color-navy); margin: 0 0 1rem; max-width: 18ch; }
  .dir-hero-sub { font-size: 1.1rem; line-height: 1.55; color: var(--color-navy-light); max-width: 38rem; margin: 0 0 1.8rem; }

  .hero-search-wrap { position: relative; width: 100%; max-width: 40rem; }
  .hero-search {
    display: flex; align-items: center; gap: 0.6rem; background: #fff; border-radius: 0.75rem; border: 1px solid #DCE3EC;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem; box-shadow: 0 12px 32px rgba(27,42,74,0.1);
  }
  .hero-search:focus-within { border-color: var(--color-orange); }
  .hero-search-icon { color: var(--color-navy); flex-shrink: 0; display: flex; }
  .hero-search input {
    border: none; outline: none; flex: 1; min-width: 0; font-size: 1rem; font-family: var(--font-body); color: var(--color-navy);
    background: transparent; -webkit-appearance: none; appearance: none; padding: 0.55rem 0;
  }
  .hero-search input::-webkit-search-decoration { -webkit-appearance: none; }
  .search-place-btn {
    flex-shrink: 0; background: var(--color-orange); color: #fff; border: none; font-weight: 600; font-size: 0.95rem;
    padding: 0.8rem 1.4rem; border-radius: 0.5rem; cursor: pointer; font-family: var(--font-body);
  }
  .search-place-btn:hover { background: #E06F15; }
  .search-place-btn:focus-visible { outline: 3px solid var(--color-navy); outline-offset: 2px; }

  .search-results {
    position: absolute; left: 0; right: 0; top: calc(100% + 0.5rem); text-align: left; background: #fff; border-radius: 0.8rem;
    box-shadow: 0 12px 30px rgba(27,42,74,0.15); overflow: hidden; z-index: 20;
  }
  /* These elements are injected client-side via innerHTML, so Astro's build-time
     scoping attribute never reaches them — :global() is required. */
  :global(.search-result-item) {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1rem; text-decoration: none;
    color: var(--color-navy); font-size: 0.9375rem; font-weight: 600; border-bottom: 1px solid var(--color-line);
  }
  :global(.search-result-item:last-child) { border-bottom: none; }
  :global(.search-result-item:hover) { background: var(--color-surface); }
  :global(.search-result-type) {
    font-size: 0.7rem; font-weight: 700; color: var(--color-orange-dark); background: var(--color-surface);
    padding: 0.2rem 0.5rem; border-radius: var(--radius-pill); flex-shrink: 0;
  }
  :global(.search-result-label) { flex: 1; }
  :global(.search-no-results) { padding: 0.9rem 1rem; font-size: 0.875rem; color: var(--color-navy-light); }

  .dir-chips { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; max-width: 46rem; }
  .dir-chip {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.95rem; border-radius: 0.6rem;
    background: #fff; border: 1px solid #DCE3EC; color: var(--color-navy); font-weight: 600; font-size: 0.9rem; text-decoration: none; white-space: nowrap;
  }
  .dir-chip svg { color: var(--color-orange-dark); flex-shrink: 0; }
  .dir-chip:hover { border-color: var(--color-orange); color: var(--color-orange-dark); }
  .dir-chip:focus-visible { outline: 3px solid var(--color-orange); outline-offset: 2px; }

  @media (max-width: 40rem) {
    .dir-hero-inner { padding-block: 2.4rem 2.2rem; }
    .dir-hero h1 { font-size: 2.2rem; }
    .dir-hero-sub { font-size: 1rem; }
    .search-place-btn { padding: 0.8rem 1rem; }
    .dir-chips { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; width: calc(100% + 2 * var(--space-3, 1.5rem)); margin-inline: calc(-1 * var(--space-3, 1.5rem)); padding-inline: var(--space-3, 1.5rem); scrollbar-width: none; }
    .dir-chips::-webkit-scrollbar { display: none; }
  }

  /* CATEGORY PILLS */
  .category-pills-row { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center; padding-block: var(--space-3); }
  .category-pill {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    background: #fff; border-radius: var(--radius); padding: var(--space-2); text-decoration: none; min-width: 6.5rem;
    box-shadow: 0 2px 10px rgba(13,23,48,0.06); border: 1px solid var(--color-line);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .category-pill:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(46,111,158,0.18); border-color: var(--color-river); }
  .category-pill-icon {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    color: var(--color-river); background: var(--color-river-light);
  }
  .category-pill span:last-child { font-size: 0.75rem; font-weight: 700; color: var(--color-navy); text-align: center; }

  .page { padding-block: var(--space-4) var(--space-6); }
  .page .eyebrow, section .eyebrow { display: inline-flex; align-items: center; gap: 0.3rem; margin-bottom: 0.2rem; }

  /* PROOF BAND */
  .proof { background: #0B1222; color: #fff; text-align: center; overflow: hidden; }
  .proof-in { padding-block: clamp(2.6rem, 5vw, 4.4rem) clamp(2rem, 4vw, 3.2rem); }
  .proof-brand { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: #FF9A4D; margin: 0 0 0.6rem; }
  .proof-type { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.4rem, 6vw, 5.2rem); line-height: 1.05; letter-spacing: -0.035em; margin: 0 0 1.6rem; min-height: 1.1em; }
