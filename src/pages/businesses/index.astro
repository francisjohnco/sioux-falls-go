---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import Icon from '../../components/Icon.astro';

const businesses = await getCollection('businesses');
const categories = await getCollection('categories');

// Real search index for the hero search — every business and category, by name
const searchIndex = [
  ...categories.map((c) => ({ type: 'category' as const, label: c.data.name, url: `/${c.data.slug}` })),
  ...businesses.map((b) => ({ type: 'business' as const, label: b.data.name, url: `/businesses/${b.id}` })),
];
const giveBack = businesses.filter((b) => b.data.partnershipTier === 'community-listing' || b.data.partnershipTier === 'community-champion');

const newlyVerified = businesses
  .filter((b) => b.data.verifiedAt)
  .sort((a, b) => b.data.verifiedAt!.getTime() - a.data.verifiedAt!.getTime())
  .slice(0, 6);

const categoryCounts = categories
  .map((cat) => ({ cat, count: businesses.filter((b) => b.data.category.id === cat.id).length }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const popularCategories = categoryCounts.slice(0, 6);

// Real stats for the closing section — computed from actual data, not made up
const givingBackCount = businesses.filter((b) => b.data.partnershipTier === 'community-champion' || b.data.partnershipTier === 'community-listing').length;
const givingBackPct = businesses.length ? Math.round((givingBackCount / businesses.length) * 100) : 0;

// Local Insights — a hand-picked set of real, useful guides, not an
// algorithmic "latest articles" dump
const insightSlugs = [
  'how-to-shop-local-and-make-every-dollar-count',
  'how-to-choose-a-plumber-in-sioux-falls',
  'how-to-choose-a-flooring-contractor-in-sioux-falls',
  'how-to-choose-a-real-estate-agent-in-sioux-falls',
  'how-to-choose-a-tree-service-in-sioux-falls',
  'how-to-choose-a-painting-contractor-in-sioux-falls',
];
const allArticles = await getCollection('articles');
const localInsights = await Promise.all(
  insightSlugs
    .map((slug) => allArticles.find((a) => a.id === slug))
    .filter((a): a is NonNullable<typeof a> => Boolean(a))
    .map(async (article) => ({ article, category: await getEntry(article.data.category) }))
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sioux Falls Business Directory',
};
---
<BaseLayout
  title="Business Directory"
  description="Browse trusted Sioux Falls businesses by category — verified hours, contact info, and services."
  canonicalPath="/businesses"
  schema={schema}
>
  <SiteHeader slot="header" />

  <!-- HERO — same copy, new warm editorial treatment -->
  <section class="dir-hero">
    <div class="container dir-hero-inner">
      <div class="dir-hero-copy">
        <span class="eyebrow">Sioux Falls Local Guide</span>
        <h1>Explore, Discover and Support Local Businesses in Sioux Falls, SD</h1>
        <p class="dir-hero-sub">Your neighbor's guide to the businesses worth knowing about — real recommendations, not paid placements.</p>

        <div class="hero-search">
          <span class="hero-search-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          </span>
          <input type="search" id="hero-search-input" placeholder="Search businesses, services, or categories..." aria-label="Search businesses" data-index={JSON.stringify(searchIndex)} autocomplete="off" />
        </div>
        <div class="search-results" id="search-results" hidden></div>
        <button class="search-place-btn" id="search-place-btn">Search Place</button>

        <p class="hero-popular-searches">
          Popular: <a href="/plumbers">Plumbers</a> · <a href="/appliance-repair-service">Appliance Repair Service</a> · <a href="/coffee-shops">Coffee Shops</a> · <a href="/restaurants-dining">Restaurants &amp; Dining</a>
        </p>
      </div>

      <div class="dir-hero-collage">
        <div class="collage-photo collage-photo--main" style="background-image: url(/images/scenic/falls-park-1.jpg)"></div>
        <div class="collage-photo collage-photo--sub" style="background-image: url(/images/scenic/downtown-2.jpg)"></div>
        <div class="collage-badge">
          <svg viewBox="0 0 120 120" class="collage-badge-ring">
            <defs><path id="badgeCircle" d="M 60,60 m -42,0 a 42,42 0 1,1 84,0 a 42,42 0 1,1 -84,0" /></defs>
            <text font-size="10.3" font-weight="700" letter-spacing="1.5" fill="#fff">
              <textPath href="#badgeCircle" startOffset="0%">YOUR SIOUX FALLS GUIDE • YOUR SIOUX FALLS GUIDE •</textPath>
            </text>
          </svg>
          <span class="collage-badge-center"><Icon name="pin" size={22} /></span>
        </div>
      </div>
    </div>
  </section>

  <div class="container page">
    <div class="hero-trust-row">
      <span><Icon name="check" size={13} /> 4.8+ rating required</span>
      <span><Icon name="check" size={13} /> Real local businesses only</span>
      <span><Icon name="check" size={13} /> No pay-to-rank listings</span>
    </div>

    {giveBack.length > 0 && (
      <section aria-labelledby="giveback-heading" class="giveback-section">
        <div class="section-header-row">
          <div>
            <span class="eyebrow"><Icon name="handshake" size={13} /> Give Back Partners</span>
            <h2 id="giveback-heading">Businesses investing in Sioux Falls</h2>
          </div>
        </div>
        <div class="grid" id="giveback-grid">
          {giveBack.map((business, i) => (
            <div class="reveal-item" data-index={i} hidden={i >= 6}><BusinessCard business={business} /></div>
          ))}
        </div>
        {giveBack.length > 6 && (
          <div class="see-more-wrap"><button class="see-more-btn" data-target="giveback-grid">See more ({giveBack.length - 6} more)</button></div>
        )}
      </section>
    )}
  </div>

  <section class="verified-band">
    <div class="container">
      <span class="eyebrow"><Icon name="sparkles" size={13} /> Newly Verified</span>
      <h2>Recently confirmed by our team</h2>
      <div class="grid">
        {newlyVerified.map((business) => <BusinessCard business={business} compact />)}
      </div>
    </div>
  </section>

  <div class="container page">
    <section class="stats-band" aria-label="Directory stats">
      <div class="stats-grid">
        <div class="stat-item">
          <strong>4.8+</strong>
          <span>Google rating required to get listed</span>
        </div>
        <div class="stat-item">
          <strong>{givingBackPct}%</strong>
          <span>Giving back to Sioux Falls</span>
        </div>
        <div class="stat-item">
          <strong>{categoryCounts.length}</strong>
          <span>Categories covered</span>
        </div>
      </div>
    </section>

    {localInsights.length > 0 && (
      <section class="insights-section">
        <div class="contour-rule" role="presentation"></div>
        <span class="eyebrow">Local Insights</span>
        <h2>Resources and Tips to Shop and Hire Smarter in Sioux Falls</h2>
        <div class="insights-grid">
          {localInsights.map(({ article, category }) => (
            <a class="insight-card" href={`/guides/${article.id}`}>
              <div class="insight-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={24} class="insight-card-icon" />}
              </div>
              <div class="insight-card-body">
                <span class="insight-tag">{article.data.contentType.replace('-', ' ')}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
                <span class="insight-link">Read more →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="legend-section" id="legend">
      <div class="legend-card">
        <div class="legend-copy">
          <span class="legend-eyebrow"><Icon name="heart" size={13} /> Already Shop Local?</span>
          <h2>Become a Local Legend</h2>
          <p>We're giving away gift cards, prizes, and exclusive deals from top local businesses in Sioux Falls! <Icon name="sparkles" size={18} class="legend-sparkle" /></p>
          <p class="legend-sub">Join Local Legend VIP and be the first to know about our next big giveaway. It's 100% free — no strings attached!</p>
          <span class="legend-badge"><Icon name="gift" size={13} /> Giveaways starting soon</span>
        </div>
        <form id="legend-form" class="legend-form">
          <label for="legend-name">Name</label>
          <input type="text" id="legend-name" name="name" placeholder="Name" />
          <label for="legend-email">Email*</label>
          <input type="email" id="legend-email" name="email" placeholder="Email" required />
          <button type="submit" class="button legend-submit" id="legend-submit-btn">Start Winning</button>
          <p class="legend-form-status" id="legend-form-status" hidden></p>
        </form>
      </div>
    </section>

    <section class="dir-faq" aria-labelledby="dir-faq-heading">
      <span class="eyebrow">Questions</span>
      <h2 id="dir-faq-heading">How the directory works</h2>
      <div class="dir-faq-list">
        <details class="dir-faq-item">
          <summary>How does a business get listed here?</summary>
          <p>Every business is personally vetted before it's added — a 4.8+ Google rating is required, along with a real, ongoing presence in the Sioux Falls community. We don't accept paid listings.</p>
        </details>
        <details class="dir-faq-item">
          <summary>What does "Verified" mean?</summary>
          <p>Our team has personally confirmed the business's contact info, hours, and standing — not an automated check, an actual review.</p>
        </details>
        <details class="dir-faq-item">
          <summary>What's the difference between Give Back Partners and Community Champions?</summary>
          <p>Both tiers meet the same 4.8+ rating bar. Give Back Partners commit to at least two community giveaways a year. Community Champions go further, with deeper community investment and additional visibility on the platform.</p>
        </details>
        <details class="dir-faq-item">
          <summary>Is this free for residents to use?</summary>
          <p>Completely. Sioux Falls Go makes money from businesses that choose to invest in the platform, never from residents.</p>
        </details>
      </div>
    </section>

    <div class="claim-cta">
      <div>
        <h3>Sioux Falls Go is invite-only.</h3>
        <p>We don't list every business — we recommend the ones that earn a 4.8+ Google rating and give back to the community. Think your business qualifies?</p>
      </div>
      <a class="button" href="/get-featured">Apply for consideration</a>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* HERO */
  .dir-hero { background: #FBF3E7; overflow: hidden; }
  .dir-hero-inner {
    display: grid; grid-template-columns: 700px 1fr; gap: 3rem; align-items: center;
    padding-block: 4rem; min-height: 34rem;
  }
  @media (max-width: 65rem) { .dir-hero-inner { grid-template-columns: 1fr; padding-block: 3rem; } }

  .dir-hero-copy .eyebrow { color: var(--color-orange-dark); }
  .dir-hero h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: 2.75rem; line-height: 1.15; color: var(--color-navy); margin: 0.5rem 0 1rem; max-width: 20ch;
  }
  .dir-hero-sub { font-size: 1.0625rem; color: var(--color-navy-light); max-width: 44ch; margin-bottom: 1.8rem; }

  .hero-search {
    display: flex; align-items: center; gap: 0.6rem; background: #fff; border-radius: 1rem;
    padding: 0.9rem 1.2rem; box-shadow: 0 8px 24px rgba(27,42,74,0.08); max-width: 30rem; position: relative;
  }
  .hero-search-icon { color: var(--color-navy-light); flex-shrink: 0; }
  .hero-search input { border: none; outline: none; flex: 1; font-size: 0.9375rem; font-family: var(--font-body); }

  .search-results {
    position: relative; max-width: 30rem; margin-top: 0.5rem; background: #fff; border-radius: 0.8rem;
    box-shadow: 0 12px 30px rgba(27,42,74,0.15); overflow: hidden; z-index: 20;
  }
  /* These elements are injected client-side via innerHTML, so Astro's build-time
     scoping attribute never reaches them — :global() is required or none of this
     CSS would ever match them, despite compiling without error. */
  :global(.search-result-item) {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1rem; text-decoration: none;
    color: var(--color-navy); font-size: 0.9375rem; font-weight: 600; border-bottom: 1px solid var(--color-line);
  }
  :global(.search-result-item:last-child) { border-bottom: none; }
  :global(.search-result-item:hover) { background: var(--color-surface); }
  :global(.search-result-type) {
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em;
    color: var(--color-orange-dark); background: var(--color-surface); padding: 0.2rem 0.5rem; border-radius: var(--radius-pill);
    flex-shrink: 0;
  }
  :global(.search-result-label) { flex: 1; }
  :global(.search-no-results) { padding: 0.9rem 1rem; font-size: 0.875rem; color: var(--color-navy-light); }

  .search-place-btn {
    display: block; margin-top: 0.8rem; background: var(--color-gold); color: var(--color-navy); border: none;
    font-weight: 700; font-size: 0.9375rem; padding: 0.9rem 1.6rem; border-radius: 1rem; cursor: pointer;
    max-width: 30rem; width: 100%; transition: background 0.2s ease, transform 0.2s ease;
  }
  .search-place-btn:hover { background: #ffc857; transform: translateY(-1px); }
  .hero-popular-searches { margin-top: 1.1rem; font-size: 0.8125rem; color: var(--color-navy-light); }
  .hero-popular-searches a { color: var(--color-orange-dark); font-weight: 700; text-decoration: none; }

  .dir-hero-collage { position: relative; height: 22rem; }
  @media (max-width: 65rem) { .dir-hero-collage { display: none; } }
  .collage-photo { position: absolute; background-size: cover; background-position: center; box-shadow: 0 20px 44px rgba(27,42,74,0.22); }
  .collage-photo--main {
    top: 0; right: 2rem; width: 78%; height: 60%; border-radius: 1.5rem;
    clip-path: polygon(12% 0, 100% 0, 88% 100%, 0% 100%);
  }
  .collage-photo--sub {
    bottom: 0; left: 0; width: 62%; height: 46%; border-radius: 1.5rem;
    clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);
  }
  .collage-badge {
    position: absolute; bottom: 18%; left: -1.5rem; width: 6.5rem; height: 6.5rem;
    display: flex; align-items: center; justify-content: center;
  }
  .collage-badge-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: badge-spin 16s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .collage-badge-ring { animation: none; } }
  @keyframes badge-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .collage-badge-center {
    position: relative; z-index: 1; width: 3rem; height: 3rem; border-radius: 50%;
    background: var(--color-orange); color: #fff; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 16px rgba(240,126,35,0.4);
  }
  .collage-badge::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--color-navy);
  }

  /* CATEGORY PILLS */
  .category-pills-row { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center; padding-block: var(--space-3); }
  .category-pill {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    background: #fff; border-radius: var(--radius); padding: var(--space-2); text-decoration: none; min-width: 6.5rem;
    box-shadow: 0 2px 10px rgba(13,23,48,0.06); border: 1px solid var(--color-line);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .category-pill:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(46,111,158,0.18); border-color: var(--color-river); }
  .category-pill-icon {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    color: var(--color-river); background: var(--color-river-light);
  }
  .category-pill span:last-child { font-size: 0.75rem; font-weight: 700; color: var(--color-navy); text-align: center; }

  .page { padding-block: var(--space-4) var(--space-6); }
  .page .eyebrow, section .eyebrow { display: inline-flex; align-items: center; gap: 0.3rem; margin-bottom: 0.2rem; }

  .hero-trust-row { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; padding: var(--space-2); background: var(--color-river-light); border-radius: var(--radius); margin-bottom: var(--space-4); font-size: 0.8125rem; font-weight: 600; }
  .hero-trust-row span { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--color-navy); }

  .section-header-row { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-2); }
  .see-all-link { font-size: 0.875rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; white-space: nowrap; }
  .see-all-link:hover { text-decoration: underline; }

  .giveback-list-section { margin-bottom: var(--space-5); }
  .giveback-list { display: flex; flex-direction: column; gap: 0.6rem; margin-top: var(--space-3); }
  .giveback-row {
    display: flex; align-items: center; gap: var(--space-2); text-decoration: none;
    background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .giveback-row:hover { transform: translateX(4px); box-shadow: 0 4px 14px rgba(46,111,158,0.14); border-color: var(--color-river); }
  .giveback-thumb {
    width: 3.25rem; height: 3.25rem; border-radius: var(--radius); flex-shrink: 0;
    background-color: var(--color-navy); background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: center; color: #fff;
  }
  .giveback-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .giveback-info strong { font-size: 0.9375rem; color: var(--color-navy); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .giveback-meta { font-size: 0.8125rem; color: var(--color-navy-light); }
  .giveback-rating { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 700; color: var(--color-navy); font-size: 0.875rem; white-space: nowrap; }
  :global(.filled-star) { fill: var(--color-gold); color: var(--color-gold); }

  /* NEWLY VERIFIED — its own blue band for depth */
  .verified-band { background: linear-gradient(180deg, var(--color-river-light) 0%, #fff 100%); padding-block: var(--space-5); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-3); }
  @media (max-width: 55rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .grid { grid-template-columns: 1fr; } }
  .empty-note { text-align: center; color: var(--color-navy-light); margin-top: var(--space-3); }
  .see-more-wrap { text-align: center; margin-top: var(--space-3); }
  .see-more-btn {
    background: #fff; border: 1.5px solid var(--color-river); color: var(--color-river);
    font-weight: 700; font-size: 0.9375rem; padding: 0.7rem 1.6rem; border-radius: var(--radius-pill); cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .see-more-btn:hover { background: var(--color-river); color: #fff; }
  .giveback-section { margin-bottom: var(--space-5); }

  .stats-band {
    margin-top: var(--space-5); padding: var(--space-4); border-radius: var(--radius);
    background: linear-gradient(120deg, var(--color-navy) 0%, var(--color-river) 100%);
  }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: var(--space-3); text-align: center; }
  .stat-item { display: flex; flex-direction: column; gap: 0.3rem; }
  .stat-item strong { display: flex; align-items: center; justify-content: center; gap: 0.4rem; font-family: var(--font-display); font-size: 1.9rem; font-weight: 700; color: #fff; }
  .stat-item span { font-size: 0.8125rem; color: rgba(255,255,255,0.8); font-weight: 600; }

  .insights-section { margin-top: var(--space-5); }
  .insights-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-3); }
  @media (max-width: 55rem) { .insights-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .insights-grid { grid-template-columns: 1fr; } }
  .insight-card {
    display: block; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden;
    text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .insight-card:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(46,111,158,0.14); border-color: var(--color-river); }
  .insight-card-media {
    height: 12.5rem; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-river) 100%);
    background-size: cover; background-position: center;
  }
  .insight-card-icon { color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); }
  .insight-card-body { padding: var(--space-3); }
  .insight-tag { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-orange-dark); }
  .insight-card h3 { font-size: 1.0625rem; margin: 0.4rem 0 0.4rem; color: var(--color-navy); }
  .insight-card p { font-size: 0.875rem; color: var(--color-navy-light); margin: 0 0 0.8rem; }
  .insight-link { font-size: 0.8125rem; font-weight: 700; color: var(--color-river); }

  .legend-section { margin-top: var(--space-5); }
  .legend-card {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-4); align-items: center;
    background: linear-gradient(120deg, var(--color-navy) 0%, #2c3f61 55%, var(--color-orange) 160%);
    border-radius: var(--radius); padding: var(--space-5); color: #fff; position: relative; overflow: hidden;
  }
  @media (max-width: 50rem) { .legend-card { grid-template-columns: 1fr; padding: var(--space-4); } }
  .legend-eyebrow { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-gold); font-weight: 700; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .legend-copy h2 { color: #fff; font-size: 2rem; margin: 0.5rem 0 0.9rem; }
  .legend-copy p { color: rgba(255,255,255,0.9); font-size: 1.0625rem; margin: 0 0 0.6rem; display: flex; align-items: center; gap: 0.4rem; }
  .legend-sparkle { color: var(--color-gold); flex-shrink: 0; }
  .legend-sub { font-size: 0.9375rem !important; color: rgba(255,255,255,0.78) !important; }
  .legend-badge {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: var(--space-2);
    background: rgba(255,255,255,0.15); font-size: 0.8125rem; font-weight: 700; padding: 0.4rem 0.9rem; border-radius: var(--radius-pill);
  }
  .legend-form {
    background: rgba(255,255,255,0.97); border-radius: var(--radius); padding: var(--space-3);
    display: flex; flex-direction: column; gap: 0.5rem; position: relative; z-index: 1;
  }
  .legend-form label { font-size: 0.75rem; font-weight: 700; color: var(--color-navy); text-transform: uppercase; letter-spacing: 0.02em; }
  .legend-form input {
    padding: 0.75rem 1rem; border-radius: 0.6rem; border: 1.5px solid var(--color-line); font-family: var(--font-body); font-size: 0.9375rem;
  }
  .legend-submit { margin-top: 0.5rem; background: var(--color-orange); border: none; }
  .legend-form-status { font-size: 0.8125rem; font-weight: 600; margin: 0.4rem 0 0; }
  .legend-form-status.is-success { color: var(--color-success); }
  .legend-form-status.is-error { color: #C0392B; }

  .dir-faq { margin-top: var(--space-5); }
  .dir-faq-list { display: flex; flex-direction: column; gap: 0.6rem; margin-top: var(--space-3); }
  .dir-faq-item { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-2); }
  .dir-faq-item summary { cursor: pointer; font-weight: 700; color: var(--color-navy); }
  .dir-faq-item p { margin: var(--space-1) 0 0; font-size: 0.9375rem; color: var(--color-navy-light); }

  .all-biz-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-2); }
  .filter-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filter-bar select {
    padding: 0.5rem 0.75rem; border-radius: var(--radius-pill); border: 1.5px solid var(--color-line);
    font-size: 0.875rem; background: #fff; color: var(--color-navy);
  }

  .claim-cta {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap;
    margin-top: var(--space-5); padding: var(--space-4); border-radius: var(--radius);
    background: linear-gradient(120deg, var(--color-navy) 0%, var(--color-river) 100%);
  }
  .claim-cta h3, .claim-cta p { color: #fff; margin: 0; }
  .claim-cta p { margin-top: 0.25rem; max-width: 44ch; }
</style>

<script>
  // Local Legend VIP signup — real MailerLite subscription, not a static form
  const legendForm = document.getElementById('legend-form') as HTMLFormElement;
  const legendStatus = document.getElementById('legend-form-status');
  const legendBtn = document.getElementById('legend-submit-btn') as HTMLButtonElement;

  legendForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('legend-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('legend-email') as HTMLInputElement).value.trim();

    legendBtn.disabled = true;
    legendBtn.textContent = 'Joining…';
    if (legendStatus) { legendStatus.hidden = true; }

    try {
      const res = await fetch('/api/subscribe-local-legend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong');

      legendForm.reset();
      if (legendStatus) {
        legendStatus.textContent = `You're in! Watch your inbox for the next giveaway.`;
        legendStatus.classList.remove('is-error');
        legendStatus.classList.add('is-success');
        legendStatus.hidden = false;
      }
    } catch (err: any) {
      if (legendStatus) {
        legendStatus.textContent = `Couldn't sign you up: ${err.message}`;
        legendStatus.classList.remove('is-success');
        legendStatus.classList.add('is-error');
        legendStatus.hidden = false;
      }
    } finally {
      legendBtn.disabled = false;
      legendBtn.textContent = 'Start Winning';
    }
  });

  // See More buttons — reveal the rest of a capped grid (still used by Give Back Partners)
  document.querySelectorAll('.see-more-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target!;
      document.querySelectorAll(`#${targetId} .reveal-item`).forEach((item) => {
        (item as HTMLElement).hidden = false;
      });
      (btn as HTMLElement).style.display = 'none';
    });
  });

  // Hero search — routes to the category page if the query matches one,
  // otherwise scrolls to Give Back Partners. The full filterable "All
  // Businesses" grid was removed from this page.
  const searchInput = document.getElementById('hero-search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results') as HTMLElement;
  const searchIndex: { type: 'business' | 'category'; label: string; url: string }[] = JSON.parse(searchInput?.dataset.index || '[]');

  function renderResults(query: string) {
    if (!query) { searchResults.hidden = true; searchResults.innerHTML = ''; return; }
    const q = query.toLowerCase();
    const matches = searchIndex.filter((item) => item.label.toLowerCase().includes(q)).slice(0, 8);
    if (matches.length === 0) {
      searchResults.innerHTML = `<div class="search-no-results">No matches for "${query}" — try a category name or business name.</div>`;
      searchResults.hidden = false;
      return;
    }
    searchResults.innerHTML = matches
      .map((m) => `<a href="${m.url}" class="search-result-item"><span class="search-result-type">${m.type === 'business' ? 'Business' : 'Category'}</span><span class="search-result-label">${m.label}</span></a>`)
      .join('');
    searchResults.hidden = false;
  }

  function runHeroSearch() {
    const q = searchInput?.value.trim().toLowerCase();
    if (!q) {
      document.querySelector('.giveback-section')?.scrollIntoView({ behavior: 'smooth' });
      return;
    }
    const exact = searchIndex.find((item) => item.label.toLowerCase() === q);
    const partial = searchIndex.find((item) => item.label.toLowerCase().includes(q));
    const match = exact || partial;
    if (match) {
      window.location.href = match.url;
    } else {
      renderResults(searchInput.value.trim());
    }
  }

  searchInput?.addEventListener('input', () => renderResults(searchInput.value.trim()));
  searchInput?.addEventListener('focus', () => { if (searchInput.value.trim()) renderResults(searchInput.value.trim()); });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.hero-search') && !(e.target as HTMLElement).closest('.search-results')) {
      searchResults.hidden = true;
    }
  });
  document.getElementById('search-place-btn')?.addEventListener('click', runHeroSearch);
  searchInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') runHeroSearch(); });
</script>
