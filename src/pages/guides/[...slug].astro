---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// For splitting content around the sponsor banner, get the raw rendered HTML
const rawHtml = article.rendered?.html ?? '';
const firstParaEnd = rawHtml.indexOf('</p>');
const introHtml = firstParaEnd !== -1 ? rawHtml.slice(0, firstParaEnd + 4) : '';
const restHtml = firstParaEnd !== -1 ? rawHtml.slice(firstParaEnd + 4) : rawHtml;
const category = await getEntry(article.data.category);

// Resolve explicit relatedArticles references first
const explicitRelated = await Promise.all(
  (article.data.relatedArticles ?? []).map((ref) => getEntry(ref))
);

// Fill out to 3 with same-category articles if the author didn't set enough explicit links
let related = [...explicitRelated];
if (related.length < 3) {
  const allArticles = await getCollection('articles');
  const sameCategory = allArticles.filter(
    (a) => a.data.category.id === category.id && a.id !== article.id && !related.some((r) => r.id === a.id)
  );
  related = [...related, ...sameCategory.slice(0, 3 - related.length)];
}
const relatedWithCategory = await Promise.all(
  related.map(async (r) => ({ article: r, category: await getEntry(r.data.category) }))
);

// Resolve related businesses for the "find a pro" resource CTA
const relatedBusinesses = await Promise.all(
  (article.data.relatedBusinesses ?? []).map((ref) => getEntry(ref))
);

// Resolve sponsor — Community Champion perk
const sponsor = article.data.sponsoredBy ? await getEntry(article.data.sponsoredBy) : null;

const schema = article.data.embeddedFaqs.length > 0 ? [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.title,
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: article.data.updatedAt.toISOString(),
    author: { '@type': 'Person', name: article.data.author },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.data.embeddedFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
] : {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: article.data.updatedAt.toISOString(),
  author: { '@type': 'Person', name: article.data.author },
};
---
<BaseLayout
  title={article.data.seo.title}
  description={article.data.seo.description}
  canonicalPath={`/guides/${article.id}`}
  schema={schema}
>
  <SiteHeader slot="header" />

  <article class="container article">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href={`/${category.data.slug}`}>{category.data.name}</a> / <span>{article.data.title}</span>
    </nav>

    <span class="eyebrow">{article.data.contentType.replace('-', ' ')}</span>
    <h1>{article.data.title}</h1>
    <p class="byline">By {article.data.author} · Updated {article.data.updatedAt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>

    {article.data.heroImage && (
      <img src={article.data.heroImage} alt={article.data.title} class="article-hero-img" />
    )}
    {article.data.heroImageCredit && (
      <p class="hero-image-credit">
        Photo by <a href={article.data.heroImageCredit.profileUrl} target="_blank" rel="noopener">{article.data.heroImageCredit.photographer}</a> on Unsplash
      </p>
    )}

    <div class="prose">
      {sponsor ? (
        <>
          <Fragment set:html={introHtml} />
          <a href={`/businesses/${sponsor.id}`} class="sponsor-banner">
            <span class="sponsor-label">Sponsored</span>
            <div class="sponsor-content">
              <div
                class="sponsor-logo"
                style={sponsor.data.heroImage ? `background-image: url(${sponsor.data.heroImage});` : undefined}
              >
                {!sponsor.data.heroImage && sponsor.data.name.slice(0, 2).toUpperCase()}
              </div>
              <div>
                <p class="sponsor-text">
                  This article is made possible by <strong>{sponsor.data.name}</strong>. They serve Sioux Falls with
                  excellence, and their support helps us keep bringing free, local content to our community.
                </p>
                <span class="sponsor-link">Read more about {sponsor.data.name} →</span>
              </div>
            </div>
          </a>
          <Fragment set:html={restHtml} />
        </>
      ) : (
        <>
          <Fragment set:html={introHtml} />
          <a href="/how-visibility-works" class="sponsor-banner sponsor-banner--open">
            <span class="sponsor-label sponsor-label--open">Open Spot</span>
            <div class="sponsor-content">
              <div class="sponsor-logo sponsor-logo--open">+</div>
              <div>
                <p class="sponsor-text">
                  Community Champion businesses can claim this spot free. Find out how visibility works on Sioux Falls Go.
                </p>
                <span class="sponsor-link">See how it works →</span>
              </div>
            </div>
          </a>
          <Fragment set:html={restHtml} />
        </>
      )}
    </div>

    {article.data.embeddedFaqs.length > 0 && (
      <section class="embedded-faqs">
        <h2>Frequently Asked Questions</h2>
        {article.data.embeddedFaqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </section>
    )}

    <div class="resource-cta card">
      <h3>Keep exploring {category.data.name.toLowerCase()} in Sioux Falls</h3>
      <p>See every {category.data.name.toLowerCase()} business we recommend, plus more local guides like this one.</p>
      <a class="button" href={`/${category.data.slug}`}>Browse {category.data.name} →</a>
    </div>

    {relatedBusinesses.length > 0 && (
      <div class="business-links">
        <span class="eyebrow">Mentioned in this guide</span>
        <div class="business-chip-row">
          {relatedBusinesses.map((b) => (
            <a class="business-chip" href={`/businesses/${b.id}`}>{b.data.name} →</a>
          ))}
        </div>
      </div>
    )}
  </article>

  {related.length > 0 && (
    <div class="container related-wrap">
      <section class="related-block">
        <h2>You might also want to read</h2>
        <div class="related-grid">
          {relatedWithCategory.map(({ article: r, category: rCategory }) => (
            <a class="related-card" href={`/guides/${r.id}`}>
              <div class="related-card-media" style={r.data.heroImage ? `background-image: url(${r.data.heroImage})` : undefined}>
                {!r.data.heroImage && <Icon name={rCategory.data.icon} size={24} class="related-card-icon" />}
              </div>
              <div class="related-card-body">
                <span class="related-tag">{r.data.contentType.replace('-', ' ')}</span>
                <h3>{r.data.title}</h3>
                <p>{r.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  )}

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .article { padding-block: var(--space-4) var(--space-6); max-width: 42rem; }
  .breadcrumbs { font-size: 0.8125rem; color: var(--color-navy-light); margin-bottom: var(--space-2); }
  .breadcrumbs a { color: var(--color-navy-light); }
  .byline { font-size: 0.875rem; color: var(--color-navy-light); margin-top: -0.25rem; }
  .review-note {
    font-size: 0.875rem;
    color: var(--color-navy-light);
    border-left: 3px solid var(--color-orange);
    padding-left: var(--space-2);
  }

  .article-hero-img {
    width: 100%; height: 20rem; object-fit: cover;
    border-radius: var(--radius); margin-top: var(--space-2);
  }

  .sponsor-banner {
    display: block; text-decoration: none; margin-top: var(--space-3);
    background: #FFF8F0; border: 1.5px solid var(--color-orange); border-radius: var(--radius);
    padding: var(--space-2); position: relative;
    transition: box-shadow 0.15s ease;
  }
  .sponsor-banner:hover { box-shadow: 0 4px 14px rgba(240,126,35,0.18); }
  .sponsor-label {
    display: inline-block; font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; color: #fff; background: var(--color-orange);
    padding: 0.15rem 0.55rem; border-radius: var(--radius-pill); margin-bottom: 0.6rem;
  }
  .sponsor-content { display: flex; gap: var(--space-2); align-items: center; }
  .sponsor-logo {
    width: 3.5rem; height: 3.5rem; border-radius: 50%; flex-shrink: 0;
    background: var(--color-navy); background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 0.9375rem;
  }
  .sponsor-text { margin: 0; font-size: 0.9375rem; color: var(--color-ink); line-height: 1.5; }
  .sponsor-link { font-size: 0.875rem; font-weight: 700; color: var(--color-orange-dark); }

  .sponsor-banner--open {
    background: var(--color-surface); border: 1.5px dashed var(--color-line);
  }
  .sponsor-banner--open:hover { border-color: var(--color-navy-light); box-shadow: 0 4px 14px rgba(27,42,74,0.1); }
  .sponsor-label--open { background: var(--color-navy-light); }
  .sponsor-logo--open {
    background: #fff; border: 1.5px dashed var(--color-line); color: var(--color-navy-light);
    font-size: 1.5rem; font-weight: 400;
  }
  .sponsor-banner--open .sponsor-text { color: var(--color-navy-light); }
  .sponsor-banner--open .sponsor-link { color: var(--color-navy); }
  .prose { margin-top: var(--space-3); }
  .prose :global(h2) { margin-top: var(--space-4); }

  .embedded-faqs { margin-top: var(--space-4); }
  .faq-item {
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius);
    padding: var(--space-2); margin-bottom: 0.5rem;
  }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--color-navy); }
  .faq-item p { margin: var(--space-1) 0 0; font-size: 0.9375rem; color: var(--color-navy-light); }

  .resource-cta {
    margin-top: var(--space-4);
    background: var(--color-surface);
    text-align: center;
  }
  .resource-cta p { color: var(--color-navy-light); margin: 0.4rem 0 var(--space-2); }

  .business-links { margin-top: var(--space-3); }
  .business-chip-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .business-chip {
    font-size: 0.875rem; font-weight: 600; text-decoration: none;
    background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem; color: var(--color-navy);
  }
  .business-chip:hover { border-color: var(--color-orange); color: var(--color-orange); }

  .related-block { margin-top: var(--space-5); }
  .related-wrap { max-width: 60rem; margin-inline: auto; padding-block: var(--space-5); }
  .related-block { padding-top: var(--space-4); border-top: 1px solid var(--color-line); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-3); }
  @media (max-width: 45rem) { .related-grid { grid-template-columns: 1fr; } }
  .related-card {
    display: block; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(27,42,74,0.05);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .related-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(240,126,35,0.14); border-color: var(--color-orange); }
  .related-card-media {
    height: 12.5rem; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 60%, #F07E23 160%);
    background-size: cover; background-position: center;
  }
  .related-card-icon { color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); }
  .related-card-body { padding: var(--space-2); }
  .related-tag { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-orange); }
  .related-card h3 { font-size: 1.0625rem; margin: 0.3rem 0 0.35rem; }
  .related-card p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }
</style>
