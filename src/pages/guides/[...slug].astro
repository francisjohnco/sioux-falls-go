---
import { getCollection, getEntry, render } from 'astro:content';
import { getLiveArticles, isLive } from '../../lib/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import { articleHero } from '../../lib/hero';

export async function getStaticPaths() {
  const articles = await getLiveArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const category = await getEntry(article.data.category);
const hero = articleHero(article);
const HERO_SIZES = '(max-width: 52rem) 100vw, 52rem';

// Every live article, used for cluster navigation and link checking.
const liveArticles = await getLiveArticles();
const liveSlugs = new Set(liveArticles.map((a) => a.id));
const byDate = (a: any, b: any) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime();

// Links to a guide that is not live yet (scheduled) are shown as plain text
// until that guide publishes. The site rebuilds daily, so each link turns on
// by itself on the day its article goes live, and there is never a broken link.
function unwrapUnpublishedLinks(html: string): string {
  return html.replace(/<a href="\/guides\/([a-z0-9-]+)\/?"[^>]*>([\s\S]*?)<\/a>/g, (whole, slug, text) => (liveSlugs.has(slug) ? whole : text));
}

// Topic cluster: one main guide (pillar) plus supporting articles.
const clusterKey = (a: any) => a.data.cluster ?? a.data.category.id;
const myCluster = clusterKey(article);
const clusterLive = liveArticles.filter((a) => clusterKey(a) === myCluster);
const pillar = clusterLive.find((a) => a.data.clusterRole === 'pillar') ?? null;
const isPillar = pillar?.id === article.id;
const clusterSupports = pillar ? clusterLive.filter((a) => a.id !== pillar.id).sort(byDate) : [];
const siblings = clusterSupports.filter((a) => a.id !== article.id);

// For splitting content around the sponsor banner, get the rendered HTML
const rawHtml = unwrapUnpublishedLinks(article.rendered?.html ?? '');
const firstParaEnd = rawHtml.indexOf('</p>');
const introHtml = firstParaEnd !== -1 ? rawHtml.slice(0, firstParaEnd + 4) : '';
const restHtml = firstParaEnd !== -1 ? rawHtml.slice(firstParaEnd + 4) : rawHtml;

// Resolve explicit relatedArticles references first
const explicitRelated = (
  await Promise.all((article.data.relatedArticles ?? []).map((ref) => getEntry(ref)))
).filter((r) => r && isLive(r)); // a scheduled article must never be linked before it exists

// Fill out to 3 with same-category articles if the author didn't set enough explicit links
let related = [...siblings.slice(0, 3)];
for (const r of explicitRelated) if (related.length < 3 && !related.some((x) => x.id === r.id)) related.push(r);
if (related.length < 3) {
  const sameCategory = liveArticles.filter(
    (a) => a.data.category.id === category.id && a.id !== article.id && !related.some((r) => r.id === a.id)
  );
  related = [...related, ...sameCategory.slice(0, 3 - related.length)];
}
const relatedWithCategory = await Promise.all(
  related.map(async (r) => ({ article: r, category: await getEntry(r.data.category) }))
);

// Resolve related businesses for the "find a pro" resource CTA
const relatedBusinesses = await Promise.all(
  (article.data.relatedBusinesses ?? []).map((ref) => getEntry(ref))
);

// Resolve sponsor — Community Champion perk
const sponsor = article.data.sponsoredBy ? await getEntry(article.data.sponsoredBy) : null;

const site = 'https://siouxfallsgo.com';
const pageUrl = `${site}/guides/${article.id}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.seo.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: article.data.updatedAt.toISOString(),
  author: { '@type': 'Organization', name: article.data.author, url: site },
  publisher: { '@type': 'Organization', name: 'Sioux Falls Go', url: site, logo: { '@type': 'ImageObject', url: `${site}/images/sfg-logo.png` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  image: { '@type': 'ImageObject', url: new URL(hero.og, site).toString(), width: 1200, height: 630, caption: hero.alt },
  ...(pillar && !isPillar ? { isPartOf: { '@type': 'Article', headline: pillar.data.title, url: `${site}/guides/${pillar.id}` } } : {}),
  about: { '@type': 'Place', name: 'Sioux Falls, South Dakota' },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: category.data.name, item: `${site}/${category.data.slug}` },
    ...(pillar && !isPillar ? [{ '@type': 'ListItem', position: 3, name: pillar.data.title, item: `${site}/guides/${pillar.id}` }] : []),
    { '@type': 'ListItem', position: pillar && !isPillar ? 4 : 3, name: article.data.title, item: pageUrl },
  ],
};
const faqSchema = article.data.embeddedFaqs.length > 0 ? [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: article.data.embeddedFaqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
}] : [];
const schema = [articleSchema, breadcrumbSchema, ...faqSchema];
---
<BaseLayout
  title={article.data.seo.title}
  description={article.data.seo.description}
  canonicalPath={`/guides/${article.id}`}
  schema={schema}
  ogImage={hero.og}
  ogImageAlt={hero.alt}
  ogType="article"
  preloadImage={{ href: hero.src, srcset: hero.srcset, sizes: HERO_SIZES }}
>
  <SiteHeader slot="header" />

  <article class="container article">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href={`/${category.data.slug}`}>{category.data.name}</a> / {pillar && !isPillar && <><a href={`/guides/${pillar.id}`}>{pillar.data.title}</a> / </>}<span>{article.data.title}</span>
    </nav>

    <span class="eyebrow">{article.data.contentType.replace('-', ' ')}</span>
    <h1>{article.data.title}</h1>
    <p class="byline">By {article.data.author} · Updated {article.data.updatedAt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>

    <figure class="article-hero">
      <img src={hero.src} srcset={hero.srcset} sizes={HERO_SIZES} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" decoding="async" class="article-hero-img" />
      {hero.credit && (
        <figcaption class="hero-image-credit">
          Photo by <a href={hero.credit.profileUrl} target="_blank" rel="noopener nofollow">{hero.credit.photographer}</a> on <a href={hero.credit.source === 'Pexels' ? 'https://www.pexels.com' : 'https://unsplash.com/?utm_source=sioux_falls_go&utm_medium=referral'} target="_blank" rel="noopener nofollow">{hero.credit.source}</a>
        </figcaption>
      )}
    </figure>

    {pillar && !isPillar && (
      <a class="cluster-parent" href={`/guides/${pillar.id}`}>
        <span class="cluster-parent-label">Part of the guide</span>
        <span class="cluster-parent-title">{pillar.data.title} →</span>
      </a>
    )}

    {isPillar && clusterSupports.length > 0 && (
      <nav class="cluster-toc" aria-label="In this guide">
        <span class="cluster-toc-label">In this guide</span>
        <ol>
          {clusterSupports.map((a) => <li><a href={`/guides/${a.id}`}>{a.data.title}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="prose">
      {sponsor ? (
        <>
          <Fragment set:html={introHtml} />
          <a href={`/businesses/${sponsor.id}`} class="sponsor-banner">
            <span class="sponsor-label">Sponsored</span>
            <div class="sponsor-content">
              <div
                class="sponsor-logo"
                style={sponsor.data.heroImage ? `background-image: url(${sponsor.data.heroImage});` : undefined}
              >
                {!sponsor.data.heroImage && sponsor.data.name.slice(0, 2).toUpperCase()}
              </div>
              <div>
                <p class="sponsor-text">
                  This article is made possible by <strong>{sponsor.data.name}</strong>. They serve Sioux Falls with
                  excellence, and their support helps us keep bringing free, local content to our community.
                </p>
                <span class="sponsor-link">Read more about {sponsor.data.name} →</span>
              </div>
            </div>
          </a>
          <Fragment set:html={restHtml} />
        </>
      ) : (
        <>
          <Fragment set:html={introHtml} />
          <a href="/how-visibility-works" class="sponsor-banner sponsor-banner--open">
            <span class="sponsor-label sponsor-label--open">Open Spot</span>
            <div class="sponsor-content">
              <div class="sponsor-logo sponsor-logo--open">+</div>
              <div>
                <p class="sponsor-text">
                  Community Champion businesses can claim this spot free. Find out how visibility works on Sioux Falls Go.
                </p>
                <span class="sponsor-link">See how it works →</span>
              </div>
            </div>
          </a>
          <Fragment set:html={restHtml} />
        </>
      )}
    </div>

    {article.data.embeddedFaqs.length > 0 && (
      <section class="embedded-faqs">
        <h2>Frequently Asked Questions</h2>
        {article.data.embeddedFaqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </section>
    )}

    {pillar && !isPillar && (
      <nav class="cluster-more" aria-label="More in this guide">
        <h2>More in this guide</h2>
        <ul>
          <li><a href={`/guides/${pillar.id}`}><strong>Start here:</strong> {pillar.data.title}</a></li>
          {siblings.map((a) => <li><a href={`/guides/${a.id}`}>{a.data.title}</a></li>)}
        </ul>
      </nav>
    )}

    <div class="resource-cta card">
      <h3>Keep exploring {category.data.name.toLowerCase()} in Sioux Falls</h3>
      <p>See every {category.data.name.toLowerCase()} business we recommend, plus more local guides like this one.</p>
      <a class="button" href={`/${category.data.slug}`}>Browse {category.data.name} →</a>
    </div>

    {relatedBusinesses.length > 0 && (
      <div class="business-links">
        <span class="eyebrow">Mentioned in this guide</span>
        <div class="business-chip-row">
          {relatedBusinesses.map((b) => (
            <a class="business-chip" href={`/businesses/${b.id}`}>{b.data.name} →</a>
          ))}
        </div>
      </div>
    )}
  </article>

  {related.length > 0 && (
    <div class="container related-wrap">
      <section class="related-block">
        <h2>You might also want to read</h2>
        <div class="related-grid">
          {relatedWithCategory.map(({ article: r, category: rCategory }) => (
            <a class="related-card" href={`/guides/${r.id}`}>
              <div class="related-card-media"><img src={articleHero(r).card} alt="" width="480" height="270" loading="lazy" decoding="async" /></div>
              <div class="related-card-body">
                <span class="related-tag">{r.data.contentType.replace('-', ' ')}</span>
                <h3>{r.data.title}</h3>
                <p>{r.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  )}

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .article { padding-block: var(--space-4) var(--space-6); max-width: 42rem; }
  .breadcrumbs { font-size: 0.8125rem; color: var(--color-navy-light); margin-bottom: var(--space-2); }
  .breadcrumbs a { color: var(--color-navy-light); }
  .byline { font-size: 0.875rem; color: var(--color-navy-light); margin-top: -0.25rem; }
  .review-note {
    font-size: 0.875rem;
    color: var(--color-navy-light);
    border-left: 3px solid var(--color-orange);
    padding-left: var(--space-2);
  }

  .article-hero { margin: var(--space-2) 0 0; }
  .article-hero-img {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover;
    border-radius: var(--radius); background: #E8EDF3;
  }
  .related-card-media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .sponsor-banner {
    display: block; text-decoration: none; margin-top: var(--space-3);
    background: #FFF8F0; border: 1.5px solid var(--color-orange); border-radius: var(--radius);
    padding: var(--space-2); position: relative;
    transition: box-shadow 0.15s ease;
  }
  .sponsor-banner:hover { box-shadow: 0 4px 14px rgba(240,126,35,0.18); }
  .sponsor-label {
    display: inline-block; font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; color: #fff; background: var(--color-orange);
    padding: 0.15rem 0.55rem; border-radius: var(--radius-pill); margin-bottom: 0.6rem;
  }
  .sponsor-content { display: flex; gap: var(--space-2); align-items: center; }
  .sponsor-logo {
    width: 3.5rem; height: 3.5rem; border-radius: 50%; flex-shrink: 0;
    background: var(--color-navy); background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 0.9375rem;
  }
  .sponsor-text { margin: 0; font-size: 0.9375rem; color: var(--color-ink); line-height: 1.5; }
  .sponsor-link { font-size: 0.875rem; font-weight: 700; color: var(--color-orange-dark); }

  .sponsor-banner--open {
    background: var(--color-surface); border: 1.5px dashed var(--color-line);
  }
  .sponsor-banner--open:hover { border-color: var(--color-navy-light); box-shadow: 0 4px 14px rgba(27,42,74,0.1); }
  .sponsor-label--open { background: var(--color-navy-light); }
  .sponsor-logo--open {
    background: #fff; border: 1.5px dashed var(--color-line); color: var(--color-navy-light);
    font-size: 1.5rem; font-weight: 400;
  }
  .sponsor-banner--open .sponsor-text { color: var(--color-navy-light); }
  .sponsor-banner--open .sponsor-link { color: var(--color-navy); }
  .prose { margin-top: var(--space-3); }
  .prose :global(h2) { margin-top: var(--space-4); }

  .embedded-faqs { margin-top: var(--space-4); }
  .faq-item {
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius);
    padding: var(--space-2); margin-bottom: 0.5rem;
  }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--color-navy); }
  .faq-item p { margin: var(--space-1) 0 0; font-size: 0.9375rem; color: var(--color-navy-light); }

  .resource-cta {
    margin-top: var(--space-4);
    background: var(--color-surface);
    text-align: center;
  }
  .resource-cta p { color: var(--color-navy-light); margin: 0.4rem 0 var(--space-2); }

  .business-links { margin-top: var(--space-3); }
  .business-chip-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .business-chip {
    font-size: 0.875rem; font-weight: 600; text-decoration: none;
    background: #fff; border: 1.5px solid var(--color-line); border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem; color: var(--color-navy);
  }
  .business-chip:hover { border-color: var(--color-orange); color: var(--color-orange); }

  .cluster-parent { display: flex; flex-direction: column; gap: 0.15rem; margin: 1rem 0 1.4rem; padding: 0.85rem 1.1rem; border: 1px solid var(--color-line); border-left: 4px solid var(--color-orange); border-radius: 0.6rem; background: #FFF8F1; text-decoration: none; }
  .cluster-parent-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-orange-dark); }
  .cluster-parent-title { font-weight: 700; color: var(--color-navy); }
  .cluster-toc { margin: 1rem 0 1.6rem; padding: 1.1rem 1.3rem; border: 1px solid var(--color-line); border-radius: 0.7rem; background: #F7F9FC; }
  .cluster-toc-label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-navy-light); margin-bottom: 0.5rem; }
  .cluster-toc ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .cluster-toc a, .cluster-more a { color: var(--color-navy); font-weight: 600; }
  .cluster-more { margin-top: var(--space-5); padding: 1.2rem 1.4rem; border-radius: 0.8rem; background: var(--color-navy); }
  .cluster-more h2 { color: #fff; font-size: 1.25rem; margin: 0 0 0.7rem; }
  .cluster-more ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .cluster-more a { color: #fff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.25); }
  .cluster-more a:hover { border-bottom-color: var(--color-gold); }
  .cluster-more strong { color: var(--color-gold); }
  .related-block { margin-top: var(--space-5); }
  .related-wrap { max-width: 60rem; margin-inline: auto; padding-block: var(--space-5); }
  .related-block { padding-top: var(--space-4); border-top: 1px solid var(--color-line); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-3); }
  @media (max-width: 45rem) { .related-grid { grid-template-columns: 1fr; } }
  .related-card {
    display: block; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(27,42,74,0.05);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .related-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(240,126,35,0.14); border-color: var(--color-orange); }
  .related-card-media {
    height: 12.5rem; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 60%, #F07E23 160%);
    background-size: cover; background-position: center;
  }
  .related-card-icon { color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); }
  .related-card-body { padding: var(--space-2); }
  .related-tag { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-orange); }
  .related-card h3 { font-size: 1.0625rem; margin: 0.3rem 0 0.35rem; }
  .related-card p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }
</style>
