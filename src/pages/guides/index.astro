---
import { articleHero } from '../../lib/hero';
import { getCollection, getEntry } from 'astro:content';
import { getLiveArticles, newestFirst } from '../../lib/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import { getUpcomingEvents } from '../../lib/events';
import { todayCentral, dateKey } from '../../lib/dates';
import { currentBlackFriday, isoDay } from '../../lib/black-friday';

const allArticles = await getLiveArticles();

// Real category groupings, matching how the original site segmented "The Loop"
const LOCALS_CATEGORIES = ['consumer-guide', 'for-locals', 'community-spotlight', 'local-spotlights'];
const VISITOR_CATEGORIES = ['explore-sioux-falls'];
const BUSINESS_CATEGORIES = ['for-local-businesses', 'grow-with-sfg', 'marketing-tips-insights', 'marketing-agencies'];

function sortByDateDesc(articles: typeof allArticles) {
  return [...articles].sort(newestFirst);
}

const allSorted = sortByDateDesc(allArticles);
const featured = allSorted[0];
const featuredCategory = await getEntry(featured.data.category);

const localsAll = sortByDateDesc(allArticles.filter((a) => LOCALS_CATEGORIES.includes(a.data.category.id)));
const visitorAll = sortByDateDesc(allArticles.filter((a) => VISITOR_CATEGORIES.includes(a.data.category.id)));
const businessAll = sortByDateDesc(allArticles.filter((a) => BUSINESS_CATEGORIES.includes(a.data.category.id) && a.id !== featured.id));

const localsArticles = localsAll.filter((a) => a.id !== featured.id).slice(0, 6);
const visitorArticles = visitorAll.filter((a) => a.id !== featured.id).slice(0, 6);
const businessArticles = businessAll.slice(0, 6);

async function withCategory(articles: typeof allArticles) {
  return Promise.all(
    articles.map(async (a) => ({ article: a, category: await getEntry(a.data.category) }))
  );
}

const localsWithCat = await withCategory(localsArticles);
const visitorWithCat = await withCategory(visitorArticles);
const businessWithCat = await withCategory(businessArticles);
// Full set, for the search bar — independent of the sectioned display
// above, so search covers every published article on the site.
const allWithCat = await withCategory(allSorted);

// Every real topic articles are actually tagged with, grouped with a
// live count — this is the real "find everything" path beyond search,
// since the curated sections above only cover a fraction of all topics.
const categoryCounts = new Map<string, number>();
for (const a of allArticles) {
  categoryCounts.set(a.data.category.id, (categoryCounts.get(a.data.category.id) ?? 0) + 1);
}
const allCategories = await getCollection('categories');
const topicList = Array.from(categoryCounts.entries())
  .map(([id, count]) => ({ category: allCategories.find((c) => c.id === id), count }))
  .filter((t) => t.category)
  .sort((a, b) => b.count - a.count);

// Hero: what is happening this week, from real events and deals.
const loopToday = todayCentral();
const weekEnd = isoDay(new Date(Date.parse(`${loopToday}T12:00:00Z`) + 7 * 86400000));
const weekAgo = isoDay(new Date(Date.parse(`${loopToday}T12:00:00Z`) - 7 * 86400000));
const bf = currentBlackFriday(loopToday);
const allDeals = await getCollection('deals');
const bfLive = allDeals.filter((d) => d.data.promotion === 'black-friday' && (!d.data.expiresAt || dateKey(d.data.expiresAt) >= loopToday));
const liveDeals = allDeals.filter((d) => (!d.data.expiresAt || dateKey(d.data.expiresAt) >= loopToday) && (!d.data.activatesAt || dateKey(d.data.activatesAt) <= loopToday)).length;
const showBf = loopToday >= isoDay(new Date(bf.blackFriday.getTime() - 10 * 86400000)) && loopToday <= isoDay(bf.cyberMonday) && bfLive.length > 0;
const weekEvents = (await getUpcomingEvents()).filter((e) => dateKey(e.date) <= weekEnd);
type WeekRow = { day: Date; title: string; detail: string; href: string; tag?: string; photo?: string };
const weekRows: WeekRow[] = [
  ...(showBf ? [{ day: loopToday > isoDay(bf.blackFriday) ? new Date(`${loopToday}T12:00:00Z`) : bf.blackFriday, title: 'Local Black Friday deals', detail: `${bfLive.length} Sioux Falls business${bfLive.length === 1 ? '' : 'es'}`, href: '/local-deals/black-friday/', tag: 'Black Friday' }] : []),
  ...weekEvents.map((e) => ({ day: e.date, title: e.title, detail: e.location, href: '/events', photo: e.photo })),
].sort((a, b) => a.day.getTime() - b.day.getTime()).slice(0, 6);
const newThisWeek = allArticles.filter((a) => dateKey(a.data.publishedAt) > weekAgo).length;
const dow = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' });
const dom = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'UTC' });

// Desktop day picker: today plus the next five days. Days with something on
// get a dot, and clicking one narrows the week list to that day.
const pickerDays = Array.from({ length: 6 }, (_, i) => new Date(Date.parse(`${loopToday}T12:00:00Z`) + i * 86400000));
const busyDays = new Set(weekRows.map((r) => isoDay(r.day)));
const whenLabel = (d: Date) => {
  const k = isoDay(d);
  if (k === loopToday) return 'Today';
  if (k === isoDay(pickerDays[1])) return 'Tomorrow';
  return d.toLocaleDateString('en-US', { weekday: 'long', timeZone: 'UTC' });
};
// "Fresh this week" tiles on desktop: the newest guides after the featured one.
const freshTiles = await withCategory(allSorted.slice(1, 5));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Loop — Sioux Falls Go',
};
---
<BaseLayout
  title="The Loop"
  description="Stay in The Loop — stories, business highlights, local guides, and community gems from Sioux Falls Go."
  canonicalPath="/guides"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="loop-hero">
    {/* Phone only: a clear photo of the falls, no dark wash over it */}
    <div class="loop-photo">
      <p class="loop-photo-cap"><span class="loop-dot"></span>Falls Park<span class="loop-wx-cap" hidden></span></p>
    </div>
    <div class="container loop-board">
      <div class="loop-intro">
        <p class="loop-today"><span id="loop-today">{new Date(`${loopToday}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span><span class="loop-wx" id="loop-wx" hidden></span></p>
        <h1><span class="loop-h1-stay">Stay in </span><mark>The Loop</mark></h1>
        <p class="loop-lede">What's happening in Sioux Falls this week, and the local guides worth your time. Written for people who live here.</p>
        <div class="loop-search-wrap">
          <Icon name="search" size={18} class="loop-search-icon" />
          <input type="search" id="loop-search-input" class="loop-search-input" placeholder="Search every article and guide" aria-label="Search articles and guides" />
        </div>
        <div class="loop-days" role="group" aria-label="Pick a day">
          {pickerDays.map((d, i) => (
            <button type="button" class:list={['loop-day', { 'is-on': i === 0 }]} data-day={isoDay(d)} aria-pressed={i === 0 ? 'true' : 'false'}>
              {dow(d)}<b>{dom(d)}</b>{busyDays.has(isoDay(d)) && <i aria-hidden="true"></i>}
            </button>
          ))}
        </div>
      </div>

      {weekRows.length > 0 && (
        <div class="loop-week">
          <div class="loop-week-head"><h2>This week</h2><a href="/events">All events →</a></div>
          <div class="loop-week-list">
            {weekRows.map((r) => (
              <a class:list={['loop-ev', { 'is-deal': r.tag }]} href={r.href} data-day={isoDay(r.day)}>
                <span class="loop-ev-media" style={r.photo ? `background-image:url(${r.photo})` : undefined}>
                  {!r.photo && <span class="loop-ev-badge">{r.tag}</span>}
                  <span class="loop-ev-date">{dow(r.day)}<b>{dom(r.day)}</b></span>
                  {r.tag && r.photo && <span class="loop-ev-tag">{r.tag}</span>}
                </span>
                <span class="loop-ev-text">
                  <strong>{r.title}</strong>
                  <small><span class="loop-ev-when">{whenLabel(r.day)} · </span>{r.detail}</small>
                </span>
              </a>
            ))}
            <p class="loop-ev-none" hidden>Nothing on the calendar that day yet.</p>
          </div>
          <a class="loop-week-more" href="/events">See the whole week →</a>
        </div>
      )}

      {/* Phone: quick numbers. Desktop: the newest guides as tiles. */}
      <div class="loop-stats">
        <p><b>{newThisWeek}</b>new guide{newThisWeek === 1 ? '' : 's'} this week</p>
        <p><b>{weekEvents.length}</b>event{weekEvents.length === 1 ? '' : 's'} this week</p>
        {liveDeals > 0 ? <p><b>{liveDeals}</b>local deal{liveDeals === 1 ? '' : 's'} live</p> : <p><b>{allArticles.length}</b>local guides in all</p>}
      </div>
    </div>

    <div class="container loop-fresh">
      <h2>Fresh this week <small>● {newThisWeek} new guide{newThisWeek === 1 ? '' : 's'}</small></h2>
      <div class="loop-fresh-grid">
        {freshTiles.map(({ article, category }) => (
          <a class="loop-fresh-tile" href={`/guides/${article.id}`}>
            <img src={articleHero(article).card} alt="" width="480" height="270" loading="lazy" decoding="async" />
            <span><em>{category?.data.name}</em>{article.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="loop-search-results" class="loop-band" hidden>
    <div class="container">
      <span class="eyebrow">Search Results</span>
      <h2 id="loop-search-heading">Articles</h2>
      <div class="loop-grid" id="loop-search-grid">
        {allWithCat.map(({ article, category }) => (
          <a href={`/guides/${article.id}`} class="loop-card" data-search={`${article.data.title} ${category?.data.name ?? ''}`.toLowerCase()} hidden>
            <div class="loop-card-media has-photo"><img src={articleHero(article).card} alt="" width="480" height="270" loading="lazy" decoding="async" />
            </div>
            <div class="loop-card-body">
              <span class="loop-tag">{category?.data.name}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.seo.description}</p>
            </div>
          </a>
        ))}
      </div>
      <p id="loop-search-empty" class="empty-note" hidden>No articles match your search.</p>
    </div>
  </section>

  <div class="container" id="loop-main-content">
    <section class="featured-story">
      <a href={`/guides/${featured.id}`} class="featured-card">
        <div class="featured-media has-photo"><img src={articleHero(featured).src} alt="" width="960" height="540" loading="lazy" decoding="async" />
        </div>
        <div class="featured-body">
          <span class="featured-tag">Latest · {featuredCategory.data.name}</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.seo.description}</p>
          <span class="featured-link">Read the full story →</span>
        </div>
      </a>
    </section>

    {localsWithCat.length > 0 && (
      <section aria-labelledby="locals-heading" class="loop-band loop-band--alt">
        <div class="sec-head">
          <div>
            <span class="eyebrow">Locals</span>
            <h2 id="locals-heading">Discover local gems</h2>
          </div>
          {localsAll.length > 6 && <a href={`/search?q=${encodeURIComponent('local')}`} class="sec-view-all">View all →</a>}
        </div>
        <div class="loop-grid">
          {localsWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media has-photo"><img src={articleHero(article).card} alt="" width="480" height="270" loading="lazy" decoding="async" />
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {visitorWithCat.length > 0 && (
      <section aria-labelledby="visitors-heading" class="loop-band">
        <div class="sec-head">
          <div>
            <span class="eyebrow">Visitors</span>
            <h2 id="visitors-heading">Explore Sioux Falls</h2>
            <p class="section-sub">Maximize your visit — explore, experience, and discover Sioux Falls.</p>
          </div>
          {visitorAll.length > 6 && <a href="/visit-sioux-falls" class="sec-view-all">View all →</a>}
        </div>
        <div class="loop-grid">
          {visitorWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media has-photo"><img src={articleHero(article).card} alt="" width="480" height="270" loading="lazy" decoding="async" />
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {businessWithCat.length > 0 && (
      <section aria-labelledby="business-heading" class="loop-band loop-band--alt">
        <div class="sec-head">
          <div>
            <span class="eyebrow">For Business Owners</span>
            <h2 id="business-heading">Grow your business</h2>
            <p class="section-sub">Tactics, marketing tools, and strategies from Sioux Falls Go.</p>
          </div>
          {businessAll.length > 6 && <a href={`/search?q=${encodeURIComponent('business')}`} class="sec-view-all">View all →</a>}
        </div>
        <div class="loop-grid">
          {businessWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media has-photo"><img src={articleHero(article).card} alt="" width="480" height="270" loading="lazy" decoding="async" />
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="topics-section" aria-labelledby="topics-heading">
      <span class="eyebrow">Every Topic</span>
      <h2 id="topics-heading">Browse everything, by topic</h2>
      <p class="section-sub">Every guide on Sioux Falls Go, sorted by what it's actually about — {allArticles.length} articles across {topicList.length} topics.</p>
      <div class="topics-grid">
        {topicList.map(({ category, count }) => (
          <a href={`/${category!.data.slug}`} class="topic-pill">
            <span class="topic-icon"><Icon name={category!.data.icon} size={16} /></span>
            <span class="topic-name">{category!.data.name}</span>
            <span class="topic-count">{count}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <div class="container">
    <section class="legend-section">
      <div class="legend-card">
        <div class="legend-copy">
          <span class="legend-eyebrow"><Icon name="heart" size={13} /> Already Shop Local?</span>
          <h2>Become a Local Legend</h2>
          <p>We're giving away gift cards, prizes, and exclusive deals from top local businesses in Sioux Falls! <Icon name="sparkles" size={18} class="legend-sparkle" /></p>
          <p class="legend-sub">Join Local Legend VIP and be the first to know about our next big giveaway. It's 100% free — no strings attached!</p>
          <span class="legend-badge"><Icon name="gift" size={13} /> Giveaways starting soon</span>
        </div>
        <form id="legend-form" class="legend-form">
          <label for="legend-name">Name</label>
          <input type="text" id="legend-name" name="name" placeholder="Name" />
          <label for="legend-email">Email*</label>
          <input type="email" id="legend-email" name="email" placeholder="Email" required />
          <button type="submit" class="button legend-submit" id="legend-submit-btn">Start Winning</button>
          <p class="legend-form-status" id="legend-form-status" hidden></p>
        </form>
      </div>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ── The Loop hero ──
     Phone: clear photo of the falls, a white card with the title and search,
     then this week's events as swipeable photo cards and three quick numbers.
     Desktop (900px+): light board with "The Loop" headline, day picker, the
     week list on the right, and the newest guides as tiles underneath. */
  .loop-hero { position: relative; background: #fff; }
  .loop-photo { position: relative; height: 19rem; background: url('/images/scenic/falls-park-golden.jpg') center 60%/cover; }
  .loop-photo-cap { position: absolute; top: 0.9rem; left: 1rem; margin: 0; display: inline-flex; align-items: center; gap: 0.45rem; background: rgba(0,0,0,0.38); color: #fff; font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.7rem; border-radius: 999px; }
  .loop-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-gold); }
  .loop-board { position: relative; z-index: 2; }
  .loop-intro { background: #fff; border-radius: 1.4rem; padding: 1.4rem 1.25rem; margin: -1.7rem -0.35rem 0; box-shadow: 0 18px 40px -20px rgba(27,42,74,0.45); }
  .loop-today { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-river); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .loop-wx { display: none; }
  .loop-intro h1 { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.02; letter-spacing: -0.035em; color: var(--color-navy); margin: 0 0 0.7rem; }
  .loop-intro h1 mark { background: none; color: inherit; }
  .loop-lede { font-size: 1rem; line-height: 1.55; color: #566076; margin: 0 0 1rem; max-width: 32rem; }
  .loop-days { display: none; }

  .loop-week { margin-top: 1.7rem; }
  .loop-week-head { display: flex; justify-content: space-between; align-items: baseline; }
  .loop-week-head h2 { font-family: var(--font-display); font-size: 1.3rem; color: var(--color-navy); margin: 0; }
  .loop-week-head a { font-size: 0.85rem; font-weight: 600; color: var(--color-orange); text-decoration: none; }
  .loop-week-list { display: flex; gap: 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.9rem 1.25rem 1.2rem; margin: 0 -1.25rem; scrollbar-width: none; }
  .loop-week-list::-webkit-scrollbar { display: none; }
  .loop-ev { flex: 0 0 14.5rem; scroll-snap-align: start; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--color-line); border-radius: 1.1rem; overflow: hidden; text-decoration: none; color: inherit; }
  .loop-ev[hidden] { display: none; }
  .loop-ev-media { position: relative; height: 7.5rem; background: var(--color-orange) center/cover; display: block; }
  .loop-ev-badge { position: absolute; inset: auto 0.9rem 0.8rem; display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; line-height: 1; color: #fff; text-transform: uppercase; letter-spacing: -0.01em; }
  .loop-ev-date { position: absolute; top: 0.6rem; left: 0.6rem; background: #fff; border-radius: 0.75rem; padding: 0.35rem 0.6rem; text-align: center; font-size: 0.62rem; font-weight: 700; color: #6B7385; letter-spacing: 0.06em; text-transform: uppercase; }
  .loop-ev-date b { display: block; font-family: var(--font-display); font-size: 1.25rem; color: var(--color-navy); line-height: 1; }
  .loop-ev-tag { position: absolute; top: 0.6rem; right: 0.6rem; background: var(--color-orange); color: #fff; font-size: 0.62rem; font-weight: 700; border-radius: 999px; padding: 0.25rem 0.55rem; }
  .loop-ev-text { padding: 0.75rem 0.9rem 0.9rem; display: block; }
  .loop-ev-text strong { display: block; font-family: var(--font-display); font-size: 0.95rem; line-height: 1.25; color: var(--color-navy); }
  .loop-ev-text small { display: block; margin-top: 0.25rem; font-size: 0.8rem; color: #6B7385; }
  .loop-ev-when { display: none; font-weight: 600; color: var(--color-river); }
  .loop-ev-none { margin: 0; padding: 1rem 1.1rem; color: #6B7385; font-size: 0.9rem; }
  .loop-week-more { display: none; }

  .loop-stats { display: flex; gap: 0.6rem; padding-bottom: 0.4rem; }
  .loop-stats p { flex: 1; margin: 0; background: var(--color-surface); border-radius: 0.9rem; padding: 0.75rem 0.4rem; text-align: center; font-size: 0.75rem; line-height: 1.3; color: #6B7385; }
  .loop-stats b { display: block; font-family: var(--font-display); font-size: 1.35rem; color: var(--color-navy); }
  .loop-fresh { display: none; }

  @media (min-width: 900px) {
    .loop-hero { background: linear-gradient(180deg, #EEF4F9 0, #fff 26rem); }
    .loop-photo, .loop-stats, .loop-h1-stay { display: none; }
    .loop-board { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2.5rem; align-items: start; padding-top: 1.6rem; }
    .loop-intro { background: none; box-shadow: none; padding: 0; margin: 0; border-radius: 0; }
    .loop-today { text-transform: none; letter-spacing: 0; font-size: 0.85rem; color: var(--color-navy); font-weight: 600; }
    .loop-wx:not([hidden]) { display: inline-flex; align-items: center; background: #fff; border: 1px solid var(--color-line); border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.75rem; font-weight: 600; color: var(--color-river); }
    .loop-intro h1 { font-size: clamp(3rem, 4.4vw, 3.6rem); margin: 0.6rem 0 0.7rem; }
    .loop-intro h1 mark { background: linear-gradient(transparent 62%, rgba(245,180,41,0.55) 62%); }
    .loop-lede { font-size: 1.05rem; }
    .loop-days { display: flex; gap: 0.5rem; margin-top: 1.1rem; }
    .loop-day { position: relative; width: 3.6rem; background: #fff; border: 1px solid var(--color-line); border-radius: 1rem; padding: 0.55rem 0 0.7rem; font: inherit; font-size: 0.68rem; font-weight: 700; color: #8A93A3; letter-spacing: 0.05em; text-transform: uppercase; cursor: pointer; }
    .loop-day b { display: block; font-family: var(--font-display); font-size: 1.3rem; color: var(--color-navy); line-height: 1.15; }
    .loop-day i { position: absolute; bottom: 0.3rem; left: 50%; width: 0.3rem; height: 0.3rem; margin-left: -0.15rem; border-radius: 50%; background: var(--color-orange); }
    .loop-day.is-on { background: var(--color-navy); border-color: var(--color-navy); color: #AFC0DA; }
    .loop-day.is-on b { color: #fff; }
    .loop-day:hover:not(.is-on) { border-color: var(--color-navy); }

    .loop-week { margin-top: 0; background: #fff; border: 1px solid var(--color-line); border-radius: 1.25rem; overflow: hidden; }
    .loop-week-head { display: none; }
    .loop-week-list { display: block; overflow: visible; padding: 0; margin: 0; }
    .loop-ev { flex-direction: row; align-items: center; gap: 0.9rem; border: 0; border-top: 1px solid var(--color-line); border-radius: 0; padding: 0.85rem 0.9rem; }
    .loop-ev:first-child { border-top: 0; }
    .loop-ev:hover { background: var(--color-surface); }
    .loop-ev.is-deal { background: #FFF4EA; }
    .loop-ev-media { flex: none; width: 4rem; height: 4rem; border-radius: 0.75rem; }
    .loop-ev-badge { inset: 0; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; line-height: 1.05; text-align: center; padding: 0 0.3rem; }
