---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LayeredHero from '../../components/LayeredHero.astro';
import Icon from '../../components/Icon.astro';

const allArticles = await getCollection('articles');

// Real category groupings, matching how the original site segmented "The Loop"
const LOCALS_CATEGORIES = ['consumer-guide', 'for-locals', 'community-spotlight', 'local-spotlights'];
const VISITOR_CATEGORIES = ['explore-sioux-falls'];
const BUSINESS_CATEGORIES = ['for-local-businesses', 'grow-with-sfg', 'marketing-tips-insights'];

function sortByDateDesc(articles: typeof allArticles) {
  return [...articles].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
}

const localsArticles = sortByDateDesc(allArticles.filter((a) => LOCALS_CATEGORIES.includes(a.data.category.id))).slice(0, 6);
const visitorArticles = sortByDateDesc(allArticles.filter((a) => VISITOR_CATEGORIES.includes(a.data.category.id))).slice(0, 6);
const businessArticles = sortByDateDesc(allArticles.filter((a) => BUSINESS_CATEGORIES.includes(a.data.category.id))).slice(0, 6);

// Everything else — the real service-category guides (Electricians, Plumbers, etc.)
// gets its own "Service Guides" section, since that's the bulk of real content now
// and didn't really exist as a "Loop" concept on the old site.
const segmentedIds = new Set(
  [...LOCALS_CATEGORIES, ...VISITOR_CATEGORIES, ...BUSINESS_CATEGORIES]
);
const serviceGuides = sortByDateDesc(allArticles.filter((a) => !segmentedIds.has(a.data.category.id))).slice(0, 6);

async function withCategory(articles: typeof allArticles) {
  return Promise.all(
    articles.map(async (a) => ({ article: a, category: await getEntry(a.data.category) }))
  );
}

const localsWithCat = await withCategory(localsArticles);
const visitorWithCat = await withCategory(visitorArticles);
const businessWithCat = await withCategory(businessArticles);
const serviceWithCat = await withCategory(serviceGuides);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Loop — Sioux Falls Go',
};
---
<BaseLayout
  title="The Loop"
  description="Stay in The Loop — stories, business highlights, local guides, and community gems from Sioux Falls Go."
  canonicalPath="/guides"
  schema={schema}
>
  <SiteHeader slot="header" />

  <LayeredHero eyebrow="The Loop" title="Stay in The Loop" subtitle="Stories, local guides, community gems, and local wins — for the people who live here and the people just visiting." photoUrl="/images/scenic/downtown-1.jpg" />

  {serviceWithCat.length > 0 && (
    <section aria-labelledby="service-heading" class="loop-band">
      <div class="container">
        <span class="eyebrow">Local Guides</span>
        <h2 id="service-heading">Guides for homeowners</h2>
        <div class="loop-grid">
          {serviceWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={28} class="loop-card-icon" />}
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {localsWithCat.length > 0 && (
    <section aria-labelledby="locals-heading" class="loop-band loop-band--alt">
      <div class="container">
        <span class="eyebrow">Locals</span>
        <h2 id="locals-heading">Discover local gems</h2>
        <div class="loop-grid">
          {localsWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={28} class="loop-card-icon" />}
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {visitorWithCat.length > 0 && (
    <section aria-labelledby="visitors-heading" class="loop-band">
      <div class="container">
        <span class="eyebrow">Visitors</span>
        <h2 id="visitors-heading">Explore Sioux Falls</h2>
        <p class="section-sub">Maximize your visit — explore, experience, and discover Sioux Falls.</p>
        <div class="loop-grid">
          {visitorWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={28} class="loop-card-icon" />}
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {businessWithCat.length > 0 && (
    <section aria-labelledby="business-heading" class="loop-band loop-band--alt">
      <div class="container">
        <span class="eyebrow">For Business Owners</span>
        <h2 id="business-heading">Grow your business</h2>
        <p class="section-sub">Tactics, marketing tools, and strategies from Sioux Falls Go.</p>
        <div class="loop-grid">
          {businessWithCat.map(({ article, category }) => (
            <a class="loop-card" href={`/guides/${article.id}`}>
              <div class="loop-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={28} class="loop-card-icon" />}
              </div>
              <div class="loop-card-body">
                <span class="loop-tag">{category.data.name}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="container">
    <section class="legend-section">
      <div class="legend-card">
        <div class="legend-copy">
          <span class="legend-eyebrow"><Icon name="heart" size={13} /> Already Shop Local?</span>
          <h2>Become a Local Legend</h2>
          <p>We're giving away gift cards, prizes, and exclusive deals from top local businesses in Sioux Falls! <Icon name="sparkles" size={18} class="legend-sparkle" /></p>
          <p class="legend-sub">Join Local Legend VIP and be the first to know about our next big giveaway. It's 100% free — no strings attached!</p>
          <span class="legend-badge"><Icon name="gift" size={13} /> Giveaways starting soon</span>
        </div>
        <form id="legend-form" class="legend-form">
          <label for="legend-name">Name</label>
          <input type="text" id="legend-name" name="name" placeholder="Name" />
          <label for="legend-email">Email*</label>
          <input type="email" id="legend-email" name="email" placeholder="Email" required />
          <button type="submit" class="button legend-submit" id="legend-submit-btn">Start Winning</button>
          <p class="legend-form-status" id="legend-form-status" hidden></p>
        </form>
      </div>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .page { padding-block: var(--space-4) var(--space-6); }
  .page :global(.eyebrow) { display: block; margin-bottom: 0.2rem; }
  .loop-band { padding-block: var(--space-5); }
  .loop-band--alt { background: var(--color-river-light, #EAF2F8); }
  .section-sub { color: var(--color-navy-light); margin-top: -0.3rem; }

  .loop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-3); }
  @media (max-width: 55rem) { .loop-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .loop-grid { grid-template-columns: 1fr; } }
  .loop-card {
    display: block; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius);
    text-decoration: none; overflow: hidden;
    box-shadow: 0 1px 2px rgba(13,23,48,0.06);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .loop-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(13,23,48,0.16); border-color: transparent; }
  .loop-card-media {
    height: 9.5rem; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 60%, #F07E23 160%);
    background-size: cover; background-position: center;
  }
  .loop-card-icon { color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); }
  .loop-card-body { padding: var(--space-2) var(--space-3) var(--space-3); }
  .loop-tag { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-orange); }
  .loop-card h3 { font-size: 1.0625rem; margin: 0.3rem 0 0.35rem; }
  .loop-card p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }
  .legend-section { margin-top: var(--space-5); margin-bottom: var(--space-6); }
  .legend-card {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-4); align-items: center;
    background: linear-gradient(120deg, var(--color-navy) 0%, #2c3f61 55%, var(--color-orange) 160%);
    border-radius: var(--radius); padding: var(--space-5); color: #fff; position: relative; overflow: hidden;
  }
  @media (max-width: 50rem) { .legend-card { grid-template-columns: 1fr; padding: var(--space-4); } }
  .legend-eyebrow { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-gold); font-weight: 700; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .legend-copy h2 { color: #fff; font-size: 2rem; margin: 0.5rem 0 0.9rem; }
  .legend-copy p { color: rgba(255,255,255,0.9); font-size: 1.0625rem; margin: 0 0 0.6rem; display: flex; align-items: center; gap: 0.4rem; }
  .legend-sparkle { color: var(--color-gold); flex-shrink: 0; }
  .legend-sub { font-size: 0.9375rem !important; color: rgba(255,255,255,0.78) !important; }
  .legend-badge {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: var(--space-2);
    background: rgba(255,255,255,0.15); font-size: 0.8125rem; font-weight: 700; padding: 0.4rem 0.9rem; border-radius: var(--radius-pill);
  }
  .legend-form {
    background: rgba(255,255,255,0.97); border-radius: var(--radius); padding: var(--space-3);
    display: flex; flex-direction: column; gap: 0.5rem; position: relative; z-index: 1;
  }
  .legend-form label { font-size: 0.75rem; font-weight: 700; color: var(--color-navy); text-transform: uppercase; letter-spacing: 0.02em; }
  .legend-form input {
    padding: 0.75rem 1rem; border-radius: 0.6rem; border: 1.5px solid var(--color-line); font-family: var(--font-body); font-size: 0.9375rem;
  }
  .legend-submit { margin-top: 0.5rem; background: var(--color-orange); border: none; }
  .legend-form-status { font-size: 0.8125rem; font-weight: 600; margin: 0.4rem 0 0; }
  .legend-form-status.is-success { color: var(--color-success); }
  .legend-form-status.is-error { color: #C0392B; }
</style>

<script>
  // Local Legend VIP signup — real MailerLite subscription, not a static form
  const legendForm = document.getElementById('legend-form') as HTMLFormElement;
  const legendStatus = document.getElementById('legend-form-status');
  const legendBtn = document.getElementById('legend-submit-btn') as HTMLButtonElement;

  legendForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('legend-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('legend-email') as HTMLInputElement).value.trim();

    legendBtn.disabled = true;
    legendBtn.textContent = 'Joining…';
    if (legendStatus) { legendStatus.hidden = true; }

    try {
      const res = await fetch('/api/subscribe-local-legend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong');

      legendForm.reset();
      if (legendStatus) {
        legendStatus.textContent = `You're in! Watch your inbox for the next giveaway.`;
        legendStatus.classList.remove('is-error');
        legendStatus.classList.add('is-success');
        legendStatus.hidden = false;
      }
    } catch (err: any) {
      if (legendStatus) {
        legendStatus.textContent = `Couldn't sign you up: ${err.message}`;
        legendStatus.classList.remove('is-success');
        legendStatus.classList.add('is-error');
        legendStatus.hidden = false;
      }
    } finally {
      legendBtn.disabled = false;
      legendBtn.textContent = 'Start Winning';
    }
  });
</script>
