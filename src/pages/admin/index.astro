            <button class="button" id="article-edit-save">Save Changes</button>
          </div>
        </div>
      </div>

      <!-- ── SPONSORSHIPS ── -->
      <section class="tab-panel" id="panel-sponsorships">
        <h1>Sponsorships</h1>
        <p class="panel-sub">Pick a business, check the articles it should sponsor, and save. Every change goes out in one update.</p>

        <SponsorManager businesses={smBusinesses} articles={smArticles} />

        <div class="sponsor-stats">
          <div class="sponsor-stat">
            <span class="sponsor-stat-num">{totalSponsoredArticles}</span>
            <span class="sponsor-stat-label">Articles sponsored</span>
          </div>
          <div class="sponsor-stat">
            <span class="sponsor-stat-num">{activeSponsorCount}</span>
            <span class="sponsor-stat-label">Active sponsors</span>
          </div>
          <div class="sponsor-stat">
            <span class="sponsor-stat-num">{champions.length - activeSponsorCount}</span>
            <span class="sponsor-stat-label">Champions not sponsoring yet</span>
          </div>
          <div class={`sponsor-stat ${totalMismatches > 0 ? 'sponsor-stat--warn' : ''}`}>
            <span class="sponsor-stat-num">{totalMismatches}</span>
            <span class="sponsor-stat-label">Off-industry matches</span>
          </div>
        </div>

        <h3 class="section-heading">By Business</h3>
        <div class="sponsor-business-list">
          {sponsorshipsByBusiness.map(({ business, articlesSponsored }) => (
            <div class="sponsor-business-card">
              <div class="sponsor-business-head">
                <span class="sponsor-business-name">{business.data.name}</span>
                <span class="sponsor-business-count">
                  {articlesSponsored.length === 0 ? 'Not sponsoring anything' : `Sponsoring ${articlesSponsored.length} article${articlesSponsored.length === 1 ? '' : 's'}`}
                </span>
              </div>
              {articlesSponsored.length > 0 && (
                <div class="sponsor-article-rows">
                  {articlesSponsored.map(({ article, categoryMatch, categoryName }) => (
                    <button class="sponsor-article-row" data-jump-to-article={article.data.title}>
                      <span class="sponsor-article-title">{article.data.title}</span>
                      <span class="sponsor-article-cat">{categoryName}</span>
                      {categoryMatch ? (
                        <span class="match-badge match-badge--ok"><Icon name="check" size={12} /> Same industry</span>
                      ) : (
                        <span class="match-badge match-badge--warn"><Icon name="zap" size={12} /> Off-industry</span>
                      )}
                    </button>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- ── DEALS ── -->
