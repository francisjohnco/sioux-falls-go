  editSaveBtn?.addEventListener('click', async () => {
    if (!currentEditSlug) return;
    const updates: Record<string, unknown> = {};

    for (const id of SCALAR_EDIT_IDS) {
      const el = document.getElementById(`edit-${id}`) as HTMLInputElement | null;
      if (!el) continue;
      const raw = el.value.trim();
      const newVal = NUMBER_FIELDS.includes(id) ? (raw === '' ? null : Number(raw)) : (raw === '' ? null : raw);
      const oldVal = currentEditOriginal[id] === '' ? null : currentEditOriginal[id];
      if (newVal !== oldVal) updates[id] = newVal;
    }

    const newHours: Record<string, string> = {};
    let hoursChanged = false;
    for (const day of DAY_KEYS) {
      const el = document.getElementById(`edit-hours-${day}`) as HTMLInputElement | null;
      const val = el?.value.trim() || '';
