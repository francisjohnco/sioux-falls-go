        <OwnerAccess champions={businesses.filter((b) => b.data.partnershipTier === 'community-champion').map((b) => ({ slug: b.id, name: b.data.name })).sort((a, b) => a.name.localeCompare(b.name))} />

        <CategoryManager items={categoryItems} />

        <div class="gsc-widget" id="reviews-sync-widget">
