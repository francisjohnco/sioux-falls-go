                <input type="text" id="article-direction" placeholder="e.g. focus on winter pipe issues, mention the giveaway" />
              </label>
              <button class="button" id="article-generate-btn"><Icon name="sparkles" size={16} /> Generate Draft</button>
            </div>
            <p class="engine-error" id="article-error" hidden></p>
          </div>

          <div class="engine-panel">
            <h3>Generate a Spotlight or Press Release</h3>
            <p class="panel-note">Champion tier only — publishes as a real article, appears under "Latest from [Business]" on their profile. Write exactly what you want — mention if it should read as a press release, an announcement, whatever fits.</p>

            <label class="engine-select">
              Business
              <select id="spotlight-business-select">
                {businessesWithCategory.filter(({ business }) => business.data.partnershipTier === 'community-champion').map(({ business }) => (
                  <option value={business.id} data-name={business.data.name}>{business.data.name}</option>
                ))}
              </select>
            </label>

            <label class="engine-field">
