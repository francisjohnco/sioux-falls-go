  async function stayPhotoCall(body: any) {
    const res = await fetch('/api/admin-biz-photo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ collection: 'stays', slug: currentStaySlug, ...body }) });
