                  <input type="checkbox" data-field="claimed" data-slug={business.id} checked={business.data.claimed} />
                  <span class="toggle-slider"></span>
                </label>
              </span>
              <span>
                <input
                  type="text"
                  class="place-id-input"
                  data-field="placeId"
                  data-slug={business.id}
                  value={business.data.placeId || ''}
                  placeholder="ChIJ..."
                />
              </span>
            </div>
          ))}
        </div>
        <p class="save-status" id="directory-save-status" hidden></p>
      </section>

