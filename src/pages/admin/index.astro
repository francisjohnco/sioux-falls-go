          <select id="article-status"><option value="">Live and scheduled</option><option value="live">Live only</option><option value="scheduled">Scheduled only</option><option value="sponsored">Sponsored</option><option value="open">No sponsor</option></select>
        </div>
        <div id="articles-list" class="articles-list">
          {allArticles
            .sort((a, b) => (b.data.publishedAt?.toString() || '').localeCompare(a.data.publishedAt?.toString() || ''))
            .map((a) => (
              <button
                class="article-row"
                data-search={a.data.title.toLowerCase()}
                data-cat={a.data.category.id}
                data-status={`${isLive(a) ? 'live' : 'scheduled'} ${a.data.sponsoredBy ? 'sponsored' : 'open'}`}
                data-open-article={a.id}
                data-article={JSON.stringify({
                  title: a.data.title,
                  seoTitle: a.data.seo.title,
                  seoDescription: a.data.seo.description,
                  bodyMarkdown: a.body || '',
                  sponsoredBy: a.data.sponsoredBy?.id ?? '',
                })}
              >
                <span class="article-row-title">{a.data.title}</span>
                <span class="article-row-meta">
                  {a.data.contentType} · {publishDay(a)}
                  {!isLive(a) && <span class="sched-chip">Scheduled for {niceDay(publishDay(a))}</span>}
