---
import PublishTracker from '../../components/PublishTracker.astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import HeroPhotos from '../../components/admin/HeroPhotos.astro';
import { articleHero } from '../../lib/hero';
import DealsPanel from '../../components/admin/DealsPanel.astro';
import type { AdminDeal } from '../../components/admin/DealsPanel.astro';
import ProfileInterview from '../../components/admin/ProfileInterview.astro';
import OwnerAccess from '../../components/admin/OwnerAccess.astro';
import CategoryManager from '../../components/admin/CategoryManager.astro';
import AnalyticsPanel from '../../components/admin/AnalyticsPanel.astro';
import SponsorManager from '../../components/admin/SponsorManager.astro';
import { categoryHero } from '../../lib/hero';
import SchedulePanel from '../../components/admin/SchedulePanel.astro';
import EventsPanel from '../../components/admin/EventsPanel.astro';
import { isLive, publishDay } from '../../lib/articles';
import { todayCentral, dateKey } from '../../lib/dates';
import nodePath from 'node:path';
import nodeFs from 'node:fs';
import { execSync } from 'node:child_process';

const businesses = await getCollection('businesses');
const businessesWithCategory = await Promise.all(
  businesses.map(async (b) => ({ business: b, category: await getEntry(b.data.category) }))
);
businessesWithCategory.sort((a, b) => a.business.data.name.localeCompare(b.business.data.name));

let newsletterConfig = { frequency: 'weekly', lastGeneratedAt: null as string | null };
try {
  const fs = await import('node:fs/promises');
  const raw = await fs.readFile(new URL('../../../data/newsletter-config.json', import.meta.url), 'utf-8');
  newsletterConfig = JSON.parse(raw);
} catch {
  // fall back to defaults if the file can't be read at build time
}

// Real dashboard stats — computed from actual content, not hardcoded
const championCount = businesses.filter((b) => b.data.partnershipTier === 'community-champion').length;
const giveBackCount = businesses.filter(
  (b) => b.data.partnershipTier === 'community-champion' || b.data.partnershipTier === 'community-listing'
).length;

// Article sponsorship is a paid Community Champion perk — only Champions
// are eligible to appear in the "Sponsored By" picker on an article.
const champions = businesses
  .filter((b) => b.data.partnershipTier === 'community-champion')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

// Full sponsorship picture, grouped by sponsoring business, with a plain
// mismatch flag when a sponsor's own category doesn't match the article's
// category (e.g. a marketing agency sponsoring an electrician guide) —
// still allowed, just surfaced so it's a deliberate choice, not an accident.
const allArticlesForSponsors = await getCollection('articles');
const allCategoriesEarly = new Map((await getCollection('categories')).map((c) => [c.id, c.data.name]));
const articleCategoryCache = new Map<string, Awaited<ReturnType<typeof getEntry>>>();
for (const a of allArticlesForSponsors) {
  if (!articleCategoryCache.has(a.data.category.id)) {
    articleCategoryCache.set(a.data.category.id, await getEntry(a.data.category));
  }
}
const sponsoredArticles = allArticlesForSponsors.filter((a) => a.data.sponsoredBy);
// Data for the Sponsor Manager: every article with its industry, series, and current sponsor.
const catName = (id: string) => articleCategoryCache.get(id)?.data.name ?? id;
const bizName = (id: string) => businesses.find((b) => b.id === id)?.data.name ?? id;
const seriesName = new Map(allArticlesForSponsors.filter((a) => a.data.clusterRole === 'pillar' && a.data.cluster).map((a) => [a.data.cluster!, a.data.title]));
const smArticles = allArticlesForSponsors.map((a) => {
  const date = publishDay(a);
  return { slug: a.id, title: a.data.title, category: a.data.category.id, categoryName: catName(a.data.category.id),
    series: a.data.cluster || '', seriesName: a.data.cluster ? (seriesName.get(a.data.cluster) || a.data.cluster.replace(/-/g, ' ')) : '',
    date, live: isLive(a), sponsor: a.data.sponsoredBy?.id || '', sponsorName: a.data.sponsoredBy ? bizName(a.data.sponsoredBy.id) : '' };
}).sort((a, b) => b.date.localeCompare(a.date));
const smBusinesses = businesses.map((b) => ({ slug: b.id, name: b.data.name, category: b.data.category.id, categoryName: allCategoriesEarly.get(b.data.category.id) || b.data.category.id, champion: b.data.partnershipTier === 'community-champion' }))
  .sort((a, b) => a.name.localeCompare(b.name));
const sponsorshipsByBusiness = champions.map((champion) => {
  const articlesSponsored = sponsoredArticles
    .filter((a) => a.data.sponsoredBy?.id === champion.id)
    .map((a) => ({
      article: a,
      categoryMatch: a.data.category.id === champion.data.category.id,
      categoryName: articleCategoryCache.get(a.data.category.id)?.data.name ?? a.data.category.id,
    }));
  return { business: champion, articlesSponsored };
});
const totalSponsoredArticles = sponsoredArticles.length;
const totalMismatches = sponsorshipsByBusiness.reduce(
  (sum, s) => sum + s.articlesSponsored.filter((a) => !a.categoryMatch).length, 0
);
const activeSponsorCount = sponsorshipsByBusiness.filter((s) => s.articlesSponsored.length > 0).length;

// Mailer Deals — real data for the admin's create/manage view.
const allDealsForAdmin = await getCollection('deals');
const nowForDeals = new Date();
const mailerDealsAll = allDealsForAdmin.filter((d) => d.data.mailerCampaign);
const mailerDealsWithBusiness = await Promise.all(
  mailerDealsAll.map(async (d) => ({
    deal: d,
    business: await getEntry(d.data.business),
    isExpired: d.data.expiresAt ? d.data.expiresAt.toISOString().slice(0, 10) < todayCentral() : false,
    isScheduled: d.data.activatesAt ? d.data.activatesAt.getTime() > nowForDeals.getTime() : false,
  }))
);
mailerDealsWithBusiness.sort((a, b) => (a.isExpired === b.isExpired ? 0 : a.isExpired ? 1 : -1));
const activeMailerCount = mailerDealsWithBusiness.filter((d) => !d.isExpired && !d.isScheduled).length;
// Verified businesses are eligible to receive a postcard offer, regardless of tier
const verifiedBusinesses = businessesWithCategory
  .filter(({ business }) => business.data.verifiedAt)
  .sort((a, b) => a.business.data.name.localeCompare(b.business.data.name));
const allArticles = await getCollection('articles');

// Scheduled publishing: articles dated in the future exist in the repo but
// have no page yet. The admin sees them; the public site does not.
const scheduledArticles = allArticles.filter((a) => !isLive(a)).sort((a, b) => publishDay(a).localeCompare(publishDay(b)));
const liveArticleCount = allArticles.length - scheduledArticles.length;
// Deals tab: every deal, with when its file first landed (for "Added today").
const dealAddedAt: Record<string, number> = {};
try {
  const log = execSync("git log --diff-filter=A --format=@%ct --name-only -- src/content/deals", { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
  let t = 0;
  for (const line of log.split('\n')) {
    if (line.startsWith('@')) t = Number(line.slice(1)) * 1000;
    else if (line.trim()) { const id = nodePath.basename(line.trim(), '.json'); if (!dealAddedAt[id]) dealAddedAt[id] = t; }
  }
} catch {}
const bizNames = new Map(businesses.map((b) => [b.id, b.data.name]));
const dayOf = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
const todayForDeals = todayCentral();
const statusRank = { live: 0, upcoming: 1, ended: 2 };
const adminDeals: AdminDeal[] = allDealsForAdmin.map((d) => {
  const startsAt = dayOf(d.data.activatesAt), endsAt = dayOf(d.data.expiresAt);
  const status: AdminDeal['status'] = endsAt && endsAt < todayForDeals ? 'ended' : startsAt && startsAt > todayForDeals ? 'upcoming' : 'live';
  return {
    id: d.id, business: d.data.business.id, businessName: bizNames.get(d.data.business.id) ?? d.data.business.id,
    title: d.data.title, description: d.data.description, discountType: d.data.discountType,
    startsAt, endsAt, blackFriday: d.data.promotion === 'black-friday', mailer: d.data.mailerCampaign ?? '',
    redeemMethod: d.data.redeemMethod ?? 'show', redeemValue: d.data.redeemValue ?? '', redeemNote: d.data.redeemNote ?? '',
    terms: d.data.terms ?? '', status, addedAt: dealAddedAt[d.id] ?? 0, source: d.data.submittedBy ?? '',
  };
}).sort((a, b) => statusRank[a.status] - statusRank[b.status] || b.addedAt - a.addedAt);
const heroItems = allArticles.map((a) => {
  const h = articleHero(a);
  const state = h.isFallback ? 'fallback' : a.data.heroImageLocked ? 'locked' : a.data.heroImageAlt ? 'chosen' : 'review';
  return { slug: a.id, title: a.data.title, card: h.card, state: state as 'chosen' | 'locked' | 'review' | 'fallback', live: isLive(a) };
});
const scheduledDatesJson = JSON.stringify(scheduledArticles.map((a) => publishDay(a)));
const niceDay = (key: string, withWeekday = true) =>
  new Date(`${key}T12:00:00Z`).toLocaleDateString('en-US', { ...(withWeekday ? { weekday: 'short' } : {}), month: 'short', day: 'numeric', timeZone: 'UTC' });
const scheduledForPanel = scheduledArticles.map((a) => ({ slug: a.id, title: a.data.title, date: publishDay(a), dateLabel: niceDay(publishDay(a)) }));
const builtAtIso = new Date().toISOString();

let topicQueue: { campaign: string; items: { slug: string; title: string; status: 'live' | 'scheduled' | 'queued'; date?: string }[] } | null = null;
try {
  const q = JSON.parse(nodeFs.readFileSync(nodePath.join(process.cwd(), 'data/topic-queue.json'), 'utf-8'));
  topicQueue = {
    campaign: q.campaign,
    items: q.topics.map((t: any) => {
      const a = allArticles.find((x) => x.id === t.slug);
      return { slug: t.slug, title: t.title, status: !a ? 'queued' : isLive(a) ? 'live' : 'scheduled', date: a ? publishDay(a) : undefined };
    }),
  };
} catch {}

// Events: every event with its exact dates, flagged past or upcoming.
const todayForEvents = todayCentral();
const adminEvents = (await getCollection('events')).map((e) => {
  const occ = e.data.occurrences
    .map((o) => ({ date: dateKey(o.date), endDate: o.endDate ? dateKey(o.endDate) : undefined, time: o.time }))
    .sort((a, b) => a.date.localeCompare(b.date));
  const idx = occ.findIndex((o) => (o.endDate ?? o.date) >= todayForEvents);
  const isPast = idx === -1;
  const shown = isPast ? occ[occ.length - 1] : occ[idx];
  return {
    id: e.id, title: e.data.title, description: e.data.description, category: e.data.category,
    occurrences: occ, location: e.data.location, photo: e.data.photo,
    sourceName: e.data.sourceName, sourceUrl: e.data.sourceUrl, note: e.data.note,
    nextLabel: shown.endDate ? `${niceDay(shown.date, false)} to ${niceDay(shown.endDate, false)}` : niceDay(shown.date),
    isPast, remaining: isPast ? 0 : occ.length - idx,
    sortKey: shown.date,
  };
}).sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const upcomingEventCount = adminEvents.filter((e) => !e.isPast).length;
const allCategories = await getCollection('categories');
const allStays = await getCollection('stays');
const sortedCategories = [...allCategories].sort((a, b) => a.data.name.localeCompare(b.data.name));
const categoryItems = sortedCategories.map((c) => {
  const h = categoryHero(c);
  return { slug: c.data.slug, name: c.data.name, parent: c.data.parentCategory?.id || '', card: h.card, hasPhoto: !h.isFallback, locked: !!c.data.heroImageLocked,
    count: businesses.filter((b) => b.data.category.id === c.id).length };
});
const articleIndexForEngine = allArticles.filter((a) => isLive(a)).map((a) => ({
  title: a.data.title,
  slug: a.id,
  category: a.data.category.id,
  description: a.data.seo.description,
}));

// Real "needs attention" list — actual data gaps, not a fake activity log.
// This is more honest and more useful than a fabricated event feed would
// be: there's no real audit trail in this static-site architecture, so a
// "Recent Activity" feed would have to be fake. This tells you what to
// actually do instead of pretending to show you what happened.
const missingPlaceId = businesses.filter((b) => !b.data.placeId);
const missingHours = businesses.filter((b) => !b.data.hoursSchedule);

// Mailer deals expiring within a week — genuinely time-sensitive, since
// these are paid postcard offers that quietly go dead if no one notices.
const sevenDaysOut = new Date();
sevenDaysOut.setDate(sevenDaysOut.getDate() + 7);
const mailerDealsExpiringSoon = mailerDealsWithBusiness.filter(
  ({ deal, isExpired, isScheduled }) => !isExpired && !isScheduled && deal.data.expiresAt && deal.data.expiresAt.getTime() <= sevenDaysOut.getTime()
);
const missingReviews = businesses.filter((b) => b.data.reviews.length === 0);

let topContentGap: { name: string; priorityScore: number } | null = null;
try {
  const fs = await import('node:fs/promises');
  const raw = await fs.readFile(new URL('../../../public/content-gaps.json', import.meta.url), 'utf-8');
  const gaps = JSON.parse(raw);
  const sorted = gaps.categories.filter((c: any) => c.priorityScore > 0).sort((a: any, b: any) => b.priorityScore - a.priorityScore);
  if (sorted.length > 0) topContentGap = sorted[0];
} catch {
  // content-gaps.json is generated at build time — if it's not there yet, just skip this insight
}

const FREQUENCY_DAYS: Record<string, number> = { weekly: 7, biweekly: 14, monthly: 30 };
const newsletterOverdue = newsletterConfig.lastGeneratedAt
  ? (Date.now() - new Date(newsletterConfig.lastGeneratedAt).getTime()) / (1000 * 60 * 60 * 24) > (FREQUENCY_DAYS[newsletterConfig.frequency] ?? 7)
  : true;
---
<BaseLayout
  title="Admin — Sioux Falls Go"
  description="Internal admin dashboard."
  canonicalPath="/admin"
  noindex
>
  <div class="admin-shell">
    <!-- Desktop sidebar / mobile top bar -->
    <header class="admin-topbar">
      <button class="admin-hamburger" id="admin-hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <a href="/" class="admin-logo-link">
        <img src="/images/sfg-logo.png" alt="Sioux Falls Go" class="admin-logo-img" />
        <em>Admin</em>
      </a>
      <button class="admin-avatar" aria-label="Account">FJ</button>
    </header>

    <div class="admin-sidebar-backdrop" id="admin-sidebar-backdrop"></div>

    <aside class="admin-sidebar" id="admin-sidebar">
      <nav>
        <button class="nav-item is-active" data-tab="dashboard">
          <span class="nav-icon"><Icon name="dashboard" size={18} /></span> Dashboard
        </button>
        <button class="nav-item" data-tab="analytics">
          <span class="nav-icon"><Icon name="activity" size={18} /></span> Analytics
        </button>
        <button class="nav-item" data-tab="content-engine">
          <span class="nav-icon"><Icon name="edit" size={18} /></span> Content Engine
        </button>
        <button class="nav-item" data-tab="drafts">
          <span class="nav-icon"><Icon name="clipboard" size={18} /></span> Drafts &amp; Articles
        </button>
        <button class="nav-item" data-tab="sponsorships">
          <span class="nav-icon"><Icon name="star" size={18} /></span> Sponsorships
        </button>
        <button class="nav-item" data-tab="deals">
          <span class="nav-icon"><Icon name="zap" size={18} /></span> Deals <span class="nav-count" id="nav-deals-count" hidden></span>
        </button>
        <button class="nav-item" data-tab="mailer-deals">
          <span class="nav-icon"><Icon name="mail" size={18} /></span> Mailer Deals
        </button>
        <button class="nav-item" data-tab="schedule">
          <span class="nav-icon"><Icon name="clock" size={18} /></span> Schedule
        </button>
        <button class="nav-item" data-tab="events">
          <span class="nav-icon"><Icon name="sparkles" size={18} /></span> Events
        </button>
        <button class="nav-item" data-tab="directory">
          <span class="nav-icon"><Icon name="folder" size={18} /></span> Directory
        </button>
        <button class="nav-item" data-tab="stays">
          <span class="nav-icon"><Icon name="key" size={18} /></span> Stays
        </button>
        <button class="nav-item" data-tab="giveaways">
          <span class="nav-icon"><Icon name="gift" size={18} /></span> Giveaways
        </button>
        <button class="nav-item" data-tab="newsletter">
          <span class="nav-icon"><Icon name="mail" size={18} /></span> Newsletter
        </button>
      </nav>
    </aside>

    <main class="admin-main">

      <!-- ── DASHBOARD ── -->
      <section class="tab-panel is-active" id="panel-dashboard">
        <h1>Dashboard</h1>
        <p class="panel-sub">What needs your attention today.</p>

        <div class="stat-grid">
          <div class="stat-card">
            <span class="stat-icon"><Icon name="folder" size={18} /></span>
            <span class="stat-number">{businesses.length}</span>
            <span class="stat-label">Businesses Live</span>
          </div>
          <div class="stat-card stat-card--accent">
            <span class="stat-icon stat-icon--accent"><Icon name="star" size={18} /></span>
            <span class="stat-number">{championCount}</span>
            <span class="stat-label">Community Champions</span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><Icon name="heart" size={18} /></span>
            <span class="stat-number">{giveBackCount}</span>
            <span class="stat-label">Give Back Partners</span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><Icon name="edit" size={18} /></span>
            <span class="stat-number">{liveArticleCount}</span>
            <span class="stat-label">Articles &amp; Guides</span>
          </div>
          <button class="stat-card stat-card--link" data-jump-tab="mailer-deals">
            <span class="stat-icon stat-icon--mail"><Icon name="mail" size={18} /></span>
            <span class="stat-number">{activeMailerCount}</span>
            <span class="stat-label">Active Mailer Deals</span>
          </button>
        </div>

        <h2 class="section-heading">Search Traffic <span class="section-heading-sub">Last 28 days, from Google Search Console · <button type="button" class="link-button" data-jump-tab="analytics">See full analytics →</button></span></h2>
        <div class="stat-grid" id="search-traffic-grid">
          <div class="stat-card">
            <span class="stat-number" id="traffic-clicks">—</span>
            <span class="stat-label">Clicks from Search</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" id="traffic-impressions">—</span>
            <span class="stat-label">Impressions</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" id="traffic-ctr">—</span>
            <span class="stat-label">Click-Through Rate</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" id="traffic-position">—</span>
            <span class="stat-label">Avg. Search Position</span>
          </div>
        </div>
        <p class="traffic-status" id="traffic-status" hidden></p>

        <h2 class="section-heading">Needs Your Attention</h2>
        <ul class="activity-list">
          <li id="attention-bf-deals" hidden>
            <span class="activity-dot activity-dot--new"></span>
            <strong>Black Friday deals</strong> from businesses waiting for your approval
            <button class="attention-link attention-link--btn" data-jump-tab="deals">Review →</button>
          </li>
          <li id="attention-owner-changes" hidden>
            <span class="activity-dot activity-dot--new"></span>
            <strong>Owner story changes</strong> waiting for your approval
            <button class="attention-link attention-link--btn" data-jump-tab="directory">Review in Directory →</button>
          </li>
          {missingPlaceId.length > 0 && (
            <li>
              <span class="activity-dot activity-dot--new"></span>
              <strong>{missingPlaceId.length} business{missingPlaceId.length === 1 ? '' : 'es'}</strong> missing a Google Place ID — reviews can't sync until it's set
              <a href="/admin?tab=directory" class="attention-link">Fix in Directory →</a>
            </li>
          )}
          {missingHours.length > 0 && (
            <li>
              <span class="activity-dot"></span>
              <strong>{missingHours.length} business{missingHours.length === 1 ? '' : 'es'}</strong> missing real hours — showing "Not listed" on their profile
            </li>
          )}
          {mailerDealsExpiringSoon.length > 0 && (
            <li>
              <span class="activity-dot activity-dot--new"></span>
              <strong>{mailerDealsExpiringSoon.length} mailer deal{mailerDealsExpiringSoon.length === 1 ? '' : 's'}</strong> expiring within a week — {mailerDealsExpiringSoon.map((d) => d.business?.data.name).join(', ')}
              <button class="attention-link attention-link--btn" data-jump-tab="deals">Review in Mailer Deals →</button>
            </li>
          )}
          {upcomingEventCount < 4 && (
            <li>
              <span class="activity-dot activity-dot--new"></span>
              <strong>Only {upcomingEventCount} upcoming event{upcomingEventCount === 1 ? '' : 's'}</strong> on the calendar, add more or review the suggestions
              <button class="attention-link attention-link--btn" data-jump-tab="events">Open Events →</button>
            </li>
          )}
          {topContentGap && (
            <li>
              <span class="activity-dot activity-dot--new"></span>
              <strong>{topContentGap.name}</strong> is your highest-priority content gap right now
              <a href="/admin?tab=content-engine" class="attention-link">Open Content Engine →</a>
            </li>
          )}
          {newsletterOverdue && (
            <li>
              <span class="activity-dot"></span>
              Newsletter is overdue for a {newsletterConfig.frequency} draft
              <a href="/admin?tab=newsletter" class="attention-link">Generate one →</a>
            </li>
          )}
          {missingPlaceId.length === 0 && missingHours.length === 0 && !topContentGap && !newsletterOverdue && upcomingEventCount >= 4 && (
            <li><span class="activity-dot"></span> Nothing urgent right now — everything's covered.</li>
          )}
        </ul>
      </section>

      <!-- ── CONTENT AI ENGINE ── -->
      <section class="tab-panel" id="panel-analytics">
        <AnalyticsPanel names={Object.fromEntries(businesses.map((b) => [b.id, b.data.name]))} />
      </section>

      <section class="tab-panel" id="panel-content-engine">
        <h1>Content Engine</h1>
        <p class="panel-sub">Turn interview answers into a finished profile — or generate the next highest-priority guide.</p>

        <div class="gsc-widget" id="gsc-widget">
          <div class="gsc-widget-header">
            <h3>Google Search Console <span class="live-tag" id="gsc-status-tag" hidden>CONNECTED</span></h3>
            <button class="button" id="gsc-connect-btn">Connect Search Console</button>
            <button class="button button--ghost" id="gsc-disconnect-btn" hidden>Disconnect</button>
          </div>
          <p class="gap-note" id="gsc-status-note">Not connected — content priority is currently based on site coverage only. Connect to add real search demand data.</p>
        </div>

        <div class="gap-queue-section">
          <h3>Content Gap Priority Queue <span class="live-tag">LIVE</span></h3>
          <p class="gap-note">Recomputed on every deploy from real site data — new categories with listings and no content jump to the top automatically.</p>
          <div id="gap-queue-list" class="gap-queue-list">
            <p class="empty-note">Loading...</p>
          </div>
        </div>

        <div class="engine-layout">
          <div class="engine-panel">
            <h3>Generate a Guide or Article</h3>
            <p class="panel-note">Pick a real content type and category — this writes a new article, avoiding topics you've already covered.</p>

            <div class="engine-controls">
              <label class="engine-select">
                Content type
                <select id="article-type-select">
                  <option value="faq">FAQ</option>
                  <option value="buying-guide">Buying Guide</option>
                  <option value="cost-guide">Cost Guide</option>
                  <option value="educational-article">Educational Article</option>
                  <option value="seasonal-guide">Seasonal Guide</option>
                  <option value="visitor-guide">Visitor Guide</option>
                  <option value="local-resource">Local Resource</option>
                  <option value="checklist">Checklist</option>
                  <option value="definition">Definition</option>
                  <option value="comparison">Comparison</option>
                  <option value="safety-information">Safety Information</option>
                  <option value="maintenance-guide">Maintenance Guide</option>
                </select>
              </label>
              <label class="engine-select">
                Category
                <select id="article-category-select">
                  {allCategories.filter((c) => !['community-spotlight','consumer-guide','explore-sioux-falls','for-local-businesses','for-locals','grow-with-sfg','local-spotlights','marketing-tips-insights','spotlight-giveaways'].includes(c.data.slug)).map((c) => (
                    <option value={c.data.slug} data-name={c.data.name}>{c.data.name}</option>
                  ))}
                </select>
              </label>
              <label class="engine-select engine-select--direction">
