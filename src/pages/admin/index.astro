            <label class="edit-field-full">Mailing Cycle <input type="text" id="deal-campaign" placeholder="e.g. September 2026" /></label>
            <label class="edit-field-full">Postcard Spot Size
              <select id="deal-spotSize">
                <option value="medium">Medium ($550)</option>
                <option value="large">Large ($900)</option>
                <option value="small">Small ($300)</option>
              </select>
            </label>
            <label class="edit-field-full">Offer Title <input type="text" id="deal-title" placeholder="e.g. $25 Off Any Drain Service" /></label>
            <label class="edit-field-full">Description <textarea id="deal-description" rows="2" placeholder="One sentence describing the offer"></textarea></label>
            <div class="edit-field-grid">
              <label>Discount Type
                <select id="deal-discountType">
                  <option value="percent-off">Percent off</option>
                  <option value="dollar-off">Dollar off</option>
                  <option value="bogo">Buy one, get one</option>
                  <option value="free-item">Free item</option>
                  <option value="bundle">Bundle</option>
                  <option value="other">Other</option>
                </select>
              </label>
              <label>Expires
                <input type="date" id="deal-expiresAt" />
              </label>
            </div>
            <label class="edit-field-full activate-field">
              <span class="activate-field-label"><Icon name="clock" size={14} /> Activates On <span class="activate-field-hint">(leave blank to go live immediately — set a future date to schedule it)</span></span>
              <input type="date" id="deal-activatesAt" />
            </label>
            <label class="edit-field-full">Terms (optional) <input type="text" id="deal-terms" placeholder="e.g. One per household." /></label>
            <p class="edit-modal-status" id="create-deal-status" hidden></p>
          </div>
          <div class="edit-modal-footer">
            <button class="button button--danger" id="deal-delete-btn" hidden>Delete Deal</button>
            <div class="edit-modal-footer-right">
              <button class="button button--ghost" id="create-deal-cancel">Cancel</button>
              <button class="button" id="create-deal-save">Create Deal</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── DIRECTORY ── -->
      <section class="tab-panel" id="panel-directory">
