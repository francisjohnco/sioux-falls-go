              <select id="edit-couponStyle">
                <option value="">Ticket Stub (default)</option>
                <option value="ticket-stub">Ticket Stub</option>
                <option value="torn-corner">Torn Corner</option>
                <option value="rubber-stamp">Rubber Stamp</option>
                <option value="clip-coupon">Clip Coupon</option>
                <option value="price-tag">Price Tag</option>
              </select>
            </label>

            <h3 class="edit-section-heading">Photos and logo</h3>
            <div class="ap-row">
              <div class="ap-slot"><div class="ap-thumb" id="ap-hero"></div><label class="button button--ghost ap-file">Main photo <input type="file" accept="image/*" data-ap="hero" /></label></div>
              <div class="ap-slot"><div class="ap-thumb ap-thumb--logo" id="ap-logo"></div><label class="button button--ghost ap-file">Logo <input type="file" accept="image/png,image/jpeg,image/webp" data-ap="logo" /></label></div>
            </div>
            <div class="ap-gallery" id="ap-gallery"></div>
            <label class="button button--ghost ap-file">Add gallery photos <input type="file" accept="image/*" multiple data-ap="gallery" /></label>
            <p class="ap-note" id="ap-note">Photos save right away. Gallery photos also appear inside the story on the profile.</p>

            <h3 class="edit-section-heading">Hours</h3>
            <div class="edit-hours-grid">
              <label>Mon <input type="text" id="edit-hours-mon" placeholder="9:00 AM - 5:00 PM" /></label>
              <label>Tue <input type="text" id="edit-hours-tue" placeholder="9:00 AM - 5:00 PM" /></label>
              <label>Wed <input type="text" id="edit-hours-wed" placeholder="9:00 AM - 5:00 PM" /></label>
              <label>Thu <input type="text" id="edit-hours-thu" placeholder="9:00 AM - 5:00 PM" /></label>
              <label>Fri <input type="text" id="edit-hours-fri" placeholder="9:00 AM - 5:00 PM" /></label>
              <label>Sat <input type="text" id="edit-hours-sat" placeholder="Closed" /></label>
              <label>Sun <input type="text" id="edit-hours-sun" placeholder="Closed" /></label>
            </div>

            <h3 class="edit-section-heading">Story</h3>
            <textarea id="edit-body" rows="10" class="edit-body-textarea" placeholder="The business's full story/description..."></textarea>

            <p class="edit-modal-status" id="edit-modal-status" hidden></p>
          </div>
          <div class="edit-modal-footer">
            <a class="button button--ghost" id="edit-manage-link" href="#" target="_blank" rel="noopener">Open owner dashboard ↗</a>
              <a class="button button--ghost" id="edit-report-link" href="#" target="_blank" rel="noopener">See this business's report</a>
            <button class="button button--ghost" id="edit-modal-cancel">Cancel</button>
            <button class="button" id="edit-modal-save">Save Changes</button>
          </div>
        </div>
      </div>

      <!-- ── STAYS ── -->
      <section class="tab-panel" id="panel-stays">
        <div class="panel-header-row">
          <div>
            <h1>Stays</h1>
            <p class="panel-sub">{allStays.length} listing{allStays.length !== 1 ? 's' : ''} — edit details, verification, and insider tips.</p>
          </div>
        </div>

        <div class="biz-row biz-row--header">
          <span>Name</span><span>Type</span><span>Location</span><span>Verified</span><span>Airbnb</span>
        </div>
        {allStays.map((stay) => (
          <div class="biz-row" data-slug={stay.id}>
            <button class="biz-name biz-name--link" data-open-stay={stay.id} data-stay={JSON.stringify({
              name: stay.data.name,
              locationLabel: stay.data.locationLabel,
              bedrooms: stay.data.bedrooms,
              bathrooms: stay.data.bathrooms,
              guestCapacityLabel: stay.data.guestCapacityLabel,
              amenities: stay.data.amenities,
              amenityCount: stay.data.amenityCount ?? '',
              airbnbUrl: stay.data.airbnbUrl,
              hostName: stay.data.hostName || '',
              heroImage: stay.data.heroImage || '',
              gallery: stay.data.gallery || [],
              verified: !!stay.data.verifiedAt,
              insiderTips: stay.data.insiderTips,
            })}>{stay.data.name}</button>
            <span>{stay.data.stayType}</span>
            <span>{stay.data.locationLabel}</span>
            <span>{stay.data.verifiedAt ? '✓ Verified' : 'Not verified'}</span>
            <a href={stay.data.airbnbUrl} target="_blank" rel="noopener">View ↗</a>
          </div>
        ))}
      </section>

      <!-- STAY EDIT MODAL -->
      <div class="edit-modal-backdrop" id="stay-edit-modal-backdrop">
        <div class="edit-modal">
          <div class="edit-modal-header">
            <h2 id="stay-edit-modal-title">Edit Stay</h2>
            <button class="edit-modal-close" id="stay-edit-modal-close" aria-label="Close">✕</button>
          </div>
          <div class="edit-modal-body">
            <div class="edit-field-grid">
              <label>Name <input type="text" id="stay-edit-name" /></label>
              <label>Host Name <input type="text" id="stay-edit-hostname" /></label>
              <label>Bedrooms <input type="number" id="stay-edit-bedrooms" /></label>
              <label>Bathrooms <input type="number" id="stay-edit-bathrooms" /></label>
            </div>
            <label class="edit-field-full">Location Label <input type="text" id="stay-edit-location" /></label>
            <label class="edit-field-full">Guest Capacity Label <input type="text" id="stay-edit-capacity" /></label>
            <label class="edit-field-full">Airbnb URL <input type="text" id="stay-edit-airbnb" /></label>
            <label class="edit-field-full">Total Amenity Count (on Airbnb) <input type="number" id="stay-edit-amenity-count" /></label>
            <label class="edit-field-full">Amenities (one per line) <textarea id="stay-edit-amenities" rows="5"></textarea></label>

            <h3 class="edit-section-heading">Photos of the home</h3>
            <div class="ap-row">
              <div class="ap-slot"><div class="ap-thumb" id="sp-hero"></div><label class="button button--ghost ap-file">Main photo <input type="file" accept="image/*" data-sp="hero" /></label></div>
            </div>
            <div class="ap-gallery" id="sp-gallery"></div>
            <label class="button button--ghost ap-file">Add photos <input type="file" accept="image/*" multiple data-sp="gallery" /></label>
            <p class="ap-note" id="sp-note">Photos save right away. You can pick several at once. Tap Make main on any photo to use it as the main one.</p>


            <label style="display:flex; align-items:center; gap:0.6rem; margin: 1rem 0;">
              <input type="checkbox" id="stay-edit-verified" style="width:auto;" />
              <span style="text-transform:none; font-size:0.9375rem;">Verified — I've personally confirmed the real Airbnb listing and key facts match</span>
            </label>

            <h3 class="edit-section-heading">Insider Tips</h3>
            <div id="stay-edit-tips-list"></div>
            <button class="button--link" id="stay-add-tip-btn" type="button">+ Add a tip</button>

            <p class="edit-modal-status" id="stay-edit-status" hidden></p>
          </div>
          <div class="edit-modal-footer">
            <button class="button button--ghost" id="stay-edit-cancel">Cancel</button>
            <button class="button" id="stay-edit-save">Save Changes</button>
          </div>
        </div>
      </div>

      <!-- ── GIVEAWAYS ── -->
      <section class="tab-panel" id="panel-giveaways">
        <div class="panel-header-row">
          <div>
            <h1>Giveaways</h1>
            <p class="panel-sub">1 active, 1 draft.</p>
          </div>
          <button class="button">+ New Giveaway</button>
        </div>

        <div class="giveaway-cards">
          <div class="card giveaway-card">
            <div class="giveaway-card-top">
              <h3>Spring Local Legend Giveaway</h3>
              <span class="status status--live">Active</span>
            </div>
            <p>Sponsored by <strong>La Luna Café</strong> — $50 gift card</p>
            <div class="giveaway-meta">
              <span>127 entries</span>
              <span>Ends in 6 days</span>
            </div>
          </div>
          <div class="card giveaway-card">
            <div class="giveaway-card-top">
              <h3>Home Services Bundle</h3>
              <span class="status status--draft">Draft</span>
            </div>
            <p>Sponsored by <strong>605 Drain Solutions</strong> + <strong>Redstone Electric</strong></p>
            <div class="giveaway-meta">
              <span>Not yet published</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ── NEWSLETTER ── -->
      <section class="tab-panel" id="panel-newsletter">
        <div class="panel-header-row">
          <div>
            <h1>Newsletter</h1>
            <p class="panel-sub">Auto-drafts from recent articles — you review and send in MailerLite, nothing sends automatically.</p>
          </div>
        </div>

        <div class="card newsletter-card">
          <div class="newsletter-field">
            <label for="newsletter-frequency">How often should a draft be generated?</label>
            <select id="newsletter-frequency">
              <option value="weekly" selected={newsletterConfig.frequency === 'weekly'}>Weekly</option>
              <option value="biweekly" selected={newsletterConfig.frequency === 'biweekly'}>Every 2 weeks</option>
              <option value="monthly" selected={newsletterConfig.frequency === 'monthly'}>Monthly</option>
            </select>
          </div>

          <div class="newsletter-meta">
            <span>Last generated:</span>
            <strong id="newsletter-last-generated">
              {newsletterConfig.lastGeneratedAt
                ? new Date(newsletterConfig.lastGeneratedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
                : 'Never yet'}
            </strong>
          </div>

          <div class="newsletter-actions">
            <button class="button" id="newsletter-generate-now">Generate Draft Now</button>
            <p class="newsletter-status" id="newsletter-status" hidden></p>
          </div>
        </div>
      </section>

    </main>

    <!-- Mobile bottom nav -->
    <nav class="admin-bottomnav">
      <button class="bottomnav-item is-active" data-tab="dashboard">
        <span><Icon name="dashboard" size={20} /></span> Home
      </button>
      <button class="bottomnav-item" data-tab="content-engine">
        <span><Icon name="edit" size={20} /></span> Content
      </button>
      <button class="bottomnav-item" data-tab="schedule">
        <span><Icon name="clock" size={20} /></span> Schedule
      </button>
      <button class="bottomnav-item" data-tab="events">
        <span><Icon name="sparkles" size={20} /></span> Events
      </button>
      <button class="bottomnav-item bottomnav-more" id="bottomnav-more" type="button">
        <span><Icon name="layers" size={20} /></span> More
      </button>
    </nav>
  </div>

  <script type="application/json" id="article-index-data" set:html={JSON.stringify(articleIndexForEngine)}></script>
  <PublishTracker />
</BaseLayout>

<style>
  .admin-shell {
    display: grid;
    grid-template-columns: 15rem 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas: "topbar topbar" "sidebar main";
    min-height: 100vh;
    background: var(--color-surface);
  }
  .admin-topbar {
    grid-area: topbar;
    background: var(--color-navy);
    color: #fff;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.5rem var(--space-3);
  }
  .admin-logo-link { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .admin-logo-img { height: 4.8rem; width: auto; filter: brightness(0) invert(1); display: block; }
  .admin-logo-link em { font-style: normal; opacity: 0.6; font-weight: 400; font-size: 0.875rem; color: #fff; padding-top: 0.15rem; }
  .admin-avatar {
    width: 2.2rem; height: 2.2rem; border-radius: 50%;
    background: var(--color-orange); color: #fff; border: none;
    font-weight: 700; font-size: 0.8125rem; cursor: pointer;
  }

  .admin-hamburger {
    display: none; flex-direction: column; justify-content: center; gap: 4px;
    width: 2.4rem; height: 2.4rem; background: none; border: none; cursor: pointer; flex-shrink: 0;
  }
  .admin-hamburger span { display: block; width: 1.4rem; height: 2px; background: #fff; border-radius: 2px; }

  .admin-sidebar-backdrop {
    display: none; position: fixed; inset: 0; background: rgba(13,23,48,0.5); z-index: 40;
    opacity: 0; visibility: hidden; transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .admin-sidebar-backdrop.is-open { opacity: 1; visibility: visible; }

  .admin-sidebar { grid-area: sidebar; background: #fff; border-right: 1px solid var(--color-line); padding: var(--space-2); }
  .admin-sidebar nav { display: flex; flex-direction: column; gap: 0.15rem; }
  .nav-item, .queue-item, .bottomnav-item { font-family: var(--font-body); }
  .nav-item {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.7rem 0.85rem; border-radius: var(--radius);
    background: none; border: none; border-left: 3px solid transparent; text-align: left;
    font-size: 0.9375rem; font-weight: 600; color: var(--color-navy-light);
    cursor: pointer; transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .nav-item:hover { background: var(--color-surface); color: var(--color-navy); }
  .nav-item.is-active { background: #FEF3E2; color: var(--color-orange-dark); border-left-color: var(--color-orange); }
  .nav-icon { font-size: 1.1rem; width: 1.2rem; text-align: center; display: inline-flex; }

  .admin-main { grid-area: main; padding: var(--space-3) var(--space-4) var(--space-6); overflow-x: hidden; }
  .admin-main h1 { margin-bottom: 0.2rem; }
  .panel-sub { color: var(--color-navy-light); margin: 0 0 var(--space-3); }
  .panel-header-row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--space-2); }

  .tab-panel { display: none; }
  .tab-panel.is-active { display: block; }

  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-3); }
  .stat-card {
    background: #fff; border: 1px solid var(--color-line); border-radius: 0.9rem; padding: 1.2rem;
    display: flex; flex-direction: column; gap: 0.5rem; position: relative; overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .stat-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(13,23,48,0.08); }
  .stat-card--accent { border-color: var(--color-orange); background: linear-gradient(160deg, #fff 60%, #FFF3E0 100%); }
  .stat-icon {
    width: 2.2rem; height: 2.2rem; border-radius: 0.6rem; background: var(--color-surface); color: var(--color-navy-light);
    display: flex; align-items: center; justify-content: center; margin-bottom: 0.2rem;
  }
  .stat-icon--accent { background: var(--color-orange); color: #fff; }
  .stat-number { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--color-navy); line-height: 1; }
  .stat-label { font-size: 0.8125rem; color: var(--color-navy-light); font-weight: 500; }

  .section-heading { margin-top: var(--space-4); font-size: 1.1875rem; }
  .section-heading-sub { font-size: 0.75rem; font-weight: 500; color: var(--color-navy-light); text-transform: none; margin-left: 0.6rem; }
  .traffic-status { font-size: 0.875rem; color: var(--color-navy-light); margin: 0.6rem 0 1.5rem; }
  .traffic-status.is-error { color: #C0392B; }
  .activity-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .activity-list li { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); padding: 0.75rem 1rem; font-size: 0.9375rem; display: flex; align-items: center; gap: 0.6rem; }
  .activity-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-line); flex-shrink: 0; }
  .activity-dot--new { background: var(--color-orange); }
  .activity-list time { margin-left: auto; font-size: 0.8125rem; color: var(--color-navy-light); white-space: nowrap; }
  .attention-link { margin-left: auto; font-size: 0.8125rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; white-space: nowrap; }
  .attention-link--btn { background: none; border: none; cursor: pointer; font-family: var(--font-body); }
  .stat-card--link { cursor: pointer; text-align: left; font-family: var(--font-body); }
  .stat-icon--mail { background: #FFF3E0; color: var(--color-orange-dark); }
  .attention-link:hover { text-decoration: underline; }

  /* Content Engine */
  .article-filters { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .article-filters .directory-search { flex: 1 1 16rem; }
  .article-filters select { padding: 0.6rem 0.7rem; border: 1px solid var(--color-line); border-radius: 0.55rem; font: inherit; background: #fff; }
  .link-button { background: none; border: 0; padding: 0; font: inherit; color: var(--color-orange-dark); font-weight: 700; cursor: pointer; }
  .gsc-widget { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-2) var(--space-3); margin-top: var(--space-2); }
  .gsc-widget-header { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .gsc-widget-header h3 { font-size: 0.9375rem; margin: 0; flex: 1; display: flex; align-items: center; gap: 0.5rem; }
  .gap-queue-section { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-2) var(--space-3); margin-top: var(--space-2); }
  .gap-queue-section h3 { font-size: 0.9375rem; margin-bottom: 0.2rem; }
  .gap-note { font-size: 0.8125rem; color: var(--color-navy-light); margin: 0 0 var(--space-2); }
  .gap-queue-list { display: flex; flex-direction: column; gap: 0.4rem; }

  .panel-note { font-size: 0.8125rem; color: var(--color-navy-light); margin: 0.3rem 0 0.9rem; }
  .pending-drafts-list { display: flex; flex-direction: column; gap: 0.7rem; margin-bottom: var(--space-4); }
  .pending-draft-card { display: flex; justify-content: space-between; gap: 1rem; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); padding: 1rem 1.2rem; }
  .pending-draft-meta { font-size: 0.75rem; color: var(--color-navy-light); margin: 0.2rem 0 0.4rem; }
  .pending-draft-excerpt { font-size: 0.8125rem; color: var(--color-navy-light); margin: 0; max-width: 42rem; }
  .pending-draft-actions { display: flex; flex-direction: column; gap: 0.5rem; flex-shrink: 0; }

  .articles-list { display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.8rem; max-height: 30rem; overflow-y: auto; }
  .article-row { display: flex; flex-direction: column; align-items: flex-start; text-align: left; background: #fff; border: 1px solid var(--color-line); border-radius: 0.5rem; padding: 0.6rem 0.9rem; cursor: pointer; width: 100%; }
  .article-row[hidden] { display: none; }
  .article-row:hover { border-color: var(--color-orange); }
  .article-row-title { font-weight: 600; font-size: 0.9rem; color: var(--color-navy); }
  .article-row-meta { font-size: 0.75rem; color: var(--color-navy-light); text-transform: capitalize; }
  .publish-date-field { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; font-size: 0.875rem; font-weight: 700; color: var(--color-navy); margin-bottom: 0.7rem; }
  .publish-date-field input { padding: 0.45rem 0.6rem; border: 1px solid var(--color-line); border-radius: 0.4rem; font-family: var(--font-body); }
  .publish-date-hint { font-weight: 500; font-size: 0.8125rem; color: var(--color-navy-light); }
  .ap-row { display: flex; gap: 1rem; flex-wrap: wrap; }
  .ap-slot { display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-start; }
  .ap-thumb { width: 10rem; height: 6rem; border-radius: 0.5rem; background: #EEF1F6 center/cover; border: 1px solid var(--color-line); }
  .ap-thumb--logo { width: 6rem; background-size: contain; background-repeat: no-repeat; background-color: #fff; }
  .ap-file { position: relative; overflow: hidden; font-size: 0.8rem !important; padding: 0.5rem 0.9rem !important; display: inline-flex !important; width: fit-content !important; text-transform: none !important; letter-spacing: normal !important; border-radius: 0.5rem !important; }
  .ap-gallery :global(.ap-note) { grid-column: 1 / -1; }
  .ap-file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .ap-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr)); gap: 0.5rem; margin: 0.8rem 0; }
  .ap-gallery :global(.ap-gthumb) { position: relative; aspect-ratio: 1; border-radius: 0.4rem; background: #EEF1F6 center/cover; }
  .ap-gallery :global(.ap-gthumb button) { position: absolute; top: 0.25rem; right: 0.25rem; font-size: 0.65rem; font-weight: 700; border: 0; border-radius: 0.3rem; padding: 0.15rem 0.35rem; background: rgba(13,23,48,0.75); color: #fff; cursor: pointer; }
  .ap-gallery :global(.ap-gthumb .ap-main) { top: auto; bottom: 0.25rem; }
  .ap-note { font-size: 0.8rem; color: var(--color-navy-light); margin: 0.4rem 0 0.8rem; }
  .pending-draft-thumb { width: 9rem; height: 5.1rem; object-fit: cover; border-radius: 0.45rem; flex-shrink: 0; background: #EEF1F6; }
  .pending-draft-thumb--none { display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: var(--color-navy-light); text-align: center; }
  @media (max-width: 40rem) { .pending-draft-thumb { display: none; } }
  .pending-draft-note { font-size: 0.8125rem; color: #B45309; font-weight: 600; margin: 0.3rem 0; }
  .pending-date { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; font-weight: 700; margin: 0.5rem 0 0; color: var(--color-navy); }
  .pending-date input { padding: 0.35rem 0.5rem; border: 1px solid var(--color-line); border-radius: 0.4rem; font-family: var(--font-body); }
  .dedupe-bar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin: 0.2rem 0 0.8rem; }
  .dedupe-note { font-size: 0.875rem; font-weight: 600; color: #2E7D4F; }
  .sched-chip { display: inline-block; margin-left: 0.5rem; font-size: 0.6875rem; font-weight: 700; padding: 0.12rem 0.5rem; border-radius: 999px; background: #DDE7F5; color: #3A5A8C; }
  .sponsor-chip {
    display: inline-flex; align-items: center; gap: 0.3rem; margin-left: 0.6rem;
    background: var(--color-gold, #F5B429); color: #1B2A4A; font-weight: 700; text-transform: none;
    padding: 0.15rem 0.55rem; border-radius: var(--radius-pill); font-size: 0.6875rem;
  }

  /* SPONSORSHIPS PANEL */
  .sponsor-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; margin: 1.2rem 0 1.8rem; }
  @media (max-width: 55rem) { .sponsor-stats { grid-template-columns: 1fr 1fr; } }
  .sponsor-stat { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); padding: 1.1rem; text-align: center; }
  .sponsor-stat--warn { border-color: #E9B44C; background: #FFF9EC; }
