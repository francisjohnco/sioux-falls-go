              <textarea id="spotlight-prompt" rows="5" placeholder="e.g. Write a press release announcing our new same-day service. Mention the giveaway happening this month."></textarea>
            </label>

            <div class="prompt-actions">
              <button class="button--link" id="save-standard-prompt-btn" type="button">Save as my standard prompt</button>
              <span class="prompt-save-status" id="prompt-save-status" hidden></span>
            </div>

            <button class="button" id="spotlight-generate-btn"><Icon name="sparkles" size={16} /> Generate Draft</button>
            <p class="engine-error" id="spotlight-error" hidden></p>
          </div>

          <div class="engine-workspace">
            <div class="engine-output" id="engine-output" hidden>
              <div class="output-header">
                <h4>Generated Draft</h4>
                <span class="badge badge--giveback">AI-assisted — review and edit before publishing</span>
              </div>
              <div class="output-image-preview" id="output-image-preview" hidden>
                <img id="output-image-preview-img" alt="Selected header image" />
                <p class="image-credit" id="output-image-credit"></p>
              </div>
              <label class="edit-field-full">Title <input type="text" id="output-title" /></label>
              <label class="edit-field-full">Body
                <textarea id="output-body" rows="12" class="edit-body-textarea"></textarea>
              </label>
              <div class="output-actions">
                <label class="publish-date-field">Go live on <input type="date" id="approve-date" /> <span class="publish-date-hint">Leave blank to publish today.</span></label>
                <button class="button" id="approve-btn">Approve &amp; Publish</button>
              </div>
              <p class="engine-error" id="publish-error" hidden></p>
              <p class="publish-success" id="publish-success" hidden></p>
            </div>
          </div>
        </div>

        <ProfileInterview businesses={businesses.map((b) => ({ slug: b.id, name: b.data.name })).sort((a, b) => a.name.localeCompare(b.name))} />
      </section>

      <!-- ── DRAFTS & ARTICLES ── -->
      <section class="tab-panel" id="panel-drafts">
        <h1>Drafts &amp; Articles</h1>
