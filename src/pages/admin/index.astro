              <label>Longitude <input type="number" step="any" id="edit-longitude" /></label>
              <label>Google Rating <input type="number" step="0.1" min="1" max="5" id="edit-googleRating" /></label>
              <label>Google Review Count <input type="number" id="edit-googleReviewCount" /></label>
              <label>Giveaways Per Year <input type="number" id="edit-giveawaysPerYear" /></label>
