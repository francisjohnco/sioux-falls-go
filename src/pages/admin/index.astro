  function renderAdminPhotos(data: any) {
    const bg = (el: string, url?: string) => { const n = document.getElementById(el); if (n) n.style.backgroundImage = url ? `url(${url})` : ''; };
    bg('ap-hero', data.heroImage); bg('ap-logo', data.logo);
    const g = document.getElementById('ap-gallery');
    if (g) g.innerHTML = (data.gallery || []).map((u: string) => `<div class="ap-gthumb" style="background-image:url('${u}')"><button type="button" data-ap-remove="${u}">Remove</button></div>`).join('') || '<p class="ap-note">No gallery photos yet.</p>';
  }
  function shrinkImage(file: File, max: number, png: boolean): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => { const k = Math.min(1, max / Math.max(img.width, img.height)); const c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k); c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height); resolve((png ? c.toDataURL('image/png') : c.toDataURL('image/jpeg', 0.85)).split(',')[1]); };
      img.onerror = () => reject(new Error('That file could not be read as an image.'));
      img.src = URL.createObjectURL(file);
    });
  }
  document.querySelectorAll<HTMLInputElement>('[data-ap]').forEach((input) => input.addEventListener('change', async () => {
