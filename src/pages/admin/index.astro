                  phone: business.data.phone || '',
                  website: business.data.website || '',
                  googleBusinessUrl: business.data.googleBusinessUrl || '',
                  heroImage: business.data.heroImage || '',
                  latitude: business.data.latitude ?? '',
                  longitude: business.data.longitude ?? '',
                  pullQuote: business.data.pullQuote || '',
                  ownerName: business.data.ownerName || '',
                  ownerRole: business.data.ownerRole || '',
                  logo: business.data.logo || '',
                  gallery: business.data.gallery || [],
                  ownerQuote: business.data.ownerQuote || '',
                  responseTime: business.data.responseTime || '',
                  googleRating: business.data.googleRating ?? '',
                  googleReviewCount: business.data.googleReviewCount ?? '',
                  giveawaysPerYear: business.data.giveawaysPerYear ?? 0,
                  hoursSchedule: business.data.hoursSchedule || {},
                  couponStyle: business.data.couponStyle || '',
