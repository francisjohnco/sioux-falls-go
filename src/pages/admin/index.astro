      </section>

      <!-- ── MAILER DEALS ── -->
      <section class="tab-panel" id="panel-mailer-deals">
        <div class="panel-header-row">
          <div>
            <h1>Mailer Deals</h1>
            <p class="panel-sub">Postcard-exclusive offers. Create one the moment a business actually pays for a spot — everything else (their redemption page, the Mailer Deals hub, their profile tab) builds itself from there.</p>
