    const t = e.target as HTMLElement;
    const rm = t.closest<HTMLElement>('[data-sp-remove]'), mk = t.closest<HTMLElement>('[data-sp-main]');
    const note = document.getElementById('sp-note')!;
    try {
      if (rm) { const out = await stayPhotoCall({ action: 'remove', url: rm.dataset.spRemove }); currentStayOriginal.gallery = out.gallery; }
      if (mk) { await stayPhotoCall({ action: 'make-main', url: mk.dataset.spMain }); currentStayOriginal.heroImage = mk.dataset.spMain; }
      if (rm || mk) { renderStayPhotos(currentStayOriginal); note.textContent = 'Saved.'; }
    } catch (err: any) { note.textContent = err.message; }
  });

  function closeStayEditModal() {
    stayModalBackdrop?.classList.remove('is-open');
    currentStaySlug = null;
    currentStayOriginal = null;
  }

  document.querySelectorAll('[data-open-stay]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-open-stay')!;
      const data = JSON.parse(btn.getAttribute('data-stay') || '{}');
      openStayEditModal(slug, data);
    });
  });

  document.getElementById('stay-edit-modal-close')?.addEventListener('click', closeStayEditModal);
  document.getElementById('stay-edit-cancel')?.addEventListener('click', closeStayEditModal);
  stayModalBackdrop?.addEventListener('click', (e) => { if (e.target === stayModalBackdrop) closeStayEditModal(); });

  document.getElementById('stay-edit-save')?.addEventListener('click', async () => {
    if (!currentStaySlug) return;
    const saveBtn = document.getElementById('stay-edit-save') as HTMLButtonElement;
    const updates: Record<string, unknown> = {};

    const fieldMap: Record<string, string> = {
      name: 'stay-edit-name', hostName: 'stay-edit-hostname', locationLabel: 'stay-edit-location',
      guestCapacityLabel: 'stay-edit-capacity', airbnbUrl: 'stay-edit-airbnb',
    };
    for (const [key, elId] of Object.entries(fieldMap)) {
      const el = document.getElementById(elId) as HTMLInputElement;
      if (el && el.value !== (currentStayOriginal[key] || '')) updates[key] = el.value;
    }
    const numberFieldMap: Record<string, string> = { bedrooms: 'stay-edit-bedrooms', bathrooms: 'stay-edit-bathrooms', amenityCount: 'stay-edit-amenity-count' };
    for (const [key, elId] of Object.entries(numberFieldMap)) {
      const el = document.getElementById(elId) as HTMLInputElement;
      const val = el.value === '' ? null : Number(el.value);
      const origVal = currentStayOriginal[key] === '' ? null : currentStayOriginal[key];
      if (val !== origVal) updates[key] = val;
    }

    const newAmenities = (document.getElementById('stay-edit-amenities') as HTMLTextAreaElement).value
      .split('\n').map((s) => s.trim()).filter(Boolean);
    if (JSON.stringify(newAmenities) !== JSON.stringify(currentStayOriginal.amenities || [])) {
      updates.amenities = newAmenities;
    }

    const newVerified = (document.getElementById('stay-edit-verified') as HTMLInputElement).checked;
    if (newVerified !== !!currentStayOriginal.verified) updates.verified = newVerified;

    const newTips = Array.from(document.querySelectorAll('#stay-edit-tips-list .tip-edit-row')).map((row) => ({
      tip: (row.querySelector('.tip-text-input') as HTMLInputElement).value.trim(),
      category: (row.querySelector('.tip-category-select') as HTMLSelectElement).value,
    })).filter((t) => t.tip);
    if (JSON.stringify(newTips) !== JSON.stringify(currentStayOriginal.insiderTips || [])) {
      updates.insiderTips = newTips;
    }

    if (Object.keys(updates).length === 0) {
      if (stayEditStatus) { stayEditStatus.textContent = 'No changes to save.'; stayEditStatus.hidden = false; stayEditStatus.className = 'edit-modal-status'; }
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/update-stay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: currentStaySlug, updates }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed');
      if (stayEditStatus) {
        stayEditStatus.textContent = 'Saved! Site will rebuild automatically.';
        stayEditStatus.className = 'edit-modal-status is-success';
        stayEditStatus.hidden = false;
      }
      setTimeout(closeStayEditModal, 1200);
    } catch (err: any) {
      if (stayEditStatus) {
        stayEditStatus.textContent = `Couldn't save: ${err.message}`;
        stayEditStatus.className = 'edit-modal-status is-error';
        stayEditStatus.hidden = false;
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });

  // DRAFTS & ARTICLES TAB
  document.getElementById('dedupe-drafts-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('dedupe-drafts-btn') as HTMLButtonElement;
    const note = document.getElementById('dedupe-note')!;
    if (!confirm('Keep the newest draft for each topic and remove the repeats? This cannot be undone.')) return;
    btn.disabled = true;
    try {
      const res = await fetch('/api/dedupe-pending-drafts', { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Cleanup failed');
      note.textContent = data.removed ? `Removed ${data.removed} repeat${data.removed === 1 ? '' : 's'}. ${data.kept} draft${data.kept === 1 ? '' : 's'} left to review.` : 'No repeats found.';
      note.hidden = false;
      loadPendingDrafts();
    } catch (err: any) { note.textContent = `Could not clean up: ${err.message}`; note.hidden = false; }
    finally { btn.disabled = false; }
  });

  async function loadPendingDrafts() {
    const listEl = document.getElementById('pending-drafts-list')!;
    const countEl = document.getElementById('pending-drafts-count')!;
    try {
      const res = await fetch('/api/list-pending-drafts');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not load pending drafts');

      const drafts = data.drafts || [];
      countEl.textContent = drafts.length > 0 ? `${drafts.length} WAITING` : '';

      if (drafts.length === 0) {
        listEl.innerHTML = '<p class="empty-note">Nothing waiting for review right now.</p>';
        return;
      }

      listEl.innerHTML = drafts
        .map(
          (d: any) => `
        <div class="pending-draft-card" data-id="${d.id}">
          ${d.draft?.heroImage ? `<img class="pending-draft-thumb" src="${d.draft.heroImage}${d.draft.heroImage.includes('?') ? '&' : '?'}w=320&h=180&fit=crop" alt="" loading="lazy" />` : '<div class="pending-draft-thumb pending-draft-thumb--none">No photo yet</div>'}
          <div style="flex:1">
            <strong>${d.draft?.title || '(untitled)'}</strong>
            <p class="pending-draft-meta">${d.categoryName} · ${d.contentType} · generated ${new Date(d.generatedAt).toLocaleDateString()}</p>
            <p class="pending-draft-excerpt">${(d.draft?.bodyMarkdown || '').slice(0, 200)}…</p>
            ${d.reviewNote ? `<p class="pending-draft-note">${d.reviewNote}</p>` : ''}
            <label class="pending-date">Go live on <input type="date" class="pending-date-input" data-id="${d.id}" value="${planNextSlot(scheduledDates, chicagoToday())}" /></label>
          </div>
          <div class="pending-draft-actions">
            <button class="button pending-publish-btn" data-id="${d.id}">Approve &amp; Schedule</button>
            <button class="button button--ghost pending-discard-btn" data-id="${d.id}">Discard</button>
          </div>
        </div>`
        )
        .join('');

      document.querySelectorAll('.pending-publish-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          const draftData = drafts.find((d: any) => d.id === id);
          if (!draftData) return;
          (btn as HTMLButtonElement).disabled = true;
          (btn as HTMLButtonElement).textContent = 'Publishing…';
          try {
            const res = await fetch('/api/publish-draft', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                draft: draftData.draft,
                categorySlug: draftData.categorySlug,
                contentType: draftData.contentType,
                pendingDraftId: id,
                slug: draftData.slug,
                relatedBusinesses: draftData.relatedBusinesses,
                cluster: draftData.cluster,
                clusterRole: draftData.clusterRole,
                publishDate: (document.querySelector(`.pending-date-input[data-id="${id}"]`) as HTMLInputElement | null)?.value || undefined,
              }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Publish failed');
            if (data.publishDate) scheduledDates.push(data.publishDate);
            loadPendingDrafts();
          } catch (err: any) {
            alert(`Couldn't publish: ${err.message}`);
            (btn as HTMLButtonElement).disabled = false;
            (btn as HTMLButtonElement).textContent = 'Approve & Publish';
          }
        });
      });

      document.querySelectorAll('.pending-discard-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          if (!confirm('Discard this draft? This cannot be undone.')) return;
          await fetch('/api/discard-draft', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          loadPendingDrafts();
        });
      });
    } catch (err: any) {
      listEl.innerHTML = `<p class="empty-note">Couldn't load pending drafts: ${err.message}</p>`;
    }
  }

  // Only load once the Drafts tab is actually opened, not on every page load
  let pendingDraftsLoaded = false;
  document.querySelector('[data-tab="drafts"]')?.addEventListener('click', () => {
    if (!pendingDraftsLoaded) {
      pendingDraftsLoaded = true;
      loadPendingDrafts();
    }
  });

  // Article search — same pattern as the Directory search
  function filterArticles() {
    const query = (document.getElementById('article-search') as HTMLInputElement).value.toLowerCase();
    const cat = (document.getElementById('article-cat') as HTMLSelectElement).value;
    const st = (document.getElementById('article-status') as HTMLSelectElement).value;
    document.querySelectorAll('.article-row').forEach((row) => {
      const el = row as HTMLElement;
      el.hidden = !el.dataset.search?.includes(query) || (!!cat && el.dataset.cat !== cat) || (!!st && !el.dataset.status?.split(' ').includes(st));
    });
  }
  ['article-search', 'article-cat', 'article-status'].forEach((id) => document.getElementById(id)?.addEventListener('input', filterArticles));

  // Article edit modal
  const articleModalBackdrop = document.getElementById('article-edit-modal-backdrop');
  const articleEditStatus = document.getElementById('article-edit-status');
  let currentArticleSlug: string | null = null;
  let currentArticleOriginal: any = null;

  function openArticleEditModal(slug: string, data: any) {
    currentArticleSlug = slug;
    currentArticleOriginal = data;
    document.getElementById('article-edit-modal-title')!.textContent = `Edit: ${data.title}`;
    (document.getElementById('article-edit-title') as HTMLInputElement).value = data.title || '';
    (document.getElementById('article-edit-seo-title') as HTMLInputElement).value = data.seoTitle || '';
    (document.getElementById('article-edit-seo-description') as HTMLTextAreaElement).value = data.seoDescription || '';
    (document.getElementById('article-edit-body') as HTMLTextAreaElement).value = data.bodyMarkdown || '';
    (document.getElementById('article-edit-sponsor') as HTMLSelectElement).value = data.sponsoredBy || '';
    if (articleEditStatus) articleEditStatus.hidden = true;
    articleModalBackdrop?.classList.add('is-open');
  }

  function closeArticleEditModal() {
    articleModalBackdrop?.classList.remove('is-open');
    currentArticleSlug = null;
    currentArticleOriginal = null;
  }

  document.querySelectorAll('[data-open-article]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-open-article')!;
      const data = JSON.parse(btn.getAttribute('data-article') || '{}');
      openArticleEditModal(slug, data);
    });
  });

  document.getElementById('article-edit-modal-close')?.addEventListener('click', closeArticleEditModal);
  document.getElementById('article-edit-cancel')?.addEventListener('click', closeArticleEditModal);
  articleModalBackdrop?.addEventListener('click', (e) => { if (e.target === articleModalBackdrop) closeArticleEditModal(); });

  document.getElementById('article-edit-save')?.addEventListener('click', async () => {
    if (!currentArticleSlug) return;
    const saveBtn = document.getElementById('article-edit-save') as HTMLButtonElement;
    const updates: Record<string, unknown> = {};

    const fieldMap: Record<string, string> = {
      title: 'article-edit-title',
      seoTitle: 'article-edit-seo-title',
      seoDescription: 'article-edit-seo-description',
      bodyMarkdown: 'article-edit-body',
      sponsoredBy: 'article-edit-sponsor',
    };
    for (const [key, elId] of Object.entries(fieldMap)) {
      const el = document.getElementById(elId) as HTMLInputElement | HTMLTextAreaElement;
      if (el && el.value !== currentArticleOriginal[key]) updates[key] = el.value;
    }

    if (Object.keys(updates).length === 0) {
      if (articleEditStatus) { articleEditStatus.textContent = 'No changes to save.'; articleEditStatus.hidden = false; articleEditStatus.className = 'edit-modal-status'; }
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/update-article', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: currentArticleSlug, updates }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed');
      if (articleEditStatus) {
        articleEditStatus.textContent = 'Saved! Site will rebuild automatically.';
        articleEditStatus.className = 'edit-modal-status is-success';
        articleEditStatus.hidden = false;
      }
      setTimeout(closeArticleEditModal, 1200);
    } catch (err: any) {
      if (articleEditStatus) {
        articleEditStatus.textContent = `Couldn't save: ${err.message}`;
        articleEditStatus.className = 'edit-modal-status is-error';
        articleEditStatus.hidden = false;
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });

  // NEWSLETTER TAB
  const freqSelect = document.getElementById('newsletter-frequency') as HTMLSelectElement | null;
  freqSelect?.addEventListener('change', async () => {
    try {
      const res = await fetch('/api/update-newsletter-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ frequency: freqSelect.value }),
      });
      if (!res.ok) throw new Error((await res.json()).error || 'Failed to save');
    } catch (err: any) {
      alert(`Couldn't save frequency: ${err.message}`);
    }
  });

  const generateBtn = document.getElementById('newsletter-generate-now') as HTMLButtonElement | null;
  const newsletterStatus = document.getElementById('newsletter-status');
  const lastGeneratedEl = document.getElementById('newsletter-last-generated');
  generateBtn?.addEventListener('click', async () => {
    generateBtn.disabled = true;
    generateBtn.textContent = 'Generating…';
    if (newsletterStatus) newsletterStatus.hidden = true;
    try {
      const res = await fetch('/api/generate-newsletter', { method: 'POST' });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Generation failed');
      if (newsletterStatus) {
        newsletterStatus.textContent = `Draft created from ${data.articleCount} recent article(s) — review and send it in MailerLite.`;
        newsletterStatus.classList.remove('is-error');
        newsletterStatus.classList.add('is-success');
        newsletterStatus.hidden = false;
      }
      if (lastGeneratedEl) {
        lastGeneratedEl.textContent = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
      }
    } catch (err: any) {
      if (newsletterStatus) {
        newsletterStatus.textContent = `Couldn't generate: ${err.message}`;
        newsletterStatus.classList.remove('is-success');
        newsletterStatus.classList.add('is-error');
        newsletterStatus.hidden = false;
      }
    } finally {
      generateBtn.disabled = false;
      generateBtn.textContent = 'Generate Draft Now';
    }
  });
</script>
