  .edit-field-full { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }
  .sponsor-field {
    background: #FFF7E2; border: 1.5px solid #E9D9A8; border-radius: var(--radius); padding: 0.8rem 0.9rem;
  }
  .sponsor-field-label { display: flex; align-items: center; gap: 0.4rem; font-weight: 700; color: #5A4A1E; font-size: 0.875rem; }
  .sponsor-field-hint { font-weight: 500; color: #8a7647; font-size: 0.75rem; }
  #article-edit-sponsor {
    margin-top: 0.5rem; padding: 0.6rem 0.8rem; border-radius: 0.5rem; border: 1px solid var(--color-line);
    font-family: var(--font-body); font-size: 0.9375rem; background: #fff;
  }
  .coupon-style-field {
    background: #EAF2F8; border: 1.5px solid #C6DCEC; border-radius: var(--radius); padding: 0.8rem 0.9rem;
  }
  .coupon-style-label { display: flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--color-river, #2E6F9E); font-size: 0.875rem; }
  .coupon-style-hint { font-weight: 500; color: #5f88a3; font-size: 0.75rem; }
  #edit-couponStyle {
    margin-top: 0.5rem; padding: 0.6rem 0.8rem; border-radius: 0.5rem; border: 1px solid var(--color-line);
    font-family: var(--font-body); font-size: 0.9375rem; background: #fff; width: 100%;
  }
  .edit-section-heading { font-size: 0.9375rem; margin: 1.2rem 0 0.7rem; padding-top: 0.9rem; border-top: 1px solid var(--color-line); }
  .edit-hours-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.7rem; margin-bottom: 0.5rem; }
  @media (max-width: 40rem) { .edit-hours-grid { grid-template-columns: repeat(2, 1fr); } .edit-field-grid { grid-template-columns: 1fr; } }
  .edit-body-textarea { width: 100%; font-family: var(--font-body); }
  .edit-modal-footer { display: flex; justify-content: flex-end; gap: 0.7rem; padding: 1.1rem 1.5rem; border-top: 1px solid var(--color-line); }
  .button--ghost { background: var(--color-surface); color: var(--color-navy); }
  .edit-modal-status { font-size: 0.8125rem; font-weight: 600; margin: 0.8rem 0 0; }
  .edit-modal-status.is-success { color: var(--color-success); }
  .edit-modal-status.is-error { color: #C0392B; }

  .button--danger { background: #fff; border: 1.5px solid #D9534F; color: #D9534F; }
  .button--danger:hover { background: #FBEAEA; }
  .edit-modal-footer-right { display: flex; gap: 0.7rem; }
  /* ── Admin design system: one layer every tab shares, including rows added by script ── */
  .admin-main input[type=text], .admin-main input[type=search], .admin-main input[type=email], .admin-main input[type=url],
  .admin-main input[type=number], .admin-main input[type=date], .admin-main input[type=tel], .admin-main input:not([type]),
  .admin-main select, .admin-main textarea {
    padding: 0.62rem 0.8rem; border: 1px solid #CBD3E0; border-radius: 0.6rem; background: #fff; font: inherit; font-size: 0.92rem;
    color: var(--color-ink); transition: border-color 0.15s, box-shadow 0.15s; max-width: 100%;
  }
  .admin-main input:focus, .admin-main select:focus, .admin-main textarea:focus { outline: none; border-color: var(--color-orange); box-shadow: 0 0 0 3px rgba(240,126,35,0.18); }
  .admin-main .directory-search, .admin-main .search-input { border-radius: 99px !important; padding-left: 1.1rem !important; min-height: 2.75rem; }

  .admin-main .button--ghost { border: 1.5px solid #D5DCE7; background: #fff; color: var(--color-navy); }
  .admin-main .button--ghost:hover { border-color: var(--color-orange); color: var(--color-orange-dark); background: #FFF8F1; }

  /* Cards */
  .admin-main .gsc-widget, .admin-main .gap-queue-section, .admin-main .pending-draft-card, .admin-main .biz-table, .admin-main .hp, .admin-main .cm {
    border-radius: 1rem; box-shadow: 0 4px 18px rgba(27,42,74,0.05);
  }
  .admin-main .gap-queue-section { padding: 1.1rem 1.3rem; border-left: 4px solid #1baf7a; }

  /* Content Engine priority queue */
  .gap-queue-list { gap: 0.55rem !important; }
  .gap-item { display: grid; grid-template-columns: 2.2rem 1fr auto; align-items: center; gap: 0.8rem; padding: 0.75rem 0.9rem;
    background: #fff; border: 1px solid var(--color-line); border-radius: 0.8rem; border-left: 4px solid var(--rank, #2a78d6); transition: box-shadow 0.15s; }
  .gap-item:hover { box-shadow: 0 6px 18px rgba(27,42,74,0.08); }
  .gap-item:nth-child(1) { --rank: #F07E23; } .gap-item:nth-child(2) { --rank: #eda100; } .gap-item:nth-child(3) { --rank: #1baf7a; } .gap-item:nth-child(4) { --rank: #2a78d6; } .gap-item:nth-child(5) { --rank: #6250d6; }
  .gap-rank { width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center; background: var(--rank, #2a78d6); color: #fff;
    font-family: var(--font-display); font-weight: 800; }
  .gap-item strong { color: var(--color-navy); font-size: 0.98rem; }
  .gap-item p { margin: 0.15rem 0 0; font-size: 0.82rem; color: var(--color-navy-light); }

  /* Pending drafts */
  .pending-draft-card { border-left: 4px solid #eda100 !important; }
  .pending-draft-note { background: #FFF4D6; padding: 0.3rem 0.6rem; border-radius: 0.4rem; display: inline-block; }

  /* Article list */
  .article-row { border-radius: 0.75rem !important; padding: 0.75rem 1rem !important; border-left: 4px solid #D5DCE7 !important; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
  .article-row:hover { border-left-color: var(--color-orange) !important; box-shadow: 0 6px 18px rgba(27,42,74,0.08); transform: translateX(2px); }
  .article-row-title { font-weight: 700; color: var(--color-navy); }
  .article-row-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; margin-top: 0.25rem; font-size: 0.78rem; color: var(--color-navy-light); }
  .sched-chip { background: #FFF4D6; color: #8A6100; border-radius: 99px; padding: 0.1rem 0.55rem; font-weight: 700; }
  .sponsor-chip { background: #FDEBDD; color: #B4560B; border-radius: 99px; padding: 0.1rem 0.55rem; font-weight: 700; }

  /* Tables: Directory and Stays */
  .admin-main .biz-row--header { background: linear-gradient(90deg, #1B2A4A, #2E4470) !important; color: #fff !important; }
  .admin-main .biz-row--header a { color: #FFD9A8 !important; }
  .admin-main .biz-row:not(.biz-row--header):hover { background: #FAFBFD; }
  #panel-stays .biz-row { background: #fff; border: 1px solid var(--color-line); }
  #panel-stays .biz-row--header { border-radius: 1rem 1rem 0 0; }
  #panel-stays .biz-row:last-child { border-radius: 0 0 1rem 1rem; }
  .admin-main .biz-name--link { color: var(--color-navy); font-weight: 700; }
  .admin-main .biz-name--link:hover { color: var(--color-orange-dark); }

  /* Empty and loading states */
  .admin-main .empty-note { background: #fff; border: 1px dashed #CBD3E0; border-radius: 0.8rem; padding: 0.9rem 1rem; color: var(--color-navy-light); }

  /* Edit modals */
  .edit-modal { border-radius: 1.1rem !important; overflow: hidden; }
  .edit-modal-header { background: linear-gradient(100deg, #1B2A4A, #2E6F9E) !important; color: #fff !important; }
  .edit-modal-header h2 { color: #fff !important; }
  .edit-modal-close { color: #fff !important; }
</style>

<script>
  import { planNextSlot, chicagoToday } from '../../../netlify/functions/_shared/schedule.mts';
  const scheduledDates: string[] = JSON.parse(document.getElementById('schedule-data')?.dataset.dates || '[]');
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('.tab-panel');

  function activateTab(tabName: string) {
    panels.forEach((p) => p.classList.toggle('is-active', p.id === `panel-${tabName}`));
    document.querySelectorAll('.nav-item, .bottomnav-item').forEach((el) => {
      el.classList.toggle('is-active', (el as HTMLElement).dataset.tab === tabName);
    });
  }

  const urlTab = new URLSearchParams(window.location.search).get('tab');
  if (urlTab) activateTab(urlTab);

  tabs.forEach((btn) => {
    if (!btn.classList.contains('nav-item') && !btn.classList.contains('bottomnav-item')) return;
    btn.addEventListener('click', () => {
      activateTab((btn as HTMLElement).dataset.tab!);
      closeSidebarDrawer();
    });
  });

  // ── Mobile sidebar drawer ──
  const adminSidebar = document.getElementById('admin-sidebar');
  const sidebarBackdrop = document.getElementById('admin-sidebar-backdrop');
  function openSidebarDrawer() {
    adminSidebar?.classList.add('is-open');
    sidebarBackdrop?.classList.add('is-open');
  }
  function closeSidebarDrawer() {
    adminSidebar?.classList.remove('is-open');
    sidebarBackdrop?.classList.remove('is-open');
  }
  document.getElementById('admin-hamburger')?.addEventListener('click', openSidebarDrawer);
  document.getElementById('bottomnav-more')?.addEventListener('click', openSidebarDrawer);
  adminSidebar?.querySelectorAll('[data-tab]').forEach((el) => el.addEventListener('click', closeSidebarDrawer));
  sidebarBackdrop?.addEventListener('click', closeSidebarDrawer);

  // Any element with data-jump-tab (dashboard stat cards, attention items)
  // switches tabs in-page without a reload.
  document.querySelectorAll('[data-jump-tab]').forEach((el) => {
    el.addEventListener('click', () => activateTab((el as HTMLElement).dataset.jumpTab!));
  });

  // ── Sponsorships: jump straight to an article in Drafts & Articles ──
  document.querySelectorAll('[data-jump-to-article]').forEach((row) => {
    row.addEventListener('click', () => {
      const title = (row as HTMLElement).dataset.jumpToArticle!;
      activateTab('drafts');
      const search = document.getElementById('article-search') as HTMLInputElement;
      if (search) {
        search.value = title;
        search.dispatchEvent(new Event('input'));
        search.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  // ── Directory: search filter ──
  const directorySearch = document.getElementById('directory-search') as HTMLInputElement;
  const bizRows = document.querySelectorAll('#panel-directory .biz-row:not(.biz-row--header)');
  directorySearch?.addEventListener('input', () => {
    const q = directorySearch.value.trim().toLowerCase();
    bizRows.forEach((row) => {
      const el = row as HTMLElement;
      el.hidden = !!q && !el.dataset.search?.includes(q);
    });
  });

  // ── Directory: real save-to-GitHub on every field change ──
  const saveStatus = document.getElementById('directory-save-status');

  function showSaveStatus(message: string, isError = false) {
    if (!saveStatus) return;
    saveStatus.textContent = message;
    saveStatus.hidden = false;
    saveStatus.classList.toggle('is-error', isError);
    saveStatus.classList.toggle('is-success', !isError);
    if (!isError) setTimeout(() => { saveStatus.hidden = true; }, 3000);
  }

  async function saveBusinessField(slug: string, field: string, value: unknown, el: HTMLElement) {
    el.classList.add('is-saving');
    showSaveStatus(`Saving ${field}…`);
    try {
      const res = await fetch('/api/update-business', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, updates: { [field]: value } }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed');
      showSaveStatus(`Saved — this will go live on the next deploy.`);
    } catch (err: any) {
      showSaveStatus(`Couldn't save: ${err.message}. Check that GITHUB_TOKEN is configured in Netlify.`, true);
    } finally {
      el.classList.remove('is-saving');
    }
  }

  document.querySelectorAll('#panel-directory .tier-select').forEach((select) => {
    select.addEventListener('change', () => {
      const el = select as HTMLSelectElement;
      const slug = el.dataset.slug!;
      const value = el.value || null; // empty string means "None" — clear the field
      saveBusinessField(slug, 'partnershipTier', value, el);
    });
  });

  document.querySelectorAll('#panel-directory .toggle-switch input[type="checkbox"]').forEach((input) => {
    input.addEventListener('change', () => {
      const el = input as HTMLInputElement;
      const slug = el.dataset.slug!;
      const field = el.dataset.field!;
      saveBusinessField(slug, field, el.checked, el);
    });
  });

  // Place ID — save on blur, not every keystroke, and only if it actually changed
  document.querySelectorAll('.place-id-input').forEach((input) => {
    const el = input as HTMLInputElement;
    const originalValue = el.value;
    el.addEventListener('blur', () => {
      if (el.value === originalValue) return;
      const slug = el.dataset.slug!;
      saveBusinessField(slug, 'placeId', el.value.trim() || null, el);
    });
  });

  // Google Reviews sync — on-demand trigger
  const reviewsSyncBtn = document.getElementById('reviews-sync-btn');
  const reviewsSyncStatus = document.getElementById('reviews-sync-status');
  reviewsSyncBtn?.addEventListener('click', async () => {
    reviewsSyncBtn.setAttribute('disabled', 'true');
    reviewsSyncBtn.textContent = 'Syncing…';
    if (reviewsSyncStatus) { reviewsSyncStatus.hidden = false; reviewsSyncStatus.textContent = 'Contacting Google — this can take a moment for 18 businesses...'; }
    try {
      const res = await fetch('/api/sync-google-reviews', { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Sync failed');
      const { summary } = data;
      if (reviewsSyncStatus) {
        reviewsSyncStatus.textContent = `Done — ${summary.updated} updated, ${summary.skipped} skipped (no Place ID), ${summary.errors.length} errors.`;
      }
    } catch (err: any) {
      if (reviewsSyncStatus) reviewsSyncStatus.textContent = `Sync failed: ${err.message}`;
    } finally {
      reviewsSyncBtn.removeAttribute('disabled');
      reviewsSyncBtn.textContent = 'Sync Reviews Now';
    }
  });

  // Content engine queue selection
  document.querySelectorAll('.queue-item').forEach((item) => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.queue-item').forEach((i) => i.classList.remove('is-active'));
      item.classList.add('is-active');
      const name = (item as HTMLElement).dataset.business;
      const label = document.getElementById('engine-business-name');
      if (label && name) label.textContent = name;
      document.getElementById('engine-output')?.setAttribute('hidden', '');
    });
  });

  // Google Search Console connection
  async function refreshGscStatus() {
    const res = await fetch('/api/gsc-status');
    const data = await res.json();
    const tag = document.getElementById('gsc-status-tag')!;
    const note = document.getElementById('gsc-status-note')!;
    const connectBtn = document.getElementById('gsc-connect-btn')!;
    const disconnectBtn = document.getElementById('gsc-disconnect-btn')!;

    if (data.connected) {
      tag.removeAttribute('hidden');
      connectBtn.setAttribute('hidden', '');
      disconnectBtn.removeAttribute('hidden');
      note.textContent = `Connected since ${new Date(data.connectedAt).toLocaleDateString()}. Real search demand data is now factored into content priority below.`;
      loadSearchOpportunities();
    } else {
      tag.setAttribute('hidden', '');
      connectBtn.removeAttribute('hidden');
      disconnectBtn.setAttribute('hidden', '');
      note.textContent = 'Not connected — content priority is currently based on site coverage only. Connect to add real search demand data.';
    }
  }

  async function loadSearchOpportunities() {
    try {
      const res = await fetch('/api/gsc-fetch-opportunities');
      const data = await res.json();
      if (!res.ok) return;
      if (data.opportunities?.length) {
        const note = document.getElementById('gsc-status-note')!;
        note.textContent += ` Top search opportunity right now: "${data.opportunities[0].query}" (${data.opportunities[0].impressions} impressions, position ${data.opportunities[0].position}).`;
      }
    } catch {
      // Search Console fetch failing shouldn't break the rest of the dashboard
    }
  }

  document.getElementById('gsc-connect-btn')?.addEventListener('click', () => {
    window.location.href = '/api/gsc-auth-start';
  });
  document.getElementById('gsc-disconnect-btn')?.addEventListener('click', async () => {
    await fetch('/api/gsc-disconnect', { method: 'POST' });
    refreshGscStatus();
  });

  // Show a one-time confirmation if we just came back from the OAuth flow
  const gscParam = new URLSearchParams(window.location.search).get('gsc');
  if (gscParam === 'connected') {
    activateTab('content-engine');
  }

  refreshGscStatus();

  // Real search traffic for the Dashboard — only meaningful once GSC is
  // actually connected, so this fails gracefully rather than showing
  // broken/blank numbers if it isn't.
  async function loadSearchTraffic() {
    const trafficStatus = document.getElementById('traffic-status');
    try {
      const res = await fetch('/api/gsc-fetch-summary');
      const data = await res.json();
      if (!res.ok) {
        if (trafficStatus) {
          const notSetUp = data.error === 'Search Console not connected' || data.error === 'GSC_SITE_PROPERTY not configured';
          trafficStatus.textContent = notSetUp
            ? 'Waiting on Google. Search traffic shows here once Search Console is connected. The Analytics tab walks you through the three steps.'
            : `Google did not answer this time (${data.error}). It usually clears on the next refresh.`;
          trafficStatus.className = notSetUp ? 'traffic-status is-waiting' : 'traffic-status is-error';
          trafficStatus.hidden = false;
        }
        return;
      }
      const set = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.textContent = val; };
      set('traffic-clicks', data.clicks.toLocaleString());
      set('traffic-impressions', data.impressions.toLocaleString());
      set('traffic-ctr', `${data.ctr}%`);
      set('traffic-position', String(data.avgPosition));
    } catch (err: any) {
      if (trafficStatus) {
        trafficStatus.textContent = 'Search traffic could not load just now. Try a refresh in a minute.';
        trafficStatus.className = 'traffic-status is-error';
        trafficStatus.hidden = false;
      }
    }
  }
  loadSearchTraffic();


  let latestGaps: any[] = [];
  fetch('/content-gaps.json')
    .then((r) => r.json())
    .then((data) => {
      latestGaps = data.categories.filter((c: any) => c.priorityScore > 0);
      const list = document.getElementById('gap-queue-list')!;
      if (latestGaps.length === 0) {
        list.innerHTML = '<p class="empty-note">No urgent gaps right now — everything\'s covered. New categories with listings will jump here automatically.</p>';
        return;
      }
      list.innerHTML = latestGaps
        .slice(0, 5)
        .map(
          (g: any, i: number) => `
        <div class="gap-item">
          <span class="gap-rank">${i + 1}</span>
          <div>
            <strong>${g.name}</strong>
            <p>${g.reasons.join(' · ')}</p>
          </div>
          <button class="button button--ghost gap-generate-btn" data-slug="${g.slug}" data-name="${g.name}" data-type="${g.missingTypes?.[0] || 'local-resource'}">Generate</button>
        </div>`
        )
        .join('');

      document.querySelectorAll('.gap-generate-btn').forEach((btn) => {
        btn.addEventListener('click', function () {
          const el = this as HTMLElement;
          generateDraft({
            categorySlug: el.dataset.slug!,
            categoryName: el.dataset.name!,
            contentType: el.dataset.type!,
          }, this as HTMLButtonElement).catch((err: any) => {
            alert(`Generation failed: ${err.message}`);
          });
        });
      });
    })
    .catch(() => {
      document.getElementById('gap-queue-list')!.innerHTML = '<p class="empty-note">Could not load gap report.</p>';
    });

  let currentDraft: any = null;

  const articleIndex: { title: string; slug: string; category: string; description: string }[] = JSON.parse(
    document.getElementById('article-index-data')?.textContent || '[]'
  );

  async function generateDraft(opts: { categorySlug: string; categoryName: string; contentType: string; interviewAnswers?: any[]; businessName?: string; direction?: string }, triggerBtn: HTMLButtonElement) {
    const outputEl = document.getElementById('engine-output')!;
    outputEl.setAttribute('hidden', '');

    const activeBtn = triggerBtn;
    const originalLabel = activeBtn?.innerHTML;
    if (activeBtn) { activeBtn.disabled = true; activeBtn.textContent = 'Starting…'; }

    try {
      // Step 1: kick off the background job — this returns almost
      // instantly with just a job ID, well clear of any timeout.
      const sameCategory = articleIndex.filter((a) => a.category === opts.categorySlug);
      const otherRelevant = articleIndex.filter((a) => a.category !== opts.categorySlug).slice(0, 15);
      const relevantExisting = [...sameCategory, ...otherRelevant];

      const startRes = await fetch('/api/start-generate-draft', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          categoryName: opts.categoryName,
          categorySlug: opts.categorySlug,
          contentType: opts.contentType,
          direction: opts.direction,
          interviewAnswers: opts.interviewAnswers,
          businessName: opts.businessName,
          existingArticles: relevantExisting,
        }),
      });
      const startText = await startRes.text();
      let startData: any;
      try {
        startData = JSON.parse(startText);
      } catch {
        throw new Error(`Server returned HTTP ${startRes.status} (not JSON): ${startText.slice(0, 200)}`);
      }
      if (!startRes.ok || !startData.jobId) throw new Error(startData.error || 'Could not start generation');

      // Step 2: poll every 2.5s for up to 2 minutes — the actual
      // generation runs in the background function, well within its
      // 15-minute budget, while this just checks in periodically.
      const jobId = startData.jobId;
      let job: any = null;
      for (let attempt = 0; attempt < 48; attempt++) {
        await new Promise((r) => setTimeout(r, 2500));
        if (activeBtn) activeBtn.textContent = `Generating${'.'.repeat((attempt % 3) + 1)}`;

        const pollRes = await fetch(`/api/check-draft-status?jobId=${jobId}`);
        const pollText = await pollRes.text();
        try {
          job = JSON.parse(pollText);
        } catch {
          throw new Error(`Status check returned HTTP ${pollRes.status} (not JSON): ${pollText.slice(0, 200)}`);
        }
        if (job.status === 'complete' || job.status === 'error') break;
      }

      if (!job || job.status === 'pending') throw new Error('Generation is taking longer than expected — check back in a minute, the job may still complete.');
      if (job.status === 'error') throw new Error(job.error || 'Generation failed');

      const data = { draft: job.draft };

      currentDraft = { draft: data.draft, categorySlug: opts.categorySlug, contentType: opts.contentType };
      (document.getElementById('output-title') as HTMLInputElement).value = data.draft.title;
      (document.getElementById('output-body') as HTMLTextAreaElement).value = data.draft.bodyMarkdown;

      const imgPreview = document.getElementById('output-image-preview')!;
      if (data.draft.heroImage) {
        (document.getElementById('output-image-preview-img') as HTMLImageElement).src = `${data.draft.heroImage}${data.draft.heroImage.includes('?') ? '&' : '?'}w=960&h=540&fit=crop`;
        (document.getElementById('output-image-preview-img') as HTMLImageElement).alt = data.draft.heroImageAlt || '';
        document.getElementById('output-image-credit')!.textContent = data.draft.heroImageCredit
          ? `Photo by ${data.draft.heroImageCredit.photographer} on ${data.draft.heroImageCredit.source || 'Unsplash'}`
          : '';
        imgPreview.hidden = false;
      } else {
        imgPreview.hidden = true;
      }

      outputEl.removeAttribute('hidden');
      outputEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } finally {
