                  <option value="community-champion" selected={business.data.partnershipTier === 'community-champion'}>Champion</option>
                </select>
              </span>
              <span>
                <label class="toggle-switch">
                  <input type="checkbox" data-field="showAddress" data-slug={business.id} checked={business.data.showAddress} />
