          <button class="button" id="open-create-deal-btn"><Icon name="mail" size={16} /> New Mailer Deal</button>
        </div>

        <p class="panel-sub">Deals businesses send in, Black Friday deals, and every other deal now live in the <button class="button--link" type="button" data-jump-tab="deals">Deals tab</button>.</p>

        <div class="sponsor-stats">
          <div class="sponsor-stat">
            <span class="sponsor-stat-num">{activeMailerCount}</span>
            <span class="sponsor-stat-label">Active mailer deals</span>
          </div>
          <div class="sponsor-stat">
            <span class="sponsor-stat-num">{mailerDealsWithBusiness.length - activeMailerCount}</span>
            <span class="sponsor-stat-label">Expired</span>
          </div>
          <div class="sponsor-stat">
            <span class="sponsor-stat-num">{verifiedBusinesses.length}</span>
            <span class="sponsor-stat-label">Verified businesses eligible</span>
          </div>
        </div>

        {mailerDealsWithBusiness.length === 0 ? (
          <p class="empty-note">No mailer deals yet — create the first one once a business books a spot.</p>
        ) : (
          <div class="mailer-deal-list">
            {mailerDealsWithBusiness.map(({ deal, business, isExpired, isScheduled }) => (
              <div class={`mailer-deal-row ${isExpired ? 'mailer-deal-row--expired' : ''}`}>
                <div>
                  <span class="mailer-deal-biz">{business?.data.name ?? deal.data.business.id}</span>
                  <span class="mailer-deal-title">{deal.data.title}</span>
                  <span class="mailer-deal-meta">
                    {deal.data.mailerCampaign} mailing
                    {deal.data.expiresAt && ` · ${isExpired ? 'expired' : 'expires'} ${deal.data.expiresAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`}
                    {isScheduled && deal.data.activatesAt && ` · starts ${deal.data.activatesAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`}
                  </span>
                </div>
                <div class="mailer-deal-row-right">
                  {isExpired ? (
                    <span class="match-badge match-badge--warn">Expired</span>
                  ) : isScheduled ? (
                    <span class="match-badge match-badge--scheduled">Scheduled</span>
                  ) : (
                    <span class="match-badge match-badge--ok">Active</span>
                  )}
                  <a href={`/mailer-deals/${business?.id}`} target="_blank" class="mailer-deal-view-btn">View</a>
                  <button
                    class="mailer-deal-edit-btn"
                    data-open-deal-edit={deal.id}
                    data-deal={JSON.stringify({
                      business: deal.data.business.id,
                      title: deal.data.title,
                      description: deal.data.description,
                      discountType: deal.data.discountType,
                      spotSize: deal.data.spotSize ?? 'medium',
                      mailerCampaign: deal.data.mailerCampaign,
                      activatesAt: deal.data.activatesAt ? deal.data.activatesAt.toISOString().split('T')[0] : '',
                      expiresAt: deal.data.expiresAt ? deal.data.expiresAt.toISOString().split('T')[0] : '',
                      terms: deal.data.terms ?? '',
                    })}
                  >
                    Edit
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
