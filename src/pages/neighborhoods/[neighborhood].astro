---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import LayeredHero from '../../components/LayeredHero.astro';

export async function getStaticPaths() {
  const neighborhoods = await getCollection('neighborhoods');
  return neighborhoods.map((neighborhood) => ({
    params: { neighborhood: neighborhood.data.slug },
    props: { neighborhood },
  }));
}

const { neighborhood } = Astro.props;

const allBusinesses = await getCollection('businesses');
const businesses = allBusinesses.filter((b) => b.data.neighborhood?.id === neighborhood.id);

const businessesWithCategory = await Promise.all(
  businesses.map(async (b) => ({ business: b, category: await getEntry(b.data.category) }))
);

const { Content } = await render(neighborhood);

const INITIAL_COUNT = 9;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${neighborhood.data.name} — Sioux Falls Go`,
};
---
<BaseLayout
  title={`${neighborhood.data.name} Neighborhood Guide`}
  description={neighborhood.data.summary}
  canonicalPath={`/neighborhoods/${neighborhood.data.slug}`}
  schema={schema}
>
  <SiteHeader slot="header" />

  <LayeredHero
    eyebrow="Neighborhood Guide"
    title={neighborhood.data.name}
    subtitle={neighborhood.data.summary}
    photoUrl={neighborhood.data.heroImage}
    centered
  >
    <nav class="hero-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/visit-sioux-falls">Explore Sioux Falls</a> / <span>{neighborhood.data.name}</span>
    </nav>
    {businesses.length > 0 && (
      <p class="hero-stats">{businesses.length} local business{businesses.length === 1 ? '' : 'es'} in this neighborhood</p>
    )}
  </LayeredHero>

  <div class="container page">
    <section class="neighborhood-story">
      <Content />
    </section>

    {businesses.length > 0 ? (
      <section aria-labelledby="biz-heading">
        <h2 id="biz-heading">Businesses in {neighborhood.data.name}</h2>
        <div class="grid neighborhood-business-grid">
          {businessesWithCategory.map(({ business }, i) => (
            <div class="grid-item" hidden={i >= INITIAL_COUNT}>
              <BusinessCard business={business} />
            </div>
          ))}
        </div>
        {businesses.length > INITIAL_COUNT && (
          <div class="see-more-wrap">
            <button class="button button--ghost" id="neighborhood-see-more">See more ({businesses.length - INITIAL_COUNT} more)</button>
          </div>
        )}
      </section>
    ) : (
      <div class="empty-state">
        <p>We haven't tagged businesses to {neighborhood.data.name} yet, but it's a real Sioux Falls neighborhood worth knowing about.</p>
        <a class="button" href="/get-featured">Know a great business here? Suggest them →</a>
      </div>
    )}
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  const btn = document.getElementById('neighborhood-see-more');
  btn?.addEventListener('click', () => {
    document.querySelectorAll('.neighborhood-business-grid .grid-item[hidden]').forEach((el) => {
      (el as HTMLElement).hidden = false;
    });
    (btn as HTMLElement).style.display = 'none';
  });
</script>

<style>
  .page { padding-block: var(--space-4) var(--space-6); }
  .hero-breadcrumbs { font-size: 0.875rem; color: rgba(255,255,255,0.75); margin-bottom: var(--space-2); }
  .hero-breadcrumbs a { color: inherit; text-decoration: underline; text-decoration-color: rgba(255,255,255,0.4); }
  .hero-breadcrumbs a:hover { text-decoration-color: currentColor; }
  .hero-stats { margin-top: var(--space-2); font-size: 0.9375rem; color: rgba(255,255,255,0.85); font-weight: 600; }
  .neighborhood-story { max-width: 42rem; margin: 0 auto var(--space-5); font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  @media (max-width: 55rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .grid { grid-template-columns: 1fr; } }
  .see-more-wrap { text-align: center; margin-top: var(--space-4); }
  .empty-state { text-align: center; padding: var(--space-5) var(--space-3); background: var(--color-surface); border-radius: var(--radius); }
  .empty-state p { color: var(--color-navy-light); margin-bottom: var(--space-2); }
</style>
