---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Get Featured on Sioux Falls Go',
};

const benefits = [
  {
    number: '01',
    title: "We're In Your Corner",
    body: "National chains can buy their way to the top of a search result. You can't — you earn your reputation one customer at a time. Sioux Falls Go exists to make sure that reputation actually shows up when someone's looking for help, instead of getting buried under ad budgets you'll never match.",
  },
  {
    number: '02',
    title: 'A Real Interview, Not a Form',
    body: "Your profile isn't a template you fill out. If you're a fit, we'll set up a short call to actually talk — what you do, what makes you different, what you're proud of. That conversation becomes your profile, written the way you'd describe your own business to a neighbor.",
  },
  {
    number: '03',
    title: 'We Promote You For Free',
    body: "Your profile lives in the directory, gets surfaced in relevant guides and FAQs, and gets shared across our channels. It's a real page you can link from your own site and point customers to — not a locked listing you have to pay to keep visible.",
  },
  {
    number: '04',
    title: "What's In It For Us?",
    body: "Sioux Falls Go is run by SAJMedia, a local marketing agency. Every once in a while, a business we feature ends up becoming a client. Most of the time we just write your spotlight, promote it, and that's the whole relationship. If we spot something that could clearly help you grow, we'll mention it — but your spotlight runs whether you ever hire us or not.",
  },
];

const championBenefits = [
  { icon: 'megaphone', label: 'A real Spotlight article written about your business' },
  { icon: 'newspaper', label: 'Monthly press release' },
  { icon: 'edit', label: 'Content sponsorship included' },
  { icon: 'rocket', label: 'RankAPro included' },
  { icon: 'clipboard', label: 'Event listing' },
  { icon: 'gift', label: 'Up to 4 giveaway campaigns a year' },
  { icon: 'zap', label: 'Instant quote requests, right from your profile' },
];
---
<BaseLayout
  title="Get Featured"
  description="Sioux Falls Go is invite-only. See what Basic Listing, Give Back Partner, and Community Champion each include, and apply for consideration."
  canonicalPath="/get-featured"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Apply for Consideration</span>
      <h1>Get Featured on Sioux Falls Go</h1>
      <p class="hero-sub">
        We don't list every business in Sioux Falls. We recommend the ones
        that have earned their community's trust — and we build every
        profile from a real conversation, not a form you fill out alone.
      </p>
    </div>
  </section>

  <div class="container page">
    <section class="tiers-section">
      <span class="eyebrow">Three Ways to Be Featured</span>
      <h2>Every real listing gets a real profile. Champions get a lot more.</h2>

      <div class="tiers-grid">
        <div class="tier-card">
          <h3>Basic Listing</h3>
          <p class="tier-tagline">Your real profile in the directory</p>
          <ul class="tier-list">
            <li><Icon name="check" size={15} /> Full business profile</li>
            <li><Icon name="check" size={15} /> Real hours, contact, story</li>
            <li><Icon name="check" size={15} /> Reviews shown on your page</li>
            <li><Icon name="check" size={15} /> Instant quote requests</li>
          </ul>
        </div>

        <div class="tier-card">
          <h3>Give Back Partner</h3>
          <p class="tier-tagline">For businesses that show up for this community</p>
          <ul class="tier-list">
            <li><Icon name="check" size={15} /> Everything in Basic Listing</li>
            <li><Icon name="check" size={15} /> Give Back Partner badge on your profile</li>
            <li><Icon name="check" size={15} /> Up to 2 giveaway campaigns a year</li>
          </ul>
        </div>

        <div class="tier-card tier-card--champion">
          <span class="tier-badge-pill">Most Visibility</span>
          <h3>Community Champion</h3>
          <p class="tier-tagline">More visibility. More traffic. More business.</p>
          <ul class="tier-list tier-list--champion">
            <li><Icon name="check" size={15} /> Everything in Give Back Partner</li>
            {championBenefits.map((b) => (
              <li><Icon name={b.icon} size={15} /> {b.label}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="benefits-section">
      <span class="eyebrow">Why This Isn't Just Another Directory</span>
      <div class="benefits-list">
        {benefits.map((b) => (
          <div class="benefit-row">
            <span class="benefit-number">{b.number}</span>
            <div>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="qualify-section">
      <span class="eyebrow">Before You Apply</span>
      <h2>To be eligible, your business must be:</h2>
      <div class="qualify-grid">
        <div class="qualify-item card">
          <h3><Icon name="pin" size={20} /> Locally Owned</h3>
          <p>Serving the Sioux Falls area. Online-only businesses aren't eligible.</p>
        </div>
        <div class="qualify-item card">
          <h3><Icon name="star" size={20} /> Highly Rated</h3>
          <p>An active Google Business Profile at <strong>4.8 stars or higher</strong> — a real qualification, not a suggestion.</p>
        </div>
        <div class="qualify-item card">
          <h3><Icon name="handshake" size={20} /> Willing to Give Back</h3>
          <p>Open to participating in up to two community giveaways a year, when it fits both sides.</p>
        </div>
        <div class="qualify-item card">
          <h3><Icon name="check" size={20} /> Ready for New Customers</h3>
          <p>Actively open and able to take on more clients right now.</p>
        </div>
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="apply-section">
      <span class="eyebrow">Tell Us About Your Business</span>
      <h2>Apply Now</h2>
      <p class="apply-sub">
        If it looks like a fit, we'll reach out to set up a quick call and
        get your spotlight started.
      </p>

      <form name="get-featured" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="apply-form">
        <input type="hidden" name="form-name" value="get-featured" />
        <p class="honeypot-field">
          <label>Don't fill this out if you're human: <input name="not_human" /></label>
        </p>

        <div class="form-row">
          <label>
            First name *
            <input type="text" name="first_name" required />
          </label>
          <label>
            Last name *
            <input type="text" name="last_name" required />
          </label>
        </div>
        <label>
          Business name *
          <input type="text" name="business_name" required />
        </label>
        <div class="form-row">
          <label>
            Email *
            <input type="email" name="email" required />
          </label>
          <label>
            Phone (optional)
            <input type="tel" name="phone" />
          </label>
        </div>
        <label>
          Website URL (optional)
          <input type="url" name="website" placeholder="https://" />
        </label>
        <button type="submit" class="button">Apply Now</button>
      </form>

      <p class="privacy-note">
        Your information stays private. We'll never spam you or sell your
        details. See our <a href="/privacy-policy">privacy policy</a>.
        We reply to every submission — but due to volume, getting featured
        isn't guaranteed.
      </p>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero { background: var(--color-navy); color: #fff; padding-block: var(--space-5); }
  .hero .eyebrow { color: var(--color-orange); }
  .hero h1 { color: #fff; margin-block: var(--space-1) var(--space-2); }
  .hero-sub { max-width: 46ch; color: rgba(255,255,255,0.85); font-size: 1.0625rem; }

  .page { padding-block: var(--space-5) var(--space-6); }

  .tiers-section { text-align: center; }
  .tiers-section h2 { font-size: 1.75rem; color: var(--color-navy); margin-top: 0.5rem; max-width: 40ch; margin-inline: auto; }
  .tiers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: var(--space-4); text-align: left; align-items: start; }
  @media (max-width: 55rem) { .tiers-grid { grid-template-columns: 1fr; } }

  .tier-card { background: #fff; border: 1.5px solid var(--color-line); border-radius: 1.1rem; padding: 1.6rem; }
  .tier-card h3 { font-size: 1.1875rem; color: var(--color-navy); margin-bottom: 0.3rem; }
  .tier-tagline { font-size: 0.875rem; color: var(--color-navy-light); margin: 0 0 1.2rem; min-height: 2.6rem; }
  .tier-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .tier-list li { display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.9rem; color: var(--color-navy); }
  .tier-list :global(svg) { color: var(--color-success); flex-shrink: 0; margin-top: 0.15rem; }

  .tier-card--champion {
    position: relative; border: 2px solid var(--color-orange);
    box-shadow: 0 16px 40px rgba(240,126,35,0.18);
    transform: scale(1.04);
  }
  @media (max-width: 55rem) { .tier-card--champion { transform: none; } }
  .tier-badge-pill {
    position: absolute; top: -0.9rem; left: 1.5rem;
    background: linear-gradient(120deg, var(--color-orange), var(--color-gold));
    color: #fff; font-weight: 800; font-size: 0.75rem; text-transform: uppercase;
    letter-spacing: 0.02em; padding: 0.35rem 0.9rem; border-radius: var(--radius-pill);
  }
  .tier-list--champion :global(svg) { color: var(--color-orange-dark); }

  .benefits-list { margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-3); }
  .benefit-row { display: grid; grid-template-columns: 3.5rem 1fr; gap: var(--space-2); }
  .benefit-number { font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; color: var(--color-orange); line-height: 1; }
  .benefit-row h3 { font-size: 1.125rem; margin-bottom: 0.35rem; }
  .benefit-row p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; max-width: 60ch; }

  .qualify-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--space-3); margin-top: var(--space-3); }
  .qualify-item h3 { display: flex; align-items: center; gap: 0.5rem; font-size: 1.0625rem; margin-bottom: 0.4rem; }
  .qualify-item h3 :global(svg) { color: var(--color-orange-dark); flex-shrink: 0; }
  .qualify-item p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }

  .contour-divider { height: 1px; background: var(--color-line); margin-block: var(--space-5); }

  .apply-sub { max-width: 55ch; color: var(--color-navy-light); }
  .apply-form { max-width: 30rem; margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }
  .honeypot-field { position: absolute; left: -9999px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .apply-form label { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 600; font-size: 0.9375rem; color: var(--color-navy); }
  .apply-form input {
    font-family: var(--font-body); font-size: 0.9375rem; font-weight: 400;
    padding: 0.65rem 0.85rem; border: 1.5px solid var(--color-line); border-radius: var(--radius);
  }
  .apply-form input:focus { border-color: var(--color-orange); outline: none; }
  .apply-form button { align-self: flex-start; margin-top: var(--space-1); }
  .privacy-note { max-width: 30rem; font-size: 0.8125rem; color: var(--color-navy-light); margin-top: var(--space-2); }

  @media (max-width: 32rem) {
    .form-row { grid-template-columns: 1fr; }
    .benefit-row { grid-template-columns: 2.5rem 1fr; }
  }
</style>
