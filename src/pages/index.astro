---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import EventsSection from '../components/EventsSection.astro';

const businesses = await getCollection('businesses');
// Only real, verified listings belong on the homepage spotlight — this is
// the site's most visible real estate, and showing an unverified business
// here undercuts the whole point of verification. Sorted most-recently
// verified first, so it also reflects genuinely current activity.
const spotlightBusinesses = businesses
  .filter((b) => b.data.heroImage && b.data.verifiedAt)
  .sort((a, b) => b.data.verifiedAt!.getTime() - a.data.verifiedAt!.getTime())
  .slice(0, 3);

function makeExcerpt(markdown: string, maxLen = 110): string {
  const plain = markdown
    .replace(/^#{1,6}\s+.*/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxLen) return plain;
  const cut = plain.slice(0, maxLen);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}

const spotlightWithCat = await Promise.all(
  spotlightBusinesses.map(async (b) => ({
    business: b,
    category: await getEntry(b.data.category),
    excerpt: makeExcerpt(b.body ?? ''),
  }))
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sioux Falls Go',
  url: 'https://siouxfallsgo.com',
};
---
<BaseLayout
  title="Sioux Falls' Guide to Trusted Local Businesses"
  description="Discover Sioux Falls' favorite local businesses — every one rated 4.8 stars or higher. Plus real local guides, giveaways, and deals for locals."
  canonicalPath="/"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="hero-photo"></div>
    <div class="hero-gradient"></div>
    <div class="hero-gradient-bottom"></div>
    <div class="container hero-inner">
      <span class="hero-eyebrow-text">Locals&rsquo; Favorite Places</span>
      <h1>Explore and Experience Sioux Falls Like a Local</h1>
      <p class="hero-sub">Discover hidden gems, support local businesses, and find more reasons to love Sioux Falls. A hand-picked guide to the places locals know and love.</p>
      <div class="hero-actions">
        <a class="btn-primary" href="/businesses">Explore Sioux Falls</a>
        <a class="btn-secondary" href="/get-featured">Get Featured</a>
      </div>
    </div>
    <div class="scroll-cue">
      Explore Sioux Falls
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
  </section>

  <section class="about" id="about">
    <div class="container">
      <div class="about-grid">
        <h2>What Is Sioux Falls Go?</h2>
        <div class="about-photo-wrap">
          <img src="/images/businesses/la-luna-cafe.jpg" alt="A local Sioux Falls coffee shop storefront at golden hour, welcoming customers in" class="about-photo" />
          <span class="about-photo-caption">La Luna Cafe &mdash; one of the local businesses on Sioux Falls Go</span>
        </div>
        <div class="about-copy" id="about-copy">
          <p>Sioux Falls Go helps locals discover trusted businesses, local favorites, special offers, and giveaways&mdash;all while supporting the businesses that make our community great.</p>
          <p>We hand-pick trusted local businesses and introduce them to more people through business spotlights, local content, special offers, and giveaways. Because the best businesses in Sioux Falls aren&rsquo;t always the ones with the biggest advertising budgets.</p>
          <div class="about-more">
            <p>They&rsquo;re often the ones quietly doing great work, earning trust, supporting their customers, and making an impact in our community. They shouldn&rsquo;t have to compete with deep pockets just to keep doing what they do best.</p>
            <p class="pull">When local businesses win, our community wins.</p>
            <p>Our listings are free, but invitation-only. That means you&rsquo;re not seeing who paid the most to be here. You&rsquo;re discovering business owners who value quality, honesty, and community&mdash;and who are helping build our local economy.</p>
            <p>Sioux Falls Go is building a stronger Sioux Falls, one local business at a time.</p>
          </div>
        </div>
        <button class="about-toggle" id="aboutToggle" aria-expanded="false">Read more</button>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <span class="eyebrow">Recently Verified</span>
      <h2>Real local businesses, checked by our team</h2>
      <div class="spotlight-grid">
        {spotlightWithCat.map(({ business, category, excerpt }) => (
          <a class="spot-card" href={`/businesses/${business.id}`}>
            <div class="spot-media" style={`background-image: url(${business.data.heroImage})`}>
              <span class="spot-badge">
                {business.data.partnershipTier === 'community-champion' ? <><Icon name="star" size={12} /> Community Champion</> : category.data.name}
              </span>
            </div>
            <div class="spot-body">
              <h3>{business.data.name}</h3>
              {business.data.googleRating && <p class="spot-rating"><Icon name="star" size={13} class="filled-star" /> {business.data.googleRating.toFixed(1)} {business.data.googleReviewCount && `(${business.data.googleReviewCount} reviews)`}</p>}
              <p class="spot-excerpt">{excerpt}</p>
              <span class="spot-readmore">Read more →</span>
            </div>
          </a>
        ))}
      </div>
      <a class="view-all" href="/businesses">View all businesses →</a>
    </section>
  </div>

  <EventsSection />

  <section class="get-featured-band">
    <div class="container gf-copy">
      <span class="eyebrow eyebrow--light">For Business Owners</span>
      <h2>Own a local business? Get featured on Sioux Falls Go.</h2>
      <p>Free, invitation-only spotlights that put you in front of people actively looking for what you do.</p>
      <a href="/get-featured" class="button button--navy">Get Featured →</a>
    </div>
  </section>

  <section class="join-section">
    <div class="container join-inner">
      <span class="eyebrow">For Locals</span>
      <h2>Join the Community</h2>
      <p>Get the newest local spotlights, offers, and giveaways sent straight to your inbox as a Local Legend VIP &mdash; no spam, just Sioux Falls.</p>
      <form name="join-community" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="join-form">
        <input type="hidden" name="form-name" value="join-community" />
        <p class="honeypot-field"><label>Don't fill this out if you're human: <input name="not_human" /></label></p>
        <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required>
        <button type="submit" class="button">Join Free</button>
      </form>
      <p class="join-fine">Free forever. Unsubscribe anytime.</p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .section { padding-block: 3.5rem; }
  .section h2 { font-size: 1.9rem; margin-top: 0.3rem; }
  .eyebrow { display: block; }

  /* HERO — exact port of the approved editorial hero mockup */
  .hero { position: relative; min-height: 40rem; display: flex; align-items: center; overflow: hidden; }
  .hero-photo {
    position: absolute; inset: 0;
    background: url('/images/scenic/downtown-2.jpg') center 42%/cover;
  }
  /* Directional gradient — dark blue behind the text, progressively clearer toward the photo.
     Uses the brand navy so the tint reads intentional, with strong opacity for contrast. */
  .hero-gradient {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      rgba(8,14,28,0.97) 0%,
      rgba(10,17,33,0.92) 32%,
      rgba(13,21,40,0.75) 58%,
      rgba(15,24,44,0.38) 80%,
      rgba(15,24,44,0.12) 100%);
  }
  .hero-gradient-bottom {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(6,11,22,0.65) 0%, transparent 30%);
  }
  .hero-inner { position: relative; z-index: 3; width: 100%; }
  .hero-eyebrow-text { display: block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; color: rgba(255,255,255,0.75); margin-bottom: 1.375rem; text-transform: uppercase; }
  .hero h1 { font-family: var(--font-display); font-weight: 700; font-size: 3.25rem; line-height: 1.12; color: #fff; margin: 0 0 1.5rem; letter-spacing: -0.01em; max-width: 16ch; }
  .hero-sub { font-size: 1.0625rem; line-height: 1.6; color: rgba(255,255,255,0.82); max-width: 30rem; margin: 0 0 2.5rem; font-weight: 400; }
  .hero-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    display: inline-block; background: #fff; color: #101826; font-weight: 600; font-size: 0.906rem;
    padding: 0.9375rem 2rem; border-radius: 4px; text-decoration: none; letter-spacing: 0.01em;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .btn-secondary {
    display: inline-block; background: transparent; color: #fff; font-weight: 600; font-size: 0.906rem;
    padding: 0.875rem 1.875rem; border-radius: 4px; text-decoration: none; letter-spacing: 0.01em;
    border: 1.5px solid rgba(255,255,255,0.55); transition: border-color 0.18s ease, background 0.18s ease;
  }
  .btn-secondary:hover { border-color: #fff; background: rgba(255,255,255,0.06); }
  .scroll-cue {
    position: absolute; left: 4rem; bottom: 2rem; z-index: 3;
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; color: rgba(255,255,255,0.5);
    text-transform: uppercase; display: flex; align-items: center; gap: 0.5rem;
  }
  .scroll-cue svg { animation: heroNudge 2s ease-in-out infinite; }
  @keyframes heroNudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue svg { animation: none; } }

  @media (max-width: 780px) {
    .hero { min-height: 35rem; align-items: flex-end; }
    .hero-gradient { background: linear-gradient(0deg, rgba(6,11,22,0.97) 0%, rgba(8,14,28,0.8) 45%, rgba(10,17,33,0.42) 75%, rgba(10,17,33,0.1) 100%); }
    .hero-inner { padding-bottom: 3.5rem; }
    .hero h1 { font-size: 2rem; }
    .hero-sub { font-size: 0.9375rem; max-width: 100%; margin-bottom: 2rem; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-secondary { text-align: center; }
    .scroll-cue { display: none; }
  }

  /* SPOTLIGHT */
  .spotlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.8rem; }
  @media (max-width: 50rem) { .spotlight-grid { grid-template-columns: 1fr; } }
  .spot-card { display: block; text-decoration: none; border-radius: 1rem; overflow: hidden; background: #fff; box-shadow: 0 1px 3px rgba(13,23,48,0.08); border: 1px solid var(--color-line); transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s ease; }
  .spot-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(13,23,48,0.18); }
  .spot-media { height: 12rem; background-size: cover; background-position: center; background-color: var(--color-navy); position: relative; }
  .spot-badge { display: inline-flex; align-items: center; gap: 0.3rem; position: absolute; top: 0.8rem; left: 0.8rem; background: var(--color-orange); color: #fff; font-size: 0.6875rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 999px; }
  .spot-body { padding: 1.3rem; }
  .spot-body h3 { font-size: 1.1875rem; margin: 0; }
  .spot-rating { display: flex; align-items: center; gap: 0.3rem; color: var(--color-navy); font-weight: 700; font-size: 0.875rem; margin-top: 0.6rem; }
  .spot-excerpt { font-size: 0.875rem; color: var(--color-navy-light); margin: 0.6rem 0 0; line-height: 1.5; }
  .spot-readmore { display: inline-block; margin-top: 0.7rem; font-size: 0.8125rem; font-weight: 700; color: var(--color-orange-dark); }
  :global(.filled-star) { fill: #F5B429; color: #F5B429; }
  .view-all { display: inline-block; margin-top: 1.8rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; }

  /* SECTION 1 — WHAT IS SIOUX FALLS GO (white, two-column with photo) */
  .about { background: #fff; padding-block: 5.5rem; }
  .about-grid {
    display: grid; max-width: 68rem; column-gap: 3.5rem; row-gap: 1.4rem;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: "h2 photo" "copy photo" "toggle photo";
    align-items: start;
  }
  .about-grid h2 { grid-area: h2; }
  .about-photo-wrap { grid-area: photo; align-self: center; }
  .about-copy { grid-area: copy; }
  .about-toggle { grid-area: toggle; }

  @media (max-width: 60rem) {
    .about-grid {
      grid-template-columns: 1fr;
      grid-template-areas: "h2" "photo" "copy" "toggle";
      row-gap: 1.6rem;
    }
  }

  .about h2 { font-size: 2.1rem; max-width: 14ch; margin-bottom: 0; color: var(--color-navy); }
  .about-copy p { font-size: 1.0625rem; line-height: 1.72; color: var(--color-navy-light); max-width: 60ch; margin: 0 0 1.1rem; }
  .about-copy .pull {
    font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; line-height: 1.4; color: var(--color-navy);
    border-left: 3px solid var(--color-orange); padding-left: 1.2rem; margin: 1.6rem 0; max-width: 38ch;
  }
  .about-toggle { display: none; }

  .about-photo {
    width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 1.2rem;
    box-shadow: 0 24px 50px rgba(13,23,48,0.16); display: block;
  }
  .about-photo-caption {
    display: block; font-size: 0.8125rem; color: var(--color-navy-light); text-align: center;
    margin-top: 0.9rem; font-style: italic;
  }
  @media (max-width: 60rem) { .about-photo { aspect-ratio: 16/10; } }

  @media (max-width: 45rem) {
    .about { padding-block: 3rem; }
    .about-more { display: none; }
    .about-copy.is-expanded .about-more { display: block; }
    .about-toggle {
      display: inline-block; margin-top: 0.2rem; background: none; border: none;
      font-family: var(--font-body); font-weight: 700; font-size: 0.9375rem; color: var(--color-orange-dark); cursor: pointer; padding: 0.4rem 0;
    }
  }

  /* SECTION 5 — GET FEATURED (separate section, muted photo treatment, not a solid orange wash) */
  .get-featured-band {
    background:
      linear-gradient(120deg, rgba(20,30,52,0.86) 0%, rgba(20,30,52,0.68) 55%, rgba(211,102,15,0.45) 100%),
      url('/images/scenic/levitt-concert-center.jpg') center/cover;
    padding-block: 4.5rem;
  }
  .get-featured-band .gf-copy { text-align: center; max-width: 34rem; margin: 0 auto; }
  .eyebrow--light { color: var(--color-gold); }
  .gf-copy h2 { color: #fff; font-size: 2rem; margin: 0.4rem 0 0.9rem; }
  .gf-copy p { color: rgba(255,255,255,0.85); font-size: 1.0625rem; line-height: 1.6; margin: 0 0 1.6rem; }
  .button--navy { background: #fff; color: var(--color-navy); }
  .button--navy:hover { background: var(--color-gold); color: var(--color-navy); }

  /* SECTION 6 — JOIN THE COMMUNITY (separate section, light and calm, follows naturally after the darker band above) */
  .join-section {
    background: var(--color-surface); padding-block: 5rem; text-align: center;
  }
  .join-inner { max-width: 34rem; margin: 0 auto; }
  .join-inner .eyebrow { color: var(--color-orange-dark); }
  .join-section h2 { font-size: 2.1rem; color: var(--color-navy); margin: 0.5rem 0 0.9rem; }
  .join-inner > p { color: var(--color-navy-light); font-size: 1.0625rem; line-height: 1.6; margin-bottom: 1.8rem; }

  .join-form { display: flex; gap: 0.7rem; }
  @media (max-width: 30rem) { .join-form { flex-direction: column; } }
  .join-form input {
    flex: 1; padding: 0.85rem 1rem; border-radius: 0.7rem; border: 1px solid var(--color-line);
    font-family: var(--font-body); font-size: 0.9375rem; background: #fff;
  }
  .join-form input:focus { outline: 2px solid var(--color-orange); outline-offset: 1px; }
  .join-fine { font-size: 0.75rem !important; color: var(--color-navy-light); opacity: 0.75; margin-top: 0.9rem !important; margin-bottom: 0 !important; }
  .honeypot-field { position: absolute; left: -9999px; }
</style>

<script>
  const aboutToggle = document.getElementById('aboutToggle');
  const aboutCopy = document.getElementById('about-copy');
  aboutToggle?.addEventListener('click', () => {
    const expanded = aboutCopy!.classList.toggle('is-expanded');
    aboutToggle.textContent = expanded ? 'Read less' : 'Read more';
    aboutToggle.setAttribute('aria-expanded', String(expanded));
  });
</script>
