---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import EventsSection from '../components/EventsSection.astro';
import HeroRotator from '../components/HeroRotator.astro';

const businesses = await getCollection('businesses');
// Only real, verified listings belong on the homepage spotlight — this is
// the site's most visible real estate, and showing an unverified business
// here undercuts the whole point of verification. Sorted most-recently
// verified first, so it also reflects genuinely current activity.
const spotlightBusinesses = businesses
  .filter((b) => b.data.heroImage && b.data.verifiedAt)
  .sort((a, b) => b.data.verifiedAt!.getTime() - a.data.verifiedAt!.getTime())
  .slice(0, 3);

function makeExcerpt(markdown: string, maxLen = 110): string {
  const plain = markdown
    .replace(/^#{1,6}\s+.*/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxLen) return plain;
  const cut = plain.slice(0, maxLen);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}

const spotlightWithCat = await Promise.all(
  spotlightBusinesses.map(async (b) => ({
    business: b,
    category: await getEntry(b.data.category),
    excerpt: makeExcerpt(b.body ?? ''),
  }))
);

const resourceSlugs = [
  'how-does-sioux-falls-go-get-my-business-in-front-of-customers',
  'how-sioux-falls-go-supports-local-businesses',
  'how-sioux-falls-go-is-changing-the-way-locals-support-local',
];
const allArticles = await getCollection('articles');
const resourceArticles = resourceSlugs
  .map((slug) => allArticles.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sioux Falls Go',
  url: 'https://siouxfallsgo.com',
};
---
<BaseLayout
  title="Sioux Falls' Guide to Trusted Local Businesses"
  description="Discover Sioux Falls' favorite local businesses — every one rated 4.8 stars or higher. Plus real local guides, giveaways, and deals for locals."
  canonicalPath="/"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="hero-photo"></div>
    <div class="hero-spotlight"></div>
    <div class="hero-timelapse"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <span class="hero-eyebrow-text">Welcome to Sioux Falls Go</span>
      <h1>Discover and Support Local Businesses in Sioux Falls, SD</h1>
      <p class="hero-sub"><strong>Businesses gain</strong> visibility and community support. <strong>Locals discover</strong> trusted companies and earn rewards. Together, we build a stronger Sioux Falls.</p>
      <div class="hero-actions">
        <a class="button" href="/businesses#legend">Join the Community</a>
      </div>
    </div>
    <HeroRotator />
  </section>

  <section class="about" id="about">
    <div class="container about-grid">
      <div>
        <h2>What Is Sioux Falls Go?</h2>
        <div class="about-copy" id="about-copy">
          <p>Sioux Falls Go helps locals discover trusted businesses, local favorites, special offers, and giveaways&mdash;all while supporting the businesses that make our community great.</p>
          <p>We hand-pick trusted local businesses and introduce them to more people through business spotlights, local content, special offers, and giveaways. Because the best businesses in Sioux Falls aren&rsquo;t always the ones with the biggest advertising budgets.</p>
          <div class="about-more">
            <p>They&rsquo;re often the ones quietly doing great work, earning trust, supporting their customers, and making an impact in our community. They shouldn&rsquo;t have to compete with deep pockets just to keep doing what they do best.</p>
            <p class="pull">When local businesses win, our community wins.</p>
            <p>Our listings are free, but invitation-only. That means you&rsquo;re not seeing who paid the most to be here. You&rsquo;re discovering business owners who value quality, honesty, and community&mdash;and who are helping build our local economy.</p>
            <p>Sioux Falls Go is building a stronger Sioux Falls, one local business at a time.</p>
          </div>
        </div>
        <button class="about-toggle" id="aboutToggle" aria-expanded="false">Read more</button>
      </div>

      <div class="about-steps">
        <span class="about-steps-kicker">How It Works</span>
        <div class="about-step">
          <span class="about-step-num">1</span>
          <div><h3>We find them</h3><p>Hand-picked businesses already earning trust in the community &mdash; not the ones with the biggest ad budget.</p></div>
        </div>
        <div class="about-step">
          <span class="about-step-num">2</span>
          <div><h3>We introduce them</h3><p>Spotlights, local content, offers, and giveaways put them in front of more locals.</p></div>
        </div>
        <div class="about-step">
          <span class="about-step-num">3</span>
          <div><h3>Sioux Falls wins</h3><p>Free, invitation-only listings mean you&rsquo;re discovering real local businesses, not the highest bidder.</p></div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <span class="eyebrow">Recently Verified</span>
      <h2>Real local businesses, checked by our team</h2>
      <div class="spotlight-grid">
        {spotlightWithCat.map(({ business, category, excerpt }) => (
          <a class="spot-card" href={`/businesses/${business.id}`}>
            <div class="spot-media" style={`background-image: url(${business.data.heroImage})`}>
              <span class="spot-badge">
                {business.data.partnershipTier === 'community-champion' ? <><Icon name="star" size={12} /> Community Champion</> : category.data.name}
              </span>
            </div>
            <div class="spot-body">
              <h3>{business.data.name}</h3>
              {business.data.googleRating && <p class="spot-rating"><Icon name="star" size={13} class="filled-star" /> {business.data.googleRating.toFixed(1)} {business.data.googleReviewCount && `(${business.data.googleReviewCount} reviews)`}</p>}
              <p class="spot-excerpt">{excerpt}</p>
              <span class="spot-readmore">Read more →</span>
            </div>
          </a>
        ))}
      </div>
      <a class="view-all" href="/businesses">View all businesses →</a>
    </section>
  </div>

  <section class="locals-section">
    <div class="container">
      <div class="locals-head">
        <span class="eyebrow">For Locals</span>
        <h2>This Is Your Sioux Falls</h2>
        <p>The people who make this city home — this whole platform exists for you.</p>
      </div>
      <div class="locals-bento">
        <a href="/businesses#legend" class="locals-hero-card">
          <div class="locals-hero-overlay"></div>
          <div class="locals-hero-content">
            <span class="locals-hero-badge"><Icon name="sparkles" size={14} /> 100% Free Forever</span>
            <h3>Become a Local Legend</h3>
            <p>Exclusive deals, gift cards, and prizes from the businesses that make Sioux Falls, Sioux Falls.</p>
            <span class="button">Join the Community →</span>
          </div>
        </a>
        <a href="/spotlight-giveaway" class="locals-small-card">
          <div class="icon-badge"><Icon name="gift" size={22} /></div>
          <h3>Enter Giveaways</h3>
          <p>Free prizes from top-rated Sioux Falls businesses. No strings attached.</p>
          <span class="locals-link">Check our giveaways →</span>
        </a>
        <a href="/businesses" class="locals-small-card">
          <div class="icon-badge"><Icon name="search" size={22} /></div>
          <h3>Explore the Directory</h3>
          <p>Community-first businesses across every category in Sioux Falls.</p>
          <span class="locals-link">Browse the directory →</span>
        </a>
      </div>
    </div>
  </section>

  <EventsSection />

  {resourceArticles.length > 0 && (
    <div class="container">
      <section class="section">
        <span class="eyebrow">Business Resources</span>
        <h2>Tips and advice for local businesses</h2>
        <div class="resource-grid">
          {resourceArticles.map((article) => (
            <a class="resource-card" href={`/guides/${article.id}`}>
              {article.data.heroImage && <div class="resource-media" style={`background-image: url(${article.data.heroImage})`}></div>}
              <div class="resource-body">
                <span class="resource-tag">{article.data.contentType.replace('-', ' ')}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  )}

  <section class="get-featured-band">
    <div class="container get-featured-inner">
      <div class="gf-copy">
        <span class="eyebrow eyebrow--light">For Business Owners</span>
        <h2>Own a local business? Get featured on Sioux Falls Go.</h2>
        <p>Join the businesses already earning trust with locals &mdash; spotlights, local content, and offers that put you in front of people actively looking for what you do. Applications are free, and we don&rsquo;t take everyone.</p>
        <a href="/get-featured" class="button button--navy">Get Featured →</a>
      </div>
      <div class="gf-points">
        <div class="gf-point"><Icon name="check" size={18} /> Free, invitation-only listings</div>
        <div class="gf-point"><Icon name="check" size={18} /> Business spotlights &amp; local content</div>
        <div class="gf-point"><Icon name="check" size={18} /> Real locals, not paid placement</div>
      </div>
    </div>
  </section>

  <section class="join-section">
    <div class="container join-inner">
      <h2>Join the Community</h2>
      <p>Get the newest local spotlights, offers, and giveaways sent straight to your inbox as a Local Legend VIP &mdash; no spam, just Sioux Falls.</p>
      <form name="join-community" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="join-form">
        <input type="hidden" name="form-name" value="join-community" />
        <p class="honeypot-field"><label>Don't fill this out if you're human: <input name="not_human" /></label></p>
        <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required>
        <button type="submit" class="button">Join Free</button>
      </form>
      <p class="join-fine">Free forever. Unsubscribe anytime.</p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .section { padding-block: 3.5rem; }
  .section h2 { font-size: 1.9rem; margin-top: 0.3rem; }
  .eyebrow { display: block; }

  /* HERO */
  .hero { position: relative; min-height: 46rem; display: flex; align-items: center; overflow: hidden; flex-wrap: wrap; }
  .hero-photo {
    position: absolute; inset: -2%; width: 104%; height: 104%;
    background: url('/images/scenic/falls-park-1.jpg') center 42%/cover;
    animation: hero-kenburns 30s ease-in-out infinite alternate;
    will-change: transform;
    /* Color grade: lifts contrast/saturation and deepens shadows slightly so
       the photo reads as produced/editorial rather than an unedited shot. */
    filter: contrast(1.1) saturate(1.18) brightness(0.98) sepia(0.05);
  }
  @keyframes hero-kenburns {
    0%   { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.1) translate(-1.5%, -1%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-photo { animation: none; } }
  /* Warm spotlight centered on the falls themselves, lifting them above the
     surrounding storm sky and rock so they read as the clear focal point. */
  .hero-spotlight {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 45% at 42% 58%, rgba(255,225,170,0.22) 0%, rgba(255,225,170,0.06) 45%, transparent 75%);
    mix-blend-mode: soft-light;
  }
  .hero-timelapse { position: absolute; inset: 0; animation: hero-timelapse 10s ease-in-out infinite alternate; }
  @keyframes hero-timelapse {
    0%   { background: linear-gradient(100deg, rgba(20,30,50,0.6) 0%, rgba(20,30,50,0.32) 50%, rgba(255,150,80,0.14) 100%); }
    50%  { background: linear-gradient(100deg, rgba(10,14,28,0.88) 0%, rgba(10,14,28,0.6) 50%, rgba(46,111,158,0.24) 100%); }
    100% { background: linear-gradient(100deg, rgba(6,9,20,0.94) 0%, rgba(6,9,20,0.72) 50%, rgba(245,180,41,0.12) 100%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-timelapse { animation: none; background: rgba(10,14,28,0.8); } }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(13,23,48,0.82) 0%, rgba(13,23,48,0.62) 45%, rgba(13,23,48,0.28) 75%); }
  .hero-inner { position: relative; z-index: 1; padding-block: 4rem; padding-left: 4rem; color: #fff; max-width: 700px; margin-left: 0; margin-right: auto; }
  .hero-eyebrow-text { display: block; font-weight: 700; font-size: 0.9375rem; color: var(--color-prairie, #F5B429); text-transform: uppercase; letter-spacing: 0.01em; margin-bottom: 0.6rem; }
  .hero h1 { font-size: 2.75rem; max-width: 20ch; line-height: 1.12; color: #fff; margin: 0; }
  .hero-sub { max-width: 66ch; color: rgba(255,255,255,0.9); font-size: 1.125rem; margin-top: 1rem; }
  .hero-actions { display: flex; gap: 0.9rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .hero-actions .button--ghost { color: #fff; border-color: rgba(255,255,255,0.3); }
  @media (max-width: 60rem) { .hero-inner { max-width: 100%; padding-left: 3.25rem; } }
  /* Stronger, more solid overlay on mobile so the headline stays legible
     over the photo on small screens, matching the reviewed mobile mockup. */
  @media (max-width: 45rem) {
    .hero-overlay { background: linear-gradient(0deg, rgba(6,9,20,0.94) 0%, rgba(6,9,20,0.78) 40%, rgba(6,9,20,0.4) 70%, rgba(6,9,20,0.15) 100%); }
    .hero { align-items: flex-end; }
    .hero-inner { padding-block: 3rem 3.5rem; padding-left: 1.5rem; padding-right: 1.5rem; }
  }


  /* SPOTLIGHT */
  .spotlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.8rem; }
  @media (max-width: 50rem) { .spotlight-grid { grid-template-columns: 1fr; } }
  .spot-card { display: block; text-decoration: none; border-radius: 1rem; overflow: hidden; background: #fff; box-shadow: 0 1px 3px rgba(13,23,48,0.08); border: 1px solid var(--color-line); transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s ease; }
  .spot-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(13,23,48,0.18); }
  .spot-media { height: 12rem; background-size: cover; background-position: center; background-color: var(--color-navy); position: relative; }
  .spot-badge { display: inline-flex; align-items: center; gap: 0.3rem; position: absolute; top: 0.8rem; left: 0.8rem; background: var(--color-orange); color: #fff; font-size: 0.6875rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 999px; }
  .spot-body { padding: 1.3rem; }
  .spot-body h3 { font-size: 1.1875rem; margin: 0; }
  .spot-rating { display: flex; align-items: center; gap: 0.3rem; color: var(--color-navy); font-weight: 700; font-size: 0.875rem; margin-top: 0.6rem; }
  .spot-excerpt { font-size: 0.875rem; color: var(--color-navy-light); margin: 0.6rem 0 0; line-height: 1.5; }
  .spot-readmore { display: inline-block; margin-top: 0.7rem; font-size: 0.8125rem; font-weight: 700; color: var(--color-orange-dark); }
  :global(.filled-star) { fill: #F5B429; color: #F5B429; }
  .view-all { display: inline-block; margin-top: 1.8rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; }

  /* FOR LOCALS */
  .locals-section { background: linear-gradient(180deg, #0d1730 0%, #1B2A4A 100%); padding-block: 5rem; position: relative; overflow: hidden; }
  .locals-section::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(245,180,41,0.5) 1.5px, transparent 1.5px);
    background-size: 34px 34px; opacity: 0.25; animation: drift-bg 22s linear infinite;
  }
  @keyframes drift-bg { from { background-position: 0 0; } to { background-position: 200px 200px; } }
  @media (prefers-reduced-motion: reduce) { .locals-section::before { animation: none; } }
  .locals-head { position: relative; z-index: 1; text-align: center; margin-bottom: 3rem; }
  .locals-head .eyebrow { color: var(--color-prairie, #F5B429); }
  .locals-head h2 { color: #fff; font-size: 2.3rem; margin-top: 0.4rem; }
  .locals-head p { color: rgba(255,255,255,0.75); font-size: 1.0625rem; max-width: 40ch; margin: 0.8rem auto 0; }

  .locals-bento { position: relative; z-index: 1; display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: auto auto; gap: 1.4rem; }
  @media (max-width: 55rem) { .locals-bento { grid-template-columns: 1fr; } }
  .locals-hero-card {
    grid-row: span 2; border-radius: 1.4rem; overflow: hidden; position: relative; text-decoration: none;
    background: url('/images/scenic/downtown-1.jpg') center/cover;
    min-height: 26rem; display: flex; align-items: flex-end;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    transition: transform 0.35s cubic-bezier(.2,.8,.2,1);
  }
  .locals-hero-card:hover { transform: scale(1.015); }
  .locals-hero-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(13,23,48,0.92) 10%, rgba(13,23,48,0.15) 65%); }
  .locals-hero-content { position: relative; z-index: 1; padding: 2.2rem; }
  .locals-hero-badge {
    display: inline-flex; align-items: center; gap: 0.4rem; background: var(--color-prairie, #F5B429); color: #1B2A4A;
    font-weight: 800; font-size: 0.8125rem; padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1rem;
    animation: badge-float 3s ease-in-out infinite;
  }
  @keyframes badge-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .locals-hero-badge { animation: none; } }
  .locals-hero-content h3 { color: #fff; font-size: 1.9rem; margin-bottom: 0.6rem; }
  .locals-hero-content p { color: rgba(255,255,255,0.85); font-size: 1.0625rem; max-width: 30ch; margin-bottom: 1.4rem; }

  .locals-small-card {
    display: flex; flex-direction: column; gap: 0.7rem; text-decoration: none;
    border-radius: 1.2rem; background: rgba(255,255,255,0.06); backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.12); padding: 1.6rem;
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1), background 0.3s ease, border-color 0.3s ease;
  }
  .locals-small-card:hover { transform: translateY(-6px); background: rgba(255,255,255,0.1); border-color: rgba(245,180,41,0.5); }
  .locals-small-card .icon-badge {
    width: 3.2rem; height: 3.2rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--color-orange), var(--color-prairie, #F5B429)); flex-shrink: 0;
    box-shadow: 0 8px 20px rgba(240,126,35,0.4); color: #fff;
  }
  .locals-small-card h3 { color: #fff; font-size: 1.15rem; margin: 0; }
  .locals-small-card p { color: rgba(255,255,255,0.7); font-size: 0.9375rem; margin: 0; }
  .locals-link { color: var(--color-prairie, #F5B429); font-weight: 700; font-size: 0.875rem; margin-top: auto; }

  /* BUSINESS RESOURCES */
  .resource-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.8rem; }
  @media (max-width: 50rem) { .resource-grid { grid-template-columns: 1fr; } }
  .resource-card { display: block; border-radius: 1rem; overflow: hidden; text-decoration: none; background: #fff; border: 1px solid var(--color-line); box-shadow: 0 1px 3px rgba(13,23,48,0.06); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .resource-card:hover { transform: translateY(-5px); box-shadow: 0 16px 32px rgba(13,23,48,0.14); }
  .resource-media { height: 11rem; background-size: cover; background-position: center; background-color: var(--color-navy); }
  .resource-body { padding: 1.2rem; }
  .resource-tag { color: var(--color-orange-dark); font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; }
  .resource-body h3 { font-size: 1.0625rem; margin-top: 0.4rem; color: var(--color-navy); }
  .resource-body p { color: var(--color-navy-light); font-size: 0.875rem; margin-top: 0.4rem; }

  /* SECTION 1 — WHAT IS SIOUX FALLS GO (white) */
  .about { background: #fff; padding-block: 5rem; }
  .about-grid { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: 4rem; align-items: start; }
  @media (max-width: 55rem) { .about-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
  .about h2 { font-size: 2.1rem; max-width: 12ch; margin-bottom: 1.4rem; color: var(--color-navy); }
  .about-copy p { font-size: 1.0625rem; line-height: 1.72; color: var(--color-navy-light); max-width: 60ch; margin: 0 0 1.1rem; }
  .about-copy .pull {
    font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; line-height: 1.4; color: var(--color-navy);
    border-left: 3px solid var(--color-orange); padding-left: 1.2rem; margin: 1.6rem 0; max-width: 38ch;
  }
  .about-toggle { display: none; }

  .about-steps { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 1rem; padding: 1.8rem; }
  .about-steps-kicker { display: block; font-weight: 700; font-size: 0.8125rem; color: var(--color-navy-light); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 1rem; }
  .about-step { display: flex; gap: 0.9rem; padding: 0.9rem 0; border-bottom: 1px solid var(--color-line); }
  .about-step:last-child { border-bottom: none; }
  .about-step-num { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--color-orange-dark); width: 1.6rem; flex-shrink: 0; }
  .about-step h3 { font-size: 0.9375rem; font-family: var(--font-body); font-weight: 700; color: var(--color-navy); margin: 0 0 0.25rem; }
  .about-step p { font-size: 0.8125rem; color: var(--color-navy-light); margin: 0; line-height: 1.5; }

  @media (max-width: 45rem) {
    .about { padding-block: 3rem; }
    .about-more { display: none; }
    .about-copy.is-expanded .about-more { display: block; }
    .about-toggle {
      display: inline-block; margin-top: 0.2rem; background: none; border: none;
      font-family: var(--font-body); font-weight: 700; font-size: 0.9375rem; color: var(--color-orange-dark); cursor: pointer; padding: 0.4rem 0;
    }
  }

  /* SECTION 5 — GET FEATURED */
  .get-featured-band { background: linear-gradient(135deg, var(--color-orange-dark) 0%, var(--color-orange) 100%); padding-block: 4.5rem; }
  .get-featured-inner { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center; }
