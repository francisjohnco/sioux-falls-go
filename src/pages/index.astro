---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import EventsSection from '../components/EventsSection.astro';
import { todayCentral } from '../lib/dates';
import { currentBlackFriday, shortDate, isoDay } from '../lib/black-friday';

const bfToday = todayCentral();
const bfSeason = currentBlackFriday(bfToday);
const showBlackFriday = bfToday >= `${bfSeason.year}-11-01` && bfToday <= isoDay(bfSeason.cyberMonday);

const businesses = await getCollection('businesses');
// Only real, verified listings belong on the homepage spotlight — this is
// the site's most visible real estate, and showing an unverified business
// here undercuts the whole point of verification. Sorted most-recently
// verified first, so it also reflects genuinely current activity.
const spotlightBusinesses = businesses
  .filter((b) => b.data.heroImage && b.data.verifiedAt)
  .sort((a, b) => b.data.verifiedAt!.getTime() - a.data.verifiedAt!.getTime())
  .slice(0, 3);

function makeExcerpt(markdown: string, maxLen = 110): string {
  const plain = markdown
    .replace(/^#{1,6}\s+.*/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxLen) return plain;
  const cut = plain.slice(0, maxLen);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}

const spotlightWithCat = await Promise.all(
  spotlightBusinesses.map(async (b) => ({
    business: b,
    category: await getEntry(b.data.category),
    excerpt: makeExcerpt(b.body ?? ''),
  }))
);

// Hero wall: real photos of real listed businesses (their own photos, not stock).
const ownPhoto = (src?: string) => !!src && !/images\.(unsplash|pexels)\.com/.test(src);
const wallBusinesses = businesses
  .filter((b) => ownPhoto(b.data.heroImage) && !/logo/i.test(b.data.heroImage!) && !/mckennan|\/images\/scenic\//i.test(`${b.id} ${b.data.heroImage}`))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((b) => ({ name: b.data.name, img: b.data.heroImage! }));
const wallRows = [0, 1, 2].map((r) => {
  const row = wallBusinesses.filter((_, i) => i % 3 === r);
  return [...row, ...row]; // doubled so the drift loops without a gap
});
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sioux Falls Go',
  url: 'https://siouxfallsgo.com',
};
---
<BaseLayout
  title="Sioux Falls' Guide to Trusted Local Businesses"
  description="Discover Sioux Falls' favorite local businesses — every one rated 4.8 stars or higher. Plus real local guides, giveaways, and deals for locals."
  canonicalPath="/"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="hero" aria-labelledby="hero-title">
    <div class="wall" aria-hidden="true">
      {wallRows.map((row, r) => (
        <div class={`wall-row wall-row--${r}`}>
          {row.map((w) => (
            <div class="wall-tile"><img src={w.img} alt="" loading={r === 0 ? 'eager' : 'lazy'} decoding="async" /><span>{w.name}</span></div>
          ))}
        </div>
      ))}
    </div>
    <div class="wall-veil"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-brand">Sioux Falls Go <span class="hero-temp" id="hero-temp" hidden></span></p>
        <h1 id="hero-title">The places that make ordinary days better.</h1>
        <p class="hero-sub">Local favorites, real offers, and the businesses that quietly hold this city together. Invited in, never paid to rank.</p>
        <div class="hero-actions">
          <a class="btn-primary" href="/businesses">Discover them</a>
          <a class="btn-secondary" href="/get-featured">Get featured</a>
        </div>
      </div>
    </div>
  </section>

  {showBlackFriday && (
    <a class="home-bf" href="/local-deals/black-friday/">
      <span class="home-bf-tag">Black Friday {bfSeason.year}</span>
      <span>Local Black Friday deals, {shortDate(bfSeason.blackFriday)} through {shortDate(bfSeason.cyberMonday)}</span>
      <strong>See the deals →</strong>
    </a>
  )}

  <section class="about" id="about">
    <div class="container">
      <div class="about-bento">
        <div class="ab-txt">
          <span class="ab-eyebrow">What is Sioux Falls Go</span>
          <h2>Meet Sioux Falls Go.</h2>
          <div class="about-copy" id="about-copy">
            <p>Sioux Falls Go helps locals discover trusted businesses, local favorites, special offers, and giveaways, while supporting the businesses that make our community great.</p>
            <div class="about-more">
              <p>We hand pick trusted local businesses and introduce them to more people through spotlights, local content, offers, and giveaways. Because the best businesses in Sioux Falls are not always the ones with the biggest advertising budgets.</p>
              <p>They are often the ones quietly doing great work, earning trust, and making an impact in our community. They should not have to compete with deep pockets just to keep doing what they do best.</p>
              <p class="pull">When local businesses win, our community wins.</p>
              <p>Our listings are free, but invitation only. You are not seeing who paid the most to be here. You are discovering owners who value quality, honesty, and community, and who help build our local economy.</p>
              <p>Sioux Falls Go is building a stronger Sioux Falls, one local business at a time.</p>
            </div>
          </div>
          <button class="about-toggle" id="aboutToggle" aria-expanded="false">Read more</button>
        </div>
        <div class="ab-store ab-tile"><img src="/images/businesses/la-luna-cafe.jpg" alt="A local Sioux Falls storefront welcoming customers" /></div>
        <div class="ab-eats ab-tile"><img src="/images/businesses/shahi-india-grill.jpeg" alt="A spread of dishes from a local Sioux Falls restaurant" /></div>
        <div class="ab-badge"><div class="shop-local-seal"><span class="badge-line1">Shop</span><span class="badge-line2">Local</span><small>Sioux Falls</small></div></div>
        <div class="ab-stat"><div class="ab-stat-num">100%</div><p>Every dollar spent local stays local. That is the whole idea behind Sioux Falls Go.</p></div>
        <a class="ab-cta" href="/get-featured/"><span class="ab-cta-h">Run a great local business?</span><span class="ab-cta-link">Get listed &rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="join-section">
    <div class="container join-inner">
      <span class="eyebrow">For Locals</span>
      <h2>Join the Community</h2>
      <p>Get the newest local spotlights, offers, and giveaways sent straight to your inbox as a Local Legend VIP &mdash; no spam, just Sioux Falls.</p>
      <form name="join-community" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="join-form">
        <input type="hidden" name="form-name" value="join-community" />
        <p class="honeypot-field"><label>Don't fill this out if you're human: <input name="not_human" /></label></p>
        <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required>
        <button type="submit" class="button">Join Free</button>
      </form>
      <p class="join-fine">Free forever. Unsubscribe anytime.</p>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <span class="eyebrow">Recently Verified</span>
      <h2>Real local businesses, checked by our team</h2>
      <div class="spotlight-grid">
        {spotlightWithCat.map(({ business, category, excerpt }) => (
          <a class="spot-card" href={`/businesses/${business.id}`}>
            <div class="spot-media" style={`background-image: url(${business.data.heroImage})`}>
              <span class="spot-badge">
                {business.data.partnershipTier === 'community-champion' ? <><Icon name="star" size={12} /> Community Champion</> : category.data.name}
              </span>
            </div>
            <div class="spot-body">
              <h3>{business.data.name}</h3>
              {business.data.googleRating && <p class="spot-rating"><Icon name="star" size={13} class="filled-star" /> {business.data.googleRating.toFixed(1)} {business.data.googleReviewCount && `(${business.data.googleReviewCount} reviews)`}</p>}
              <p class="spot-excerpt">{excerpt}</p>
              <span class="spot-readmore">Read more →</span>
            </div>
          </a>
        ))}
      </div>
      <a class="view-all" href="/businesses">View all businesses →</a>
    </section>
  </div>

  <EventsSection />

  <section class="get-featured-band">
    <div class="container gf-copy">
      <span class="eyebrow eyebrow--light">For Business Owners</span>
      <h2>Own a local business? Get featured on Sioux Falls Go.</h2>
      <p>Free, invitation-only spotlights that put you in front of people actively looking for what you do.</p>
      <a href="/get-featured" class="button button--navy">Get Featured →</a>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .section { padding-block: 3.5rem; }
  .section h2 { font-size: 1.9rem; margin-top: 0.3rem; }
  .eyebrow { display: block; }

  /* HERO: a slowly drifting wall of real listed businesses behind the
     headline, with a live card for the weather and who is open right now. */
  .hero { position: relative; min-height: 41rem; display: flex; align-items: center; overflow: hidden; background: #0E1626; color: #fff; }
  .wall { position: absolute; inset: -3rem -12%; display: grid; grid-template-rows: repeat(3, 1fr); gap: 0.75rem; transform: rotate(-4deg); }
  .wall-row { display: flex; gap: 0.75rem; width: max-content; animation: wallDrift 140s linear infinite; }
  .wall-row--1 { animation-direction: reverse; animation-duration: 170s; margin-left: -11rem; }
  .wall-row--2 { animation-duration: 155s; }
  @keyframes wallDrift { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .wall-row { animation: none; } }
  .wall-tile { position: relative; flex: 0 0 18.5rem; height: 100%; min-height: 12rem; border-radius: 0.9rem; overflow: hidden; background: #1B2A4A; }
  .wall-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wall-tile span { position: absolute; left: 0.6rem; bottom: 0.6rem; font-size: 0.75rem; font-weight: 600; background: rgba(14,22,38,0.72); padding: 0.25rem 0.6rem; border-radius: 999px; }
  .wall-veil { position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 55%, rgba(14,22,38,0.94) 0%, rgba(14,22,38,0.8) 45%, rgba(14,22,38,0.35) 100%); }
  .hero-inner { position: relative; z-index: 2; width: 100%; padding-top: 5.5rem; padding-bottom: 5.5rem; }
  .hero-temp { font-family: var(--font-body); font-weight: 500; font-size: 1rem; color: rgba(255,255,255,0.82); margin-left: 0.6rem; }
  .hero-temp b { font-family: var(--font-display); font-weight: 700; color: #fff; font-size: 1.15rem; }
  .hero-brand { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: #FF9A4D; margin: 0 0 1rem; letter-spacing: -0.01em; }
  .hero h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 5.2vw, 4.9rem); line-height: 1.02; letter-spacing: -0.035em; color: #fff; margin: 0 0 1.4rem; max-width: 14ch; }
  .hero-sub { font-size: 1.15rem; line-height: 1.6; color: rgba(255,255,255,0.84); max-width: 33rem; margin: 0 0 2rem; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .btn-primary, .btn-secondary { display: inline-block; font-weight: 600; font-size: 0.95rem; padding: 0.95rem 1.7rem; border-radius: 0.5rem; text-decoration: none; }
  .btn-primary { background: var(--color-orange); color: #fff; }
  .btn-primary:hover { background: #E06F15; }
  .btn-secondary { color: #fff; border: 1.5px solid rgba(255,255,255,0.5); }
  .btn-secondary:hover { border-color: #fff; background: rgba(255,255,255,0.08); }
  .btn-primary:focus-visible, .btn-secondary:focus-visible { outline: 3px solid #FF9A4D; outline-offset: 3px; }

  @media (max-width: 860px) {
    .hero { min-height: 0; }
    .hero-inner { padding-top: 3.4rem; padding-bottom: 3.4rem; }
    .wall-tile { flex-basis: 12rem; }
    .hero h1 { font-size: 2.55rem; }
    .hero-sub { font-size: 1rem; }
    .hero-actions { flex-direction: column; }
    .btn-primary, .btn-secondary { text-align: center; }
  }

  /* SPOTLIGHT */
  .spotlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.8rem; }
  @media (max-width: 50rem) { .spotlight-grid { grid-template-columns: 1fr; } }
  .spot-card { display: block; text-decoration: none; border-radius: 1rem; overflow: hidden; background: #fff; box-shadow: 0 1px 3px rgba(13,23,48,0.08); border: 1px solid var(--color-line); transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s ease; }
  .spot-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(13,23,48,0.18); }
  .spot-media { height: 12rem; background-size: cover; background-position: center; background-color: var(--color-navy); position: relative; }
  .spot-badge { display: inline-flex; align-items: center; gap: 0.3rem; position: absolute; top: 0.8rem; left: 0.8rem; background: var(--color-orange); color: #fff; font-size: 0.6875rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 999px; }
  .spot-body { padding: 1.3rem; }
  .spot-body h3 { font-size: 1.1875rem; margin: 0; }
  .spot-rating { display: flex; align-items: center; gap: 0.3rem; color: var(--color-navy); font-weight: 700; font-size: 0.875rem; margin-top: 0.6rem; }
  .spot-excerpt { font-size: 0.875rem; color: var(--color-navy-light); margin: 0.6rem 0 0; line-height: 1.5; }
  .spot-readmore { display: inline-block; margin-top: 0.7rem; font-size: 0.8125rem; font-weight: 700; color: var(--color-orange-dark); }
  :global(.filled-star) { fill: #F5B429; color: #F5B429; }
  .view-all { display: inline-block; margin-top: 1.8rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; }

  /* SECTION 1 — WHAT IS SIOUX FALLS GO (light bento grid) */
  .about { background: linear-gradient(180deg, #FBF3EA 0%, #fff 60%); padding-block: 5.5rem; }
  .about-bento {
    display: grid; max-width: 68rem; margin: 0 auto; gap: 1rem;
    grid-template-columns: 1.25fr 1fr 0.9fr 0.9fr;
    grid-template-areas:
      "txt txt store eats"
      "txt txt store badge"
      "stat stat stat cta";
  }
  .about-bento > * { border-radius: 18px; }

  .ab-txt { grid-area: txt; background: #fff; border: 1px solid var(--color-line); padding: 2.2rem; }
  .ab-eyebrow {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-display); font-weight: 600; font-size: 0.8125rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-orange);
  }
  .ab-eyebrow::before { content: ""; width: 26px; height: 2px; background: var(--color-orange); border-radius: 2px; }
  .ab-txt h2 {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    line-height: 1.05; letter-spacing: -0.02em; color: var(--color-navy); margin: 0.9rem 0; max-width: 14ch;
  }
  .about-copy p { font-size: 1.0625rem; line-height: 1.7; color: var(--color-navy-light); margin: 0 0 1rem; }
  .about-copy .pull {
    font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.4; color: var(--color-navy);
    border-left: 3px solid var(--color-orange); padding-left: 1.1rem; margin: 1.4rem 0;
  }
  .about-more { display: none; }
  .about-copy.is-expanded .about-more { display: block; }
  .about-toggle {
    margin-top: 1.1rem; display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: #fff;
    background: var(--color-orange); border: none; border-radius: var(--radius-pill);
    padding: 0.8rem 1.5rem; cursor: pointer; transition: background 0.2s, transform 0.15s;
  }
  .about-toggle:hover { background: var(--color-orange-dark); transform: translateY(-2px); }

  .ab-tile { position: relative; overflow: hidden; min-height: 150px; }
  .ab-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ab-store { grid-area: store; min-height: 240px; }
  .ab-eats { grid-area: eats; }

  .ab-badge { grid-area: badge; background: var(--color-navy); display: flex; align-items: center; justify-content: center; padding: 1.2rem; }
  .shop-local-seal {
    width: 7rem; height: 7rem; border-radius: 50%; background: var(--color-orange); color: #fff;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    box-shadow: 0 12px 30px rgba(240,126,35,0.45); transform: rotate(-6deg);
  }
  .badge-line1, .badge-line2 { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; line-height: 1.05; }
  .shop-local-seal small { font-family: var(--font-display); font-weight: 600; font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.9; margin-top: 0.25rem; }

  .ab-stat { grid-area: stat; background: #FBEAD6; border: 1px solid var(--color-line); display: flex; align-items: center; gap: 1.4rem; padding: 1.6rem 2rem; }
  .ab-stat-num { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 4vw, 3rem); line-height: 1; color: var(--color-orange); }
  .ab-stat p { margin: 0; color: var(--color-navy-light); font-size: 0.98rem; line-height: 1.5; }

  .ab-cta { grid-area: cta; background: var(--color-navy); color: #fff; display: flex; flex-direction: column; justify-content: center; gap: 0.6rem; padding: 1.4rem 1.6rem; text-decoration: none; transition: transform 0.15s; }
  .ab-cta:hover { transform: translateY(-2px); }
  .ab-cta-h { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: #fff; line-height: 1.25; }
  .ab-cta-link { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--color-gold); display: inline-flex; align-items: center; gap: 0.4rem; }

  @media (max-width: 60rem) {
    .about-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "txt txt"
        "store eats"
        "badge badge"
        "stat stat"
        "cta cta";
    }
    .ab-store { min-height: 200px; }
  }
  @media (max-width: 45rem) {
    .about { padding-block: 3.2rem; }
    .about-bento {
      grid-template-columns: 1fr;
      grid-template-areas: "txt" "store" "eats" "badge" "stat" "cta";
    }
    .ab-txt { padding: 1.6rem; }
    .ab-tile { min-height: 180px; }
  }

  /* SECTION 5 — GET FEATURED (separate section, muted photo treatment, not a solid orange wash) */
  .get-featured-band {
    background:
      linear-gradient(120deg, rgba(20,30,52,0.86) 0%, rgba(20,30,52,0.68) 55%, rgba(211,102,15,0.45) 100%),
      url('/images/scenic/levitt-concert-center.jpg') center/cover;
    padding-block: 4.5rem;
  }
  .get-featured-band .gf-copy { text-align: center; max-width: 34rem; margin: 0 auto; }
  .eyebrow--light { color: var(--color-gold); }
  .gf-copy h2 { color: #fff; font-size: 2rem; margin: 0.4rem 0 0.9rem; }
  .gf-copy p { color: rgba(255,255,255,0.85); font-size: 1.0625rem; line-height: 1.6; margin: 0 0 1.6rem; }
  .button--navy { background: #fff; color: var(--color-navy); }
  .button--navy:hover { background: var(--color-gold); color: var(--color-navy); }

  /* SECTION 6 — JOIN THE COMMUNITY (separate section, light and calm, follows naturally after the darker band above) */
  .join-section {
    background: var(--color-surface); padding-block: 5rem; text-align: center;
  }
  .join-inner { max-width: 34rem; margin: 0 auto; }
  .join-inner .eyebrow { color: var(--color-orange-dark); }
  .join-section h2 { font-size: 2.1rem; color: var(--color-navy); margin: 0.5rem 0 0.9rem; }
  .join-inner > p { color: var(--color-navy-light); font-size: 1.0625rem; line-height: 1.6; margin-bottom: 1.8rem; }

  .join-form { display: flex; gap: 0.7rem; }
  @media (max-width: 30rem) { .join-form { flex-direction: column; } }
  .join-form input {
    flex: 1; padding: 0.85rem 1rem; border-radius: 0.7rem; border: 1px solid var(--color-line);
    font-family: var(--font-body); font-size: 0.9375rem; background: #fff;
  }
  .join-form input:focus { outline: 2px solid var(--color-orange); outline-offset: 1px; }
  .join-fine { font-size: 0.75rem !important; color: var(--color-navy-light); opacity: 0.75; margin-top: 0.9rem !important; margin-bottom: 0 !important; }
  .honeypot-field { position: absolute; left: -9999px; }
  .home-bf { display: flex; align-items: center; justify-content: center; gap: 0.9rem; flex-wrap: wrap; padding: 0.85rem 1rem; background: #0E1424; color: rgba(255,255,255,0.88); text-decoration: none; font-size: 0.95rem; text-align: center; }
  .home-bf-tag { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; background: var(--color-gold); color: #0E1424; padding: 0.22rem 0.55rem; border-radius: 0.3rem; }
  .home-bf strong { color: var(--color-orange); }
  .home-bf:hover strong { text-decoration: underline; }
</style>

<script>
  // Sioux Falls temperature next to the brand line, from the National Weather Service.
  (() => {
    const el = document.getElementById('hero-temp');
    if (!el) return;
    const hour = Number(new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
    const slot = hour < 12 ? 'this morning' : hour < 17 ? 'this afternoon' : 'tonight';
    fetch('/api/weather').then((r) => (r.ok ? r.json() : null)).then((w) => {
      if (!w || typeof w.tempF !== 'number') return;
      el.innerHTML = `<b>${w.tempF}°</b> ${w.sky ? `and ${w.sky.toLowerCase()} ` : ''}${slot}`;
      el.hidden = false;
    }).catch(() => {});
  })();

  const aboutToggle = document.getElementById('aboutToggle');
  const aboutCopy = document.getElementById('about-copy');
  aboutToggle?.addEventListener('click', () => {
    const expanded = aboutCopy!.classList.toggle('is-expanded');
    aboutToggle.textContent = expanded ? 'Read less' : 'Read more';
    aboutToggle.setAttribute('aria-expanded', String(expanded));
  });
</script>
