---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';

// Facts sourced from the three real articles already published about this
// product. Pricing tiers (Large/Medium/Small) follow the same "Local
// Spotlight" franchise structure shown in the sibling-market reference
// (salinelocal.com/spotlight) — confirm exact Sioux Falls rates before
// this goes live if they differ. Spot statuses below are honest for a
// first-ever Sioux Falls mailing: shown mostly Open, not fabricated as sold out.

const included = [
  { icon: 'edit', title: 'Free Professional Ad Design', body: 'We design your spot for you — no designer, no software, no hassle.' },
  { icon: 'layers', title: 'Free Spotlight Landing Page', body: 'Every spot gets its own page with a QR code, so you can track results.' },
  { icon: 'check', title: 'No Competing Businesses', body: 'One business per industry, per mailing — you\u2019re never sharing your category.' },
  { icon: 'sparkles', title: 'Full Color, Both Sides', body: 'Professionally printed, front and back, on real cardstock.' },
];

const reasons = [
  { icon: 'star', title: 'No Competitors Allowed', body: 'Your business is the only one in its category, so you\u2019re never sharing the card with a competitor.' },
  { icon: 'mail', title: 'No Pages to Flip Through', body: 'It\u2019s a postcard, not an envelope to open or a page to flip past. Your ad is right there, every time.' },
  { icon: 'wrench', title: 'We Handle Everything', body: 'Design, printing, postage \u2014 all handled. You just show up and answer the phone.' },
  { icon: 'zap', title: 'Real, Trackable Results', body: 'Every spot gets a QR code to its own redemption page, so you see exactly what it drove.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Sioux Falls Spotlight Postcard',
  description: 'A shared direct-mail postcard reaching 5,000 Sioux Falls households — one business per industry, multiple ad sizes available.',
};
---
<BaseLayout
  title="The Sioux Falls Spotlight Postcard — Direct Mail, Done Together"
  description="Get your business in front of 5,000 Sioux Falls households with the Sioux Falls Spotlight — a shared direct-mail postcard with no competing businesses, free design, and no contracts."
  canonicalPath="/postcard"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="sl-hero">
    <div class="container sl-hero-inner">
      <span class="sl-eyebrow">The Sioux Falls Spotlight</span>
      <h1>Get Your Business in Front of 5,000 Sioux Falls Homes</h1>
      <p class="sl-hero-sub">Need a budget-friendly way to connect with local customers? The Spotlight is a direct-mail postcard that puts your business in front of 5,000 Sioux Falls households &mdash; no massive ad budget required.</p>
      <a href="#apply" class="sl-cta">Claim Your Spot</a>
    </div>

    <div class="sl-postcard-stack">
      <img src="/images/postcard-example.png" alt="The back of the Sioux Falls Spotlight postcard" class="sl-stack-photo sl-stack-photo--back" />
      <img src="/images/postcard-example.png" alt="The Sioux Falls Spotlight postcard, showing local business ad spots of varying sizes" class="sl-stack-photo sl-stack-photo--front" />
    </div>
  </section>

  <div class="container sl-page">
    <section class="sl-greet">
      <h2>Hello, Sioux Falls business owner!</h2>
      <p>The Spotlight is a full-color, <strong>oversized postcard</strong> hand-delivered to every mailbox on the mailing route &mdash; no envelope to open, no page to flip past. It lands right in front of 5,000 local households.</p>
      <p>Best of all, only one business per category is featured on each mailer &mdash; so when a neighbor pulls the Spotlight out of their mailbox, your business is the star of your category. No competitors, no crowded page, just your name in front of the people already looking for what you offer.</p>
    </section>

    <section class="sl-included">
      <span class="sl-eyebrow sl-eyebrow--dark">What's Included</span>
      <h2>Everything You Need, Nothing You Don't</h2>
      <div class="sl-included-grid">
        {included.map((item) => (
          <div class="sl-card">
            <div class="sl-icon-badge"><Icon name={item.icon} size={24} /></div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="sl-spots">
      <span class="sl-date-pill"><Icon name="star" size={14} /> September Mailing</span>
      <h2>Live View of Open Spots &mdash; Claim Yours Now!</h2>
      <p class="sl-spots-sub">Only one business per category makes it onto each mailer, and spots for the next drop are going fast. Reach out today to lock in your category before someone else does.</p>

      <div class="sl-mock-card">
        <div class="sl-mock-tile sl-mock-tile--medium sl-mock-tile--open" style="grid-area: m1;">
          <span class="sl-mock-price">$550</span><span class="sl-mock-size">MEDIUM</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--small sl-mock-tile--open" style="grid-area: s1;">
          <span class="sl-mock-price">$300</span><span class="sl-mock-size">SMALL</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
        <div class="sl-mock-tile sl-mock-indicia" style="grid-area: ind;">
          <span class="sl-mock-mast">sioux falls <strong>go</strong><br/><em>SPOTLIGHT</em></span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--large sl-mock-tile--open" style="grid-area: lg;">
          <span class="sl-mock-price">$900</span><span class="sl-mock-size">LARGE</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--small sl-mock-tile--sold" style="grid-area: s2;">
          <span class="sl-mock-price">$300</span><span class="sl-mock-size">SMALL</span>
          <span class="sl-mock-stamp sl-mock-stamp--sold">CLAIMED</span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--medium sl-mock-tile--open" style="grid-area: m2;">
          <span class="sl-mock-price">$550</span><span class="sl-mock-size">MEDIUM</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--small sl-mock-tile--open" style="grid-area: s3;">
          <span class="sl-mock-price">$300</span><span class="sl-mock-size">SMALL</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--small sl-mock-tile--open" style="grid-area: s4;">
          <span class="sl-mock-price">$300</span><span class="sl-mock-size">SMALL</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
        <div class="sl-mock-tile sl-mock-tile--small sl-mock-tile--open" style="grid-area: s5;">
          <span class="sl-mock-price">$300</span><span class="sl-mock-size">SMALL</span>
          <span class="sl-mock-stamp sl-mock-stamp--open">OPEN</span>
        </div>
      </div>
      <p class="sl-mock-fine">Pricing shown matches the standard Spotlight rate card &mdash; confirm current availability when you apply. All spots shown are open for Sioux Falls' first run, except where noted.</p>
    </section>

    <section class="sl-why">
      <span class="sl-eyebrow sl-eyebrow--dark">Why Join</span>
      <h2>Why Join the Sioux Falls Spotlight?</h2>
      <div class="sl-why-grid">
        {reasons.map((r) => (
          <div class="sl-card">
            <div class="sl-icon-badge sl-icon-badge--gold"><Icon name={r.icon} size={24} /></div>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="sl-founder">
      <img src="/images/scenic/francis-founder.jpg" alt="Francis, founder of Sioux Falls Go" class="sl-founder-photo" />
      <span class="sl-eyebrow sl-eyebrow--dark">A Note From The Founder</span>
      <h2>Hey, Francis here.</h2>
      <p>You don't need a massive ad budget to get noticed here. My goal is simple: I connect good local businesses with the neighbors who are already looking for what they offer.</p>
      <p>That's it. No frills, no long-term commitment, just a straightforward way to get your name in front of people nearby.</p>
      <p class="sl-founder-sign">&mdash; Francis, Sioux Falls Go</p>
    </section>

    <section class="sl-qualify">
      <h2>We Don't Take Everyone</h2>
      <p class="sl-qualify-sub">Participation isn't just about advertising &mdash; it's about aligning with values that foster trust in the community. To be eligible, your business should be:</p>
      <div class="sl-qualify-grid">
        <div class="sl-card"><div class="sl-icon-badge"><Icon name="home" size={22} /></div><h3>Locally Owned &amp; Operated</h3><p>Rooted in Sioux Falls, not a national chain with a local storefront.</p></div>
        <div class="sl-card"><div class="sl-icon-badge"><Icon name="rocket" size={22} /></div><h3>Ready to Serve More Customers</h3><p>5,000 households means real interest &mdash; you should be ready to answer it.</p></div>
        <div class="sl-card"><div class="sl-icon-badge"><Icon name="heart" size={22} /></div><h3>Ethical &amp; Trustworthy</h3><p>We spotlight businesses that already operate with integrity, not just anyone who can pay.</p></div>
      </div>
    </section>

    <section class="sl-apply-band" id="apply">
      <h2>Claim Your Spot</h2>
      <p>Ready to get your business in front of 5,000 local homes? Spots for the next mailing are limited &mdash; fill out the form below to get started.</p>

      <form name="postcard-apply" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="sl-form">
        <input type="hidden" name="form-name" value="postcard-apply" />
        <p class="honeypot-field"><label>Don't fill this out if you're human: <input name="not_human" /></label></p>

        <div class="sl-form-row">
          <label>First Name<input type="text" name="first_name" required /></label>
          <label>Last Name<input type="text" name="last_name" required /></label>
        </div>
        <div class="sl-form-row">
          <label>Business Name<input type="text" name="business_name" required /></label>
          <label>Industry / Category<input type="text" name="industry" placeholder="e.g. Roofing, Dentist, Coffee Shop" required /></label>
        </div>
        <div class="sl-form-row">
          <label>Email<input type="email" name="email" required /></label>
          <label>Phone<input type="tel" name="phone" /></label>
        </div>
        <label>Preferred Spot Size
          <select name="preferred_size">
            <option value="not-sure">Not sure yet &mdash; tell me what's available</option>
            <option value="small">Small ($300)</option>
            <option value="medium">Medium ($550)</option>
            <option value="large">Large ($900)</option>
          </select>
        </label>
        <label>Message<textarea name="notes" rows="3" placeholder="Anything else we should know?"></textarea></label>

        <button type="submit" class="sl-cta sl-cta--form">Send</button>
      </form>
      <p class="sl-form-fine">Your information stays private. See our <a href="/privacy-policy">privacy policy</a>. Applying doesn't guarantee a spot in the next mailing.</p>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Lora:ital,wght@0,400;0,500;1,500&display=swap');

  :root {
    --sl-green: #1f3d2f;
    --sl-green-light: #2a4d3a;
    --sl-cream: #f6efe0;
    --sl-cream-line: #e9dfc8;
    --sl-gold: #c9922f;
    --sl-gold-dark: #a8791f;
    --sl-ink: #262420;
    --sl-ink-light: #5c584f;
  }

  .sl-page :global(h1), .sl-page :global(h2), .sl-page :global(h3),
  .sl-hero h1, .sl-hero h2 { font-family: 'Playfair Display', serif; }
  .sl-page, .sl-hero { font-family: 'Lora', serif; color: var(--sl-ink); }

  .sl-eyebrow { display: block; font-family: 'Lora', serif; font-weight: 600; font-size: 0.8125rem; color: var(--sl-gold); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.8rem; }
  .sl-eyebrow--dark { text-align: center; }

  .sl-cta {
    display: inline-block; background: var(--sl-gold); color: #fff; font-weight: 700; font-size: 1rem;
    padding: 1rem 2.2rem; border-radius: 0.6rem; text-decoration: none; transition: background 0.15s ease;
    font-family: 'Lora', serif;
  }
  .sl-cta:hover { background: var(--sl-gold-dark); }

  /* HERO */
  .sl-hero { background: var(--sl-green); padding: 4.5rem 0 0; text-align: center; }
  .sl-hero-inner { max-width: 44rem; margin: 0 auto; }
  .sl-hero h1 { color: #fff; font-size: 2.6rem; font-weight: 700; line-height: 1.2; margin: 0 0 1.2rem; }
  .sl-hero-sub { color: rgba(255,255,255,0.75); font-size: 1.125rem; line-height: 1.65; margin-bottom: 2rem; }

  .sl-postcard-stack { position: relative; max-width: 46rem; margin: 3.5rem auto 0; padding-bottom: 3.5rem; }
  .sl-stack-photo { width: 100%; border-radius: 0.6rem; box-shadow: 0 30px 60px rgba(0,0,0,0.35); display: block; }
  .sl-stack-photo--back { position: absolute; inset: 0; transform: rotate(4deg) translateX(2%); opacity: 0.85; filter: brightness(0.85); }
  .sl-stack-photo--front { position: relative; transform: rotate(-2deg); }

  /* SHARED SECTION RHYTHM */
  .sl-page { padding-block: 4rem; }
  .sl-page > section { padding-block: 3.5rem; text-align: center; }
  .sl-page > section h2 { font-size: 2rem; color: var(--sl-ink); margin: 0 0 1.2rem; max-width: 26ch; margin-inline: auto; }
  .sl-page > section p { color: var(--sl-ink-light); font-size: 1.0625rem; line-height: 1.7; max-width: 60ch; margin: 0 auto 1rem; }

  .sl-greet strong { color: var(--sl-ink); }

  /* CARDS SHARED */
  .sl-card {
    background: #fff; border-radius: 1rem; padding: 2.2rem 1.8rem; box-shadow: 0 6px 20px rgba(38,36,32,0.06);
  }
  .sl-card h3 { font-size: 1.1875rem; color: var(--sl-ink); margin: 0 0 0.6rem; }
  .sl-card p { font-size: 0.9375rem; margin: 0; max-width: none; }
  .sl-icon-badge {
    width: 3.6rem; height: 3.6rem; border-radius: 0.9rem; background: var(--sl-cream); color: var(--sl-green);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 1.1rem;
  }
  .sl-icon-badge--gold { background: #f7e9d2; color: var(--sl-gold-dark); }

  /* INCLUDED + WHY (cream bg sections) */
  .sl-included, .sl-why, .sl-spots { background: var(--sl-cream); border-radius: 1.4rem; margin-inline: -1rem; padding-inline: 1rem; }
  .sl-included-grid, .sl-why-grid, .sl-qualify-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; margin-top: 2rem; text-align: left;
  }
  .sl-qualify-grid { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 55rem) { .sl-included-grid, .sl-why-grid, .sl-qualify-grid { grid-template-columns: 1fr; } }
  .sl-included-grid .sl-card, .sl-why-grid .sl-card { text-align: center; }

  /* LIVE SPOTS MOCK CARD */
  .sl-date-pill {
    display: inline-flex; align-items: center; gap: 0.5rem; background: #fff; border-radius: 999px;
    padding: 0.5rem 1.2rem; font-size: 0.8125rem; font-weight: 700; color: var(--sl-ink); margin-bottom: 1.2rem;
  }
  .sl-date-pill :global(svg) { color: var(--sl-gold); }
  .sl-spots-sub { margin-bottom: 2.2rem !important; }

  .sl-mock-card {
    max-width: 40rem; margin: 0 auto; background: #fdf6df; border: 3px solid #f0dfa0; border-radius: 1rem;
    padding: 0.7rem; box-shadow: 0 20px 50px rgba(38,36,32,0.15);
    display: grid; gap: 0.5rem; text-align: left;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 5.2rem) repeat(2, 5.2rem);
    grid-template-areas:
      "m1 s1 ind ind"
      "m1 lg lg s2"
      "m2 lg lg s3"
      "m2 s4 s5 s5";
  }
  @media (max-width: 30rem) {
    .sl-mock-card { grid-template-rows: repeat(2, 4.2rem) repeat(2, 4.2rem); }
  }
  .sl-mock-tile {
    position: relative; background: #fff; border-radius: 0.5rem; display: flex; flex-direction: column;
    align-items: center; justify-content: center; overflow: hidden; border: 1px solid #f0dfa0;
  }
  .sl-mock-price { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.1rem; color: #2e9e5b; margin-top: -1.2rem; }
  .sl-mock-tile--sold .sl-mock-price { color: var(--sl-ink-light); }
  .sl-mock-size { font-size: 0.625rem; font-weight: 700; letter-spacing: 0.05em; color: var(--sl-ink-light); margin-top: 0.1rem; }
  .sl-mock-stamp {
    position: absolute; bottom: 0.4rem; font-family: 'Playfair Display', serif; font-weight: 800; font-size: 0.9rem;
    transform: rotate(-10deg); padding: 0.05rem 0.7rem; border: 2.5px solid; border-radius: 0.3rem;
    background: rgba(255,255,255,0.75); letter-spacing: 0.03em;
  }
  .sl-mock-stamp--open { color: #2e9e5b; border-color: #2e9e5b; }
  .sl-mock-stamp--sold { color: #c1442e; border-color: #c1442e; }
  .sl-mock-indicia {
    background: var(--sl-green) !important; border: none !important;
  }
  .sl-mock-mast { font-family: 'Playfair Display', serif; font-weight: 700; color: #fff; font-size: 0.75rem; text-align: center; line-height: 1.5; }
  .sl-mock-mast strong { color: var(--sl-gold); }
  .sl-mock-mast em { display: block; font-style: normal; letter-spacing: 0.1em; font-size: 0.5625rem; color: rgba(255,255,255,0.6); }
  .sl-mock-fine { font-size: 0.8125rem !important; color: var(--sl-ink-light); margin-top: 1.6rem !important; }

  /* FOUNDER */
  .sl-founder-photo {
    width: 8.5rem; height: 8.5rem; border-radius: 50%; object-fit: cover; margin: 0 auto 1.4rem;
    border: 4px solid #fff; box-shadow: 0 10px 30px rgba(38,36,32,0.15); display: block;
  }
  .sl-founder p { font-style: italic; }
  .sl-founder-sign { font-style: italic; font-weight: 600; color: var(--sl-ink) !important; }

  /* APPLY FORM */
  .sl-apply-band { background: var(--sl-green); border-radius: 1.4rem; margin-inline: -1rem; padding: 3rem 1.5rem !important; }
  .sl-apply-band h2 { color: #fff !important; }
  .sl-apply-band > p { color: rgba(255,255,255,0.75) !important; }
  .sl-form {
    max-width: 30rem; margin: 0 auto; background: #fff; border-radius: 1rem; padding: 2rem;
    display: flex; flex-direction: column; gap: 1rem; text-align: left;
  }
  .sl-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 28rem) { .sl-form-row { grid-template-columns: 1fr; } }
  .sl-form label { display: flex; flex-direction: column; gap: 0.4rem; font-weight: 600; font-size: 0.9375rem; color: var(--sl-ink); }
  .sl-form input, .sl-form select, .sl-form textarea {
    padding: 0.75rem 0.9rem; border-radius: 0.5rem; border: 1px solid #ddd6c4; font-family: 'Lora', serif;
    font-size: 0.9375rem; resize: vertical;
  }
  .sl-form input:focus, .sl-form select:focus, .sl-form textarea:focus { outline: 2px solid var(--sl-gold); border-color: var(--sl-gold); }
  .sl-cta--form { align-self: center; width: 100%; text-align: center; border: none; cursor: pointer; margin-top: 0.4rem; }
  .sl-form-fine { color: rgba(255,255,255,0.6) !important; font-size: 0.8125rem !important; margin-top: 1.2rem !important; }
  .sl-form-fine a { color: var(--sl-gold); }
  .honeypot-field { position: absolute; left: -9999px; }
</style>
