---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';

// Facts below are sourced from the three real articles already published
// about this product (shine-bright-with-the-sioux-falls-go-postcard,
// unlock-massive-reach-with-sioux-falls-go-direct-mail-postcards,
// turn-the-sioux-falls-go-postcard-into-a-power-sales-machine). None of
// those ever state a dollar figure — they consistently funnel to "contact
// us" for pricing — so exact per-card rates stay out of this page until
// confirmed. The reference photo is a real example of the same
// shared-postcard product from a sibling market, used here to show the
// actual print format — not a Sioux Falls-specific mailing.
// Structure modeled on salinelocal.com/spotlight, the same "Local
// Spotlight" franchise format, adapted to SFG's real facts and design system.

const included = [
  { icon: 'edit', title: 'Free Professional Ad Design' },
  { icon: 'layers', title: 'Free Spotlight Landing Page' },
  { icon: 'check', title: 'No Competing Businesses' },
  { icon: 'sparkles', title: 'Full Color, Both Sides' },
  { icon: 'heart', title: 'No Long-Term Contracts' },
];

const reasons = [
  { icon: 'star', title: 'No Competitors Allowed', body: 'One business per industry, per mailing — you\u2019re never sharing the card with someone doing what you do.' },
  { icon: 'mail', title: 'No Pages to Flip Past', body: 'It\u2019s a postcard, not an envelope to open or a page to scroll past. Your ad is right there, every time.' },
  { icon: 'wrench' , title: 'We Handle Everything', body: 'Design, printing, postage \u2014 all handled. You just show up and answer the phone.' },
  { icon: 'zap', title: 'Real, Trackable Results', body: 'Every spot gets a QR code to its own redemption landing page, so you see exactly what the postcard drove.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Sioux Falls Spotlight Postcard',
  description: 'A shared direct-mail postcard reaching 5,000 Sioux Falls households — one business per industry, multiple ad sizes available.',
};
---
<BaseLayout
  title="The Sioux Falls Spotlight Postcard — Direct Mail, Done Together"
  description="Get your business in front of 5,000 Sioux Falls households with the Sioux Falls Spotlight — a shared direct-mail postcard with no competing businesses, free design, and no contracts."
  canonicalPath="/postcard"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-eyebrow"><span class="dot"></span> Only 16 Spots Per Mailing</span>
        <h1>Get your business in front of 5,000 Sioux Falls homes</h1>
        <p class="hero-sub">The Sioux Falls Spotlight is a shared, professionally printed direct-mail postcard &mdash; no massive ad budget required, and no competing business in your category.</p>
        <div class="hero-cta-row">
          <a href="#apply" class="hero-cta">Claim Your Spot →</a>
          <span class="hero-free-note">Free to apply &middot; one business per industry</span>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <img src="/images/postcard-example.png" alt="A real example of the Spotlight postcard, showing local business ad spots of varying sizes" class="hero-postcard-photo" />
        <span class="hero-photo-caption">A real example of the Spotlight postcard from a sibling market &mdash; same format, same sizes, printed for a different city.</span>
      </div>
    </div>
  </section>

  <section class="stat-band">
    <div class="container stat-grid">
      <div class="stat"><span class="stat-num">5,000</span><span class="stat-label">Households mailed, targeted ZIP codes across Sioux Falls</span></div>
      <div class="stat"><span class="stat-num">60&ndash;90%</span><span class="stat-label">Typically saved vs. a solo direct mail campaign</span></div>
      <div class="stat"><span class="stat-num">1 of 16</span><span class="stat-label">Spots per mailing, one business per industry</span></div>
    </div>
  </section>

  <div class="container page">
    <section class="greet-section">
      <div class="greet-text">
        <span class="eyebrow">Hello, Sioux Falls Business Owner</span>
        <h2>A full-color postcard, hand-delivered to 5,000 mailboxes</h2>
        <p>The Spotlight is a full-color, oversized postcard mailed directly to targeted ZIP codes across Sioux Falls &mdash; no envelope to open, no page to flip past. It lands right in the mailbox.</p>
        <p>Only one business per industry is featured on each mailing, so when a neighbor pulls the Spotlight out of their mailbox, your business is the only one like it on the card. No competitors, no crowded page &mdash; just your name in front of people already looking for what you do.</p>
      </div>
      <div class="greet-photo-wrap">
        <div class="greet-collage">
          <img src="/images/businesses/redstone-electric.jpg" alt="A real Sioux Falls business already featured on Sioux Falls Go" class="collage-photo collage-photo--top" />
          <img src="/images/businesses/thorson-construction.jpg" alt="A real Sioux Falls business already featured on Sioux Falls Go" class="collage-photo collage-photo--bottom" />
          <div class="greet-badge">
            <span class="badge-line1">Could Be</span>
            <span class="badge-line2">You</span>
          </div>
        </div>
      </div>
    </section>

    <div class="cut-divider"><span>What's Included</span></div>

    <section class="included-section">
      <h2>Everything you need, nothing you don't</h2>
      <div class="included-grid">
        {included.map((item) => (
          <div class="included-item">
            <Icon name={item.icon} size={18} />
            <span>{item.title}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="cut-divider"><span>September Mailing</span></div>

    <section class="spots-section">
      <h2>Live View of Open Spots &mdash; Claim Yours Now</h2>
      <p class="spots-sub">Only one business per industry makes it onto each mailer, and spots for the next drop go fast. This is a to-scale replica of the actual card &mdash; reach out today to lock in your category before someone else does.</p>

      <div class="replica-card">
        <div class="replica-tile replica-tile--feature replica-tile--open" style="grid-area: f1;">
          <span class="replica-size">Feature Spot</span>
          <span class="replica-status"><Icon name="check" size={13} /> Open</span>
        </div>
        <div class="replica-tile replica-tile--open" style="grid-area: s1;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--open" style="grid-area: s2;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--open" style="grid-area: s3;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--open" style="grid-area: s4;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>

        <div class="replica-mast" style="grid-area: mast;">
          <span class="replica-mast-logo">sioux falls <strong>go</strong></span>
          <span class="replica-mast-tag">SPOTLIGHT</span>
          <span class="replica-mast-cta">Want to advertise?<br /><a href="#apply">Claim a spot →</a></span>
        </div>

        <div class="replica-tile replica-tile--open" style="grid-area: s5;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--open" style="grid-area: s6;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--open" style="grid-area: s7;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--open" style="grid-area: s8;"><span class="replica-status"><Icon name="check" size={13} /> Open</span></div>
        <div class="replica-tile replica-tile--feature replica-tile--open" style="grid-area: f2;">
          <span class="replica-size">Feature Spot</span>
          <span class="replica-status"><Icon name="check" size={13} /> Open</span>
        </div>
      </div>

      <div class="replica-legend">
        <span class="legend-item"><span class="legend-swatch legend-swatch--open"></span> Open &mdash; apply to claim it</span>
        <span class="legend-item"><span class="legend-swatch legend-swatch--sold"></span> Sold &mdash; already claimed</span>
      </div>
      <p class="spots-fine">Live for the next mailing &mdash; updated as spots are claimed. All 10 shown are open for the very first Sioux Falls run. Apply below and we'll confirm exactly what's open in your industry.</p>
    </section>

    <div class="cut-divider"><span>Why Join the Sioux Falls Spotlight?</span></div>

    <section class="reasons-section">
      <div class="reasons-grid">
        {reasons.map((r) => (
          <div class="reason-card">
            <Icon name={r.icon} size={20} />
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="cut-divider"><span>A Note From Francis</span></div>

    <section class="founder-section">
      <div class="founder-photo" style="background-image: url('/images/scenic/francis-founder.jpg')"></div>
      <div class="founder-copy">
        <p>"You don't need a massive ad budget to get noticed here. My goal is simple &mdash; connect good local businesses with the neighbors who are already looking for what they offer. That's it. No frills, no long-term commitment, just a straightforward way to get your name in front of people nearby."</p>
        <p class="founder-sign">&mdash; Francis, Sioux Falls Go</p>
      </div>
    </section>

    <div class="cut-divider"><span>Before You Apply</span></div>

    <section class="qualify-section">
      <h2>We don't take everyone</h2>
      <p class="qualify-sub">Participation isn't just about advertising &mdash; it's about aligning with values that foster trust in the community. To be eligible, your business should be:</p>
      <div class="qualify-grid">
        <div class="qualify-item"><h3><Icon name="home" size={20} /> Locally Owned &amp; Operated</h3><p>Rooted in Sioux Falls, not a national chain with a local storefront.</p></div>
        <div class="qualify-item"><h3><Icon name="rocket" size={20} /> Ready to Serve More Customers</h3><p>5,000 households means real interest &mdash; you should be ready to answer it.</p></div>
        <div class="qualify-item"><h3><Icon name="heart" size={20} /> Ethical &amp; Trustworthy</h3><p>We spotlight businesses that already operate with integrity, not just anyone who can pay.</p></div>
      </div>
    </section>

    <div class="cut-divider"><span>Claim Your Spot</span></div>

    <section class="apply-section" id="apply">
      <div class="apply-stamp"><Icon name="mail" size={22} /></div>
      <h2>Apply for the Next Mailing</h2>
      <p class="apply-sub">
        Spots are limited to one business per industry. Tell us about your
        business below and we'll follow up with availability, sizes, and
        pricing for the next drop.
      </p>

      <form name="postcard-apply" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="apply-form">
        <input type="hidden" name="form-name" value="postcard-apply" />
        <p class="honeypot-field">
          <label>Don't fill this out if you're human: <input name="not_human" /></label>
        </p>

        <div class="form-row">
          <label>
            First name *
            <input type="text" name="first_name" required />
          </label>
          <label>
            Last name *
            <input type="text" name="last_name" required />
          </label>
        </div>
        <div class="form-row">
          <label>
            Business name *
            <input type="text" name="business_name" required />
          </label>
          <label>
            Industry / category *
            <input type="text" name="industry" placeholder="e.g. Roofing, Dentist, Coffee Shop" required />
          </label>
        </div>
        <div class="form-row">
          <label>
            Email *
            <input type="email" name="email" required />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" />
          </label>
        </div>
        <label>
          Preferred spot size
          <select name="preferred_size">
            <option value="not-sure">Not sure yet &mdash; tell me what's available</option>
            <option value="standard">Standard Spot</option>
            <option value="feature">Feature Spot</option>
          </select>
        </label>
        <label>
          Anything else we should know?
          <textarea name="notes" rows="3" placeholder="Neighborhood you'd like to target, timing, questions — anything."></textarea>
        </label>

        <button type="submit" class="button">Apply for a Spot →</button>
      </form>

      <p class="apply-fine">
        Your information stays private. We'll never spam you or sell your
        details. See our <a href="/privacy-policy">privacy policy</a>.
        Spots are limited and go quickly by industry &mdash; applying doesn't
        guarantee a spot in the next mailing.
      </p>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .page { padding-block: 3.5rem; }
  .eyebrow { display: block; font-weight: 700; font-size: 0.8125rem; color: var(--color-orange-dark); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem; }

  .cut-divider {
    display: flex; align-items: center; gap: 1rem; margin-block: 3.5rem;
    color: var(--color-navy-light); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  }
  .cut-divider::before, .cut-divider::after { content: ''; flex: 1; border-top: 2px dashed var(--color-line); }
  .cut-divider span { white-space: nowrap; }

  /* HERO */
  .hero { background: var(--color-navy); padding-block: 4rem; position: relative; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.18fr; gap: 3rem; align-items: center; }
  @media (max-width: 60rem) { .hero-grid { grid-template-columns: 1fr; } }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.8125rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.2rem; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-gold); }
  .hero h1 { font-family: 'Anton', var(--font-display); font-weight: 400; color: #fff; font-size: 2.75rem; line-height: 1.12; margin: 0; letter-spacing: 0.01em; text-transform: uppercase; max-width: 14ch; }
  .hero-sub { color: rgba(255,255,255,0.78); font-size: 1.0625rem; line-height: 1.6; max-width: 32rem; margin-top: 1.3rem; }
  .hero-cta-row { display: flex; align-items: center; gap: 1.1rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .hero-cta { display: inline-block; background: var(--color-orange); color: #fff; font-weight: 700; font-size: 0.9375rem; padding: 0.85rem 1.8rem; border-radius: var(--radius-pill); text-decoration: none; transition: background 0.15s ease; }
  .hero-cta:hover { background: var(--color-orange-dark); }
  .hero-free-note { color: rgba(255,255,255,0.55); font-size: 0.875rem; }

  .hero-photo-wrap { position: relative; }
  .hero-postcard-photo {
    width: 100%; border-radius: 0.5rem; box-shadow: 0 30px 70px rgba(0,0,0,0.5);
    transform: rotate(1.2deg); border: 6px solid #fff; display: block;
  }
  .hero-photo-caption { display: block; font-size: 0.75rem; color: rgba(255,255,255,0.45); text-align: center; margin-top: 1.2rem; max-width: 26rem; margin-inline: auto; line-height: 1.5; }

  /* STAT BAND */
  .stat-band { background: var(--color-surface); border-bottom: 1px solid var(--color-line); padding-block: 2.4rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; text-align: center; }
  @media (max-width: 45rem) { .stat-grid { grid-template-columns: 1fr; } }
  .stat-num { display: block; font-family: var(--font-display); font-weight: 700; font-size: 2.1rem; color: var(--color-navy); }
  .stat-label { display: block; font-size: 0.875rem; color: var(--color-navy-light); margin-top: 0.3rem; max-width: 22ch; margin-inline: auto; }

  /* GREETING — two-column with real photo collage */
  .greet-section {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; align-items: center;
    background: linear-gradient(135deg, #FBF3EA 0%, #fff 60%); border-radius: 1.4rem; padding: 2.8rem;
  }
  @media (max-width: 55rem) { .greet-section { grid-template-columns: 1fr; gap: 2rem; padding: 1.8rem; } }
  .greet-text h2 { font-size: 1.9rem; color: var(--color-navy); margin: 0.3rem 0 1.2rem; max-width: 20ch; }
  .greet-text p { font-size: 1.0625rem; color: var(--color-navy-light); line-height: 1.65; max-width: 62ch; margin: 0 0 1rem; }

  .greet-collage { position: relative; }
  .collage-photo {
    width: 82%; object-fit: cover; border-radius: 1rem; display: block;
    box-shadow: 0 20px 40px rgba(13,23,48,0.18); border: 5px solid #fff;
  }
  .collage-photo--top { aspect-ratio: 5/4; position: relative; z-index: 1; }
  .collage-photo--bottom { aspect-ratio: 5/4; margin: -3rem 0 0 auto; position: relative; z-index: 2; }
  .greet-badge {
    position: absolute; top: -1.2rem; right: -0.6rem; z-index: 3;
    width: 6rem; height: 6rem; border-radius: 50%; background: var(--color-navy);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: #fff; box-shadow: 0 12px 26px rgba(13,23,48,0.35); transform: rotate(7deg);
  }
  .badge-line1, .badge-line2 { font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; line-height: 1.15; }
  @media (max-width: 55rem) {
    .collage-photo { width: 74%; }
    .collage-photo--bottom { margin-top: -2.2rem; }
    .greet-badge { width: 5rem; height: 5rem; }
    .badge-line1, .badge-line2 { font-size: 0.9375rem; }
  }

  /* WHAT'S INCLUDED — stamped checklist, not icon cards */
  .included-section h2 { font-size: 1.9rem; color: var(--color-navy); margin: 0.3rem 0 1.6rem; }
  .included-grid { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .included-item {
    display: flex; align-items: center; gap: 0.6rem; background: var(--color-surface); border: 1px solid var(--color-line);
    border-radius: var(--radius-pill); padding: 0.7rem 1.3rem; font-weight: 600; font-size: 0.9375rem; color: var(--color-navy);
  }
  .included-item :global(svg) { color: var(--color-orange-dark); flex-shrink: 0; }

  /* LIVE VIEW OF OPEN SPOTS */
  .spots-section h2 { font-size: 1.9rem; color: var(--color-navy); margin: 0.3rem 0 1rem; max-width: 26ch; }
  .spots-sub { color: var(--color-navy-light); font-size: 1rem; max-width: 60ch; margin-bottom: 2rem; line-height: 1.6; }

  /* Replica card — a to-scale mock of the actual postcard grid, echoing
     the real reference photo's layout: a feature tile top-left, a masthead
     band cutting across the middle, a mirrored feature tile bottom-right. */
  .replica-card {
    display: grid; gap: 0.5rem; background: #0c1220; border-radius: 0.9rem; padding: 0.9rem;
    box-shadow: 0 24px 60px rgba(13,23,48,0.25); border: 1px solid #1c2436;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(2, 5.5rem) auto repeat(2, 5.5rem);
    grid-template-areas:
      "f1 f1 f1 s1 s2 s3"
      "f1 f1 f1 s1 s2 s3"
      "mast mast mast mast mast mast"
      "s5 s5 s6 s6 f2 f2"
      "s7 s7 s8 s8 f2 f2";
  }
  @media (max-width: 40rem) {
    .replica-card {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 4.5rem) repeat(2, 3.4rem) auto repeat(2, 3.4rem) repeat(2, 4.5rem);
      grid-template-areas:
        "f1 f1 f1" "f1 f1 f1"
        "s1 s2 s3" "s1 s2 s3"
        "mast mast mast"
        "s5 s6 s7" "s5 s6 s7"
        "f2 f2 f2" "f2 f2 f2";
    }
  }
  .replica-tile {
    border-radius: 0.4rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
    text-align: center; padding: 0.5rem;
  }
  .replica-tile--open { background: rgba(46,158,91,0.14); border: 1.5px dashed rgba(111,214,153,0.55); }
  .replica-tile--feature .replica-size { color: #fff; font-weight: 700; font-size: 0.875rem; }
  .replica-tile:not(.replica-tile--feature) .replica-size { display: none; }
  .replica-status { color: #6fd699; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; gap: 0.3rem; }
  .replica-mast {
    grid-area: mast; background: #000; border-radius: 0.4rem; display: flex; align-items: center; justify-content: space-between;
    padding: 0.9rem 1.4rem; flex-wrap: wrap; gap: 0.6rem;
  }
  .replica-mast-logo { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: #fff; }
  .replica-mast-logo strong { color: var(--color-gold); }
  .replica-mast-tag { font-family: 'Anton', var(--font-display); color: var(--color-gold); font-size: 1.3rem; letter-spacing: 0.03em; }
  .replica-mast-cta { color: rgba(255,255,255,0.65); font-size: 0.6875rem; line-height: 1.4; text-align: right; }
  .replica-mast-cta a { color: var(--color-gold); font-weight: 700; text-decoration: none; }

  .replica-legend { display: flex; gap: 1.6rem; margin-top: 1.4rem; flex-wrap: wrap; }
  .legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-navy-light); }
  .legend-swatch { width: 0.9rem; height: 0.9rem; border-radius: 0.25rem; display: inline-block; }
  .legend-swatch--open { background: rgba(46,158,91,0.18); border: 1.5px dashed #2e9e5b; }
  .legend-swatch--sold { background: var(--color-line); border: 1.5px solid var(--color-navy-light); }
  .spots-fine { font-size: 0.8125rem; color: var(--color-navy-light); margin-top: 1.4rem; }

  /* WHY JOIN */
  .reasons-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
  @media (max-width: 45rem) { .reasons-grid { grid-template-columns: 1fr; } }
  .reason-card { padding: 1.7rem; background: var(--color-surface); border-radius: 1rem; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .reason-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(13,23,48,0.1); }
  .reason-card :global(svg) { color: var(--color-orange-dark); }
  .reason-card h3 { font-size: 1.0625rem; color: var(--color-navy); margin: 0.7rem 0 0.5rem; }
  .reason-card p { font-size: 0.9375rem; color: var(--color-navy-light); line-height: 1.55; margin: 0; }

  /* FOUNDER NOTE */
  .founder-section { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 2.5rem; align-items: center; }
  @media (max-width: 45rem) { .founder-section { grid-template-columns: 1fr; } }
  .founder-photo { aspect-ratio: 4/5; border-radius: 1rem; background-size: cover; background-position: center; box-shadow: 0 16px 40px rgba(13,23,48,0.14); }
