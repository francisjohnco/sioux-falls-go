---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';

// Facts below are sourced from the three real articles already published
// about this product (shine-bright-with-the-sioux-falls-go-postcard,
// unlock-massive-reach-with-sioux-falls-go-direct-mail-postcards,
// turn-the-sioux-falls-go-postcard-into-a-power-sales-machine). None of
// those ever state a dollar figure — they consistently funnel to "contact
// us" for pricing — so this page follows the same pattern rather than
// inventing a number. Swap in real pricing whenever it's ready.

const benefits = [
  {
    icon: 'gift',
    title: 'Half the Cost, None of the Guesswork',
    body: "By sharing the postcard with other trusted local businesses, participants typically pay 60–90% less than a solo direct mail campaign — professionally designed, with no hidden fees.",
  },
  {
    icon: 'star',
    title: 'Built-In Credibility',
    body: 'Your business is featured alongside other reputable local brands — instant trust by association, not just another ad in the mailbox.',
  },
  {
    icon: 'zap',
    title: 'A Landing Page, Not a Dead End',
    body: "Every postcard directs recipients to a dedicated redemption landing page with a QR code — so you can actually track scans, clicks, and redemptions instead of hoping it worked.",
  },
];

const steps = [
  { num: '1', title: 'Apply for a spot', body: 'One business per industry — tell us about yours below and we\u2019ll confirm eligibility and availability.' },
  { num: '2', title: 'We build your space', body: 'Professional design, a neighborhood-specific offer if you want one, and a QR code tied to your own redemption page.' },
  { num: '3', title: 'It lands in 5,000 mailboxes', body: 'The oversized postcard mails to targeted ZIP codes across Sioux Falls — then results roll in on your landing page.' },
];

const qualifications = [
  { icon: 'home', title: 'Locally Owned & Operated', body: 'Rooted in Sioux Falls, not a national chain with a local storefront.' },
  { icon: 'rocket', title: 'Ready to Serve More Customers', body: '5,000 households means real interest — you should be ready to answer it.' },
  { icon: 'heart', title: 'Ethical & Trustworthy', body: 'We spotlight businesses that already operate with integrity, not just anyone who can pay.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Sioux Falls Spotlight Postcard',
  description: 'A shared direct-mail postcard reaching 5,000 Sioux Falls households — one business per industry.',
};
---
<BaseLayout
  title="The Sioux Falls Spotlight Postcard — Direct Mail, Done Together"
  description="Reach 5,000 Sioux Falls households for a fraction of the cost of a solo direct mail campaign. Shared, professionally designed, and limited to one business per industry."
  canonicalPath="/postcard"
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="container hero-inner">
      <span class="hero-eyebrow"><span class="dot"></span> Only 16 Spots Per Mailing</span>
      <h1>Get your business into 5,000 Sioux Falls mailboxes — for a fraction of the cost.</h1>
      <p class="hero-sub">The Sioux Falls Spotlight Postcard is a shared, professionally designed direct-mail piece featuring a curated group of local businesses. One spot per industry. No solo direct-mail price tag.</p>
      <div class="hero-cta-row">
        <a href="#apply" class="hero-cta">Apply for a Spot →</a>
        <span class="hero-free-note">Free to apply · One business per industry</span>
      </div>
    </div>
  </section>

  <section class="stat-band">
    <div class="container stat-grid">
      <div class="stat"><span class="stat-num">5,000</span><span class="stat-label">Households mailed, targeted ZIP codes across Sioux Falls</span></div>
      <div class="stat"><span class="stat-num">60&ndash;90%</span><span class="stat-label">Typically saved vs. a solo direct mail campaign</span></div>
      <div class="stat"><span class="stat-num">1 of 16</span><span class="stat-label">Spots per mailing, one business per industry</span></div>
    </div>
  </section>

  <div class="container page">
    <section class="benefits-section">
      <span class="eyebrow">Why This Isn't Typical Direct Mail</span>
      <h2>Three things you won't get mailing solo</h2>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card">
            <div class="benefit-icon"><Icon name={b.icon} size={22} /></div>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="how-section">
      <span class="eyebrow">How It Works</span>
      <h2>From mailbox to customer, in three steps</h2>
      <div class="how-grid">
        {steps.map((s) => (
          <div class="how-card">
            <span class="how-num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="founder-section">
      <div class="founder-photo" style="background-image: url('/images/scenic/francis-founder.jpg')"></div>
      <div class="founder-copy">
        <span class="eyebrow">A Note From Francis</span>
        <p>"I started Sioux Falls Go because the best businesses in this city usually aren't the ones with the biggest ad budgets — they're the ones quietly doing great work and earning trust one customer at a time. The Spotlight Postcard is the same idea applied to direct mail: instead of every business fighting alone for space in a mailbox, we share it, split the cost, and all show up stronger together. If that sounds like your business, I'd like to hear from you."</p>
        <p class="founder-sign">&mdash; Francis, Sioux Falls Go</p>
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="qualify-section">
      <span class="eyebrow">Before You Apply</span>
      <h2>We don't take everyone</h2>
      <p class="qualify-sub">Participation isn't just about advertising — it's about aligning with values that foster trust in the community. To be eligible, your business should be:</p>
      <div class="qualify-grid">
        {qualifications.map((q) => (
          <div class="qualify-item card">
            <h3><Icon name={q.icon} size={20} /> {q.title}</h3>
            <p>{q.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="contour-divider"></div>

    <section class="mockup-section">
      <span class="eyebrow">What You Actually Get</span>
      <h2>Here's what a business spot looks like</h2>
      <p class="mockup-sub">Every business gets its own tile on the shared postcard &mdash; photo, name, category, rating, and a QR code straight to their offer. This is what real Sioux Falls Go businesses already look like on it.</p>

      <div class="postcard-mock">
        <div class="postcard-mock-head">
          <span class="postcard-mock-logo">sioux falls <strong>go</strong></span>
          <span class="postcard-mock-tag">Locals&rsquo; Favorite Places &mdash; September Edition</span>
        </div>
        <div class="postcard-mock-grid">
          <div class="postcard-tile">
            <div class="postcard-tile-photo" style="background-image: url('/images/businesses/redstone-electric.jpg')"></div>
            <div class="postcard-tile-body">
              <span class="postcard-tile-cat">Electricians</span>
              <h3>Redstone Electric</h3>
              <p class="postcard-tile-offer">$25 off your first service call</p>
            </div>
            <div class="postcard-tile-qr" aria-hidden="true">
              <svg viewBox="0 0 60 60" width="34" height="34"><rect width="60" height="60" fill="#fff"/><g fill="#12181f"><rect x="4" y="4" width="16" height="16"/><rect x="40" y="4" width="16" height="16"/><rect x="4" y="40" width="16" height="16"/><rect x="8" y="8" width="8" height="8" fill="#fff"/><rect x="44" y="8" width="8" height="8" fill="#fff"/><rect x="8" y="44" width="8" height="8" fill="#fff"/><rect x="24" y="4" width="4" height="4"/><rect x="32" y="4" width="4" height="4"/><rect x="24" y="12" width="4" height="4"/><rect x="24" y="24" width="4" height="4"/><rect x="32" y="24" width="4" height="4"/><rect x="40" y="24" width="4" height="4"/><rect x="48" y="24" width="4" height="4"/><rect x="24" y="32" width="4" height="4"/><rect x="24" y="40" width="4" height="4"/><rect x="24" y="48" width="4" height="4"/><rect x="32" y="48" width="4" height="4"/><rect x="40" y="40" width="4" height="4"/><rect x="48" y="48" width="4" height="4"/></g></svg>
            </div>
          </div>

          <div class="postcard-tile">
            <div class="postcard-tile-photo" style="background-image: url('/images/businesses/605-drain-solutions.jpg')"></div>
            <div class="postcard-tile-body">
              <span class="postcard-tile-cat">Plumbers</span>
              <h3>605 Drain Solutions</h3>
              <p class="postcard-tile-offer">4.9★ (47 reviews) &mdash; Free estimates</p>
            </div>
            <div class="postcard-tile-qr" aria-hidden="true">
              <svg viewBox="0 0 60 60" width="34" height="34"><rect width="60" height="60" fill="#fff"/><g fill="#12181f"><rect x="4" y="4" width="16" height="16"/><rect x="40" y="4" width="16" height="16"/><rect x="4" y="40" width="16" height="16"/><rect x="8" y="8" width="8" height="8" fill="#fff"/><rect x="44" y="8" width="8" height="8" fill="#fff"/><rect x="8" y="44" width="8" height="8" fill="#fff"/><rect x="24" y="8" width="4" height="4"/><rect x="32" y="8" width="4" height="4"/><rect x="24" y="16" width="4" height="4"/><rect x="40" y="24" width="4" height="4"/><rect x="24" y="28" width="4" height="4"/><rect x="32" y="28" width="4" height="4"/><rect x="48" y="28" width="4" height="4"/><rect x="24" y="36" width="4" height="4"/><rect x="32" y="44" width="4" height="4"/><rect x="24" y="48" width="4" height="4"/><rect x="40" y="48" width="4" height="4"/><rect x="48" y="40" width="4" height="4"/></g></svg>
            </div>
          </div>

          <div class="postcard-tile">
            <div class="postcard-tile-photo" style="background-image: url('/images/businesses/american-tree-service.jpg')"></div>
            <div class="postcard-tile-body">
              <span class="postcard-tile-cat">Tree Services</span>
              <h3>American Tree Service</h3>
              <p class="postcard-tile-offer">Free quote on any removal</p>
            </div>
            <div class="postcard-tile-qr" aria-hidden="true">
              <svg viewBox="0 0 60 60" width="34" height="34"><rect width="60" height="60" fill="#fff"/><g fill="#12181f"><rect x="4" y="4" width="16" height="16"/><rect x="40" y="4" width="16" height="16"/><rect x="4" y="40" width="16" height="16"/><rect x="8" y="8" width="8" height="8" fill="#fff"/><rect x="44" y="8" width="8" height="8" fill="#fff"/><rect x="8" y="44" width="8" height="8" fill="#fff"/><rect x="28" y="4" width="4" height="4"/><rect x="24" y="20" width="4" height="4"/><rect x="32" y="20" width="4" height="4"/><rect x="40" y="28" width="4" height="4"/><rect x="48" y="20" width="4" height="4"/><rect x="24" y="32" width="4" height="4"/><rect x="32" y="36" width="4" height="4"/><rect x="24" y="44" width="4" height="4"/><rect x="44" y="44" width="4" height="4"/><rect x="36" y="48" width="4" height="4"/></g></svg>
            </div>
          </div>

          <div class="postcard-tile postcard-tile--open">
            <div class="postcard-tile-photo postcard-tile-photo--empty">
              <Icon name="briefcase" size={26} />
            </div>
            <div class="postcard-tile-body">
              <span class="postcard-tile-cat postcard-tile-cat--open">Your Industry</span>
              <h3>Your Business Here</h3>
              <p class="postcard-tile-offer">This spot is open &mdash; one per industry</p>
            </div>
            <a href="#apply" class="postcard-tile-cta">Claim It →</a>
          </div>
        </div>
      </div>
      <p class="mockup-caption">A mockup showing real Sioux Falls Go businesses as they'd appear on the shared mailer. Final layout and business count vary by mailing.</p>
    </section>

    <div class="contour-divider"></div>

    <section class="apply-section" id="apply">
      <span class="eyebrow">Claim Your Spot</span>
      <h2>Apply for the Next Mailing</h2>
      <p class="apply-sub">
        Spots are limited to one business per industry. Tell us about your
        business below and we'll follow up with availability and pricing
        for the next drop.
      </p>

      <form name="postcard-apply" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="apply-form">
        <input type="hidden" name="form-name" value="postcard-apply" />
        <p class="honeypot-field">
          <label>Don't fill this out if you're human: <input name="not_human" /></label>
        </p>

        <div class="form-row">
          <label>
            First name *
            <input type="text" name="first_name" required />
          </label>
          <label>
            Last name *
            <input type="text" name="last_name" required />
          </label>
        </div>
        <div class="form-row">
          <label>
            Business name *
            <input type="text" name="business_name" required />
          </label>
          <label>
            Industry / category *
            <input type="text" name="industry" placeholder="e.g. Roofing, Dentist, Coffee Shop" required />
          </label>
        </div>
        <div class="form-row">
          <label>
            Email *
            <input type="email" name="email" required />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" />
          </label>
        </div>
        <label>
          Anything else we should know?
          <textarea name="notes" rows="3" placeholder="Neighborhood you'd like to target, timing, questions — anything."></textarea>
        </label>

        <button type="submit" class="button">Apply for a Spot →</button>
      </form>

      <p class="apply-fine">
        Your information stays private. We'll never spam you or sell your
        details. See our <a href="/privacy-policy">privacy policy</a>.
        Spots are limited and go quickly by industry — applying doesn't
        guarantee a spot in the next mailing.
      </p>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .page { padding-block: 3.5rem; }
  .eyebrow { display: block; font-weight: 700; font-size: 0.8125rem; color: var(--color-orange-dark); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem; }
  .contour-divider { height: 1px; background: var(--color-line); margin-block: 3.5rem; }

  /* HERO */
  .hero { background: linear-gradient(135deg, var(--color-navy) 0%, #24365c 100%); padding-block: 5rem; position: relative; overflow: hidden; }
  .hero-inner { position: relative; max-width: 42rem; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.8125rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-gold); }
  .hero h1 { color: #fff; font-size: 2.5rem; line-height: 1.14; max-width: 18ch; margin: 0; }
  .hero-sub { color: rgba(255,255,255,0.82); font-size: 1.0625rem; line-height: 1.6; max-width: 48ch; margin-top: 1.2rem; }
  .hero-cta-row { display: flex; align-items: center; gap: 1.1rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .hero-cta { display: inline-block; background: var(--color-orange); color: #fff; font-weight: 700; font-size: 0.9375rem; padding: 0.85rem 1.8rem; border-radius: var(--radius-pill); text-decoration: none; transition: background 0.15s ease; }
  .hero-cta:hover { background: var(--color-orange-dark); }
  .hero-free-note { color: rgba(255,255,255,0.6); font-size: 0.875rem; }

  /* STAT BAND */
  .stat-band { background: var(--color-surface); border-bottom: 1px solid var(--color-line); padding-block: 2.4rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; text-align: center; }
  @media (max-width: 45rem) { .stat-grid { grid-template-columns: 1fr; } }
  .stat-num { display: block; font-family: var(--font-display); font-weight: 700; font-size: 2.1rem; color: var(--color-navy); }
  .stat-label { display: block; font-size: 0.875rem; color: var(--color-navy-light); margin-top: 0.3rem; max-width: 22ch; margin-inline: auto; }

  /* BENEFITS */
  .benefits-section h2, .how-section h2, .qualify-section h2 { font-size: 1.9rem; color: var(--color-navy); margin: 0.3rem 0 1.6rem; }

  /* POSTCARD MOCKUP */
  .mockup-sub { color: var(--color-navy-light); font-size: 1rem; max-width: 58ch; margin-bottom: 2rem; }
  .postcard-mock {
    background: #fff; border-radius: 1.2rem; box-shadow: 0 24px 60px rgba(13,23,48,0.16), 0 2px 8px rgba(13,23,48,0.08);
    border: 1px solid var(--color-line); overflow: hidden; transform: rotate(-0.6deg); max-width: 46rem; margin: 0 auto;
  }
  .postcard-mock-head {
    background: var(--color-navy); padding: 1.1rem 1.6rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;
  }
  .postcard-mock-logo { font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; color: #fff; text-transform: lowercase; }
  .postcard-mock-logo strong { color: var(--color-gold); }
  .postcard-mock-tag { font-size: 0.75rem; color: rgba(255,255,255,0.6); font-weight: 600; }
  .postcard-mock-grid { display: grid; grid-template-columns: 1fr 1fr; }
  @media (max-width: 40rem) { .postcard-mock-grid { grid-template-columns: 1fr; } }
  .postcard-tile { border-right: 1px dashed var(--color-line); border-bottom: 1px dashed var(--color-line); padding: 1.1rem; position: relative; }
  .postcard-tile:nth-child(2) { border-right: none; }
  .postcard-tile:nth-child(4) { border-right: none; }
  .postcard-tile-photo { height: 6.5rem; border-radius: 0.6rem; background-size: cover; background-position: center; margin-bottom: 0.8rem; }
  .postcard-tile-cat { font-size: 0.6875rem; font-weight: 700; color: var(--color-orange-dark); text-transform: uppercase; letter-spacing: 0.04em; }
  .postcard-tile h3 { font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; color: var(--color-navy); margin: 0.2rem 0 0.3rem; }
  .postcard-tile-offer { font-size: 0.8125rem; color: var(--color-navy-light); margin: 0; }
  .postcard-tile-qr { position: absolute; bottom: 1.1rem; right: 1.1rem; }
  .postcard-tile--open { background: var(--color-surface); }
  .postcard-tile-photo--empty {
    background: repeating-linear-gradient(45deg, var(--color-line), var(--color-line) 8px, transparent 8px, transparent 16px);
    display: flex; align-items: center; justify-content: center; color: var(--color-navy-light); border: 1.5px dashed var(--color-navy-light);
  }
  .postcard-tile-cat--open { color: var(--color-navy-light); }
  .postcard-tile-cta {
    display: inline-block; margin-top: 0.5rem; font-weight: 700; font-size: 0.8125rem; color: #fff;
    background: var(--color-orange); padding: 0.45rem 0.9rem; border-radius: var(--radius-pill); text-decoration: none;
  }
  .mockup-caption { font-size: 0.8125rem; color: var(--color-navy-light); text-align: center; margin-top: 1.6rem; }
  .benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 55rem) { .benefits-grid { grid-template-columns: 1fr; } }
  .benefit-card { background: #fff; border: 1px solid var(--color-line); border-radius: 1rem; padding: 1.6rem; box-shadow: 0 1px 3px rgba(13,23,48,0.06); }
  .benefit-icon { width: 3rem; height: 3rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--color-orange), var(--color-gold)); color: #fff; margin-bottom: 1rem; }
  .benefit-card h3 { font-size: 1.0625rem; color: var(--color-navy); margin: 0 0 0.5rem; }
  .benefit-card p { font-size: 0.9375rem; color: var(--color-navy-light); line-height: 1.55; margin: 0; }

  /* HOW IT WORKS */
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 55rem) { .how-grid { grid-template-columns: 1fr; } }
  .how-card { background: var(--color-surface); border-radius: 1rem; padding: 1.7rem; border: 1px solid var(--color-line); }
  .how-num { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; color: var(--color-orange-dark); margin-bottom: 0.6rem; }
  .how-card h3 { font-size: 1.0625rem; color: var(--color-navy); margin: 0 0 0.5rem; }
  .how-card p { font-size: 0.9375rem; color: var(--color-navy-light); line-height: 1.55; margin: 0; }

  /* FOUNDER NOTE */
  .founder-section { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 2.5rem; align-items: center; }
  @media (max-width: 45rem) { .founder-section { grid-template-columns: 1fr; } }
  .founder-photo { aspect-ratio: 4/5; border-radius: 1rem; background-size: cover; background-position: center; box-shadow: 0 16px 40px rgba(13,23,48,0.14); }
  .founder-copy p { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.55; color: var(--color-navy); font-style: italic; margin: 0 0 1rem; max-width: 48ch; }
  .founder-sign { font-family: var(--font-body) !important; font-style: normal !important; font-weight: 700; font-size: 0.9375rem !important; color: var(--color-navy-light) !important; }

  /* QUALIFY */
  .qualify-sub { color: var(--color-navy-light); font-size: 1rem; max-width: 56ch; margin-bottom: 1.8rem; }
  .qualify-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.3rem; }
  @media (max-width: 55rem) { .qualify-grid { grid-template-columns: 1fr; } }
  .qualify-item.card { background: #fff; border: 1px solid var(--color-line); border-radius: 1rem; padding: 1.5rem; box-shadow: 0 1px 3px rgba(13,23,48,0.06); }
  .qualify-item h3 { display: flex; align-items: center; gap: 0.5rem; font-size: 1rem; color: var(--color-navy); margin: 0 0 0.5rem; }
  .qualify-item p { font-size: 0.875rem; color: var(--color-navy-light); margin: 0; line-height: 1.5; }

  /* APPLY FORM */
  .apply-section h2 { font-size: 1.9rem; color: var(--color-navy); margin: 0.3rem 0 0.6rem; }
  .apply-sub { color: var(--color-navy-light); font-size: 1rem; max-width: 56ch; margin-bottom: 1.6rem; }
  .apply-form { max-width: 34rem; display: flex; flex-direction: column; gap: 1rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 30rem) { .form-row { grid-template-columns: 1fr; } }
  .apply-form label { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 600; font-size: 0.9375rem; color: var(--color-navy); }
  .apply-form input, .apply-form textarea {
    padding: 0.75rem 0.9rem; border-radius: 0.6rem; border: 1px solid var(--color-line);
    font-family: var(--font-body); font-size: 0.9375rem; background: var(--color-surface); resize: vertical;
  }
