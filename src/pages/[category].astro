---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BusinessCard from '../components/BusinessCard.astro';
import LayeredHero from '../components/LayeredHero.astro';
import Icon from '../components/Icon.astro';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const allBusinesses = await getCollection('businesses');
const businesses = allBusinesses.filter((b) => b.data.category.id === category.id);

const allArticles = await getCollection('articles');
const articles = allArticles.filter((a) => a.data.category.id === category.id);

const allFaqs = await getCollection('faqs');
const categoryFaqs = allFaqs.filter(
  (faq) => !faq.data.canonicalOf && faq.data.category.id === category.id
);
const renderedFaqs = await Promise.all(
  categoryFaqs.map(async (faq) => ({ faq, Content: (await render(faq)).Content }))
);

// Real photo for the hero background — prefer a real business photo from
// this category if one exists, otherwise a real Sioux Falls scenic photo
// (never the CSS-art fallback on this page — a real image was requested).
const businessWithPhoto = businesses.find((b) => b.data.heroImage);
const scenicFallbacks = ['/images/scenic/falls-park-1.jpg', '/images/scenic/downtown-2.jpg', '/images/scenic/falls-park-2.jpg'];
const scenicIndex = category.data.slug.length % scenicFallbacks.length;
const heroPhoto = category.data.heroImage || businessWithPhoto?.data.heroImage || scenicFallbacks[scenicIndex];

const INITIAL_COUNT = 6;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.data.seo.title,
};
---
<BaseLayout
  title={category.data.seo.title}
  description={category.data.seo.description}
  canonicalPath={`/${category.data.slug}`}
  schema={schema}
>
  <SiteHeader slot="header" />

  <LayeredHero
    eyebrow="Category"
    title={category.data.name}
    subtitle={category.data.seo.description}
    photoUrl={heroPhoto}
    centered
  >
    <nav class="hero-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/businesses">Directory</a> / <span>{category.data.name}</span>
    </nav>
    {businesses.length > 0 && (
      <p class="hero-stats">{businesses.length} business{businesses.length === 1 ? '' : 'es'} · {articles.length} local guide{articles.length === 1 ? '' : 's'}</p>
    )}
  </LayeredHero>

  <div class="container search-section">
    <div class="category-search">
      <input type="search" id="category-search-input" placeholder={`Search ${category.data.name.toLowerCase()}...`} aria-label={`Search ${category.data.name}`} />
      <button class="category-search-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>
    </div>
  </div>

  <div class="container page">
    {businesses.length > 0 ? (
      <section aria-labelledby="biz-heading">
        <h2 id="biz-heading">{category.data.name} businesses</h2>
        <div class="grid" id="category-business-grid">
          {businesses.map((business, i) => (
            <div class="grid-item" data-search={business.data.name.toLowerCase()} data-index={i} hidden={i >= INITIAL_COUNT}>
              <BusinessCard business={business} />
            </div>
          ))}
        </div>
        <p id="no-results" class="empty-note" hidden>No businesses match your search.</p>
        {businesses.length > INITIAL_COUNT && (
          <div class="see-more-wrap">
            <button id="see-more-btn" class="button button--ghost">See more ({businesses.length - INITIAL_COUNT} more)</button>
          </div>
        )}
      </section>
    ) : (
      <div class="empty-state">
        <p>This category is set up but doesn't have content yet.</p>
        <a class="button" href="/get-featured">Know a great {category.data.name.toLowerCase()} business? Suggest them →</a>
      </div>
    )}

  </div>

  {articles.length > 0 && (
    <section class="guides-band" aria-labelledby="guides-heading">
      <div class="container">
        <span class="eyebrow">From the Knowledge Base</span>
        <h2 id="guides-heading">Helpful guides for {category.data.name.toLowerCase()}</h2>
        <div class="grid">
          {articles.slice(0, 3).map((article) => (
            <a class="guide-card" href={`/guides/${article.id}`}>
              <div class="guide-card-media" style={article.data.heroImage ? `background-image: url(${article.data.heroImage})` : undefined}>
                {!article.data.heroImage && <Icon name={category.data.icon} size={26} class="guide-card-icon" />}
              </div>
              <div class="guide-card-body">
                <span class="guide-tag">{article.data.contentType.replace('-', ' ')}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="container page">
    {renderedFaqs.length > 0 && (
      <>
        <div class="contour-rule" role="presentation"></div>
        <section id="faqs" aria-labelledby="faqs-heading">
          <h2 id="faqs-heading">Frequently asked questions</h2>
          <div class="faq-list">
            {renderedFaqs.map(({ faq, Content }) => (
              <details class="faq-item">
                <summary>{faq.data.question}</summary>
                <div class="faq-answer"><Content /></div>
              </details>
            ))}
          </div>
        </section>
      </>
    )}
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero-breadcrumbs { font-size: 0.8125rem; color: rgba(255,255,255,0.7); margin-bottom: 0.5rem; }
  .hero-breadcrumbs a { color: rgba(255,255,255,0.7); }
  .hero-breadcrumbs a:hover { color: #fff; }
  .hero-stats { margin-top: var(--space-2); font-size: 0.9375rem; color: rgba(255,255,255,0.85); font-weight: 600; }

  .search-section { padding-block: var(--space-3); display: flex; justify-content: center; }
  .category-search { display: flex; gap: 0.5rem; max-width: 30rem; width: 100%; }
  .category-search input {
    flex: 1; padding: 0.85rem 1.2rem; border-radius: var(--radius-pill); border: 1.5px solid var(--color-line);
    font-size: 0.9375rem; box-shadow: 0 2px 10px rgba(13,23,48,0.06);
  }
  .category-search-btn {
    width: 2.9rem; height: 2.9rem; border-radius: 50%; border: none; flex-shrink: 0;
    background: var(--color-orange); color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .category-search-btn:hover { background: var(--color-orange-dark); transform: scale(1.05); }

  .page { padding-block: 0 var(--space-6); }
  .contour-rule { height: 1px; background: var(--color-line); margin-block: var(--space-5); }

  .guides-band {
    background: var(--color-river-light, #EAF2F8);
    padding-block: var(--space-5);
    margin-block: var(--space-5);
  }
  .guides-band .eyebrow { display: block; margin-bottom: 0.2rem; }
  .page :global(.eyebrow) { display: block; margin-bottom: 0.2rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  @media (max-width: 55rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .grid { grid-template-columns: 1fr; } }

  .see-more-wrap { text-align: center; margin-top: var(--space-3); }
  .empty-note { text-align: center; color: var(--color-navy-light); margin-top: var(--space-3); }

  .guide-card {
    display: block; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(27,42,74,0.05);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .guide-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(240,126,35,0.14); border-color: var(--color-orange); }
  .guide-card-media {
    height: 12.5rem; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 60%, #F07E23 160%);
    background-size: cover; background-position: center;
  }
  .guide-card-icon { color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); }
  .guide-card-body { padding: var(--space-2); }
  .guide-tag { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-orange); }
  .guide-card h3 { font-size: 1.0625rem; margin: 0.3rem 0 0.35rem; }
  .guide-card p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }

  .faq-list { margin-top: var(--space-3); display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-2); }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--color-navy); }
  .faq-answer { margin-top: var(--space-1); font-size: 0.9375rem; }
  .faq-answer :global(p) { margin: 0; }

  .empty-state { text-align: center; padding: var(--space-5) 0; color: var(--color-navy-light); }
  .empty-state .button { margin-top: var(--space-2); }
</style>

<script>
  const searchInput = document.getElementById('category-search-input') as HTMLInputElement;
  const items = Array.from(document.querySelectorAll('#category-business-grid .grid-item'));
  const noResults = document.getElementById('no-results')!;
  const seeMoreBtn = document.getElementById('see-more-btn');
  const INITIAL_COUNT = 6;
  let expanded = false;

  function render() {
    const q = searchInput?.value.trim().toLowerCase() || '';
    let visibleCount = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const index = Number(el.dataset.index);
      const matchesSearch = !q || el.dataset.search?.includes(q);
      const withinLimit = expanded || q || index < INITIAL_COUNT;
      const visible = matchesSearch && withinLimit;
      el.hidden = !visible;
      if (visible) visibleCount++;
    });
    noResults.hidden = visibleCount > 0;
    if (seeMoreBtn) (seeMoreBtn as HTMLElement).style.display = (q || expanded) ? 'none' : '';
  }

  searchInput?.addEventListener('input', render);
  seeMoreBtn?.addEventListener('click', () => {
    expanded = true;
    render();
  });
</script>
