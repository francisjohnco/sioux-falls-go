---
import { articleHero } from '../lib/hero';
import { getCollection, render } from 'astro:content';
import { getLiveArticles, newestFirst } from '../lib/articles';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BusinessCard from '../components/BusinessCard.astro';
import LayeredHero from '../components/LayeredHero.astro';
import { categoryHero } from '../lib/hero';
import Icon from '../components/Icon.astro';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const allCategories = await getCollection('categories');
const allBusinesses = await getCollection('businesses');
const allArticles = await getLiveArticles();

// Recursively collect every business under a category, including its
// children's children, grouped by which category they're actually tagged
// with. The category's own direct businesses come first as a group, then
// one group per direct child (itself expanded recursively).
function collectGroups(cat: typeof category): { key: string; label: string; businesses: typeof allBusinesses }[] {
  const direct = allBusinesses.filter((b) => b.data.category.id === cat.id);
  const groups = direct.length > 0 ? [{ key: cat.data.slug, label: cat.data.name, businesses: direct }] : [];
  const children = allCategories.filter((c) => c.data.parentCategory?.id === cat.id);
  for (const child of children) {
    groups.push(...collectGroups(child));
  }
  return groups;
}

const groups = collectGroups(category);
const businesses = groups.flatMap((g) => g.businesses);
const isAggregated = groups.length > 1 || (groups.length === 1 && groups[0].key !== category.data.slug);

const articles = allArticles.filter((a) => a.data.category.id === category.id).sort(newestFirst);

const allFaqs = await getCollection('faqs');
const categoryFaqs = allFaqs.filter(
  (faq) => !faq.data.canonicalOf && faq.data.category.id === category.id
);
const renderedFaqs = await Promise.all(
  categoryFaqs.map(async (faq) => ({ faq, Content: (await render(faq)).Content }))
);

// The category's own photo, picked to show what the category is about.
// Never borrowed from a business in the category.
const hero = categoryHero(category, articles);
const heroPhoto = hero.large;

const INITIAL_COUNT = 6;

// Search description: the category's own, unless it is still the old
// one-line template, in which case it is built from the real listings.
const rated = businesses.filter((b) => typeof b.data.googleRating === 'number');
const minRating = rated.length ? Math.min(...rated.map((b) => b.data.googleRating as number)) : 0;
const lower = category.data.name.toLowerCase();
const isGeneric = (d: string) => /^(find trusted|discover|sioux falls )/i.test(d) || d.length < 90;
const metaDescription = !isGeneric(category.data.seo.description) ? category.data.seo.description
  : businesses.length
    ? `Compare ${businesses.length >= 3 ? `${businesses.length} ` : ''}top-rated ${lower} in Sioux Falls, SD${rated.length >= 2 && minRating >= 4.5 ? `, each rated ${minRating.toFixed(1)} stars${minRating < 5 ? ' or higher' : ''} on Google` : ''}. Hours, phone numbers, and local guides in one place.`.slice(0, 158)
    : `${category.data.name} in Sioux Falls, SD: local guides, answers to common questions, and what to look for when you hire.`.slice(0, 158);

// Questions: the category's own plus any from the FAQ library, no repeats.
const ownFaqs = (category.data.faqs || []).map((f) => ({ q: f.q, a: f.a }));
const seenQ = new Set(ownFaqs.map((f) => f.q.toLowerCase()));
const libraryFaqs = renderedFaqs.filter(({ faq }) => !seenQ.has(faq.data.question.toLowerCase()));

// Related categories: the parent, its other children, and this category's children.
const parentId = category.data.parentCategory?.id;
const related = allCategories.filter((c) => c.id !== category.id && (
  c.id === parentId || (parentId && c.data.parentCategory?.id === parentId) || c.data.parentCategory?.id === category.id
)).sort((a, b) => a.data.name.localeCompare(b.data.name)).slice(0, 12);

const newestArticle = articles.map((a) => a.data.publishedAt.toISOString().slice(0, 10)).sort().pop();
const updatedOn = [category.data.contentUpdatedAt, newestArticle].filter(Boolean).sort().pop();
const updatedLabel = updatedOn ? new Date(`${updatedOn}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';

const site = 'https://siouxfallsgo.com';
const pageUrl = `${site}/${category.data.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.data.seo.title,
    description: metaDescription,
    url: pageUrl,
    ...(businesses.length ? { mainEntity: {
      '@type': 'ItemList',
      numberOfItems: businesses.length,
      itemListElement: businesses.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site}/businesses/${b.id}/`, name: b.data.name })),
    } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Directory', item: `${site}/businesses/` },
      { '@type': 'ListItem', position: 3, name: category.data.name, item: pageUrl },
    ],
  },
  ...(ownFaqs.length ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ownFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }] : []),
];
---
<BaseLayout
  title={category.data.seo.title}
  description={metaDescription}
  canonicalPath={`/${category.data.slug}`}
  schema={schema}
  ogImage={hero.og}
  ogImageAlt={hero.alt}
>
  <SiteHeader slot="header" />

  <LayeredHero
    eyebrow="Category"
    title={category.data.name}
    subtitle={metaDescription}
    photoUrl={heroPhoto}
    photoAlt={hero.alt}
    photoCredit={hero.credit ? `Photo: ${hero.credit.photographer} on ${hero.credit.source}` : undefined}
    centered
  >
    <nav class="hero-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/businesses">Directory</a> / <span>{category.data.name}</span>
    </nav>
    {businesses.length > 0 && (
      <p class="hero-stats">{businesses.length} business{businesses.length === 1 ? '' : 'es'}{articles.length > 0 && ` · ${articles.length} local guide${articles.length === 1 ? '' : 's'}`}{updatedLabel && ` · Updated ${updatedLabel}`}</p>
    )}
  </LayeredHero>

  <div class="container search-section">
    <div class="category-search">
      <input type="search" id="category-search-input" placeholder={`Search ${category.data.name.toLowerCase()}...`} aria-label={`Search ${category.data.name}`} />
      <button class="category-search-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>
    </div>
  </div>

  <div class="container page">
    {businesses.length > 0 ? (
      <section aria-labelledby="biz-heading">
        <h2 id="biz-heading">{category.data.name} businesses</h2>
        {groups.map((group) => (
          <div class="category-group" data-group={group.key}>
            {isAggregated && <h3 class="category-group-heading"><a href={`/${group.key}`} class="category-link">{group.label}</a></h3>}
            <div class="grid category-business-grid" data-grid={group.key}>
              {group.businesses.map((business, i) => (
                <div class="grid-item" data-search={business.data.name.toLowerCase()} data-index={i} hidden={i >= INITIAL_COUNT}>
                  <BusinessCard business={business} />
                </div>
              ))}
            </div>
            <p class="empty-note" data-no-results={group.key} hidden>No businesses match your search.</p>
            {group.businesses.length > INITIAL_COUNT && (
              <div class="see-more-wrap">
                <button class="button button--ghost see-more-btn" data-see-more={group.key}>See more ({group.businesses.length - INITIAL_COUNT} more)</button>
              </div>
            )}
          </div>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        <p>This category is set up but doesn't have content yet.</p>
        <a class="button" href="/get-featured">Know a great {category.data.name.toLowerCase()} business? Suggest them →</a>
      </div>
    )}

    {(category.data.intro || category.data.tips?.length) && (
      <section class="choose" aria-labelledby="choose-heading">
        <h2 id="choose-heading">How to choose {lower} in Sioux Falls</h2>
        <div class="choose-grid">
          {category.data.intro && <div class="choose-intro">{category.data.intro.split(/\n\s*\n/).map((p) => <p>{p}</p>)}</div>}
          {category.data.tips?.length && (
            <div class="choose-tips">
              <h3>What to look for</h3>
              <ul>{category.data.tips.map((t) => <li><Icon name="check" size={16} /><span>{t}</span></li>)}</ul>
            </div>
          )}
        </div>
      </section>
    )}
  </div>

  {articles.length > 0 && (
    <section class="guides-band" aria-labelledby="guides-heading">
      <div class="container">
        <span class="eyebrow">From the Knowledge Base</span>
        <h2 id="guides-heading">Helpful guides for {category.data.name.toLowerCase()}</h2>
        <div class="grid">
          {articles.slice(0, 6).map((article) => (
            <a class="guide-card" href={`/guides/${article.id}`}>
              <div class="guide-card-media has-photo"><img src={articleHero(article).card} alt="" width="480" height="270" loading="lazy" decoding="async" />
              </div>
              <div class="guide-card-body">
                <span class="guide-tag">{article.data.contentType.replace('-', ' ')}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.seo.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="container page">
    {(ownFaqs.length > 0 || libraryFaqs.length > 0) && (
      <>
        <div class="contour-rule" role="presentation"></div>
        <section id="faqs" aria-labelledby="faqs-heading">
          <h2 id="faqs-heading">{category.data.name} questions, answered for Sioux Falls</h2>
          <div class="faq-list">
            {ownFaqs.map((f, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>{f.q}</summary>
                <div class="faq-answer"><p>{f.a}</p></div>
              </details>
            ))}
            {libraryFaqs.map(({ faq, Content }) => (
              <details class="faq-item">
                <summary>{faq.data.question}</summary>
                <div class="faq-answer"><Content /></div>
              </details>
            ))}
          </div>
          <p class="faq-more"><a href="/faqs/local-service-faqs">More Sioux Falls answers by industry →</a></p>
        </section>
      </>
    )}

    {related.length > 0 && (
      <section class="related-cats" aria-labelledby="related-heading">
        <h2 id="related-heading">Related categories</h2>
        <div class="related-chips">
          {related.map((c) => <a href={`/${c.data.slug}`}><Icon name={c.data.icon} size={16} />{c.data.name}</a>)}
        </div>
      </section>
    )}
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .choose { margin-top: var(--space-6); }
  .choose-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-4); align-items: start; margin-top: var(--space-3); }
  .choose-intro p { margin: 0 0 1rem; line-height: 1.65; color: var(--color-ink); }
  .choose-tips { background: var(--color-river-light); border-radius: 1rem; padding: 1.2rem 1.3rem; }
  .choose-tips h3 { margin: 0 0 0.7rem; font-size: 1rem; color: var(--color-navy); }
  .choose-tips ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .choose-tips li { display: flex; gap: 0.55rem; align-items: flex-start; line-height: 1.45; font-size: 0.9375rem; }
  .choose-tips li :global(svg) { flex: none; margin-top: 0.2rem; color: var(--color-river); }
  .faq-more { margin-top: var(--space-2); font-weight: 700; }
  .related-cats { margin-top: var(--space-6); }
  .related-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--space-2); }
  .related-chips a { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.9rem; border: 1px solid var(--color-line); border-radius: 99px; color: var(--color-navy); font-weight: 600; font-size: 0.875rem; text-decoration: none; background: #fff; }
  .related-chips a:hover { border-color: var(--color-orange); color: var(--color-orange-dark); }
  @media (max-width: 760px) { .choose-grid { grid-template-columns: 1fr; } }
  .hero-breadcrumbs { font-size: 0.8125rem; color: rgba(255,255,255,0.7); margin-bottom: 0.5rem; }
  .hero-breadcrumbs a { color: rgba(255,255,255,0.7); }
  .hero-breadcrumbs a:hover { color: #fff; }
  .hero-stats { margin-top: var(--space-2); font-size: 0.9375rem; color: rgba(255,255,255,0.85); font-weight: 600; }
  .category-group { margin-top: var(--space-6); }
  .category-group:first-child { margin-top: 0; }
  .category-group-heading { font-size: 1.25rem; margin-bottom: var(--space-3); }
  .category-group-heading .category-link { color: inherit; text-decoration: underline; text-decoration-color: rgba(0,0,0,0.25); text-underline-offset: 0.2em; }
  .category-group-heading .category-link:hover { text-decoration-color: currentColor; }

  .search-section { padding-block: var(--space-3); display: flex; justify-content: center; }
  .category-search { display: flex; gap: 0.5rem; max-width: 30rem; width: 100%; }
  .category-search input {
    flex: 1; padding: 0.85rem 1.2rem; border-radius: var(--radius-pill); border: 1.5px solid var(--color-line);
    font-size: 0.9375rem; box-shadow: 0 2px 10px rgba(13,23,48,0.06);
  }
  .category-search-btn {
    width: 2.9rem; height: 2.9rem; border-radius: 50%; border: none; flex-shrink: 0;
    background: var(--color-orange); color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .category-search-btn:hover { background: var(--color-orange-dark); transform: scale(1.05); }

  .page { padding-block: 0 var(--space-6); }
  .contour-rule { height: 1px; background: var(--color-line); margin-block: var(--space-5); }

  .guides-band {
    background: var(--color-river-light, #EAF2F8);
    padding-block: var(--space-5);
    margin-block: var(--space-5);
  }
  .guides-band .eyebrow { display: block; margin-bottom: 0.2rem; }
  .page :global(.eyebrow) { display: block; margin-bottom: 0.2rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  @media (max-width: 55rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .grid { grid-template-columns: 1fr; } }

  .see-more-wrap { text-align: center; margin-top: var(--space-3); }
  .empty-note { text-align: center; color: var(--color-navy-light); margin-top: var(--space-3); }

  .guide-card {
    display: block; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(27,42,74,0.05);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .guide-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(240,126,35,0.14); border-color: var(--color-orange); }
  .guide-card-media {
    height: 12.5rem; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 60%, #F07E23 160%);
    background-size: cover; background-position: center;
  }
  .guide-card-icon { color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25)); }
  .guide-card-body { padding: var(--space-2); }
  .guide-tag { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-orange); }
  .guide-card h3 { font-size: 1.0625rem; margin: 0.3rem 0 0.35rem; }
  .guide-card p { color: var(--color-navy-light); font-size: 0.9375rem; margin: 0; }

  .faq-list { margin-top: var(--space-3); display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-2); }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--color-navy); }
  .faq-answer { margin-top: var(--space-1); font-size: 0.9375rem; }
  .faq-answer :global(p) { margin: 0; }

  .empty-state { text-align: center; padding: var(--space-5) 0; color: var(--color-navy-light); }
  .empty-state .button { margin-top: var(--space-2); }
  .has-photo { position: relative; overflow: hidden; }
  .has-photo > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>

<script>
  const searchInput = document.getElementById('category-search-input') as HTMLInputElement;
  const groupEls = Array.from(document.querySelectorAll('.category-group'));
  const INITIAL_COUNT = 6;
  const expandedGroups = new Set<string>();

  function render() {
    const q = searchInput?.value.trim().toLowerCase() || '';
    groupEls.forEach((groupEl) => {
      const key = (groupEl as HTMLElement).dataset.group!;
      const expanded = expandedGroups.has(key);
      const items = Array.from(groupEl.querySelectorAll('.grid-item'));
      let visibleCount = 0;
      items.forEach((item) => {
        const el = item as HTMLElement;
        const index = Number(el.dataset.index);
        const matchesSearch = !q || el.dataset.search?.includes(q);
        const withinLimit = expanded || q || index < INITIAL_COUNT;
        const visible = matchesSearch && withinLimit;
        el.hidden = !visible;
        if (visible) visibleCount++;
      });
      const noResults = groupEl.querySelector(`[data-no-results="${key}"]`) as HTMLElement | null;
      if (noResults) noResults.hidden = visibleCount > 0;
      (groupEl as HTMLElement).hidden = q ? visibleCount === 0 : false;
      const seeMoreBtn = groupEl.querySelector(`[data-see-more="${key}"]`) as HTMLElement | null;
      if (seeMoreBtn) seeMoreBtn.style.display = (q || expanded) ? 'none' : '';
    });
  }

  searchInput?.addEventListener('input', render);
  groupEls.forEach((groupEl) => {
    const key = (groupEl as HTMLElement).dataset.group!;
    const seeMoreBtn = groupEl.querySelector(`[data-see-more="${key}"]`);
    seeMoreBtn?.addEventListener('click', () => {
      expandedGroups.add(key);
      render();
    });
  });
</script>
