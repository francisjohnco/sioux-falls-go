---
const year = new Date().getFullYear();
const columns = [
  {
    title: 'Sioux Falls Go',
    links: [
      { href: '/about', label: 'About' },
      { href: '/guides', label: 'Blog' },
      { href: '/sioux-falls-top-picks-trusted-local-businesses-by-category-2', label: 'Top Picks' },
      { href: '/resource-shelf', label: 'The Resource Shelf' },
      { href: '/contact', label: 'Contact' },
      { href: '/privacy-policy', label: 'Privacy Policy' },
      { href: '/terms-of-use', label: 'Terms of Use' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: '/visit-sioux-falls', label: 'Visit Sioux Falls' },
      { href: '/spotlight-giveaway', label: 'Spotlight Giveaway' },
      { href: '/local-deals', label: 'Local Deals' },
      { href: '/businesses', label: 'Directory' },
      { href: '/guides', label: 'Resources' },
      { href: '/faqs/local-service-faqs', label: 'Local Service FAQs' },
    ],
  },
  {
    title: 'Service Providers',
    links: [
      { href: '/get-featured', label: 'Get Featured' },
      { href: '/postcard', label: 'Postcard Advertising' },
      { href: '/badges', label: 'Banners & Badges' },
      { href: '/earn-badges', label: 'Earn Your Badge' },
      { href: '/host-login', label: 'Host Login' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="footer-top">
    <div class="container footer-top-inner">
      <div class="footer-brand">
        <a href="/" class="footer-wordmark">sioux falls <strong>go</strong></a>
        <p class="footer-tagline">The homepage for living in Sioux Falls &mdash; real local businesses, checked by real people.</p>
        <div class="footer-social">
          <a href="https://www.facebook.com/SiouxFallsGo" rel="noopener" target="_blank" aria-label="Sioux Falls Go on Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/siouxfallsgo/" rel="noopener" target="_blank" aria-label="Sioux Falls Go on Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <form name="footer-newsletter" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="footer-newsletter">
        <input type="hidden" name="form-name" value="footer-newsletter" />
        <p class="honeypot-field"><label>Don't fill this out if you're human: <input name="not_human" /></label></p>
        <span class="footer-newsletter-label">Stay in the loop</span>
        <div class="footer-newsletter-row">
          <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />
          <button type="submit" aria-label="Subscribe">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="container footer-grid">
    {columns.map((col) => (
      <div class="footer-col">
        <h4>{col.title}</h4>
        <nav>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    ))}
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} Sioux Falls Go &mdash; the homepage for living in Sioux Falls.</p>
    <a href="#top" class="footer-back-top">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy); color: #fff; margin-top: var(--space-6);
    position: relative;
  }
  .site-footer::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--color-orange) 0%, var(--color-gold) 50%, var(--color-orange) 100%);
  }

  .footer-top { border-bottom: 1px solid rgba(255,255,255,0.1); padding-block: var(--space-4); }
  .footer-top-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-4); flex-wrap: wrap; }

  .footer-wordmark { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: #fff; text-decoration: none; text-transform: lowercase; }
  .footer-wordmark strong { color: var(--color-gold); }
  .footer-tagline { color: rgba(255,255,255,0.6); font-size: 0.9375rem; max-width: 30ch; margin: 0.6rem 0 1.1rem; line-height: 1.5; }
  .footer-social { display: flex; gap: 0.7rem; }
  .footer-social a {
    width: 2.3rem; height: 2.3rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.75); border: 1px solid rgba(255,255,255,0.18); transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .footer-social a:hover { color: var(--color-navy); background: var(--color-gold); border-color: var(--color-gold); }

  .footer-newsletter { min-width: 18rem; }
  .footer-newsletter-label { display: block; font-weight: 700; font-size: 0.8125rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.6rem; }
  .footer-newsletter-row { display: flex; gap: 0.6rem; }
  .footer-newsletter-row input {
    flex: 1; padding: 0.7rem 1rem; border-radius: var(--radius); border: 1px solid rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06); color: #fff; font-family: var(--font-body); font-size: 0.9375rem;
  }
  .footer-newsletter-row input::placeholder { color: rgba(255,255,255,0.4); }
  .footer-newsletter-row input:focus { outline: none; border-color: var(--color-orange); }
  .footer-newsletter-row button {
    width: 2.8rem; height: 2.8rem; flex-shrink: 0; border-radius: var(--radius); border: none; cursor: pointer;
    background: var(--color-orange); color: #fff; display: flex; align-items: center; justify-content: center;
    transition: background 0.15s ease;
  }
  .footer-newsletter-row button:hover { background: var(--color-orange-dark); }
  .honeypot-field { position: absolute; left: -9999px; }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .footer-col h4 { color: #fff; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2); opacity: 0.75; }
  .footer-col nav { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-col a { color: rgba(255,255,255,0.7); font-size: 0.9375rem; text-decoration: none; transition: color 0.15s ease; }
  .footer-col a:hover { color: var(--color-gold); }

  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-block: var(--space-3);
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.5);
  }
  .footer-back-top { color: rgba(255,255,255,0.5); text-decoration: none; font-weight: 600; transition: color 0.15s ease; }
  .footer-back-top:hover { color: var(--color-gold); }

  @media (max-width: 45rem) {
    .footer-top-inner { flex-direction: column; align-items: flex-start; }
    .footer-newsletter { width: 100%; }
  }
</style>
