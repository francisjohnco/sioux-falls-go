---
const year = new Date().getFullYear();
const columns = [
  {
    title: 'Sioux Falls Go',
    links: [
      { href: '/about', label: 'About' },
      { href: '/guides', label: 'Blog' },
      { href: '/sioux-falls-top-picks-trusted-local-businesses-by-category-2', label: 'Top Picks' },
      { href: '/resource-shelf', label: 'The Resource Shelf' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: '/visit-sioux-falls', label: 'Visit Sioux Falls' },
      { href: '/spotlight-giveaway', label: 'Spotlight Giveaway' },
      { href: '/local-deals', label: 'Local Deals' },
      { href: '/businesses', label: 'Directory' },
      { href: '/faqs/local-service-faqs', label: 'Local Service FAQs' },
    ],
  },
  {
    title: 'Service Providers',
    links: [
      { href: '/get-featured', label: 'Get Featured' },
      { href: '/postcard', label: 'Postcard Advertising' },
      { href: '/badges', label: 'Banners & Badges' },
      { href: '/earn-badges', label: 'Earn Your Badge' },
      { href: '/host-login', label: 'Host Login' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="footer-logo-link">
        <img src="/images/sfg-logo.png" alt="Sioux Falls Go" class="footer-logo" />
      </a>
      <p class="footer-tagline">The homepage for living in Sioux Falls &mdash; real local businesses, checked by real people.</p>

      <form name="footer-newsletter" method="POST" data-netlify="true" data-netlify-honeypot="not_human" class="footer-newsletter">
        <input type="hidden" name="form-name" value="footer-newsletter" />
        <p class="honeypot-field"><label>Don't fill this out if you're human: <input name="not_human" /></label></p>
        <span class="footer-newsletter-label">Stay In The Loop</span>
        <div class="footer-newsletter-row">
          <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />
          <button type="submit" aria-label="Subscribe">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      </form>

      <div class="footer-social">
        <a href="https://www.facebook.com/SiouxFallsGo" rel="noopener" target="_blank" aria-label="Sioux Falls Go on Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.instagram.com/siouxfallsgo/" rel="noopener" target="_blank" aria-label="Sioux Falls Go on Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer-links">
      {columns.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      ))}
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Sioux Falls Go &mdash; the homepage for living in Sioux Falls.</p>
    <div class="footer-bottom-links">
      <a href="/privacy-policy">Privacy Policy</a>
      <span class="footer-bottom-dot">&middot;</span>
      <a href="/terms-of-use">Terms of Use</a>
      <span class="footer-bottom-dot">&middot;</span>
      <a href="#top" class="footer-back-top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy); color: #fff; margin-top: var(--space-6);
    position: relative;
  }
  .site-footer::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--color-orange) 0%, var(--color-gold) 50%, var(--color-orange) 100%);
  }

  .footer-main {
    display: grid; grid-template-columns: 1.3fr 2fr; gap: clamp(2.5rem, 5vw, 5rem);
    padding-block: var(--space-6) var(--space-5);
  }
  @media (max-width: 55rem) { .footer-main { grid-template-columns: 1fr; gap: var(--space-5); } }

  .footer-logo-link { display: inline-block; }
  .footer-logo { height: 2.1rem; width: auto; filter: brightness(0) invert(1); display: block; }
  .footer-tagline { color: rgba(255,255,255,0.62); font-size: 0.9375rem; max-width: 26ch; margin: 1.1rem 0 1.6rem; line-height: 1.55; }

  .footer-newsletter-label { display: block; font-weight: 700; font-size: 0.75rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.7rem; }
  .footer-newsletter-row { display: flex; gap: 0.6rem; max-width: 22rem; }
  .footer-newsletter-row input {
    flex: 1; min-width: 0; padding: 0.75rem 1rem; border-radius: var(--radius); border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.05); color: #fff; font-family: var(--font-body); font-size: 0.9375rem;
  }
  .footer-newsletter-row input::placeholder { color: rgba(255,255,255,0.38); }
  .footer-newsletter-row input:focus { outline: none; border-color: var(--color-orange); background: rgba(255,255,255,0.08); }
  .footer-newsletter-row button {
    width: 2.9rem; height: 2.9rem; flex-shrink: 0; border-radius: var(--radius); border: none; cursor: pointer;
    background: var(--color-orange); color: #fff; display: flex; align-items: center; justify-content: center;
    transition: background 0.15s ease;
  }
  .footer-newsletter-row button:hover { background: var(--color-orange-dark); }
  .honeypot-field { position: absolute; left: -9999px; }

  .footer-social { display: flex; gap: 0.6rem; margin-top: 1.8rem; }
  .footer-social a {
    width: 2.2rem; height: 2.2rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.16); transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .footer-social a:hover { color: var(--color-navy); background: var(--color-gold); border-color: var(--color-gold); }

  .footer-links {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4);
  }
  @media (max-width: 34rem) { .footer-links { grid-template-columns: 1fr 1fr; } }
  .footer-col { display: flex; flex-direction: column; }
  .footer-col h4 { color: #fff; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; margin: 0 0 1.1rem; opacity: 0.85; }
  .footer-col a { color: rgba(255,255,255,0.66); font-size: 0.9375rem; text-decoration: none; transition: color 0.15s ease; padding-block: 0.4rem; }
  .footer-col a:hover { color: var(--color-gold); }

  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-block: 1.4rem;
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.48);
  }
  .footer-bottom-links { display: flex; align-items: center; gap: 0.6rem; }
  .footer-bottom-links a { color: rgba(255,255,255,0.48); text-decoration: none; transition: color 0.15s ease; }
  .footer-bottom-links a:hover { color: var(--color-gold); }
  .footer-bottom-dot { opacity: 0.4; }

  @media (max-width: 30rem) {
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
