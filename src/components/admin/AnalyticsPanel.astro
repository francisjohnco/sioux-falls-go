---
// Admin Analytics tab. Loads when the tab is first opened.
interface Props { names: Record<string, string> }
const { names } = Astro.props;
---
<div class="an" id="analytics-root" data-names={JSON.stringify(names)}>
  <div class="an-head">
    <div>
      <h1>Analytics</h1>
      <p class="an-sub" id="an-range">How people find Sioux Falls Go on Google, and what they do on business profiles.</p>
    </div>
    <button class="button button--ghost" id="an-refresh" type="button">Refresh now</button>
  </div>
  <p class="an-fresh" id="an-fresh" hidden></p>
  <p class="an-msg" id="an-msg">Loading analytics...</p>

  <div id="an-body" hidden>
    <section class="an-wait" id="an-wait" hidden>
      <h2>Your full analytics view is waiting on Google</h2>
      <p id="an-wait-why">The plain-English summary, the River, your position by industry, the weekly chart, and the search splits all come from Google Search Console, which is not connected yet. Profile visits and taps below are already counting.</p>
      <ol>
        <li>In Google Search Console, verify siouxfallsgo.com with the <b>HTML tag</b> method (the tag is already on the site).</li>
        <li>In Netlify, set <b>GSC_SITE_PROPERTY</b> to <b>https://siouxfallsgo.com/</b> and redeploy.</li>
        <li>Here in Admin, open <b>Content Engine</b> and click <b>Connect Search Console</b>, using the same Google account.</li>
      </ol>
      <p class="an-small">Google needs a few days after connecting before numbers appear, and always runs about two days behind.</p>
    </section>

    <section class="an-story" id="an-story" hidden>
      <h2>In plain English</h2>
      <ul id="an-story-list"></ul>
    </section>

    <section class="an-card an-river-card" id="an-river" hidden>
      <div class="an-card-head"><h2>The River, from a Google search to a customer</h2><p>Last 4 weeks. Each stop shows how many people made it that far, and the river narrows the way real interest does.</p></div>
      <div id="an-river-svg"></div>
      <p class="an-small">"Opened a business" counts every visit to a business profile, including people who arrived from inside Sioux Falls Go, not only from Google.</p>
    </section>

    <div class="an-kpis" id="an-kpis"></div>

    <section class="an-card" id="an-trend" hidden>
      <div class="an-card-head"><h2>Google search, week by week</h2><span class="an-legend"><i class="k1"></i>Times seen <i class="k2"></i>Clicks</span></div>
      <div id="an-chart"></div>
    </section>

    <div class="an-glance" id="an-glance" hidden>
      <section class="an-card"><div class="an-card-head"><h2>Where Google sends people</h2><p>Clicks from Google by kind of page.</p></div><div id="an-types"></div></section>
      <section class="an-card"><div class="an-card-head"><h2>Phone or computer</h2><p>Clicks from Google by device.</p></div><div id="an-devices"></div></section>
      <section class="an-card"><div class="an-card-head"><h2>New people finding you</h2><p>Clicks from searches that did not include "Sioux Falls Go".</p></div><div id="an-discovery"></div></section>
      <section class="an-card"><div class="an-card-head"><h2>What visitors tap</h2><p>Contact taps on business profiles this month.</p></div><div id="an-taps"></div></section>
    </div>

    <section class="an-card" id="an-ind" hidden>
      <div class="an-card-head"><h2>Your Google position by industry</h2><p>Each industry's category page, guides, and business profiles together. The bar shows how often Google showed them; position is the average spot on the results page (1 is the top, lower is better).</p></div>
      <div class="an-ind" id="an-ind-list"></div>
    </section>

    <section class="an-card" id="an-wins" hidden>
      <div class="an-card-head"><h2>Quick wins: better titles</h2><p>Pages Google shows often near the top, but few people click. A sharper title and description usually lifts these first.</p></div>
      <div class="an-table-wrap"><table class="an-table" id="an-wins-t"></table></div>
    </section>

    <section class="an-card" id="an-queries" hidden>
      <div class="an-card-head"><h2>Top searches</h2><p>Last 4 weeks, sorted by clicks.</p></div>
      <div class="an-table-wrap"><table class="an-table" id="an-queries-t"></table></div>
    </section>

    <section class="an-card" id="an-pages" hidden>
      <div class="an-card-head"><h2>Top pages</h2><p>Last 4 weeks, sorted by clicks.</p></div>
      <div class="an-table-wrap"><table class="an-table" id="an-pages-t"></table></div>
    </section>

    <section class="an-card">
      <div class="an-card-head"><h2>Business profiles this month</h2><p>Visits and contact taps counted on each profile (calls, directions, website, quote requests). Open any business's full report to share with the owner.</p></div>
      <div class="an-table-wrap"><table class="an-table" id="an-biz-t"></table></div>
    </section>
    <p class="an-note" id="an-note"></p>
  </div>
</div>

<script>
  const root = document.getElementById('analytics-root')!;
  const names: Record<string, string> = JSON.parse(root.dataset.names || '{}');
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const n = (v: number) => Math.round(v).toLocaleString();
  const d = (s: string) => new Date(`${s}T12:00:00Z`).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  let loaded = false;
  const SERIES = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4'];
  const DARK_TEXT = new Set(['#eda100', '#e87ba4']);

  // One whole split into parts: a tall segmented bar with the share printed on
  // each block where it fits, and a legend that names every part.
  function segBar(parts: { label: string; value: number }[], unit = 'clicks') {
    const total = parts.reduce((t, p) => t + p.value, 0);
    if (!total) return '<p class="an-empty">Nothing counted yet.</p>';
    const shown = parts.filter((p) => p.value > 0).slice(0, 5);
    const blocks = shown.map((p, i) => {
      const pct = (p.value / total) * 100, c = SERIES[i];
      return `<div class="seg" style="flex:${p.value};background:${c};color:${DARK_TEXT.has(c) ? '#0b0b0b' : '#fff'}" title="${esc(p.label)}: ${n(p.value)} ${unit} (${Math.round(pct)}%)">${pct >= 12 ? `${Math.round(pct)}%` : ''}</div>`;
    }).join('');
    const legend = shown.map((p, i) => `<li><i style="background:${SERIES[i]}"></i>${esc(p.label)}<b>${n(p.value)}</b></li>`).join('');
    return `<div class="segbar" role="img" aria-label="${shown.map((p) => `${p.label} ${Math.round((p.value / total) * 100)}%`).join(', ')}">${blocks}</div><ul class="seglegend">${legend}</ul>`;
  }

  // The River: four stops, the band's width shrinking with each step.
  // On phones the river runs top to bottom so every label stays readable.
  function riverVertical(stops: { label: string; value: number }[]) {
    const W = 360, H = 520, mid = 70, ys = [50, 180, 310, 440];
    const max = Math.max(...stops.map((s2) => s2.value), 1);
    const th = stops.map((s2) => 10 + 70 * (Math.log10(s2.value + 1) / Math.log10(max + 1)));
    const curve = (pts: number[][], move = true) => pts.map((p, i) => (i === 0 ? `${move ? 'M' : 'L'}${p[0]},${p[1]}` : `C${pts[i - 1][0]},${(pts[i - 1][1] + p[1]) / 2} ${p[0]},${(pts[i - 1][1] + p[1]) / 2} ${p[0]},${p[1]}`)).join(' ');
    const left = ys.map((y, i) => [mid - th[i] / 2, y]), right = ys.map((y, i) => [mid + th[i] / 2, y]).reverse();
    const band = `<path d="${curve(left)} ${curve(right, false)} Z" fill="url(#rvv)" />`;
    const marks = stops.map((s2, i) => `<circle cx="${mid}" cy="${ys[i]}" r="9" fill="#fff" stroke="#1B2A4A" stroke-width="3"/><text x="${mid + 58}" y="${ys[i] - 2}" class="rv-num">${n(s2.value)}</text><text x="${mid + 58}" y="${ys[i] + 18}" class="rv-lab">${esc(s2.label)}</text>`).join('');
    const steps = stops.slice(1).map((s2, i) => {
      const prev = stops[i].value; if (!prev || s2.value > prev) return '';
      const pct = (s2.value / prev) * 100;
      return `<text x="${mid + 58}" y="${(ys[i] + ys[i + 1]) / 2 + 6}" class="rv-step">↓ ${pct < 1 ? pct.toFixed(1) : Math.round(pct)}% kept going</text>`;
    }).join('');
    return `<svg viewBox="0 0 ${W} ${H}" class="rv rv--v" role="img" aria-label="${stops.map((s2) => `${s2.label}: ${s2.value}`).join(', ')}"><defs><linearGradient id="rvv" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#9CC3EC"/><stop offset="0.55" stop-color="#2a78d6"/><stop offset="1" stop-color="#1B4F94"/></linearGradient></defs>${band}${marks}${steps}</svg>`;
  }

  function river(stops: { label: string; value: number }[]) {
    if (root.clientWidth < 620) return riverVertical(stops);
    const W = 760, H = 250, mid = 118, xs = [60, 273, 487, 700];
    const max = Math.max(...stops.map((s2) => s2.value), 1);
    const th = stops.map((s2) => 10 + 70 * (Math.log10(s2.value + 1) / Math.log10(max + 1)));
    const top = xs.map((x, i) => [x, mid - th[i] / 2]), bot = xs.map((x, i) => [x, mid + th[i] / 2]);
    const curve = (pts: number[][]) => pts.map((p, i) => (i === 0 ? `M${p[0]},${p[1]}` : `C${(pts[i - 1][0] + p[0]) / 2},${pts[i - 1][1]} ${(pts[i - 1][0] + p[0]) / 2},${p[1]} ${p[0]},${p[1]}`)).join(' ');
    const rev = [...bot].reverse();
    const bottomPath = rev.map((p, i) => (i === 0 ? `L${p[0]},${p[1]}` : `C${(rev[i - 1][0] + p[0]) / 2},${rev[i - 1][1]} ${(rev[i - 1][0] + p[0]) / 2},${p[1]} ${p[0]},${p[1]}`)).join(' ');
    const band = `<path d="${curve(top)} ${bottomPath} Z" fill="url(#rv)" />`;
    const ripples = [0.3, 0.55, 0.8].map((f) => `<path d="${curve(xs.map((x, i) => [x, mid - th[i] / 2 + th[i] * f]))}" fill="none" stroke="#fff" stroke-opacity="0.28" stroke-width="1.5" stroke-dasharray="10 14" />`).join('');
    const marks = stops.map((s2, i) => `<g><circle cx="${xs[i]}" cy="${mid}" r="9" fill="#fff" stroke="#1B2A4A" stroke-width="3"><title>${esc(s2.label)}: ${n(s2.value)}</title></circle>
      <text x="${xs[i]}" y="${mid - th[i] / 2 - 30}" text-anchor="middle" class="rv-num">${n(s2.value)}</text>
      <text x="${xs[i]}" y="${mid - th[i] / 2 - 12}" text-anchor="middle" class="rv-lab">${esc(s2.label)}</text></g>`).join('');
    const steps = stops.slice(1).map((s2, i) => {
      const prev = stops[i].value; if (!prev || s2.value > prev) return '';
      const pct = (s2.value / prev) * 100;
      return `<text x="${(xs[i] + xs[i + 1]) / 2}" y="${H - 14}" text-anchor="middle" class="rv-step">${pct < 1 ? pct.toFixed(1) : Math.round(pct)}% kept going</text>`;
    }).join('');
    return `<svg viewBox="0 0 ${W} ${H}" class="rv" role="img" aria-label="${stops.map((s2) => `${s2.label}: ${s2.value}`).join(', ')}"><defs><linearGradient id="rv" x1="0" x2="1"><stop offset="0" stop-color="#9CC3EC"/><stop offset="0.55" stop-color="#2a78d6"/><stop offset="1" stop-color="#1B4F94"/></linearGradient></defs>${band}${ripples}${marks}${steps}</svg>`;
  }

  function meter(part: number, whole: number, label: string) {
    if (!whole) return '<p class="an-empty">Nothing counted yet.</p>';
    const pct = Math.round((part / whole) * 100);
    return `<div class="an-hero">${pct}%</div><div class="meter"><div style="width:${pct}%"></div></div><p class="an-small">${n(part)} of ${n(whole)} ${label}</p>`;
  }


  function chg(cur: number, prev: number, lowerIsBetter = false) {
    if (!prev) return '';
    if (lowerIsBetter) {
      const delta = Math.round((prev - cur) * 10) / 10;
      if (!delta) return '<span class="an-chg">no change</span>';
      return `<span class="an-chg ${delta > 0 ? 'up' : 'down'}">${delta > 0 ? '▲ up' : '▼ down'} ${Math.abs(delta)} spots</span>`;
    }
    const p = Math.round(((cur - prev) / prev) * 100);
    return `<span class="an-chg ${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '▲' : '▼'} ${Math.abs(p)}%</span>`;
  }

  function chart(weeks: any[]) {
    const W = 760, H = 220, L = 48, R = 12, T = 14, B = 28;
    const ms = Math.max(1, ...weeks.map((w) => w.impressions)), mc = Math.max(1, ...weeks.map((w) => w.clicks));
    const bw = (W - L - R) / weeks.length;
    const y = (v: number, m: number) => T + (H - T - B) * (1 - v / m);
    const bars = weeks.map((w, i) => `<rect x="${(L + i * bw + bw * 0.18).toFixed(1)}" y="${y(w.impressions, ms).toFixed(1)}" width="${(bw * 0.64).toFixed(1)}" height="${(H - B - y(w.impressions, ms)).toFixed(1)}" rx="3" class="b"><title>Week of ${d(w.week)}: seen ${n(w.impressions)}, ${n(w.clicks)} clicks</title></rect>`).join('');
    const pts = weeks.map((w, i) => `${(L + i * bw + bw / 2).toFixed(1)},${y(w.clicks, mc).toFixed(1)}`);
    const labels = weeks.map((w, i) => (i % 2 === 0 ? `<text x="${(L + i * bw + bw / 2).toFixed(1)}" y="${H - 8}" text-anchor="middle" class="t">${d(w.week)}</text>` : '')).join('');
    return `<svg viewBox="0 0 ${W} ${H}" class="an-svg" role="img" aria-label="Weekly times seen and clicks"><text x="${L - 8}" y="${T + 8}" text-anchor="end" class="t">${n(ms)}</text><line x1="${L}" x2="${W - R}" y1="${H - B}" y2="${H - B}" class="base"/>${bars}<polyline points="${pts.join(' ')}" class="l"/>${pts.map((p) => `<circle cx="${p.split(',')[0]}" cy="${p.split(',')[1]}" r="3.5" class="dot"/>`).join('')}${labels}</svg>`;
  }

  function table(el: string, head: string[], rows: string[][]) {
    $(el).innerHTML = `<thead><tr>${head.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map((r) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody>`;
  }

  async function load(refresh = false) {
    $('an-msg').hidden = false; $('an-msg').textContent = 'Loading analytics...';
    try {
      const res = await fetch(`/api/site-analytics${refresh ? '?refresh=1' : ''}`);
      const r = await res.json();
      if (!res.ok) throw new Error(r.error || 'Could not load analytics.');
      const g = r.gsc;
      const k: string[] = [];
      if (g.connected) {
        const c = g.current, p = g.previous;
        k.push(`<div class="an-kpi"><span>Clicks from Google</span><strong>${n(c.clicks)}</strong>${chg(c.clicks, p.clicks)}</div>`);
        k.push(`<div class="an-kpi"><span>Times seen on Google</span><strong>${n(c.impressions)}</strong>${chg(c.impressions, p.impressions)}</div>`);
        k.push(`<div class="an-kpi"><span>Click-through rate</span><strong>${c.ctr}%</strong>${chg(c.ctr, p.ctr)}</div>`);
        k.push(`<div class="an-kpi"><span>Average position</span><strong>${c.position || '·'}</strong>${chg(c.position, p.position, true)}</div>`);
      }
      const acts = r.businesses.reduce((s: number, b: any) => s + b.actions, 0);
      const views = r.businesses.reduce((s: number, b: any) => s + b.view, 0);
      k.push(`<div class="an-kpi"><span>Profile visits this month</span><strong>${n(views)}</strong></div>`);
      k.push(`<div class="an-kpi"><span>Contact taps this month</span><strong>${n(acts)}</strong></div>`);
      $('an-kpis').innerHTML = k.join('');

      if (g.connected && g.weekly.length > 1) { $('an-chart').innerHTML = chart(g.weekly.slice(-13)); $('an-trend').hidden = false; }
      if (g.connected && g.titleWins.length) { table('an-wins-t', ['Page', 'Seen', 'CTR', 'Position'], g.titleWins.map((p: any) => [`<a href="${esc(p.path)}" target="_blank" rel="noopener">${esc(p.path)}</a>`, n(p.impressions), `${p.ctr}%`, p.position])); $('an-wins').hidden = false; }
      $('an-fresh').innerHTML = `${g.connected ? `Google data through <b>${d(g.dataThrough || r.range.end)}</b> (Google runs about two days behind). ` : ''}Profile visits and taps count live. Last refreshed ${new Date(r.generatedAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}.`;
      $('an-fresh').hidden = false;

      if (!g.connected) {
        if (g.error) $('an-wait-why').textContent = `Google search numbers could not load: ${g.error}. The summary, the River, your position by industry, and the charts appear once this is fixed. Profile visits and taps below are already counting.`;
        $('an-wait').hidden = false;
      } else $('an-wait').hidden = true;
      if (g.connected) {
        const ra = r.rangeActivity || { view: 0, contacts: 0 };
        $('an-river-svg').innerHTML = river([
          { label: 'Saw you on Google', value: g.current.impressions },
          { label: 'Clicked through', value: g.current.clicks },
          { label: 'Opened a business', value: ra.view },
          { label: 'Reached out', value: ra.contacts },
        ]);
        $('an-river').hidden = false;

        const lines: string[] = [];
        const c = g.current, p = g.previous;
        const imprCh = p.impressions ? Math.round(((c.impressions - p.impressions) / p.impressions) * 100) : null;
        lines.push(`Google showed Sioux Falls Go <b>${n(c.impressions)}</b> times in the last 4 weeks${imprCh !== null ? `, <b>${Math.abs(imprCh)}% ${imprCh >= 0 ? 'more' : 'fewer'}</b> than the 4 weeks before` : ''}, and <b>${n(c.clicks)}</b> people clicked.`);
        const disc = g.discovery, dt2 = disc.otherClicks + disc.brandClicks;
        if (dt2) lines.push(`<b>${Math.round((disc.otherClicks / dt2) * 100)}%</b> of clicks came from people who did not search for Sioux Falls Go by name. They searched for a service or a question, and found you.`);
        const ind = g.industries || [];
        if (ind.length) lines.push(`<b>${esc(ind[0].name)}</b> is your most visible industry: seen ${n(ind[0].impressions)} times at an average position of ${ind[0].position}.`);
        const movers = ind.filter((x: any) => x.previous !== null).map((x: any) => ({ ...x, delta: Math.round((x.previous - x.position) * 10) / 10 })).sort((a: any, b2: any) => b2.delta - a.delta);
        if (movers[0]?.delta > 0) lines.push(`Biggest climb: <b>${esc(movers[0].name)}</b> moved up ${movers[0].delta} spots on Google.`);
        const phone = (g.devices || []).find((x: any) => x.label === 'Phone');
        if (phone && c.clicks) lines.push(`<b>${Math.round((phone.clicks / c.clicks) * 100)}%</b> of Google clicks came from phones.`);
        $('an-story-list').innerHTML = lines.map((l) => `<li>${l}</li>`).join('');
        $('an-story').hidden = false;
      }

      const tapTotals = ['call', 'directions', 'website', 'quote'].map((k) => r.businesses.reduce((s2: number, b: any) => s2 + b[k], 0));
      $('an-taps').innerHTML = segBar([{ label: 'Calls', value: tapTotals[0] }, { label: 'Website', value: tapTotals[2] }, { label: 'Directions', value: tapTotals[1] }, { label: 'Quote requests', value: tapTotals[3] }].sort((a, b2) => b2.value - a.value), 'taps');
      if (g.connected) {
        $('an-types').innerHTML = segBar(g.pageTypes.map((t: any) => ({ label: t.label, value: t.clicks })));
        $('an-devices').innerHTML = segBar(g.devices.map((t: any) => ({ label: t.label, value: t.clicks })));
        const disc = g.discovery;
        $('an-discovery').innerHTML = meter(disc.otherClicks, disc.otherClicks + disc.brandClicks, 'clicks came from people searching for a service, a topic, or a business, not for Sioux Falls Go by name');
      } else {
        ['an-types', 'an-devices', 'an-discovery'].forEach((id) => { $(id).innerHTML = '<p class="an-empty">Shows once Search Console is connected.</p>'; });
      }
      $('an-glance').hidden = false;

      if (g.connected && g.industries?.length) {
        const max = Math.max(...g.industries.map((x: any) => x.impressions));
        $('an-ind-list').innerHTML = g.industries.map((x: any) => {
          let trend = '';
          if (x.previous !== null) {
            const delta = Math.round((x.previous - x.position) * 10) / 10;
            trend = delta === 0 ? '<span class="an-trend">no change</span>' : `<span class="an-trend ${delta > 0 ? 'up' : 'down'}">${delta > 0 ? '▲ up' : '▼ down'} ${Math.abs(delta)}</span>`;
          }
          return `<div class="ind-row"><a href="/${esc(x.slug)}" target="_blank" rel="noopener" class="ind-name">${esc(x.name)}</a><div class="ind-bar" title="${esc(x.name)}: seen ${n(x.impressions)} times, ${n(x.clicks)} clicks"><div style="width:${Math.max(2, (x.impressions / max) * 100)}%"></div></div><div class="ind-fig"><b>${x.position}</b><small>avg position</small>${trend}</div><div class="ind-sub">${n(x.impressions)} seen · ${n(x.clicks)} clicks</div></div>`;
        }).join('');
        $('an-ind').hidden = false;
      }
      if (g.connected && g.queries.length) { table('an-queries-t', ['Search', 'Clicks', 'Seen', 'CTR'], g.queries.map((q: any) => [esc(q.query), n(q.clicks), n(q.impressions), `${q.ctr}%`])); $('an-queries').hidden = false; }
      if (g.connected && g.pages.length) { table('an-pages-t', ['Page', 'Type', 'Clicks', 'Seen', 'CTR', 'Position'], g.pages.map((p: any) => [`<a href="${esc(p.path)}" target="_blank" rel="noopener">${esc(p.path)}</a>`, esc(p.type), n(p.clicks), n(p.impressions), `${p.ctr}%`, p.position])); $('an-pages').hidden = false; }

      const biz = r.businesses.length ? r.businesses : [];
      table('an-biz-t', ['Business', 'Visits', 'Calls', 'Directions', 'Website', 'Quotes', ''], biz.length
        ? biz.map((b: any) => [esc(names[b.slug] || b.slug), n(b.view), n(b.call), n(b.directions), n(b.website), n(b.quote), `<a href="/business-report/?b=${encodeURIComponent(b.slug)}" target="_blank" rel="noopener">Report →</a>`])
        : [['No profile visits counted yet this month. Counting started November 17, 2026.', '', '', '', '', '', '']]);

      $('an-note').textContent = g.connected ? 'Google numbers refresh every three hours, or click Refresh now. Google hides very rare searches for privacy, so search lists can add up to slightly less than the totals.'
        : g.error ? `Google search numbers are unavailable: ${g.error}` : 'Google search numbers appear here once Search Console is connected (Content Engine tab, Connect Search Console) and GSC_SITE_PROPERTY is set in Netlify.';
      $('an-msg').hidden = true; $('an-body').hidden = false;
      loaded = true;
    } catch (err: any) { $('an-msg').textContent = err.message; }
  }

  document.querySelectorAll('[data-tab="analytics"], [data-jump-tab="analytics"]').forEach((el) => el.addEventListener('click', () => { if (!loaded) load(); }));
  if (new URLSearchParams(location.search).get('tab') === 'analytics') load();
  $('an-refresh').addEventListener('click', () => load(true));
</script>

