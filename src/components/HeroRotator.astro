---
// Self-contained, continuously-scrolling benefit showcase for the right side
// of the homepage hero. SiteGround-style coverflow: all messages stay
// visible in a vertical strip, whichever one passes through the center gets
// magnified and brightened, the rest shrink and fade with distance.
// Deliberately does not touch any existing hero markup or styles — it's an
// independent sibling element, absolutely positioned. All classes below are
// prefixed sfg-cf- to avoid any collision with existing site-wide styles.
---

<div class="sfg-cf-outer">
  <div class="sfg-cf-wrap">
    <div class="sfg-cf-center-line"></div>
    <div class="sfg-cf-track" id="sfg-cf-track"></div>
  </div>
</div>

<style>
  .sfg-cf-outer {
    position: absolute; top: 50%; right: calc(2vw + 3rem); transform: translateY(-50%);
    z-index: 2;
  }
  @media (max-width: 60rem) {
    .sfg-cf-outer { display: none; }
  }

  .sfg-cf-wrap {
    position: relative; height: 20rem; width: 23rem; overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }
  @media (max-width: 60rem) { .sfg-cf-wrap { width: 100%; max-width: 23rem; } }
  @media (max-width: 26rem) { .sfg-cf-wrap { max-width: 100%; } }

  .sfg-cf-center-line {
    position: absolute; left: 0; right: 0; top: 50%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,180,41,0.5), transparent);
    transform: translateY(-50%); pointer-events: none;
  }

  .sfg-cf-track { position: relative; will-change: transform; }

  :global(.sfg-cf-item) {
    display: flex; align-items: center; justify-content: center; gap: 0.9rem;
    min-height: 4.6rem; padding: 0.7rem 1.2rem;
    color: #fff; font-family: var(--font-display, 'Poppins', sans-serif); font-weight: 700; font-size: 1rem;
    white-space: normal; line-height: 1.3;
    transform-origin: left center;
    will-change: transform, opacity, filter;
    background: linear-gradient(160deg, rgba(255,255,255,0.22), rgba(255,255,255,0.06));
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.32);
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(0,0,0,0.22), inset 0 1px 0 rgba(255,255,255,0.25);
    margin-block: 0.35rem;
  }
  :global(.sfg-cf-item-text) { min-width: 0; }
  @media (max-width: 26rem) {
    :global(.sfg-cf-item) { font-size: 0.8125rem; gap: 0.6rem; }
    :global(.sfg-cf-icon) { width: 1.8rem; height: 1.8rem; }
  }
  :global(.sfg-cf-icon) {
    flex-shrink: 0; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: #fff;
  }
  :global(.sfg-cf-num) {
    background: linear-gradient(90deg, #fff, #F5B429);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
</style>

<script>
  const items = [
    {
      html: 'Real Events. Real Prizes.',
      icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>',
    },
    {
      html: '<span class="sfg-cf-num">98</span> Real Local Guides',
      icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>',
    },
    {
      html: 'Local Businesses We Stand Behind',
      icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/></svg>',
    },
    {
      html: 'Real Tools. Not Just Listings.',
      icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94Z"/></svg>',
    },
    {
      html: '<span class="sfg-cf-num">98</span> Articles. Built to Drive Traffic.',
      icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
    },
  ];

  const track = document.getElementById('sfg-cf-track');
  const wrap = document.querySelector('.sfg-cf-wrap');

  if (track && wrap) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 60rem)').matches;

    if (isMobile) {
      // Hidden via CSS on mobile — skip building/animating it entirely
      // rather than running an invisible animation loop in the background.
    } else {

    const REPEATS = 3;
    const allItems: HTMLElement[] = [];
    for (let r = 0; r < REPEATS; r++) {
      items.forEach((item) => {
        const el = document.createElement('div');
        el.className = 'sfg-cf-item';
        el.innerHTML = `<div class="sfg-cf-icon">${item.icon}</div><div class="sfg-cf-item-text">${item.html}</div>`;
        track.appendChild(el);
        allItems.push(el);
      });
    }

    const oneSetItems = allItems.slice(0, items.length);
    const SET_HEIGHT =
      oneSetItems[oneSetItems.length - 1].offsetTop +
      oneSetItems[oneSetItems.length - 1].offsetHeight -
      oneSetItems[0].offsetTop;

    // Compute the largest safe scale factor from real measured widths, so no
    // item can ever be pushed past the wrap's edge regardless of viewport
    // size or how long its text is — safer than guessing a fixed max scale.
    const wrapWidth = wrap.getBoundingClientRect().width;
    let maxSafeScale = 1.35;
    oneSetItems.forEach((el) => {
      const naturalWidth = el.getBoundingClientRect().width;
      if (naturalWidth > 0) {
        const safeScale = wrapWidth / naturalWidth;
        if (safeScale < maxSafeScale) maxSafeScale = safeScale;
      }
    });
    maxSafeScale = Math.max(1.0, Math.min(1.35, maxSafeScale));
    const minScale = maxSafeScale - 0.55;

    let offset = SET_HEIGHT;
    const SPEED = 14;

    function applyStyles() {
      track!.style.transform = `translateY(${-offset}px)`;
      const wrapCenter = wrap!.getBoundingClientRect().height / 2;
      allItems.forEach((el) => {
        const itemCenterAbs = el.offsetTop + el.offsetHeight / 2 - offset;
        const dist = Math.abs(itemCenterAbs - wrapCenter);
        const maxDist = wrapCenter;
        const t = Math.max(0, 1 - dist / maxDist);

        const scale = minScale + t * (maxSafeScale - minScale);
        const opacity = 0.18 + t * 0.82;
        const blur = (1 - t) * 2.2;

        el.style.transform = `scale(${scale.toFixed(3)})`;
        el.style.opacity = opacity.toFixed(3);
        el.style.filter = `blur(${blur.toFixed(2)}px)`;
      });
    }

    if (reduceMotion) {
      applyStyles();
    } else {
      let last = performance.now();
      function loop(now: number) {
        const dt = (now - last) / 1000;
        last = now;
        offset += SPEED * dt;
        if (offset >= SET_HEIGHT * 2) offset -= SET_HEIGHT;
        applyStyles();
        requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);
    }
    }
  }
</script>
