---
import { getCollection } from 'astro:content';

const allCategories = await getCollection('categories');

const PARENT_GROUPS = [
  { slug: 'home-services', label: 'Home Services' },
  { slug: 'professional-services', label: 'Professional Services' },
  { slug: 'health-wellness', label: 'Health & Fitness' },
  { slug: 'food-retail', label: 'Food & Retail' },
];

const proGroups = PARENT_GROUPS.map((group) => {
  const parent = allCategories.find((c) => c.data.slug === group.slug);
  const children = allCategories
    .filter((c) => c.data.parentCategory?.id === group.slug && c.data.slug !== group.slug)
    .sort((a, b) => a.data.name.localeCompare(b.data.name));
  return { ...group, parentSlug: parent?.data.slug ?? group.slug, children };
});

const exploreItems = [
  { href: '/shopping-retail', label: 'Shopping', icon: 'M6 2l1.5 5h9L18 2M3 7h18l-1.5 13.5a1 1 0 0 1-1 .9H5.5a1 1 0 0 1-1-.9L3 7z' },
  { href: '/restaurants-dining', label: 'Places to Eat', icon: 'M3 2v20M3 7h4M21 15c-3 0-4-2-4-4V2v13c0 4-2 6-4 6' },
  { href: '/stay', label: 'Places to Stay', icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 9h1M9 13h1M14 9h1M14 13h1M10 21v-4h4v4' },
  { href: '/visit-sioux-falls', label: 'Things to Do', icon: 'M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z M12 12a3 3 0 100-6 3 3 0 000 6z' },
  { href: '/itineraries', label: 'Itineraries', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
  { href: '/map', label: 'Map', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">
      <img src="/images/sfg-logo.png" alt="Sioux Falls Go" class="wordmark-logo" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <a class="nav-secondary-link" href="/guides">The Loop</a>

      <!-- EXPLORE SIOUX FALLS — split button, de-highlighted to plain text -->
      <div class="split-wrap">
        <div class="split-btn">
          <a href="/visit-sioux-falls" class="split-btn-main">Explore Sioux Falls</a>
          <button class="split-btn-chev" id="explore-chev" aria-expanded="false" aria-label="Show explore options">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
        <div class="dropdown-panel" id="explore-dropdown">
          <div class="dropdown-grid one-col">
            {exploreItems.map((item) => (
              <a class="dropdown-item" href={item.href}>
                <span class="dropdown-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" set:html={`<path d="${item.icon}"/>`} /></span>
                <span class="dropdown-item-text"><strong>{item.label}</strong></span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a class="nav-secondary-link" href="/spotlight-giveaway">Giveaway</a>
      <a class="nav-secondary-link" href="/local-deals">Local Deals</a>

      <!-- LOCAL PROS — split button, mega-menu, de-highlighted to plain text -->
      <div class="split-wrap">
        <div class="split-btn">
          <a href="/businesses" class="split-btn-main">Local Pros</a>
          <button class="split-btn-chev" id="pros-chev" aria-expanded="false" aria-label="Show local pro categories">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
        <div class="dropdown-panel mega" id="pros-dropdown">
          <div class="mega-grid">
            {proGroups.map((group) => (
              <div class="mega-col">
                <a class="mega-col-title" href={`/${group.parentSlug}`}>{group.label}</a>
                <ul>
                  {group.children.map((child) => (
                    <li><a href={`/${child.data.slug}`}>{child.data.name}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <a class="mega-footer-link" href="/businesses">See All Local Pros →</a>
        </div>
      </div>
    </nav>

    <a href="/search" class="nav-search-link" aria-label="Search Sioux Falls Go">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </a>

    <a href="/get-featured" class="button header-cta desktop-cta">Get Featured</a>

    <button class="hamburger-btn" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav aria-label="Mobile primary">
      <a class="mobile-flat-link" href="/search">Search</a>
      <a class="mobile-flat-link" href="/guides">The Loop</a>

      <div class="mobile-accordion">
        <button class="mobile-trigger" id="mobile-explore-trigger" aria-expanded="false">
          <span>Explore Sioux Falls</span>
          <svg class="mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="mobile-submenu" id="mobile-explore-submenu">
          <a class="mobile-sub-browse-all" href="/visit-sioux-falls">Browse All →</a>
          {exploreItems.map((item) => (
            <a class="mobile-sub-link" href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>

      <a class="mobile-flat-link" href="/spotlight-giveaway">Giveaway</a>
      <a class="mobile-flat-link" href="/local-deals">Local Deals</a>

      <div class="mobile-accordion">
        <button class="mobile-trigger" id="mobile-pros-trigger" aria-expanded="false">
          <span>Local Pros</span>
          <svg class="mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="mobile-submenu" id="mobile-pros-submenu">
          <a class="mobile-sub-browse-all" href="/businesses">See All Local Pros →</a>
          {proGroups.map((group) => (
            <a class="mobile-sub-link" href={`/${group.parentSlug}`}>{group.label}</a>
          ))}
        </div>
      </div>
    </nav>
    <a href="/get-featured" class="button mobile-menu-cta">Get Featured</a>
  </div>
  <div class="mobile-menu-backdrop" id="mobile-menu-backdrop"></div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-2);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .wordmark {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }
  .wordmark-logo { height: 4.6rem; width: auto; display: block; }

  .desktop-nav {
    display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap;
  }
  .nav-secondary-link {
    padding: 0.55rem 0.8rem; text-decoration: none; color: var(--color-navy);
    font-weight: 700; font-size: 0.9375rem;
  }
  .nav-secondary-link:hover { color: var(--color-orange); }

  /* SPLIT BUTTON */
  .split-wrap { position: relative; }
  .split-btn {
    display: flex; align-items: stretch; border-radius: 999px; overflow: hidden;
  }
  .split-btn-main {
    display: flex; align-items: center; padding: 0.55rem 0.3rem 0.55rem 0.9rem;
    text-decoration: none; font-weight: 700; font-size: 0.9375rem; color: var(--color-navy);
  }
  .split-btn-main:hover { color: var(--color-orange); }
  .split-btn-chev {
    display: flex; align-items: center; padding: 0.55rem 0.6rem 0.55rem 0.2rem; border: none;
    background: none; cursor: pointer; color: var(--color-navy);
  }
  .split-btn-chev:hover { color: var(--color-orange); }
  .split-btn-chev svg { transition: transform 0.2s ease; }
  .split-btn-chev[aria-expanded="true"] svg { transform: rotate(180deg); }

  .dropdown-panel {
    position: absolute; top: calc(100% + 0.6rem); left: 50%; transform: translateX(-50%) translateY(-8px);
    background: #fff; border-radius: 1rem; box-shadow: 0 20px 50px rgba(13,23,48,0.18);
    border: 1px solid var(--color-line); padding: 1rem; z-index: 30;
    opacity: 0; visibility: hidden; transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    width: 16rem;
  }
  .dropdown-panel.is-open { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .dropdown-grid.one-col { display: flex; flex-direction: column; gap: 0.2rem; }
  .dropdown-item { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem; border-radius: 0.6rem; text-decoration: none; color: var(--color-navy); }
  .dropdown-item:hover { background: var(--color-surface); }
  .dropdown-icon { width: 1.9rem; height: 1.9rem; border-radius: 0.5rem; background: rgba(240,126,35,0.12); color: var(--color-orange); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .dropdown-item-text strong { font-weight: 700; font-size: 0.9rem; }

  /* MEGA MENU */
  .dropdown-panel.mega { width: 34rem; }
  .mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .mega-col-title {
    display: block; font-family: var(--font-display); font-weight: 700; font-size: 0.9375rem;
    color: var(--color-navy); text-decoration: none; margin-bottom: 0.5rem; padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-orange);
  }
  .mega-col-title:hover { color: var(--color-orange); }
  .mega-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .mega-col a { text-decoration: none; color: var(--color-navy-light); font-size: 0.8438rem; font-weight: 600; }
  .mega-col a:hover { color: var(--color-orange); }
  .mega-footer-link {
    display: block; text-align: center; margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--color-line);
    font-weight: 700; font-size: 0.875rem; color: var(--color-orange-dark); text-decoration: none;
  }

  /* GET FEATURED — rectangular, river blue, not a pill */
  .nav-search-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border-radius: 50%; color: var(--color-navy);
    transition: background 0.15s;
  }
  .nav-search-link:hover { background: var(--color-surface); }
  .header-cta {
    padding: 0.65rem 1.5rem; font-size: 0.9375rem; font-weight: 700;
    background: var(--color-river); color: #fff; border-radius: 0.5rem;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .header-cta:hover { background: var(--color-navy); transform: translateY(-1px); }

  .hamburger-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem; height: 2.5rem;
    background: none; border: none; cursor: pointer;
    padding: 0;
  }
  .hamburger-btn span {
    display: block; height: 2px; width: 100%;
    background: var(--color-navy); border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .hamburger-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburger-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; top: 0; right: 0; height: 100vh; width: 80%; max-width: 20rem;
    background: #fff; z-index: 40;
    box-shadow: -8px 0 24px rgba(13,23,48,0.15);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
    display: flex; flex-direction: column;
    padding: 5rem var(--space-3) var(--space-3);
    overflow-y: auto;
  }
  .mobile-menu.is-open { transform: translateX(0); }

  .mobile-flat-link {
    display: block; padding: var(--space-2) 0; font-size: 1.0625rem; font-weight: 700;
    color: var(--color-navy); text-decoration: none; border-bottom: 1px solid var(--color-line);
  }
  .mobile-flat-link:hover { color: var(--color-orange); }

  .mobile-accordion { border-bottom: 1px solid var(--color-line); }
  .mobile-trigger {
    width: 100%; display: flex; align-items: center; justify-content: space-between;
    background: none; border: none; padding: var(--space-2) 0; cursor: pointer;
    font-size: 1.0625rem; font-weight: 700; color: var(--color-navy); font-family: var(--font-body);
  }
  .mobile-chevron { transition: transform 0.25s ease; }
  .mobile-trigger[aria-expanded="true"] .mobile-chevron { transform: rotate(180deg); }

  .mobile-submenu { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .mobile-submenu.is-open { max-height: 20rem; padding-bottom: 0.7rem; }
  .mobile-sub-browse-all {
    display: block; padding: 0.7rem 0.8rem; margin-bottom: 0.3rem; border-radius: 0.6rem;
    background: rgba(240,126,35,0.08); border: 1px dashed rgba(240,126,35,0.4);
    color: var(--color-navy); font-weight: 700; font-size: 0.9375rem; text-decoration: none;
  }
  .mobile-sub-link {
    display: block; padding: 0.65rem 0.8rem; color: var(--color-navy-light);
    font-weight: 600; font-size: 0.9375rem; text-decoration: none;
  }
  .mobile-sub-link:hover { color: var(--color-orange); }

  .mobile-menu-cta {
    margin-top: var(--space-3); text-align: center;
    background: var(--color-river); border-radius: 0.5rem;
  }

  .mobile-menu-backdrop {
    position: fixed; inset: 0; background: rgba(13,23,48,0.4); z-index: 35;
    opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
  }
  .mobile-menu-backdrop.is-open { opacity: 1; pointer-events: auto; }

  @media (max-width: 62rem) {
    .desktop-nav, .desktop-cta, .nav-search-link { display: none; }
    .hamburger-btn { display: flex; }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const backdrop = document.getElementById('mobile-menu-backdrop')!;

  function closeMenu() {
    menu.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  function openMenu() {
    menu.classList.add('is-open');
    backdrop.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  btn.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });
  backdrop.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  // Desktop dropdowns — click to toggle, click outside or Escape to close
  function setupDropdown(chevId: string, panelId: string) {
    const chev = document.getElementById(chevId);
    const panel = document.getElementById(panelId);
    if (!chev || !panel) return;
    chev.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = panel.classList.contains('is-open');
      document.querySelectorAll('.dropdown-panel.is-open').forEach((p) => p.classList.remove('is-open'));
      document.querySelectorAll('.split-btn-chev[aria-expanded="true"]').forEach((c) => c.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        panel.classList.add('is-open');
        chev.setAttribute('aria-expanded', 'true');
      }
    });
  }
  setupDropdown('explore-chev', 'explore-dropdown');
  setupDropdown('pros-chev', 'pros-dropdown');

  document.addEventListener('click', () => {
    document.querySelectorAll('.dropdown-panel.is-open').forEach((p) => p.classList.remove('is-open'));
    document.querySelectorAll('.split-btn-chev[aria-expanded="true"]').forEach((c) => c.setAttribute('aria-expanded', 'false'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.dropdown-panel.is-open').forEach((p) => p.classList.remove('is-open'));
      document.querySelectorAll('.split-btn-chev[aria-expanded="true"]').forEach((c) => c.setAttribute('aria-expanded', 'false'));
      closeMenu();
    }
  });

  // Mobile accordions
  function setupMobileAccordion(triggerId: string, submenuId: string) {
    const trigger = document.getElementById(triggerId);
    const submenu = document.getElementById(submenuId);
    if (!trigger || !submenu) return;
    trigger.addEventListener('click', () => {
      const isOpen = submenu.classList.contains('is-open');
      submenu.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  }
  setupMobileAccordion('mobile-explore-trigger', 'mobile-explore-submenu');
  setupMobileAccordion('mobile-pros-trigger', 'mobile-pros-submenu');
</script>
