---
const links = [
  { href: '/businesses', label: 'Businesses' },
  { href: '/spotlight-giveaway', label: 'Giveaway' },
  { href: '/local-deals', label: 'Local Deals' },
  { href: '/guides', label: 'The Loop' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">Sioux Falls <span>Go</span></a>
    <nav aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/get-featured" class="button header-cta">Get Listed</a>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-2);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }
  .wordmark span { color: var(--color-orange); }
  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--color-navy);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  nav a:hover { color: var(--color-orange); }
  .header-cta { padding: 0.6rem 1.4rem; font-size: 0.875rem; }
</style>
