---
const links = [
  { href: '/things-to-do', label: 'Things to Do' },
  { href: '/businesses', label: 'Directory' },
  { href: '/events', label: 'Events' },
  { href: '/neighborhoods', label: 'Neighborhoods' },
  { href: '/guides', label: 'Guides' },
  { href: '/faqs/local-service-faqs', label: 'Local FAQs' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">Sioux Falls <span>Go</span></a>
    <nav aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-river);
    padding-block: var(--space-2);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-bluff);
    text-decoration: none;
  }
  .wordmark span { color: var(--color-prairie); }
  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--color-bluff);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  nav a:hover { color: var(--color-prairie); }
</style>
