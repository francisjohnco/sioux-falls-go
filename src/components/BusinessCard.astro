---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';

interface Props {
  business: CollectionEntry<'businesses'>;
}
const { business } = Astro.props;
const category = await getEntry(business.data.category);
const tier = business.data.partnershipTier;
---
<a class="biz-card" href={`/businesses/${business.id}`}>
  <div class="biz-card-media" style={business.data.heroImage ? `background-image: url(${business.data.heroImage}); background-size: cover; background-position: center;` : undefined}>
    {!business.data.heroImage && (
      <svg class="media-pattern" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <polygon points="0,160 0,90 90,60 180,95 260,50 300,75 300,160" fill="#ffffff" opacity="0.06" />
        <polygon points="0,160 0,120 110,105 220,130 300,110 300,160" fill="#ffffff" opacity="0.08" />
      </svg>
    )}
    <span class="media-icon">{category.data.icon}</span>
    <button class="favorite-btn" aria-label="Save to favorites" onclick="event.preventDefault()">♡</button>
    <span class="ribbon">{category.data.name}</span>
  </div>
  <div class="biz-card-body">
    <h3>{business.data.name}</h3>
    <div class="badge-row">
      {business.data.verifiedAt && <span class="badge badge--verified">✓ Verified</span>}
      {tier === 'community-champion' && <span class="badge badge--champion-solid">★ Champion</span>}
      {tier === 'community-listing' && <span class="badge badge--giveback">Give Back</span>}
    </div>
    {business.data.googleRating && (
      <p class="biz-rating">★ {business.data.googleRating.toFixed(1)} {business.data.googleReviewCount && `(${business.data.googleReviewCount})`}</p>
    )}
    {business.data.hours
      ? <p class="biz-hours">{business.data.hours}</p>
      : <p class="biz-hours biz-hours--pending">Hours coming soon</p>}
  </div>
</a>

<style>
  .biz-card {
    display: block; text-decoration: none; overflow: hidden; background: #fff;
    border-radius: var(--radius); border: 1px solid var(--color-line);
    box-shadow: 0 1px 2px rgba(13,23,48,0.06);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .biz-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(13,23,48,0.16); border-color: transparent; }

  .biz-card-media {
    position: relative; height: 8.5rem; overflow: hidden;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 55%, #1B2A4A 100%);
  }
  .media-pattern { position: absolute; inset: 0; width: 100%; height: 100%; }
  .media-icon {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 2.25rem; opacity: 0.9; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));
  }
  .favorite-btn {
    position: absolute; top: 0.6rem; right: 0.6rem; z-index: 2;
    width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: rgba(255,255,255,0.92); border: none;
    font-size: 1.1rem; line-height: 1; color: var(--color-orange);
    cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.15s ease;
  }
  .favorite-btn:hover { transform: scale(1.1); }
  .ribbon {
    position: absolute; bottom: 0.6rem; left: 0.6rem; z-index: 2;
    background: var(--color-orange); color: #fff;
    font-size: 0.6875rem; font-weight: 700;
    padding: 0.25rem 0.7rem; border-radius: var(--radius-pill);
    box-shadow: 0 2px 6px rgba(240,126,35,0.35);
  }

  .biz-card-body { padding: var(--space-2) var(--space-3) var(--space-3); }
  .biz-card h3 { margin: 0 0 0.4rem; font-size: 1.0625rem; }
  .badge-row { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.3rem; }
  .badge--verified { background: #E7F6ED; color: var(--color-success); }
  .badge--champion-solid { background: var(--color-orange); color: #fff; }
  .badge--giveback { background: #E7F6ED; color: var(--color-success); }
  .biz-rating { margin: 0.35rem 0 0; font-size: 0.875rem; color: var(--color-navy-light); font-weight: 600; }
  .biz-hours { margin: 0.3rem 0 0; font-size: 0.875rem; color: var(--color-navy-light); }
  .biz-hours--pending { font-style: italic; opacity: 0.7; }
</style>
