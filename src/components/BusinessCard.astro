---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  business: CollectionEntry<'businesses'>;
  compact?: boolean;
}
const { business, compact = false } = Astro.props;
const category = await getEntry(business.data.category);
const tier = business.data.partnershipTier;

function makeExcerpt(markdown: string, maxLen = 130): string {
  const plain = markdown
    .replace(/^#{1,6}\s+.*/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxLen) return plain;
  const cut = plain.slice(0, maxLen);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}
const excerpt = makeExcerpt(business.body ?? '');
---
<div class={`biz-card ${compact ? 'biz-card--compact' : ''}`}>
  <a href={`/businesses/${business.id}`} class="biz-card-photo-link">
    <div class="biz-card-media" style={business.data.heroImage ? `background-image: url(${business.data.heroImage}); background-size: cover; background-position: center;` : undefined}>
      {!business.data.heroImage && (
        <svg class="media-pattern" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <polygon points="0,160 0,90 90,60 180,95 260,50 300,75 300,160" fill="#ffffff" opacity="0.06" />
          <polygon points="0,160 0,120 110,105 220,130 300,110 300,160" fill="#ffffff" opacity="0.08" />
        </svg>
      )}
      {!business.data.heroImage && <Icon name={category.data.icon} size={32} class="media-icon" />}
    </div>
  </a>
  <div class="biz-card-body">
    <span class="biz-category-tag"><Icon name={category.data.icon} size={14} /> {category.data.name}</span>
    <a href={`/businesses/${business.id}`} class="biz-card-name-link">
      <h3>
        {business.data.name}
        {business.data.verifiedAt && <span class="verified-check" title="Verified by Sioux Falls Go"><Icon name="check" size={11} /></span>}
      </h3>
    </a>
    {tier === 'community-champion' && <span class="badge badge--champion-solid"><Icon name="star" size={11} /> Community Champion</span>}
    {tier === 'community-listing' && <span class="badge badge--giveback">Give Back Partner</span>}
    {business.data.googleRating && (
      <p class="biz-rating"><Icon name="star" size={13} class="rating-star" /> {business.data.googleRating.toFixed(1)} <span class="biz-rating-count">{business.data.googleReviewCount && `(${business.data.googleReviewCount})`}</span></p>
    )}
    {excerpt && <p class="biz-excerpt">{excerpt}</p>}
    <div class="biz-card-footer">
      <a href={`/businesses/${business.id}`} class="read-more-link">Read more →</a>
      {business.data.phone && <a href={`tel:${business.data.phone}`} class="call-link"><Icon name="phone" size={13} /> Call</a>}
    </div>
  </div>
</div>

<style>
  .biz-card {
    display: flex; flex-direction: column; overflow: hidden; background: #fff;
    border-radius: var(--radius); border: 1px solid var(--color-line);
    box-shadow: 0 1px 2px rgba(13,23,48,0.06);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .biz-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(13,23,48,0.16); border-color: transparent; }
  .biz-card-photo-link { display: block; }

  .biz-card-media {
    position: relative; height: 12.5rem; overflow: hidden;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 55%, #1B2A4A 100%);
  }
  .biz-card--compact .biz-card-media { height: 9rem; }
  .media-pattern { position: absolute; inset: 0; width: 100%; height: 100%; }
  .media-icon {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    color: #fff; opacity: 0.9; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));
  }

  .biz-card-body { padding: var(--space-2) var(--space-3) var(--space-3); flex: 1; display: flex; flex-direction: column; }
  .biz-category-tag { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 700; color: var(--color-orange-dark); text-transform: uppercase; letter-spacing: 0.02em; }
  .biz-card-name-link { text-decoration: none; }
  .biz-card h3 { margin: 0.35rem 0 0; font-size: 1.125rem; color: var(--color-navy); display: flex; align-items: center; gap: 0.4rem; }
  .verified-check {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.1rem; height: 1.1rem; border-radius: 50%; background: var(--color-success);
    color: #fff; font-size: 0.625rem; font-weight: 700; flex-shrink: 0;
  }
  .badge--champion-solid { background: var(--color-orange); color: #fff; display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 0.4rem; font-size: 0.6875rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); width: fit-content; }
  .badge--champion-solid .icon { fill: currentColor; }
  .badge--giveback { background: #E7F6ED; color: var(--color-success); display: inline-block; margin-top: 0.4rem; font-size: 0.6875rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); width: fit-content; }
  .biz-rating { display: flex; align-items: center; gap: 0.3rem; margin: 0.4rem 0 0; font-size: 0.875rem; color: var(--color-navy); font-weight: 700; }
  .rating-star { fill: #F5B429; color: #F5B429; }
  .biz-rating-count { color: var(--color-navy-light); font-weight: 400; }
  .biz-excerpt { margin: 0.5rem 0 0; font-size: 0.9375rem; color: var(--color-ink); line-height: 1.55; flex: 1; }

  .biz-card-footer {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    margin-top: var(--space-2); padding-top: var(--space-1); border-top: 1px solid var(--color-line);
  }
  .read-more-link { font-size: 0.9375rem; font-weight: 700; color: var(--color-orange-dark); text-decoration: none; }
  .read-more-link:hover { text-decoration: underline; }
  .call-link { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8125rem; color: var(--color-navy-light); text-decoration: none; font-weight: 600; }
  .call-link:hover { color: var(--color-navy); }
</style>
