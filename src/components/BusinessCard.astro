---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';

interface Props {
  business: CollectionEntry<'businesses'>;
  compact?: boolean;
}
const { business, compact = false } = Astro.props;
const category = await getEntry(business.data.category);
const tier = business.data.partnershipTier;

function makeExcerpt(markdown: string, maxLen = 110): string {
  const plain = markdown
    .replace(/^#{1,6}\s+.*/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxLen) return plain;
  const cut = plain.slice(0, maxLen);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}
const excerpt = makeExcerpt(business.body ?? '');
---
<div class={`biz-card ${compact ? 'biz-card--compact' : ''}`}>
  <a href={`/businesses/${business.id}`} class="biz-card-link">
    <div class="biz-card-media" style={business.data.heroImage ? `background-image: url(${business.data.heroImage}); background-size: cover; background-position: center;` : undefined}>
      {!business.data.heroImage && (
        <svg class="media-pattern" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <polygon points="0,160 0,90 90,60 180,95 260,50 300,75 300,160" fill="#ffffff" opacity="0.06" />
          <polygon points="0,160 0,120 110,105 220,130 300,110 300,160" fill="#ffffff" opacity="0.08" />
        </svg>
      )}
      <span class="media-icon">{category.data.icon}</span>
      <button class="favorite-btn" aria-label="Save to favorites" onclick="event.preventDefault(); event.stopPropagation();">♡</button>
      {tier === 'community-champion' ? (
        <span class="ribbon ribbon--champion">★ Community Champion</span>
      ) : tier === 'community-listing' ? (
        <span class="ribbon ribbon--giveback">Give Back Partner</span>
      ) : (
        <span class="ribbon">{category.data.name}</span>
      )}
    </div>
    <div class="biz-card-body">
      <div class="biz-card-title-row">
        <h3>{business.data.name}</h3>
        {business.data.verifiedAt && <span class="verified-check" title="Verified by Sioux Falls Go">✓</span>}
      </div>
      <p class="biz-category-line">{category.data.icon} {category.data.name}</p>
      {business.data.googleRating && (
        <p class="biz-rating">★ {business.data.googleRating.toFixed(1)} <span class="biz-rating-count">{business.data.googleReviewCount && `(${business.data.googleReviewCount} reviews)`}</span></p>
      )}
      {excerpt && <p class="biz-excerpt">{excerpt}</p>}
      {business.data.hours
        ? <p class="biz-hours">🕐 {business.data.hours}</p>
        : <p class="biz-hours biz-hours--pending">Hours coming soon</p>}
    </div>
  </a>
  <div class="biz-card-actions">
    {business.data.phone && (
      <a href={`tel:${business.data.phone}`} class="quick-action" onclick="event.stopPropagation();">📞 Call</a>
    )}
    {business.data.website && (
      <a href={business.data.website} target="_blank" rel="nofollow noopener" class="quick-action" onclick="event.stopPropagation();">🌐 Website</a>
    )}
    <a href={`/businesses/${business.id}`} class="quick-action quick-action--primary">Read more →</a>
  </div>
</div>

<style>
  .biz-card {
    display: flex; flex-direction: column; overflow: hidden; background: #fff;
    border-radius: var(--radius); border: 1px solid var(--color-line);
    box-shadow: 0 1px 2px rgba(13,23,48,0.06);
    transition: transform 0.2s cubic-bezier(.2,.8,.2,1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .biz-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(13,23,48,0.16); border-color: transparent; }
  .biz-card-link { text-decoration: none; color: inherit; display: block; }

  .biz-card-media {
    position: relative; height: 8.5rem; overflow: hidden;
    background: linear-gradient(135deg, #16233d 0%, #2c3f61 55%, #1B2A4A 100%);
  }
  .biz-card--compact .biz-card-media { height: 6rem; }
  .media-pattern { position: absolute; inset: 0; width: 100%; height: 100%; }
  .media-icon {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 2.25rem; opacity: 0.9; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));
  }
  .favorite-btn {
    position: absolute; top: 0.6rem; right: 0.6rem; z-index: 2;
    width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: rgba(255,255,255,0.92); border: none;
    font-size: 1.1rem; line-height: 1; color: var(--color-orange);
    cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.15s ease;
  }
  .favorite-btn:hover { transform: scale(1.1); }
  .ribbon {
    position: absolute; bottom: 0.6rem; left: 0.6rem; z-index: 2;
    background: var(--color-orange); color: #fff;
    font-size: 0.6875rem; font-weight: 700;
    padding: 0.25rem 0.7rem; border-radius: var(--radius-pill);
    box-shadow: 0 2px 6px rgba(240,126,35,0.35);
  }
  .ribbon--champion { background: linear-gradient(135deg, var(--color-orange), #F5B429); }
  .ribbon--giveback { background: var(--color-success); box-shadow: 0 2px 6px rgba(46,158,91,0.35); }

  .biz-card-body { padding: var(--space-2) var(--space-3) var(--space-1); flex: 1; }
  .biz-card-title-row { display: flex; align-items: center; gap: 0.4rem; }
  .biz-card h3 { margin: 0; font-size: 1.0625rem; }
  .verified-check {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.15rem; height: 1.15rem; border-radius: 50%; background: var(--color-success);
    color: #fff; font-size: 0.6875rem; font-weight: 700; flex-shrink: 0;
  }
  .biz-category-line { margin: 0.25rem 0 0; font-size: 0.8125rem; color: var(--color-navy-light); }
  .biz-rating { margin: 0.4rem 0 0; font-size: 0.875rem; color: var(--color-navy); font-weight: 700; }
  .biz-rating-count { color: var(--color-navy-light); font-weight: 400; }
  .biz-excerpt { margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--color-ink); line-height: 1.5; }
  .biz-hours { margin: 0.5rem 0 0; font-size: 0.8125rem; color: var(--color-navy-light); }
  .biz-hours--pending { font-style: italic; opacity: 0.7; }

  .biz-card-actions {
    display: flex; gap: 0.5rem; padding: var(--space-2) var(--space-3) var(--space-3);
    border-top: 1px solid var(--color-line); margin-top: var(--space-1);
  }
  .quick-action {
    flex: 1; text-align: center; text-decoration: none; font-size: 0.8125rem; font-weight: 700;
    padding: 0.5rem 0.5rem; border-radius: var(--radius-pill);
    background: var(--color-surface); color: var(--color-navy);
    border: 1px solid var(--color-line);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .quick-action:hover { border-color: var(--color-orange); color: var(--color-orange-dark); }
  .quick-action--primary { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }
  .quick-action--primary:hover { background: var(--color-orange); border-color: var(--color-orange); color: #fff; }
</style>
