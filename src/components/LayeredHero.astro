---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  photoUrl?: string;
  photoCredit?: string;
  compact?: boolean;
}
const { eyebrow, title, subtitle, photoUrl, photoCredit, compact = false } = Astro.props;
---
<section class={`layered-hero ${compact ? 'layered-hero--compact' : ''}`}>
  {photoUrl ? (
    <>
      <div class="hero-photo" style={`background-image: url(${photoUrl});`}></div>
      <div class="hero-photo-overlay"></div>
      {photoCredit && <span class="photo-credit">{photoCredit}</span>}
    </>
  ) : (
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 1400 500" preserveAspectRatio="xMidYMax slice" class="hero-svg">
        <defs>
          <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0d1730" />
            <stop offset="55%" stop-color="#1B2A4A" />
            <stop offset="100%" stop-color="#2c3f61" />
          </linearGradient>
          <linearGradient id="sunGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#F5B429" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#F07E23" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="riverGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#F07E23" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#F5B429" stop-opacity="0.15" />
          </linearGradient>
        </defs>

        <rect width="1400" height="500" fill="url(#skyGrad)" />
        <circle cx="1080" cy="150" r="220" fill="url(#sunGrad)" />

        <!-- Downtown skyline silhouette, far layer -->
        <g class="drift-slow" opacity="0.35" fill="#0d1730">
          <rect x="60" y="260" width="34" height="140" />
          <rect x="110" y="230" width="26" height="170" />
          <rect x="150" y="280" width="40" height="120" />
          <rect x="960" y="240" width="30" height="160" />
          <rect x="1000" y="200" width="24" height="200" />
          <rect x="1040" y="260" width="36" height="140" />
          <rect x="1090" y="220" width="28" height="180" />
          <rect x="1250" y="250" width="32" height="150" />
        </g>

        <!-- Quartzite terraces, evoking Falls Park's ledges -->
        <polygon points="0,500 0,240 260,170 560,250 900,150 1200,210 1400,170 1400,500" fill="#16233d" opacity="0.55" />
        <polygon points="0,500 0,300 320,250 680,310 1050,240 1400,280 1400,500" fill="#1B2A4A" opacity="0.75" />
        <polygon points="0,500 0,360 380,330 760,370 1130,320 1400,350 1400,500" fill="#22314f" opacity="0.92" />

        <!-- River, catching the light -->
        <path class="drift-slow" d="M0,500 Q200,430 420,450 T860,440 T1400,455 L1400,500 Z" fill="url(#riverGrad)" />
        <path d="M0,500 Q220,460 460,470 T900,462 T1400,472 L1400,500 Z" fill="#F07E23" opacity="0.14" />
      </svg>
    </div>
  )}
  <div class="hero-inner-wrap">
    <div class="container hero-inner">
      <span class="eyebrow hero-eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .layered-hero {
    position: relative; overflow: hidden;
    min-height: 28rem; display: flex; align-items: flex-end;
    background: #0d1730;
  }
  .layered-hero--compact { min-height: 17rem; }

  .hero-art { position: absolute; inset: 0; }
  .hero-svg { width: 100%; height: 100%; display: block; }
  .drift-slow { animation: drift 14s ease-in-out infinite; transform-origin: center; }
  @keyframes drift {
    0%, 100% { transform: translateX(0) translateY(0); }
    50% { transform: translateX(-6px) translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) { .drift-slow { animation: none; } }

  .hero-photo { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .hero-photo-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(13,23,48,0.35) 0%, rgba(13,23,48,0.82) 100%);
  }
  .photo-credit {
    position: absolute; bottom: 0.6rem; right: 0.8rem; z-index: 2;
    font-size: 0.6875rem; color: rgba(255,255,255,0.6);
  }

  .hero-inner-wrap { position: relative; z-index: 1; width: 100%; padding-block: var(--space-6) var(--space-5); }
  .layered-hero--compact .hero-inner-wrap { padding-block: var(--space-4) var(--space-3); }

  .hero-eyebrow {
    color: var(--color-prairie, #F5B429); font-weight: 700;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }
  .layered-hero h1 {
    color: #fff; margin-block: 0.35rem 0.6rem;
    text-shadow: 0 4px 24px rgba(0,0,0,0.35);
    letter-spacing: -0.01em;
  }
  .layered-hero--compact h1 { font-size: var(--step-2); }
  .hero-subtitle {
    max-width: 46ch; color: rgba(255,255,255,0.9); font-size: 1.125rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
    margin: 0;
  }
</style>
